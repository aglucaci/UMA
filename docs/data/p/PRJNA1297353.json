{"v":1,"accession":"PRJNA1297353","title":"Mixotrophic Nitrification Denitrification","description":"The integration of sequential nitrification/heterotrophic denitrification (SNHD) or sequential nitrification/mixotrophic denitrification (SNMD) within a single reactor has been scarcely reported. This study aimed to adapt an industrial inoculum to SNHD and SNMD using two types of sequential batch reactors: a control (SBR) and one with zeolite (SBBR). Over 276 days (d), reactors operated in 7-day cycle (3.38 d nitrification; 3.38 d denitrification; 0.5 d medium replacement). No significant differences were observed between the system with carriers (zeolite) and the system without carriers, although zeolite has a role in the type of microorganisms that developed in SBBR.","center":"Universidad de Santiago de Chile","data_type":"Raw sequence reads","submission_date":"2025/07/28 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN50222036","MIMARKS Survey related sample from sludge metagenome","non_urban",null,null,null,"CL","O'Higgins Region",3873775,"Rancagua","probable",-34.1989,-70.8678,"Chile: Doigue",null,"treatment plant biome","piggery wastewater","aerated lagoon","environmental sample from a non-urban site"],["SAMN50222037","MIMARKS Survey related sample from sludge metagenome","non_environmental",null,null,null,"CL","Santiago Metropolitan",3871336,"Santiago","verified",-33.4473,-70.6814,"Chile: Santiago",null,"bioreactor biome","control","sequential nitrification/heterotrophic denitrification","laboratory or culture material"],["SAMN50222038","MIMARKS Survey related sample from sludge metagenome","non_environmental",null,null,null,"CL","Santiago Metropolitan",3871336,"Santiago","verified",-33.4473,-70.6814,"Chile: Santiago",nu