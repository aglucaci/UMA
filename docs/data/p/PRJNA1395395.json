{"v":1,"accession":"PRJNA1395395","title":"Municipal sludge compost Metagenome","description":"Conventional aerobic composting of municipal sludge is often limited by low efficiency and unstable product quality. In this study, high-throughput sequencing was used to evaluate the composting performance of a self-selected hyperthermophilic consortium (NJ) as the experimental group, with a commercial inoculant (SY) as the control. The results showed that NJ exhibited better composting performance, including enhanced organic matter degradation, improved compost stabilization, and higher compost maturity compared with SY. Microbial community analysis indicated that NJ promoted a microbial structure more favorable for high-temperature composting. This study provides microbial evidence supporting the application of hyperthermophilic consortia in municipal sludge composting.","center":"Southeast University","data_type":"Metagenome","submission_date":"2025/12/30 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN54365302","NJ_1","probable_urban","municipal_wastewater","2023-01-04",2023,"CN","Jiangsu",1799962,"Nanjing","verified",32.06,118.78,"China:Nanjing","sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN54365303","NJ_2","probable_urban","municipal_wastewater","2023-01-05",2023,"CN","Jiangsu",1799962,"Nanjing","verified",32.06,118.78,"China:Nanjing","sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN54365304","NJ_3","confirmed_urban","municipal_wastewater","2023-01-16",2023,"CN","Jiangsu",1799962,"Nanjing","verified",32.06,118.78,"China:Nanjing","municipal sludge",null,null,null,"explicit urban setting at sample level"],["SAMN54365305","SY_1","probable_urban","municipa