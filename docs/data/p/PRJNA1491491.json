{"v":1,"accession":"PRJNA1491491","title":"Microbial community dynamics in anaerobic digesters treating food waste and sewage sludge","description":"This study investigated bacterial and archaeal community dynamics in food waste and sewage sludge anaerobic digesters operated at 35 C and 45 C. The goal was to evaluate how feedstock type, operating temperature, inoculum source, and operational transitions affected anaerobic digestion performance and microbial community development from start-up to long-term operation. Microbial communities were analyzed using Illumina MiSeq sequencing of the 16S rRNA gene V3-V4 region. The study provides insight into feedstock-dependent process stability and microbial responses associated with reactor resilience or instability.","center":"University of Southampton","data_type":"Raw sequence reads","submission_date":"2026/07/07 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN61462996","MIMARKS Survey related sample from anaerobic digester metagenome","non_environmental",null,"2024-05-22",2024,"GB","England",2637487,"Southampton","verified",50.91,-1.4,"United Kingdom: Southampton",null,"anthropogenic terrestrial biome [ENVO:01000219]","anaerobic bioreactor [ENVO:00002124]","anaerobic digester sludge [ENVO:00003965]","laboratory or culture material"],["SAMN61462997","MIMARKS Survey related sample from anaerobic digester metagenome","non_environmental",null,"2024-05-22",2024,"GB","England",2637487,"Southampton","verified",50.91,-1.4,"United Kingdom: Southampton",null,"anthropogenic terrestrial biome [ENVO:01000219]","anaerobic bioreactor [ENVO:00002124]","anaerobic digester sludge [ENVO:00003965]","laboratory or culture material"],["SAMN61462998","MIMARKS Survey related sample from anaerobic digester