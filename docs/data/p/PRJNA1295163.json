{"v":1,"accession":"PRJNA1295163","title":"Overlooked risk source during landfill mining: High-risk airborne micropollutants and potential pathogenic bioaerosol","description":"This study selected seven types of HRAM in 2.5-micrometer particulate matter (PM2.5), inhalable particles (PM10) and total suspended particulates (TSP) during entire landfill mining process by suspect screening. PPM in these particulate matter (PM) samples were also screened, in order to unravelling the occurrence characteristics of HRAM and PPM. Meanwhile, aerosolization potential of HRAM and PPM were evaluated by aerosolization index (AI) based on the occurrence characteristics in PMs and waste. Structural equation model (SEM) was used to clarify the similarity and differences of cross media behavior. Results of this study can provide scientific reference and management suggestion for airborne pollution control during landfill mining.","center":"Tongji University","data_type":"Raw sequence reads","submission_date":"2025/07/23 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN50153277","bacterial metagenome1","non_urban",null,null,2024,"CN","Zhejiang",1793952,"Songyuan","probable",27.6232,119.0568,"China: Zhejiang","environmental sample1",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN50153278","bacterial metagenome2","non_urban",null,null,2024,"CN","Zhejiang",1793952,"Songyuan","probable",27.6232,119.0568,"China: Zhejiang","environmental sample2",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN50153279","bacterial metagenome3","non_urban",null,null,2024,"CN","Zhejiang",1793952,"Songyuan","probable",27.6232,119.0568,"China: Zhejiang","environmental sample3",null,null,null,"BioProject ind