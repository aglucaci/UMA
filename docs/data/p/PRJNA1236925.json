{"v":1,"accession":"PRJNA1236925","title":"Regulation of waste activated sludge fermentation directed towards product spectrum via tailored blending of incompletely oxidizing sulfate-reducing bacteria","description":"The recovery of resources and energy via anaerobic treatment was a key approach for utilizing carbonaceous organics in waste activated sludge (WAS). The employment of incomplete oxidative sulfate-reducing bacteria (io-SRB) could alleviate the thermodynamic constraints of the hydrogen-producing acetogenesis process and enhance WAS fermentation. The impact of various blending strategies of io-SRB on anaerobic fermentation performance, however, remained poorly understood. This study investigated the effects of different blending ratios of io-SRB on the anaerobic fermentation performance of sludge.","center":"Taiyuan University of Technology","data_type":"Raw sequence reads","submission_date":"2025/03/17 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN47409363","F_111","uncertain",null,"2023-01-12",2023,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN47409365","F_114","uncertain",null,"2023-01-12",2023,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN47409367","F_141","uncertain",null,"2023-01-12",2023,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN47409369","F_411","uncertain",null,"2023-01-12",2023,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN47409371","F_Conrol","uncertain",null,