{"v":1,"accession":"PRJEB111196","title":"Improvement of machine learning models on wastewater data","description":"In this research an improved machine learning model for bacterial community time-series prediction and outlier detection is presented that allows stronger seasonality modeling and generalizability. The proposed architecture combines temporal convolutional networks and recurrent layers with a dedicated metadata branch, decoupling environmental variables from microbial trajectories. An attention mechanism captures long-range temporal dependencies, while a gating strategy adaptively integrates microbial and metadata representations. This design increases sensitivity to temperature-driven and seasonal effects while maintaining robustness across datasets with varying metadata availability. Empirical evaluation demonstrates improved predictive performance and more reliable anomaly detection compared to baseline approaches.","center":"Institute for Artificial Intelligence in Medicine, University Hospital Essen","data_type":"Other","submission_date":"2026/07/02 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA122710368","WWKL2403","uncertain",null,"2024-04-11",2024,"DE",null,null,null,"unresolved",null,null,"Germany",null,null,null,null,"environmental sample; urban association not established"],["SAMEA122710369","WWKL2404","uncertain",null,"2024-04-16",2024,"DE",null,null,null,"unresolved",null,null,"Germany",null,null,null,null,"environmental sample; urban association not established"],["SAMEA122710370","WWKL2405","uncertain",null,"2024-04-18",2024,"DE",null,null,null,"unresolved",null,null,"Germany",null,null,null,null,"environmental sample; urban association not established"],["SAMEA122710371","WWKL2406","uncertain",nu