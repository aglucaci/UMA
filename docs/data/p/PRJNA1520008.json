{"v":1,"accession":"PRJNA1520008","title":"Valorization of Waste Activated Sludge from Municipal Wastewater Treatment Plants: Microbial Fuel Cell-Driven Low-Temperature Degradation and Bioelectricity Generation","description":"This project performed both 16S rRNA gene and ITS amplicon high-throughput sequencing to investigate the bacterial and fungal community structure and succession in SMFC. The reactors were fed with raw waste activated sludge (WAS) and operated under unheated low-temperature winter conditions. This study aims to reveal the key electroactive microorganisms, fungal-bacterial interactions, and microbial mechanisms related to bioelectricity generation and pollutant removal in liter-scale sediment microbial fuel cell systems.","center":"Taiyuan University of Technology","data_type":"Raw sequence reads","submission_date":"2026/08/27 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN62754197","Metagenome or environmental sample from activated sludge metagenome","probable_urban","municipal_wastewater","2025-12-10",2025,"CN","Shanxi",1803567,"Linfen","verified",36.0885,111.513,"China: Shanxi, Linfen","Biofilm on carbon felt anode of sediment microbial fuel cell fed with waste activated sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN62754198","Metagenome or environmental sample from activated sludge metagenome","probable_urban","municipal_wastewater","2025-12-10",2025,"CN","Shanxi",1803567,"Linfen","verified",36.0885,111.5131,"China: Shanxi, Linfen","Anodic biofilm of sediment microbial fuel cell fed with raw waste activated sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN62754199","Metagenome or environmental sample from activated sludge metage