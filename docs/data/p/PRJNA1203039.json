{"v":1,"accession":"PRJNA1203039","title":"Shifts in microbiome and antibiotic resistome due to the discharge of urban wastewater to rivers in the twin city, Odisha, India","description":"River surface water collected from various sites to determine the dissemination of ARGs and pathogenic microbial communities from wastewater to the river. The metagenomic sequences of the samples collected from nine different sites were analyzed for microbial community profiling, ARGs and MGEs. The study sheds information on the antibiotic resistome dynamics in the river water due to the discharge of urban wastewater directly into the river denoting the rivers as major reservoirs of mobile ARGs.","center":"Siksha O Anusandhan (deemed to be) University","data_type":"Raw sequence reads","submission_date":"2024/12/26 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN42183755","Metagenome or environmental sample from aquatic metagenome","probable_urban","water_drainage","2023-04-27",2023,"IN","Odisha",1275817,"Bhubaneswar","probable",20.4736,85.7689,"India","Mahanadi river",null,null,null,"urban context stated at BioProject level only"],["SAMN42183756","Metagenome or environmental sample from aquatic metagenome","probable_urban","municipal_wastewater","2023-04-27",2023,"IN","Odisha",1275817,"Bhubaneswar","probable",20.4686,85.8496,"India","Wastewater from CDA",null,null,null,"urban context stated at BioProject level only"],["SAMN42183757","Metagenome or environmental sample from aquatic metagenome","probable_urban","water_drainage","2023-04-27",2023,"IN","Odisha",1275817,"Bhubaneswar","probable",20.4661,85.851,"India","Kathajodi river",null,null,null,"urban context stated at BioProject level only"],["SAMN42183758","Metagenome or environmental sample