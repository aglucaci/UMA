{"v":1,"accession":"PRJNA1547315","title":"Mainstream anammox enables high-rate nitrogen and phosphorus removal from low-COD/N municipal wastewater in a biofilm-enhanced A2/O process","description":"A continuous-flow anaerobic/anoxic/oxic reactor with integrated fixed-film activated sludge (A2/O-IFAS) treated real low-COD/N municipal wastewater for 500 days without external carbon. Floc sludge, anoxic carrier biofilm and oxic carrier biofilm were sampled on days 1, 116, 400 and 500, and the V3-V4 region of the bacterial 16S rRNA gene was sequenced (Illumina MiSeq PE300) to characterize the microbial communities, including anammox bacteria, nitrifiers and phosphorus-accumulating organisms.","center":"Beijing University of Technology","data_type":"Raw sequence reads","submission_date":"2026/10/20 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN64311574","Floc sludge, day 1","confirmed_urban","municipal_wastewater","2022-07-23",2022,"CN","Beijing",1816670,"Beijing","verified",39.92,116.43,"China:Beijing","floc sludge of a lab-scale A2/O-IFAS reactor treating real municipal wastewater",null,null,null,"explicit urban setting at sample level"],["SAMN64311575","Anoxic biofilm, day 1","confirmed_urban","municipal_wastewater","2022-07-23",2022,"CN","Beijing",1816670,"Beijing","verified",39.92,116.43,"China:Beijing","anoxic carrier biofilm of a lab-scale A2/O-IFAS reactor treating real municipal wastewater",null,null,null,"explicit urban setting at sample level"],["SAMN64311576","Oxic biofilm, day 1","confirmed_urban","municipal_wastewater","2022-07-23",2022,"CN","Beijing",1816670,"Beijing","verified",39.92,116.43,"China:Beijing","oxic carrier biofilm of a lab-scale A2/O-IFAS reactor treating real municipal wastewater",null,null,null,"ex