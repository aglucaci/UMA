{"v":1,"accession":"PRJNA1454751","title":"Metagenomic analysis of biomass-retention states in sidestream partial nitritation reactors","description":"This project contains metagenomic sequencing data from sidestream partial nitritation sequencing batch reactors operated under different biomass-retention states. Three reactors were maintained at approximately 2, 4, and 6 g L-1 mixed liquor suspended solids (MLSS) under stepwise ammonium loading. The data were generated to investigate how biomass-retention state affects partial nitritation performance, ammonia-oxidizing bacterial activity, nitrifying guild structure, and functional gene expression. The study focuses on the relationship between retained nitrifier-related potential and realized ammonia-oxidizing function during load escalation.","center":"Tongji University","data_type":"Raw sequence reads","submission_date":"2026/04/17 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN57320012","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2025-06-20",2025,"CN","Shanghai",1796236,"Shanghai","verified",31.26,121.53,"China: Shanghai",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN57320013","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2025-06-20",2025,"CN","Shanghai",1796236,"Shanghai","verified",31.26,121.53,"China: Shanghai",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN57320014","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2025-06-20",2025,"CN","Shanghai",1796236,"Shanghai","verified",31.26,121.53,"China: Shanghai",null,null,null,null,"city-level lo