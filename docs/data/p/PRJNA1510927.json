{"v":1,"accession":"PRJNA1510927","title":"Differentiation of bacterial communities in shallow lake water and sediment during the frozen period: evidence from co-occurrence networks and community assembly","description":"This study focused on the water bodies and sediments of the frozen Yaluosui Lake. Based on 16S rRNA gene amplicon sequencing, combined with community diversity, co-occurrence networks, niche width, community assembly models, and environmental correlation analysis, it conducted an in-depth comparative analysis of the composition, diversity, network structure, assembly process, and environmental factor correlation mechanisms of the bacterial communities in these two habitats.","center":"Inner Mongolia Agricultural University","data_type":"Raw sequence reads","submission_date":"2026/08/11 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN62343047","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater",null,2024,"CN",null,null,null,"unresolved",40.0,108.0,"China: Wulianshui Lake","surficial sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN62343048","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater",null,2024,"CN",null,null,null,"unresolved",40.0,108.0,"China: Wulianshui Lake","surficial sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN62343049","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater",null,2024,"CN",null,null,null,"unresolved",40.0,108.0,"China: Wulianshui Lake","surficial sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN62343050","Metagenome or environmental s