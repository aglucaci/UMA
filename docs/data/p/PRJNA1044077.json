{"v":1,"accession":"PRJNA1044077","title":"The effect of biochar on microbial community during anaerobic digestion","description":"Alkaline biochar was added to the anaerobic co-digestion of poultry litter with wheat straw to examine its effect on the microbial community of the anaerobic sludge. The sludge in the initial stage (Initial), and the sludge after the digestion including the control (no biochar addition), and the treatment (Biochar) were compared in microbial community composition using 16S rRNA sequencing.","center":"University of Arkansas","data_type":"Raw sequence reads","submission_date":"2023/11/22 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN38369877","Initial stage sludge","non_urban",null,"2022-04-25",2022,"US","Arkansas",4110486,"Fayetteville","verified",null,null,"USA: Fayetteville, Arkansas",null,"Wastewater reactor","anaerobic sequencing batch digester","sludge","BioProject indicates an agricultural or industrial source"],["SAMN38369878","Sluge after AD without biochar","non_urban",null,"2022-08-04",2022,"US","Arkansas",4110486,"Fayetteville","verified",null,null,"USA: Fayetteville, Arkansas",null,"Wastewater reactor","batch anaerobic digester","sludge","BioProject indicates an agricultural or industrial source"],["SAMN38369879","Sluge after AD with biochar","non_urban",null,"2022-08-05",2022,"US","Arkansas",4110486,"Fayetteville","verified",null,null,"USA: Fayetteville, Arkansas",null,"Wastewater reactor","batch anaerobic digester","sludge","BioProject indicates an agricultural or industrial source"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR26918579","SAMN38369879","SRX2261257