{"v":1,"accession":"PRJDB18300","title":"Microbial community structure analysis in a photosynthesis reactor used for sub-treatment of microbial fuel cells.","description":"This project explore the microbial community in the photosynthesis reactor. The sampling sites were selected to represent diverse are as where the presence of microorganisms could impact the performance of photosynthesis process, including the zeolite on reactor (Zeo-S), those attached to plates submerged in the reactor (Zeo-P), zeolite material (Zeo-Z), and influent the zeolite reactor (referred to as Zeo-in).  Afterward, we determine the function of each microorganism for NH4+ and organic matter removal from sewage.","center":"Nagoya Institute of Technology","data_type":"Targeted Locus (Loci)","submission_date":"2024/06/24 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00794389","zeolite on reactor","uncertain",null,"2023-06-09",2023,"JP","Aichi",1856057,"Nagoya","verified",35.1268,136.9786,"Japan:Aichi, Nagoya",null,"aquatic biome","seawage","seawage","no environmental-sample evidence"],["SAMD00794390","attached to plates submerged in the reactor","uncertain",null,"2023-06-09",2023,"JP","Aichi",1856057,"Nagoya","verified",35.1268,136.9786,"Japan:Aichi, Nagoya",null,"aquatic biome","seawage","seawage","no environmental-sample evidence"],["SAMD00794391","zeolite material","uncertain",null,"2023-06-09",2023,"JP","Aichi",1856057,"Nagoya","verified",35.1268,136.9786,"Japan:Aichi, Nagoya",null,"aquatic biome","seawage","seawage","no environmental-sample evidence"],["SAMD00794392","influent the zeolite reactor","uncertain",null,"2023-06-09",2023,"JP","Aichi",1856057,"Nagoya","verified",35.1268,136.9786,"Japan:Aichi, Nagoya",null,"aquatic biome","seawage","seawag