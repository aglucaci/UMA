{"v":1,"accession":"PRJNA1469097","title":"Biological additives enhancing PPCPs degradationduring sewage sludge composting","description":"The persistence of pharmaceutical and personal care products (PPCPs) during sewage sludge composting poses environmental challenges and constrains the safe reuse of compost. This study systematically evaluated the efficacy of four bio additives cellulase (CL), protease (PR), sludge-fermenting bacteria (SF), and an effective microorganism inoculant (EM) in enhancing PPCPs removal and reducing ecological risks. under the assumed land application scenario, thereby potentially improving the overall safety of land use.","center":"Henan Normal University","data_type":"Raw sequence reads","submission_date":"2026/05/21 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN60340640","CK-0","uncertain",null,"2024-05-13",2024,null,null,null,null,"unresolved",null,null,null,"sludge",null,null,null,"environmental sample; urban association not established"],["SAMN60340641","CK-4","uncertain",null,"2024-05-17",2024,null,null,null,null,"unresolved",null,null,null,"sludge",null,null,null,"environmental sample; urban association not established"],["SAMN60340642","CK-8","uncertain",null,"2024-05-21",2024,null,null,null,null,"unresolved",null,null,null,"sludge",null,null,null,"environmental sample; urban association not established"],["SAMN60340643","CK-18","uncertain",null,"2024-05-31",2024,null,null,null,null,"unresolved",null,null,null,"sludge",null,null,null,"environmental sample; urban association not established"],["SAMN60340644","CK-30","uncertain",null,"2024-06-12",2024,null,null,null,null,"unresolved",null,null,null,"sludge",null,null,null,"environmental sample; urban association not established"],["SAMN6034