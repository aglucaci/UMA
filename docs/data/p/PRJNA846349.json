{"v":1,"accession":"PRJNA846349","title":"Diversity of comammox bacteria in wastewater.","description":"The overall objective of this study was to test the hypothesis that the widespread distribution and persistence of nearly identical comammox bacterial population in multiple secondary wastewater treatment systems was due to the presence of large number of co-existing strains (i.e., high microdiversity). To accomplish this, we used a combination of full-length 16S rRNA gene sequencing and hybrid metagenome assembly and binning approach to systematically explore the population and strain level diversity of nitrifiers in three full-scale nitrogen removal systems with different process configurations. In doing so, we also aimed to assess factors that may influence the population and intra-population diversity of co-existing nitrifiers.","center":"Northeastern University","data_type":"Genome sequencing and assembly","submission_date":"2022/07/15 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN28887174","Metagenome or environmental sample from activated sludge metagenome","uncertain",null,null,2018,"US","Pennsylvania",null,null,"unresolved",null,null,"USA: Pennsylvania","wastewater",null,null,null,"environmental sample; urban association not established"],["SAMN28887175","Metagenome or environmental sample from activated sludge metagenome","uncertain",null,null,2018,"US","Pennsylvania",null,null,"unresolved",null,null,"USA: Pennsylvania","wastewater",null,null,null,"environmental sample; urban association not established"],["SAMN28887176","Metagenome or environmental sample from activated sludge metagenome","uncertain",null,null,2018,"US","Pennsylvania",null,null,"unresolved",null,null,"USA: Pennsylvania","wastewater",null,null,nul