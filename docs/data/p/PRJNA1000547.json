{"v":1,"accession":"PRJNA1000547","title":"Floc sluge and biocarriers samples at different reflux ratios","description":"The samples were taken from a CANON reactor based on MBBR. The reflux ratio experiment was carried out at the concentration of ~300 mg/L ammonia nitrogen. The samples were inoculated floc sludge and biological carrier respectively, and floc sludge and biological carrier in stable operation stage (75th day) with different reflux ratio. Among them, the floc sludge and biological carrier samples are the mixed sludge of floc sludge and biological carrier in the three reaction zones of the reactor, respectively.","center":"Beijingjiaotong University","data_type":"Raw sequence reads","submission_date":"2023/07/31 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN36770565","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2023-01-20",2023,"CN","Beijing",1816670,"Beijing","verified",39.54,116.35,"China:Beijing",null,null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN36770566","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2023-01-20",2023,"CN","Beijing",1816670,"Beijing","verified",39.54,116.35,"China:Beijing",null,null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN36770567","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2023-01-20",2023,"CN","Beijing",1816670,"Beijing","verified",39.54,116.35,"China:Beijing",null,null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN36770568","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2023-01-20",2023,"CN","Beijing",1816670,"Beijing","verified",39.54,116.35,"China:Beijing",null,null,nu