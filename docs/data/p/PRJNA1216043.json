{"v":1,"accession":"PRJNA1216043","title":"Glucose-induced mixotrophic fermentation to alleviate the H2S inhibition on syngas bioconversion","description":"The inhibitory threshold and mechanism of H2S to syngas fermentation have been elucidated, but the methods to minimize H2S inhibition are urgently needed. Herein, the present study attempted to stimulate microbial proliferation by changing the nutritional type, and systematically revealed whether and how glucose-induced mixotrophic fermentation alleviate H2S inhibition in syngas bioconversion.","center":"Jiangnan University","data_type":"Raw sequence reads","submission_date":"2025/01/27 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN46424527","Control","uncertain",null,"2024-06-18",2024,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN46424528","Control","uncertain",null,"2024-06-18",2024,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN46424529","Control","uncertain",null,"2024-06-18",2024,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN46424530","S2","uncertain",null,"2024-06-18",2024,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN46424531","S2","uncertain",null,"2024-06-18",2024,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN46424532","S2","uncertain",null,"2024-06-18",2024,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmenta