{"v":1,"accession":"PRJNA1496078","title":"Transcriptomic analysis of Rhodococcus pyridinivorans grown in Organic Liquid Extract (OLE) derived from polyurethane ozonolysis","description":"This project investigates the transcriptomic response of Rhodococcus pyridinivorans grown in an Organic Liquid Extract (OLE) generated by the aqueous ozonolytic depolymerization of polyurethane waste. RNA sequencing was performed to identify differentially expressed genes and metabolic pathways involved in the assimilation of OLE-derived compounds, providing insights into the microbial mechanisms underlying the biological valorization of polyurethane waste.","center":"University of Seville","data_type":"Raw sequence reads","submission_date":"2026/07/16 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN61667317","bacterial culture","uncertain",null,"2022-10-14",2022,"ES","Andalusia",2511495,"Salteras","verified",null,null,"Spain: slaughterhouse Matadero del Sur (Salteras)","Sludge from slaughterhouse wastewater treatment plant",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN61667318","bacterial culture","uncertain",null,"2022-10-14",2022,"ES","Andalusia",2511495,"Salteras","verified",null,null,"Spain: slaughterhouse Matadero del Sur (Salteras)","Sludge from slaughterhouse wastewater treatment plant",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN61667319","bacterial culture","uncertain",null,"2022-10-14",2022,"ES","Andalusia",2511495,"Salteras","verified",null,null,"Spain: slaughterhouse Matadero del Sur (Salteras)","Sludge from slaughterhouse wastewater treatment plant",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN61667320","bacterial culture","uncerta