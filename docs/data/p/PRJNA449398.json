{"v":1,"accession":"PRJNA449398","title":"Finding the source: towards quantitative methods for microbial sourcing tracking","description":"In this study, amplicon sequencing (emerging technique not fully adapted for source tracking) is applied for microbial source tracking of spiked samples (mixtures of surface water and known quantities of horse, goose, and dog fecal matter, and wastewater) as well as field samples of impacted surface water. Results will be evaluated to identify microbial community fingerprints associated with different fecal sources within the samples. The goal is to verify/demonstrate amplicon sequencing as an effective fingerprinting method with great potential for future use in source tracking.","center":"Rutgers University","data_type":"Raw sequence reads","submission_date":"2018/04/09 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN08902890","SW","confirmed_urban","municipal_wastewater","2017-07-12",2017,"US","New York",5139568,"Staten Island","probable",40.3543,-74.0724,"USA: New Jersey","Surface Water- Navesink River, Wastewater treatment plant influent",null,null,null,"named urban infrastructure at sample level"],["SAMN08902891","Swdup","confirmed_urban","municipal_wastewater","2017-07-12",2017,"US","New York",5139568,"Staten Island","probable",40.3543,-74.0724,"USA: New Jersey","Surface Water- Navesink River, Wastewater treatment plant influent",null,null,null,"named urban infrastructure at sample level"],["SAMN08902892","SWG","uncertain",null,"2017-07-12",2017,"US","New York",5139568,"Staten Island","probable",40.3543,-74.0724,"USA: New Jersey","Surface Water- Navesink River, Wastewater treatment plant influent, fecal sample",null,null,null,"conflicting evidence: environmental and host/clinical"],["