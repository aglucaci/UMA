{"v":1,"accession":"PRJNA988503","title":"Continuous Co-treatment of Mine Drainage with Municipal Wastewater","description":"Synthetic acid mine drainage (AMD) was co-treated with synthetic MWW in a continuously-operating (24 hr/d) bench-scale sequencing batch reactor (SBR). The treatment system simulates addition of AMD after aeration but before secondary settling. SBRs treated MWW with two strengths of AMD (91 and 720 mg/L as CaCO3 Acidity) to capture the variations of coal AMD chemistry and strength observed in the field. Each co-treatment phases lasted 40+ days, during which clarified effluent and settled sludge quality was routinely monitored to determine impacts of co-treatment on the wastewater microbial community.","center":"Iowa State University","data_type":"Raw sequence reads","submission_date":"2023/06/28 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN36022855","MIMARKS Survey related sample from metagenome","non_urban",null,"2022-05-18",2022,"US","Rhode Island",8436572,"South Kingstown","probable",41.4862,-71.5307,"USA: Rhode Island",null,"wastewater","acid mine drainage1","wastewater","BioProject indicates an agricultural or industrial source"],["SAMN36022856","MIMARKS Survey related sample from metagenome","non_urban",null,"2022-05-18",2022,"US","Rhode Island",8436572,"South Kingstown","probable",41.4862,-71.5307,"USA: Rhode Island",null,"wastewater","acid mine drainage2","wastewater","BioProject indicates an agricultural or industrial source"],["SAMN36022857","MIMARKS Survey related sample from metagenome","non_urban",null,"2022-05-18",2022,"US","Rhode Island",8436572,"South Kingstown","probable",41.4862,-71.5307,"USA: Rhode Island",null,"wastewater","acid mine drainage3","wastewater","BioProject indicates an a