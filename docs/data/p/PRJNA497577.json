{"v":1,"accession":"PRJNA497577","title":"Studies of microbial diversity during dark fermentation of food waste","description":"Deciphering the microbial composition is one of the most important steps in dark fermentation studies in order to optimize H2 production. In particular, changes in microbial composition after inoculum pre-treatment in comparison with the untreated inoculum reveals the efficiency of the process. Changes in microbial community composition were studied after inoculum pre-treatment with waste frying oil. Moreover, microbial dynamics were followed after dark fermentation of food waste using pre-treated inoculum.","center":"University of Padova","data_type":"Raw sequence reads","submission_date":"2018/10/19 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN10261084","Metagenome sample from C","probable_urban","municipal_wastewater","2018-01-15",2018,"IT","Veneto",3171728,"Padua","verified",45.3865,11.9108,"Italy: Padova",null,"ENVO:00002129","ENVO:00002129","ENVO:00002129","city-level location without sample-site confirmation"],["SAMN10261085","Metagenome sample from P","probable_urban","municipal_wastewater","2018-01-16",2018,"IT","Veneto",3171728,"Padua","verified",45.3865,11.9108,"Italy: Padova",null,"ENVO:00002129","ENVO:00002129","ENVO:00002129","city-level location without sample-site confirmation"],["SAMN10261086","Metagenome sample from W","probable_urban","municipal_wastewater","2018-01-17",2018,"IT","Veneto",3171728,"Padua","verified",45.3865,11.9108,"Italy: Padova",null,"ENVO:00002129","ENVO:00002129","ENVO:00002129","city-level location without sample-site confirmation"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","rele