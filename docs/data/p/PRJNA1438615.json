{"v":1,"accession":"PRJNA1438615","title":"Auto-floating microalgal granule","description":"Enrichment of auto-floating microalgal granules. This study presents a simple and effective approach to improve microalgae-based wastewater treatment by enabling microalgae to naturally float and aggregate, making them easier to collect. The process works reliably under practical, non-sterile conditions and leads to the formation of stable structures that enhance both separation and treatment performance. Overall, it offers a low-cost and efficient solution for nutrient removal and biomass recovery.","center":"University of Galway","data_type":"Raw sequence reads","submission_date":"2026/03/17 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN56542514","MIMARKS Survey related sample from wastewater metagenome","uncertain",null,"2023-12-10",2023,"IE","Connacht",2964180,"Galway","probable",53.27,-9.05,"Ireland",null,"aquatic biome","wastewater treatment","wastewater","environmental sample; urban association not established"],["SAMN56542515","MIMARKS Survey related sample from wastewater metagenome","uncertain",null,"2024-02-06",2024,"IE","Connacht",2964180,"Galway","probable",53.27,-9.05,"Ireland",null,"aquatic biome","wastewater treatment","wastewater","environmental sample; urban association not established"],["SAMN56542516","MIMARKS Survey related sample from wastewater metagenome","uncertain",null,"2024-03-11",2024,"IE","Connacht",2964180,"Galway","probable",53.27,-9.05,"Ireland",null,"aquatic biome","wastewater treatment","wastewater","environmental sample; urban association not established"],["SAMN56542517","MIMARKS Survey related sample from wastewater metagenome","uncertain",null,"2024-04-23",2024,"IE","Connacht",2964180,"Galway","pr