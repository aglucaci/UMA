{"v":1,"accession":"PRJNA475478","title":"Distribution of aerial grass pollen revealed using environmental metabarcoding","description":"Grass pollen is an important aeroallergen and sensitivity towards grass pollen varies between species, but currently there is no way of detecting, modelling or forecasting the aerial-dispersion of grass pollen below family level. Environmental metabarcoding allows challenging biodiversity assessments to be completed with relative ease, using high throughput methods. Using metabarcoding sequencing of the rbcL and ITS2 markers, we show that there is a seasonal progression of aerial grass pollen which varies with latitude across Britain.","center":"PollerGEN","data_type":"Raw sequence reads","submission_date":"2018/06/11 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN09389965","IOW_w1_p1","probable_urban","air_dust","2016-05-23",2016,"GB","England",2639996,"Portsmouth","probable",50.7111,-1.3009,"United Kingdom: Isle of Wight",null,"air",null,"air","city-level location without sample-site confirmation"],["SAMN09389966","BNG_w1_p1","probable_urban","air_dust","2016-05-25",2016,"GB","Wales",2656397,"Bangor","verified",53.23,-4.13,"United Kingdom: Bangor",null,"air",null,"air","city-level location without sample-site confirmation"],["SAMN09389967","WOR_w1_p1","probable_urban","air_dust","2016-05-25",2016,"GB","England",2633563,"Worcester","verified",52.1976,-2.243,"United Kingdom: Worcester",null,"air",null,"air","city-level location without sample-site confirmation"],["SAMN09389968","YORK_w1_p1","probable_urban","air_dust","2016-05-26",2016,"GB","England",2633352,"York","verified",53.9484,-1.0535,"United Kingdom: York",null,"air",null,"air","city-level location without sample-site confirmation"],[