{"v":1,"accession":"PRJNA1086902","title":"Microbial communities in an advanced water treatment system for potable reuse","description":"The objective of this study was to characterize the diversity, dominant taxa, and changes in the microbial communities across unit processes in a potable reuse treatment train that incorporates primary, secondary, and tertiary wastewater treatment followed by ozonation, biological activated carbon (BAC) filtration, membrane filtration, reverse osmosis (RO), and ultraviolet and advanced oxidation processes (UV/AOP). Furthermore, the potential metabolic capabilities of microorganisms detected in the BAC filter biofilm were assessed, especially those related to the degradation of aromatic compounds.","center":"San Diego State University","data_type":"Raw sequence reads","submission_date":"2024/03/12 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN40418770","Untreated_1","probable_urban","municipal_wastewater","2018-07-26",2018,"US","California",5391811,"San Diego","probable",null,null,"USA: San Diego",null,"sewage biome","sewage collected at treatment plant after headworks","water","city-level location without sample-site confirmation"],["SAMN40418771","Untreated_2","probable_urban","municipal_wastewater","2018-07-26",2018,"US","California",5391811,"San Diego","probable",null,null,"USA: San Diego",null,"sewage biome","sewage collected at treatment plant after headworks","water","city-level location without sample-site confirmation"],["SAMN40418772","Untreated_3","probable_urban","municipal_wastewater","2018-07-26",2018,"US","California",5391811,"San Diego","probable",null,null,"USA: San Diego",null,"sewage biome","sewage collected at treatment plant after headworks","water","city-level location w