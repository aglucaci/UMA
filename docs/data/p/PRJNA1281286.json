{"v":1,"accession":"PRJNA1281286","title":"Acidic nitrification bioreactor metatranscriptome","description":"In this study, we characterise identify and metabolic features of microbiome originated from acidic nitrification bioreactors. These bioreactors are operated to enhance energy efficiency in wastewater treatment processes. We conducted metagenomic and metatranscriptomic analysis coupled with reactor operation to understand the identity and metabolic capabilities that allowed microorganisms to facilitate nitrification at acidic pH.","center":"The University of Queensland","data_type":"Raw sequence reads","submission_date":"2025/06/23 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN49556053","R2","non_environmental",null,null,2024,"AU",null,null,null,"unresolved",null,null,"Australia",null,"wastewater treatment plant (ENVO_00002043)",null,null,"laboratory or culture material"],["SAMN49556054","R3","non_environmental",null,null,2024,"AU",null,null,null,"unresolved",null,null,"Australia",null,"wastewater treatment plant (ENVO_00002043)",null,null,"laboratory or culture material"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR34148066","SAMN49556054","SRX29328685","Metatranscriptomics","WGS","METATRANSCRIPTOMIC","PAIRED","ILLUMINA","Illumina NovaSeq 6000",19560183748,74153885,"2026-07-01","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos9/sra-pub-zq-924/SRR034/34148/SRR34148066/SRR34148066.lite.1"],["SRR34148067","SAMN49556053","SRX29328684","Metatranscriptomics","WGS","METATRANSCRIPTOMIC","PAIRED","ILLUMINA","Illumina NovaSeq 6000",19928444055,72283322,"2026-07-01","https://sra-downloadb.be-md.ncbi.nlm.nih