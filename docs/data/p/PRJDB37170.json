{"v":1,"accession":"PRJDB37170","title":"Metagenomic sequencing of livestock farm wastewater samples from Chongqing, China (PRJCA041830)","description":"This project involves metagenomic sequencing of wastewater samples collected from livestock farms in Chongqing, China. The study aims to investigate microbial community composition, functional gene profiles, and the occurrence of antibiotic resistance genes in agricultural wastewater. Sequencing was performed on the BGI T7 platform, with each sample generating over 20 Gb of paired-end data. The dataset contributes to understanding the ecological impact and public health relevance of microbial pollutants in livestock wastewater environments.","center":"Ecological and Environment Monitoring Center of Chongqing","data_type":"Other","submission_date":"2025/09/24 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD01632681","CQLS-TZ1 (SAMC5318632)","non_urban",null,"2023-09-17",2023,null,null,null,null,"unresolved",null,null,"missing: data agreement established pre-2023",null,"farm","sewage","waste water","environmental sample from a non-urban site"],["SAMD01632682","CQLS-TZ2 (SAMC5318633)","non_urban",null,"2023-09-17",2023,null,null,null,null,"unresolved",null,null,"missing: data agreement established pre-2023",null,"farm","sewage","waste water","environmental sample from a non-urban site"],["SAMD01632683","CQLS-TZ3 (SAMC5318634)","non_urban",null,"2023-09-17",2023,null,null,null,null,"unresolved",null,null,"missing: data agreement established pre-2023",null,"farm","sewage","waste water","environmental sample from a non-urban site"],["SAMD01632684","CQLS-RQ1 (SAMC5318635)","non_urban",null,"2023-09-17",2023,null,null,null,null,"unresolved",null,null,"missing: data agreement establishe