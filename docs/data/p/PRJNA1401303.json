{"v":1,"accession":"PRJNA1401303","title":"Urban forest soil metagenomic data","description":"Urban forests serve as significant reservoirs of soil organic carbon (SOC) within terrestrial ecosystems and play a critical role in the global carbon (C) cycle. However, the regulatory mechanisms underlying SOC dynamics across urbanization gradients in urban forests remain poorly understood. In this study, we investigated the interrelationships among plant diversity, SOC and its oxidation-stable fractions, and microbial functional genes across an urbanization gradient encompassing an urban center (UC), urban subcenter, suburb, and exurb.","center":"Nanning Normal University","data_type":"Raw sequence reads","submission_date":"2026/01/11 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN54560407","Metagenome or environmental sample from metagenome","probable_urban","soil_greenspace",null,2024,"CN","Guangxi",1799869,"Nanning","verified",22.78,108.78,"China:Nanning","soil",null,null,null,"city-level location without sample-site confirmation"],["SAMN54560408","Metagenome or environmental sample from metagenome","probable_urban","soil_greenspace",null,2024,"CN","Guangxi",1799869,"Nanning","verified",22.76,108.75,"China:Nanning","soil",null,null,null,"city-level location without sample-site confirmation"],["SAMN54560409","Metagenome or environmental sample from metagenome","probable_urban","soil_greenspace",null,2024,"CN","Guangxi",1799869,"Nanning","verified",22.77,108.73,"China:Nanning","soil",null,null,null,"city-level location without sample-site confirmation"],["SAMN54560410","Metagenome or environmental sample from metagenome","probable_urban","soil_greenspace",null,2024,"CN","Guangxi",1799869,"Nanning","verified",22.74,108.67,"China:Na