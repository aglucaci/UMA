{"v":1,"accession":"PRJNA1260180","title":"Metagenomic sequencing of activated sludge from sewage treatment plants","description":"Achieving energy-efficient simultaneous removal of nitrogen and phosphorus is a key goal for the sustainable development of municipal sewage treatment. This study focused on a large municipal sewage treatment plant in a tropical region. The staged influent multi-stage AO process was adopted to systematically investigate the enrichment characteristics of anaerobic ammonia-oxidizing bacteria in aerobic biofilms and their role in mainstream denitrification. Microbial data were measured by metagenomic sequencing.","center":"Hainan university","data_type":"Raw sequence reads","submission_date":"2025/05/08 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN48387612","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2024-06-27",2024,"CN","Hainan",1809078,"Haikou","verified",20.06,110.33,"China:haikou","WWTP-1",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN48387613","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2024-06-27",2024,"CN","Hainan",1809078,"Haikou","verified",20.06,110.33,"China:haikou","WWTP-2",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN48387614","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2024-06-27",2024,"CN","Hainan",1809078,"Haikou","verified",20.06,110.33,"China:haikou","WWTP-3",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN48387615","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2024-06-27",2024,"CN","Hainan",1809078,"Haikou","verified",20.06,110.33,"China:haikou","WWTP-4",