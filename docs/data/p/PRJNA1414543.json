{"v":1,"accession":"PRJNA1414543","title":"Urban wastewater Metagenome","description":"This project comprises shotgun metagenomic sequencing of 13 municipal wastewater samples collected from the influent of an urban wastewater treatment plant in Guelph, Ontario, Canada. Samples were collected between October 2023 and July 2024 and processed using the Illumina Viral Surveillance Panel 2 hybrid capture enrichment protocol to enhance detection of viral nucleic acids. Libraries were sequenced on an Illumina NextSeq 1000 platform (2 x 150 bp), and resulting reads were analyzed using the DRAGEN microbial enrichment plus pipeline for taxonomic profiling.","center":"University of Guelph","data_type":"Metagenome","submission_date":"2026/01/26 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN54904225","Metagenome or environmental sample from metagenome","confirmed_urban","municipal_wastewater","2024-07-02",2024,"CA","Ontario",5967629,"Guelph","verified",43.5228,-80.2661,"Canada: Ontario, Guelph","municipal wastewater",null,null,null,"explicit urban setting at sample level"],["SAMN54904226","Metagenome or environmental sample from metagenome","confirmed_urban","municipal_wastewater","2024-04-02",2024,"CA","Ontario",5967629,"Guelph","verified",43.5228,-80.2661,"Canada: Ontario, Guelph","municipal wastewater",null,null,null,"explicit urban setting at sample level"],["SAMN54904227","Metagenome or environmental sample from metagenome","confirmed_urban","municipal_wastewater","2024-04-29",2024,"CA","Ontario",5967629,"Guelph","verified",43.5228,-80.2661,"Canada: Ontario, Guelph","municipal wastewater",null,null,null,"explicit urban setting at sample level"],["SAMN54904228","Metagenome or environmental sample from metagenome","confirmed_urban","m