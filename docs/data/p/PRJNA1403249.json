{"v":1,"accession":"PRJNA1403249","title":"Metagenomic analysis of microbial community response to simulated domestic sewage input in the Qiantang River Estuary","description":"This study investigates how domestic sewage discharge affects the carbon cycle in estuarine ecosystems, using the Qiantang River Estuary as a model system. We conducted a laboratory microcosm experiment simulating sewage input, through integrated multi-omics approaches including 16S rRNA gene sequencing, metagenomics, and metatranscriptomics, we tracked the dynamic responses of the aquatic microbial community over a 28-day incubation.","center":"Zhejiang Sci-Tech University","data_type":"Raw sequence reads","submission_date":"2026/01/15 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN54623400","Metagenome or environmental sample from bioreactor metagenome","non_environmental",null,"2025-06-17",2025,null,null,null,null,"unresolved",null,null,null,"water from the Qiantang River was supplemented with domestic sewage",null,null,null,"laboratory or culture material"],["SAMN54623401","Metagenome or environmental sample from bioreactor metagenome","non_environmental",null,"2025-06-17",2025,null,null,null,null,"unresolved",null,null,null,"water from the Qiantang River was supplemented with domestic sewage",null,null,null,"laboratory or culture material"],["SAMN54623402","Metagenome or environmental sample from bioreactor metagenome","non_environmental",null,"2025-06-17",2025,null,null,null,null,"unresolved",null,null,null,"water from the Qiantang River was supplemented with domestic sewage",null,null,null,"laboratory or culture material"],["SAMN54623403","Metagenome or environmental sample from bioreactor metagenome","non_environmental",null,"2025-06-17",2025,nu