{"v":1,"accession":"PRJNA1218404","title":"Effects of impurities on the syngas fermentation: Mechanism and future perspectives","description":"The inhibitory threshold and mechanism of H2S to syngas fermentation have been elucidated, but the methods to minimize H2S inhibition are urgently needed. Herein, the present study attempted to stimulate microbial proliferation by changing the nutritional type, and systematically revealed whether and how glucose-induced mixotrophic fermentation alleviate H2S inhibition in syngas bioconversion.","center":"Jiangnan University","data_type":"Raw sequence reads","submission_date":"2025/02/02 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN46521055","Control","uncertain",null,"2024-06-18",2024,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN46521056","Control","uncertain",null,"2024-06-18",2024,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN46521057","Control","uncertain",null,"2024-06-18",2024,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN46521058","S2","uncertain",null,"2024-06-18",2024,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN46521059","S2","uncertain",null,"2024-06-18",2024,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN46521060","S2","uncertain",null,"2024-06-18",2024,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urb