{"v":1,"accession":"PRJNA1081427","title":"Sequencing and DNA Yield Data for Zymo Microbial Community Standard (Cat# D6300) Extracted From Multiple Field-Deployable Sampler Options","description":"Shotgun-sequencing analysis of indoor microbiomes is critical to understanding the impacts of urban environments on human health and wellbeing. However, challenges in collecting sufficient biological material indoors, alongside sampling and processing inconsistencies, contribute to a field-wide crisis of replicability. Here, a sampling method utilizing deployable polydimethylsiloxane coupons optimized for commercially available extraction kits demonstrated greater DNA yields over swab-based protocols, which would improve the replicability of future indoor microbiome research.","center":"Yale CEA","data_type":"Raw sequence reads","submission_date":"2024/02/27 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN40175492","Metagenome or environmental sample from synthetic metagenome","non_environmental",null,"2021-11-03",2021,"US","New York",5128581,"New York City","verified",40.6935,-73.9875,"USA: NYC, 370 J Street","Zymo Microbial Community Standard (Cat# D6300",null,null,null,"laboratory or culture material"],["SAMN40175493","Metagenome or environmental sample from synthetic metagenome","non_environmental",null,"2021-11-03",2021,"US","New York",5128581,"New York City","verified",40.6935,-73.9875,"USA: NYC, 370 J Street","Zymo Microbial Community Standard (Cat# D6300",null,null,null,"laboratory or culture material"],["SAMN40175494","Metagenome or environmental sample from synthetic metagenome","non_environmental",null,"2021-11-03",2021,"US","New York",5128581,"New York City","verified",40.6935,-73.9875,"USA: NYC, 370 J Street","Zymo Microb