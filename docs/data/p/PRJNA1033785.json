{"v":1,"accession":"PRJNA1033785","title":"Efficient nitrogen removal from real municipal wastewater and mature landfill leachate using partial nitrification-simultaneous anammox and partial denitrification process","description":"Anaerobic ammonia oxidation (anammox) of municipal wastewater is a research focus, especially the combined treatment with mature landfill leachate is a current research hotspot. In this study, municipal wastewater was treated by partial nitrification via sequencing batch reactor (SBR), and its effluent and mature landfill leachate were then mixed into an up-flow anaerobic sludge blanket (UASB) for simultaneous anammox and partial denitrification reaction.","center":"Beijing University of Technology","data_type":"Raw sequence reads","submission_date":"2023/10/30 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN38044102","H_UASB_56d","non_urban",null,"2023-10-30",2023,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN38044103","H_UASB_120d","non_urban",null,"2023-10-30",2023,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN38044104","S_1d.","non_urban",null,"2023-10-30",2023,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN38044105","S_35d","non_urban",null,"2023-10-30",2023,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN38044106","S_56d","non_urban",null,"2023-10-30",2023,null,null,null,null,"unresolved",null,null