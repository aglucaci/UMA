{"v":1,"accession":"PRJNA672815","title":"Target capture data of Saxifraga (Saxifragaceae)","description":"Target capture data generated for Saxifraga ssp. through use of a specialized target capture reference sequences. Data is used for the study of the evolution of the genus Saxifraga, and effect of multi-copy loci within NGS datasets on phylogenetic inference. Most sequence data is retrieved from herbarium specimens and the effect of specimen age on target locus retrieval is tested.","center":"Royal Botanic Gardens, Kew","data_type":"Raw sequence reads","submission_date":"2020/10/28 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN16578559","Plant sample from Saxifraga tridactylites","non_environmental",null,null,null,"CH","Grisons",2659787,"Maienfeld","verified",null,null,"Switzerland: Graubunden, Maienfeld, railway station",null,null,null,null,"host-derived or clinical material"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR13090678","SAMN16578559","SRX9536446","Amplicon","AMPLICON","GENOMIC","PAIRED","ILLUMINA","Illumina MiSeq",151328352,251376,"2024-01-20","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos9/sra-pub-zq-924/SRR013/13090/SRR13090678/SRR13090678.lite.1"]],"sample_projects":{}}