{"v":1,"accession":"PRJNA739507","title":"Mask spreads antibiotic resistance during COVID-19 pandemic","description":"In the midst of the COVID-19 pandemic, the demand of facial mask remains high. However, little is known about the discarded mask as a potential refuge for contaminants that may shelter, enrich and spread antibiotic resistance genes (ARG) in marine systems. We address this subject by conducting an in-situ time-series experiment to investigate the dynamic change of ARGs, bacteria and protozoa in discarded masks.","center":"Chinese Academy of sciences","data_type":"Raw sequence reads","submission_date":"2021/06/21 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN19790722","A1","uncertain",null,"2021-03-03",2021,"CN","Fujian",1790645,"Xiamen","verified",24.6,118.06,"China: Xiamen","water",null,null,null,"no environmental-sample evidence"],["SAMN19790723","A2","uncertain",null,"2021-03-03",2021,"CN","Fujian",1790645,"Xiamen","verified",24.6,118.07,"China: Xiamen","water",null,null,null,"no environmental-sample evidence"],["SAMN19790724","A3","uncertain",null,"2021-03-03",2021,"CN","Fujian",1790645,"Xiamen","verified",24.6,118.08,"China: Xiamen","water",null,null,null,"no environmental-sample evidence"],["SAMN19790725","A4","uncertain",null,"2021-03-03",2021,"CN","Fujian",1790645,"Xiamen","verified",24.6,118.09,"China: Xiamen","water",null,null,null,"no environmental-sample evidence"],["SAMN19790726","A5","uncertain",null,"2021-03-10",2021,"CN","Fujian",1790645,"Xiamen","verified",24.6,118.1,"China: Xiamen","water",null,null,null,"no environmental-sample evidence"],["SAMN19790727","A6","uncertain",null,"2021-03-10",2021,"CN","Fujian",1790645,"Xiamen","verified",24.6,118.11,"China: Xiamen","water",null,null,null,"no env