{"v":1,"accession":"PRJNA1466314","title":"Laboratory scale studies of microbial diversity on anaerobic sludge","description":"This study investigated sulfur-driven dissimilatory nitrate reduction to ammonium in a continuous-flow reactor under different S/N ratios. Reactor performance, batch experiments, isotope tracing, and metagenomic analyses were used to characterize nitrogen and sulfur transformation pathways and microbial functional traits. The study focused on ammonium assimilation occurring simultaneously with nitrate reduction, which may underestimate ammonium production in sulfur-driven nitrate reduction systems. These findings improve understanding of microbial nitrogen retention and sulfur cycling in autotrophic wastewater treatment processes.","center":"Shandong University","data_type":"Raw sequence reads","submission_date":"2026/05/14 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN60054094","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater","2022-03-14",2022,"CN","Shandong",1797929,"Qingdao","verified",36.3614,120.6883,"China: Shandong, Qingdao","sulfur-driven DNRA reactor sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN60054095","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater","2022-04-28",2022,"CN","Shandong",1797929,"Qingdao","verified",36.3614,120.6883,"China: Shandong, Qingdao","sulfur-driven DNRA reactor sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN60054096","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater","2022-09-03",2022,"CN","Shandong",1797929,"Qingdao","verified",36.