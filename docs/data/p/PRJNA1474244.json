{"v":1,"accession":"PRJNA1474244","title":"Disintegrated halophilic aerobic granular sludge restoration using zinc oxide nanoparticles: Synergistic effects of fungal toxicity inhibition and extracellular polymeric substances production","description":"Halophilic aerobic granular sludge (HAGS) buking caused by filamentous fungal overgrowth limits its engineering application. This study applied zinc oxide nanoparticles (ZnO NPs) to recover disintegrated HAGS. This study showed that 1 and 10 mg/L of ZnO NPs could effectively inhibit the filamentous fungal overgrowth (the population size decreasing by 66.42% and 89.78% respectively), and successfully restored HAGS structure.","center":"Beijing University of Technology","data_type":"Raw sequence reads","submission_date":"2026/06/03 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN60588741","sludge","uncertain",null,"2025-03-01",2025,"CN","Beijing",1816670,"Beijing","probable",39.87,116.48,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN60588742","sludge","uncertain",null,"2025-03-01",2025,"CN","Beijing",1816670,"Beijing","probable",39.87,116.48,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN60588743","sludge","uncertain",null,"2025-03-01",2025,"CN","Beijing",1816670,"Beijing","probable",39.87,116.48,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN60588744","sludge","uncertain",null,"2025-03-01",2025,"CN","Beijing",1816670,"Beijing","probable",39.87,116.48,null,null,null,null,null,"environmental sample; urban association not established"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots"