{"v":1,"accession":"PRJNA1503081","title":"16S rRNA gene amplicon sequencing of microbial communities in HZ9-bioaugmented sequencing batch reactors under increasing ammonium loading","description":"This project characterizes bacterial community succession in two laboratory sequencing batch reactors treating synthetic landfill-leachate-like wastewater under stepwise increases in influent ammonium concentration. One reactor was repeatedly bioaugmented with Stutzerimonas stutzeri HZ9, whereas the control reactor received an equal volume of sterile water. The reactors were operated for 30 days across three ammonium-loading stages, with influent NH4+-N concentrations of 300, 500, and 800 mg/L and an operational duration of 10 days per stage. Sludge samples were analyzed by 16S rRNA gene amplicon sequencing to compare microbial community restructuring between the bioaugmented and control reactors and to evaluate community responses to increasing ammonium stress.","center":"Chinese Academy of Sciences","data_type":"Raw sequence reads","submission_date":"2026/07/27 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN62003256","Metagenome or environmental sample from activated sludge metagenome","uncertain",null,null,2026,"CN","Hubei",null,null,"unresolved",null,null,"China:Hubei","activated sludge",null,null,null,"environmental sample; urban association not established"],["SAMN62003257","Metagenome or environmental sample from activated sludge metagenome","uncertain",null,null,2026,"CN","Hubei",null,null,"unresolved",null,null,"China:Hubei","activated sludge",null,null,null,"environmental sample; urban association not established"],["SAMN62003258","Metagenome or environmental sample from activated sludge metagenome","uncertain",null,null,2