{"v":1,"accession":"PRJNA395239","title":"Indoor air viral diversity","description":"Diverse microbial communities inhabit human-occupied buildings and circulate in indoor air; however, little is known about viral diversity in these environments. Here we investigated DNA and RNA viruses circulating in the air of university dormitory rooms (n = 12) by analyzing dust accumulated over a one-year period on heating, ventilation, and air conditioning (HVAC) filters through viral metagenomics. This study significantly expands the known airborne viral diversity found indoors, enabling the design of sensitive and quantitative assays to further investigate specific viruses of interest.","center":"University of South Florida","data_type":"Raw sequence reads","submission_date":"2017/07/20 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN07373705","M1_DNA","uncertain",null,null,2015,"US","Colorado",5574991,"Boulder","probable",40.02,-105.26,"USA: Colorado","HVAC filters",null,null,null,"environmental sample; urban association not established"],["SAMN07373706","NegativeControl_DNA","uncertain",null,null,2015,"US","Colorado",5574991,"Boulder","probable",40.02,-105.26,"USA: Colorado","HVAC filters",null,null,null,"environmental sample; urban association not established"],["SAMN07373707","M2_DNA","uncertain",null,null,2015,"US","Colorado",5574991,"Boulder","probable",40.02,-105.26,"USA: Colorado","HVAC filters",null,null,null,"environmental sample; urban association not established"],["SAMN07373708","F1_DNA","uncertain",null,null,2015,"US","Colorado",5574991,"Boulder","probable",40.02,-105.26,"USA: Colorado","HVAC filters",null,null,null,"environmental sample; urban association not established"],["SAMN07373709","M3_DNA","uncertain",null,null,201