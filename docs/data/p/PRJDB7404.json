{"v":1,"accession":"PRJDB7404","title":"Airborne microbial communities at high-altitude and suburban sites in Toyama, Japan suggest a new perspective for bioprospecting","description":"This study was conducted to compare the composition and abundance of airborne microorganisms at a high-altitude site, Mt. Jodo (2,839 m above mean sea level (AMSL)) and a suburban site (23 m AMSL) in Toyama, Japan. To our knowledge, this is the first study to investigate airborne microbial communities in air samples collected simultaneously from high-altitude and suburban sites in a small area. Air samples were collected at five time points from 2009 to 2011 during late summer to early autumn. We then examined the bacterial and eukaryotic communities using Illumina MiSeq sequencing of the 16S and 18S rRNA gene hypervariable regions and estimated the abundance of bacteria and fungi with real-time TaqMan PCR.","center":"Graduate School of Science and Engineering, University of Toyama","data_type":"Targeted Locus (Loci)","submission_date":"2018/09/07 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00137651","air sample from a high-altitude site, label number 20090916H","uncertain",null,"2009-09-16",2009,"JP","Toyama",1849876,"Toyama","verified",36.5667,137.6058,"Japan:Toyama, Mt. Jodo",null,null,null,"aerosol","environmental sample; urban association not established"],["SAMD00137652","air sample from a suburban site, label number 20090916S","uncertain",null,"2009-09-16",2009,"JP","Toyama",1849876,"Toyama","verified",36.6983,137.1869,"Japan:Toyama, Univ. Toyama",null,null,null,"aerosol","environmental sample; urban association not established"],["SAMD00137653","air sample from a high-altitude site, label number 20100820H","uncertain",null,"2010-08-20