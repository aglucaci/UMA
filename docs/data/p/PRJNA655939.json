{"v":1,"accession":"PRJNA655939","title":"Assessment of acid mist on mortar biodeterioration simulating the wall of the National Museum of Rio de Janeiro","description":"Environmental factors contribute to mortar biodeterioration. In this work we aimed to evaluate the effect of acid mist on microbial communities developed on mortar with same composition from the wall of the National Museum in Rio de Janeiro.The experimental approach applied in the present work is proposed as a strategy to address bioreceptibility. This approach has the advantage to be less time-consuming than in situ studies, not destructive, using lab controlled systems with the possibility of extrapolation to the real ecosystem.","center":"Universite de Pau et des Pays de l'Adour","data_type":"Raw sequence reads","submission_date":"2020/08/07 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN15762302","CCL-E-EXP10","uncertain",null,null,null,"BR",null,null,null,"unresolved",null,null,"Brazil","microcosm 8",null,null,null,"environmental sample; urban association not established"],["SAMN15762303","CCL-E-EXP11","uncertain",null,null,null,"BR",null,null,null,"unresolved",null,null,"Brazil","microcosm 8",null,null,null,"environmental sample; urban association not established"],["SAMN15762304","CCL-E-EXP12","uncertain",null,null,null,"BR",null,null,null,"unresolved",null,null,"Brazil","microcosm 8",null,null,null,"environmental sample; urban association not established"],["SAMN15762305","CCL-E-EXP1","uncertain",null,null,null,"BR",null,null,null,"unresolved",null,null,"Brazil","microcosm 5",null,null,null,"environmental sample; urban association not established"],["SAMN15762306","CCL-E-EXP2","uncertain",null,null,null,"BR",null,null,null,"unresolved",null,null,"Brazi