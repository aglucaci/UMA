{"v":1,"accession":"PRJEB60945","title":"Antimicrobial Resistance Gene Sequencing","description":"Using a novel multiplexed amplicon sequencing approach, numerous antimicrobial resistance genes (ARGs) were amplified and sequenced together on the Illumina MiSeq platform. Sequencing provided information on the genetic diversity of antimicrobial resistance genes within the targeted region. This data was used to track the dynamics of antimicrobial resistance genes between the influent wastewater and the activated sludge.","center":"mcgill university","data_type":"Other","submission_date":"2023/03/31 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA112843211","Synth+InfluentSolids1","uncertain",null,null,2018,"CA",null,null,null,"unresolved",null,null,"Canada",null,null,null,null,"environmental sample; urban association not established"],["SAMEA112843212","Syntho+SterileSolids3","uncertain",null,null,2018,"CA",null,null,null,"unresolved",null,null,"Canada",null,null,null,null,"environmental sample; urban association not established"],["SAMEA112843219","Influent2","uncertain",null,null,2018,"CA",null,null,null,"unresolved",null,null,"Canada",null,null,null,null,"environmental sample; urban association not established"],["SAMEA112843220","Influent3","uncertain",null,null,2018,"CA",null,null,null,"unresolved",null,null,"Canada",null,null,null,null,"environmental sample; urban association not established"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["ERR11174222","SAMEA112843211","ERX10606673","Amplicon","AMPLICON","GENOMIC","PAIRED","ILLUMINA","Illumina MiSeq",64316000,128632,"2023-03-31","https://sra-downloadb.be-md.