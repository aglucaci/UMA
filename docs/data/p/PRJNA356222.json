{"v":1,"accession":"PRJNA356222","title":"Filamentous bulking sludge from a dairy wastewater treatment plant Raw sequence reads","description":"The study aimed to test different mitigation strategies to solve a recurring filamentous bulking caused by Thiothrix in a full-scale dairy wastewater treatment plant composed of two parallel sequential batch reactors (SBR1 and SBR2). The efficiency of the mitigation strategy was assessed by performing bacterial diversity assays using 16S amplicon sequencing, with a particular interest on the reduction of Thiothrix and the simultaneous increase of glycogen-accumulating organisms.","center":"Universite catholique de Louvain","data_type":"Raw sequence reads","submission_date":"2016/12/05 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN06109938","Metagenome or environmental sample from activated sludge metagenome","non_urban",null,null,2015,"LU","Mersch",2960276,"Mersch","probable",49.77,6.08,"Luxembourg: Roost-Bissen","Filamentous bulking sludge from SBR1",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN06109939","Metagenome or environmental sample from activated sludge metagenome","non_urban",null,null,2015,"LU","Mersch",2960276,"Mersch","probable",49.77,6.08,"Luxembourg: Roost-Bissen","Filamentous bulking sludge from SBR1",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN06109988","Metagenome or environmental sample from activated sludge metagenome","non_urban",null,null,2015,"LU","Mersch",2960276,"Mersch","probable",49.77,6.08,"Luxembourg: Roost-Bissen","Filamentous bulking sludge from SBR1",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN06109989","Metagenome or environmental sample fro