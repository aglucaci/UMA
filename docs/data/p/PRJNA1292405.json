{"v":1,"accession":"PRJNA1292405","title":"Metagenomic profiling of raw wastewater: tool box for microbial evolution","description":"Over a period of one year, from November 2022 to October 2023, wastewater samples were collected in the district of Giessen (Germany, Biebertal Wastewater Treatment Plant). Sampling was done once a week, and a composite sample was taken every Monday over a period of 24 hours. A total of 52 samples were collected, four of which were combined from one month. This resulted in 12 samples that underwent metagenomic analysis. Authors: Silke Zechel-Gran, Benedikt Luecker, Jane Falgenhauer, Eugen Domann","center":"Justus Liebig University Giessen","data_type":"Raw sequence reads","submission_date":"2025/07/17 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN49999798","wastewater_01","confirmed_urban","municipal_wastewater",null,2022,"DE",null,null,null,"unresolved",50.38,8.35,"Germany: Biebertal","Wastewater treatment plant",null,null,null,"named urban infrastructure at sample level"],["SAMN49999799","wastewater_02","confirmed_urban","municipal_wastewater",null,2022,"DE",null,null,null,"unresolved",50.38,8.35,"Germany: Biebertal","Wastewater treatment plant",null,null,null,"named urban infrastructure at sample level"],["SAMN49999800","wastewater_03","confirmed_urban","municipal_wastewater",null,2023,"DE",null,null,null,"unresolved",50.38,8.35,"Germany: Biebertal","Wastewater treatment plant",null,null,null,"named urban infrastructure at sample level"],["SAMN49999801","wastewater_04","confirmed_urban","municipal_wastewater",null,2023,"DE",null,null,null,"unresolved",50.38,8.35,"Germany: Biebertal","Wastewater treatment plant",null,null,null,"named urban infrastructure at sample level"],["SAMN49999802","wast