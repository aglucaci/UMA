{"v":1,"accession":"PRJNA242639","title":"Urban river microbes Targeted Locus (Loci)","description":"Microplastic may offer a novel habitat for microbes in the environment, and waste water treatment plant (WWTP) effluent provides a concentrated means for microplastic's entry in rivers. Analysis of our samples compares the bacterial community composition that colonizes microplastic in comparison to those that colonize natural substrate. Samples were collected from the following: water column upstream of a WWTP, water column downstream of a WWTP, organic material downstream of a WWTP, and microplastic.","center":"Loyola University Chicago","data_type":"Targeted Locus (Loci)","submission_date":"2014/03/25 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN02700017","MIMS Environmental/Metagenome sample from wastewater metagenome","confirmed_urban","municipal_wastewater","2013-09-13",2013,"US","Illinois",4887398,"Chicago","verified",42.022,-87.7102,"USA: North Shore Channel, Chicago",null,null,null,null,"explicit urban setting at sample level"],["SAMN02700018","MIMS Environmental/Metagenome sample from wastewater metagenome","confirmed_urban","municipal_wastewater","2013-09-13",2013,"US","Illinois",4887398,"Chicago","verified",42.022,-87.7102,"USA: North Shore Channel, Chicago",null,null,null,null,"explicit urban setting at sample level"],["SAMN02700019","MIMS Environmental/Metagenome sample from wastewater metagenome","confirmed_urban","municipal_wastewater","2013-09-13",2013,"US","Illinois",4887398,"Chicago","verified",42.022,-87.7102,"USA: North Shore Channel, Chicago",null,null,null,null,"explicit urban setting at sample level"],["SAMN02700020","MIMS Environmental/Metagenome sample from wastewater metagenome","confirmed_urban","mu