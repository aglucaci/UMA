{"v":1,"accession":"PRJNA1274428","title":"Transcriptomic profiling of Pseudomonas mendocina under nanoplastic and shear stress exposure","description":"This project investigates the transcriptomic responses of Pseudomonas mendocina under environmental exposure to nanoplastics (15 mg/L) and fluid shear stress (50-160 rpm). Samples were collected under static and dynamic culture conditions to assess gene expression profiles associated with plastic-induced stress and mechanical disturbance. The data support understanding of bacterial adaptation mechanisms in wastewater environments.","center":"guangzhou university","data_type":"Raw sequence reads","submission_date":"2025/06/10 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN48957378","MIGS Cultured Bacterial/Archaeal sample from Ectopseudomonas mendocina","uncertain",null,"2024-04-30",2024,"CN","Guangdong",1809858,"Guangzhou","verified",23.12,113.22,"China: Guangzhou, Datansha Wastewater Treatment Plant",null,"aquatic biome","municipal wastewater treatment plant","wastewater","conflicting evidence: environmental and host/clinical"],["SAMN48957379","MIGS Cultured Bacterial/Archaeal sample from Ectopseudomonas mendocina","uncertain",null,"2024-04-30",2024,"CN","Guangdong",1809858,"Guangzhou","verified",23.12,113.22,"China: Guangzhou, Datansha Wastewater Treatment Plant",null,"aquatic biome","municipal wastewater treatment plant","wastewater","conflicting evidence: environmental and host/clinical"],["SAMN48957380","MIGS Cultured Bacterial/Archaeal sample from Ectopseudomonas mendocina","uncertain",null,"2024-04-30",2024,"CN","Guangdong",1809858,"Guangzhou","verified",23.12,113.22,"China: Guangzhou, Datansha Wastewater Treatment Plant",null,"aquatic biome","municipal wastewater treat