{"v":1,"accession":"PRJNA1209223","title":"Comparison of Microbial Communities in SBRC and SBRH1 Sewage Treatment Processes at Different Time Points (1, 5, 14 days)","description":"This project aims to investigate the microbial diversity and community structure in the sludge-water mixtures of two sewage treatment systems, namely the control group SBRC (conventional SBR device) and the experimental group SBRH1 (SBR device with the addition of Corynebacterium xerosis). Samples were collected from both systems at three distinct time points: 1 day, 5 days, and 14 days. The study will utilize 16S rRNA sequencing to analyze the microbial communities, with the goal of understanding the impact of the added Corynebacterium xerosis on the microbial ecology and potential functional changes in the sewage treatment process. Insights gained from this research could provide valuable information for optimizing sewage treatment efficiency and understanding microbial interactions in such systems.","center":"Jilin Agricultural University","data_type":"Raw sequence reads","submission_date":"2025/01/11 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN46209984","Metagenome or environmental sample from wastewater metagenome","uncertain",null,null,2023,"CN","Jilin",2038180,"Changchun","verified",43.81,125.408,"China:Changchun","in the SBR used for treating swine wastewater",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN46209985","Metagenome or environmental sample from wastewater metagenome","uncertain",null,null,2023,"CN","Jilin",2038180,"Changchun","verified",43.81,125.409,"China:Changchun","in the SBR used for treating swine wastewater",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN4620