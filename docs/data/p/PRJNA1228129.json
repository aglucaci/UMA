{"v":1,"accession":"PRJNA1228129","title":"Metagenomic Profiling of Airborne Microbial Communities from Aircraft Filters and Face Masks","description":"Airborne microbial communities, though challenging to study due to low biomass, play a critical role in public health, antimicrobial resistance, and pathogen transmission. This project aims to characterize the microbial diversity and functional potential of airborne microbiomes in high-occupancy environments, such as hospitals and airplanes, using shotgun metagenomics. By leveraging non-invasive air sampling from face masks and aircraft cabin filters, we developed an optimized workflow incorporating environmental and enrichment protocols to enhance microbial DNA recovery and diversity profiling.","center":"NORTHWESTERN UNIVERSITY","data_type":"Raw sequence reads","submission_date":"2025/02/25 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN47007089","Aircraft Filter Metganome 1","uncertain",null,"2021-04-01",2021,null,null,null,null,"unresolved",null,null,null,null,"built environment","aircraft cabin air","air filter","environmental sample; urban association not established"],["SAMN47007090","Aircraft Filter Metganome 2","uncertain",null,"2021-04-01",2021,null,null,null,null,"unresolved",null,null,null,null,"built environment","aircraft cabin air","air filter","environmental sample; urban association not established"],["SAMN47007091","Aircraft Filter Metganome 3","uncertain",null,"2021-04-01",2021,null,null,null,null,"unresolved",null,null,null,null,"built environment","aircraft cabin air","air filter","environmental sample; urban association not established"],["SAMN47007092","Aircraft Filter Metganome 4","uncertain",null,"2021-04-01",2021,null,null,null,null,"unresolved",null,n