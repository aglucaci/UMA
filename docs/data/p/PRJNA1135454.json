{"v":1,"accession":"PRJNA1135454","title":"Microbial diversity in dental unit waterlines and generated dental bioaerosols affected by waterline disinfection","description":"The effectiveness of dental unit waterline (DUWL) disinfection techniques on bacterial diversity in both dental unit water and dental bioaerosols was assessed. Two DUWL disinfection techniques (iodine-releasing cartridge and plasma sterilization system) were installed in different dental chair units. Dental procedures were conducted, and dental unit water samples and air samples were collected before and after the procedures. These samples were assessed using a metagenomic workflow.","center":"Faculty of Dentistry, Chulalongkorn University","data_type":"Raw sequence reads","submission_date":"2024/07/13 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN42481115","BLCT","uncertain",null,"2023-03-15",2023,"TH","Bangkok",1609350,"Bangkok","verified",13.7436,100.5337,"Thailand: Bangkok","DNase/RNase-free distilled water",null,null,null,"no environmental-sample evidence"],["SAMN42481116","BLTX","uncertain",null,"2023-03-15",2023,"TH","Bangkok",1609350,"Bangkok","verified",13.7436,100.5337,"Thailand: Bangkok","DNase/RNase-free distilled water",null,null,null,"no environmental-sample evidence"],["SAMN42481117","SLCT","non_environmental",null,"2023-03-15",2023,"TH","Bangkok",1609350,"Bangkok","verified",13.7436,100.5337,"Thailand: Bangkok",null,null,null,null,"host-derived or clinical material"],["SAMN42481118","SLTX","non_environmental",null,"2023-03-15",2023,"TH","Bangkok",1609350,"Bangkok","verified",13.7436,100.5337,"Thailand: Bangkok",null,null,null,null,"host-derived or clinical material"],["SAMN42481119","U1aASCT","uncertain",null,"2023-03-15",2023,"TH","Bangkok