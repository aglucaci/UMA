{"v":1,"accession":"PRJNA1418541","title":"Metagenomic sequencing of wastewater microbial communities under antibiotic and quorum-sensing inhibitor treatments","description":"This project presents shotgun metagenomic sequencing data generated from wastewater samples collected under controlled laboratory treatments. The samples were exposed to levofloxacin alone or in combination with quorum-sensing inhibitors, including vanillin and indole, to investigate their effects on microbial community composition and antibiotic resistance gene profiles. Total community DNA was extracted from filtered water samples and sequenced using Illumina paired-end technology. The resulting datasets provide insights into the responses of wastewater microbial communities and resistomes to antibiotic pressure and quorum-sensing interference.","center":"Tongji University","data_type":"Raw sequence reads","submission_date":"2026/02/04 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN55047032","Control wastewater sample","probable_urban","municipal_wastewater","2025-04-10",2025,"CN","Anhui",1808722,"Hefei","verified",null,null,"China: Anhui, Hefei","wastewater",null,null,null,"city-level location without sample-site confirmation"],["SAMN55047033","Wastewater sample treated with levofloxacin","probable_urban","municipal_wastewater","2025-04-10",2025,"CN","Anhui",1808722,"Hefei","verified",null,null,"China: Anhui, Hefei","wastewater",null,null,null,"city-level location without sample-site confirmation"],["SAMN55047034","Wastewater sample treated with vanillin","probable_urban","municipal_wastewater","2025-04-10",2025,"CN","Anhui",1808722,"Hefei","verified",null,null,"China: Anhui, Hefei","wastewater",null,null,null,"city-level location without sample-site c