{"v":1,"accession":"PRJEB8946","title":"Bacterial community dynamics in horizontal subsurface flow constructed wetland units treating municipal wastewater","description":"Microbial community of a newly established horizontal subsurface flow constructed wetland was studied using Illumina based sequencing. Samples were taken over five month period from July to November 2009 after the working regime was started, on days 26, 45, 64, 94, and 150 of the system performance. HSSF MCs microbial community profiling was performed using Illumina HiSeq 2000 sequencing combinatorial sequence-tagged PCR products. Primers were used to amplify the bacterial specific V6 hypervariable region of the 16S rRNA gene. The paired-end reads were assembled into composite reads with SHERA software. The initial number of sequences was 2,227,966 in total.","center":"UNIVERSITY OF TARTU","data_type":"Other","submission_date":"2015/05/25 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA3312259","HSSF 26 I","probable_urban","municipal_wastewater",null,2009,"EE",null,null,null,"unresolved",null,null,"Estonia",null,null,null,null,"urban context stated at BioProject level only"],["SAMEA3312260","HSSF 26 II","probable_urban","municipal_wastewater",null,2009,"EE",null,null,null,"unresolved",null,null,"Estonia",null,null,null,null,"urban context stated at BioProject level only"],["SAMEA3312261","HSSF 26 III","probable_urban","municipal_wastewater",null,2009,"EE",null,null,null,"unresolved",null,null,"Estonia",null,null,null,null,"urban context stated at BioProject level only"],["SAMEA3312262","HSSF 45 I","probable_urban","municipal_wastewater",null,2009,"EE",null,null,null,"unresolved",null,null,"Estonia",null,null,null,null,"urban context stated at BioProject level