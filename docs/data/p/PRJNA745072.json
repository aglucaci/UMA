{"v":1,"accession":"PRJNA745072","title":"Bacterial communities of cryoconite holes of South America","description":"Cryoconite holes are peculiar structures of glaciers surface, they are small ponds full of melting water with a sediment on the bottom. This sediment is an hotspot of biodiveristy and bacterial communities inhabiting cryoconite have been descibed allover the world but in South America. The aim of this study is to provide the first description of the composition of bacterial communities of Andean glaciers to fill this gap of knowledge and investigate geographical differences.","center":"University of Milano-Bicocca","data_type":"Raw sequence reads","submission_date":"2021/07/09 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN20133398","MIMARKS Survey related sample from dust metagenome","uncertain",null,"2018-03-01",2018,"CL",null,null,null,"unresolved",-46.5187,-73.175,"Chile",null,null,null,"cryoconite","environmental sample; urban association not established"],["SAMN20133399","MIMARKS Survey related sample from dust metagenome","uncertain",null,"2018-03-01",2018,"CL",null,null,null,"unresolved",-46.5188,-73.175,"Chile",null,null,null,"cryoconite","environmental sample; urban association not established"],["SAMN20133400","MIMARKS Survey related sample from dust metagenome","uncertain",null,"2018-03-01",2018,"CL",null,null,null,"unresolved",-46.5193,-73.1751,"Chile",null,null,null,"cryoconite","environmental sample; urban association not established"],["SAMN20133401","MIMARKS Survey related sample from dust metagenome","uncertain",null,"2018-03-01",2018,"CL",null,null,null,"unresolved",-46.5192,-73.1754,"Chile",null,null,null,"cryoconite","environmental sample; urban association not established"],["SAMN20133402",