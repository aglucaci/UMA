{"v":1,"accession":"PRJNA1135324","title":"Algal-bacterial granular sludge","description":"Despite the ecological and biotechnological significance of microalgae-bacterium symbionts, the response of microalgae-bacterium-virus interactions to external fluctuations and the role of viruses in phycosphere remain largely unexplored. Herein, we employed algal-bacterial granular sludge (ABGS) with varying light intensity and organic carbon loading to investigate the response mechanisms of microalgae-bacterium symbionts to environmental fluctuations.","center":"Zhejiang University","data_type":"Raw sequence reads","submission_date":"2024/07/13 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN42474384","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2020-11-18",2020,null,null,null,null,"unresolved",null,null,null,"reactor sample1",null,null,null,"environmental sample; urban association not established"],["SAMN42474385","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2020-11-18",2020,null,null,null,null,"unresolved",null,null,null,"reactor sample2",null,null,null,"environmental sample; urban association not established"],["SAMN42474386","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2020-11-18",2020,null,null,null,null,"unresolved",null,null,null,"reactor sample3",null,null,null,"environmental sample; urban association not established"],["SAMN42474387","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2020-11-18",2020,null,null,null,null,"unresolved",null,null,null,"reactor sample4",null,null,null,"environmental sample; urban association not established"],["SAMN42474388","Metagenome or environmental sample from sludge met