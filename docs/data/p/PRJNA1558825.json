{"v":1,"accession":"PRJNA1558825","title":"Genomic Characterisation of Escherichia coli From Urban Wastewater and Outpatient Urine Cultures","description":"This study provides genomic comparisons of Escherichia coli from urban wastewaterand outpatient urine cultures in Cote d Ivoire, using portable nanopore sequencing in anational public health laboratory. It addresses a major gap in West Africa, wheregenomic data on antimicrobial resistance outside hospitals are scarce, revealing CTXM-15 spread across unrelated lineages, plasmid-mediated AmpC genes, and thecolistin resistance gene mcr-1.1 in wastewater. Clinical and wastewater isolates weregenomically distinct, showing that wastewater captures resistance determinantscirculating in the community that clinical surveillance alone may miss. These findingssupport integrating genomic wastewater surveillance into national AMR action plansand show that this approach is feasible with locally available, affordable sequencingtechnology.","center":"INSTITUT PASTEUR DE COTE D'IVOIRE","data_type":"Raw sequence reads","submission_date":"2026/11/09 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN64748715","One Health Enteric sample from Escherichia coli","uncertain",null,null,2024,"CI",null,null,null,"ambiguous",null,null,"Cote d'Ivoire: Abidjan, Adjame","wastewater",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN64748716","One Health Enteric sample from Escherichia coli","uncertain",null,null,2024,"CI",null,null,null,"ambiguous",null,null,"Cote d'Ivoire: Abidjan, Adjame","wastewater",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN64748717","One Health Enteric sample from Escherichia coli","uncertain",null,null,2024,"CI","Abidjan A