{"v":1,"accession":"PRJNA1218928","title":"Novel Insights into Biomethane Production from Stillage: The Role of Temperature, Organic Loading Rate, and Inoculum Variability","description":"Molasses stillage has been found to be a suitable feedstock for biogas production due to its high organic content and nutrient-rich composition. This study investigates the biochemical methane potential (BMP) of molasses stillage under varying conditions. The aim was to evaluate the methane production potential of molasses stillage across a spectrum of operational parameters. Additionally, the microbial community dynamics were explored using 16S rRNA sequencing, providing insights into the composition and shifts within the microbial populations under different experimental conditions.","center":"Masaryk University","data_type":"Raw sequence reads","submission_date":"2025/02/04 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN46536827","40 C inoculum","confirmed_urban","municipal_wastewater","2024-02-24",2024,"CZ","South Moravian",3070416,"Modřice","verified",49.1307,16.6311,"Czech Republic: Modrice","wastewater treatment plant",null,null,null,"named urban infrastructure at sample level"],["SAMN46536828","40 C OLR2","confirmed_urban","municipal_wastewater","2024-02-24",2024,"CZ","South Moravian",3070416,"Modřice","verified",49.1307,16.6311,"Czech Republic: Modrice","wastewater treatment plant",null,null,null,"named urban infrastructure at sample level"],["SAMN46536829","40 C OLR5","confirmed_urban","municipal_wastewater","2024-02-24",2024,"CZ","South Moravian",3070416,"Modřice","verified",49.1307,16.6311,"Czech Republic: Modrice","wastewater treatment plant",null,null,null,"named urban infrastructure at sample level"],["SAMN46536830","40 C OLR10