{"v":1,"accession":"PRJNA1393330","title":"Hospital surface microbiome","description":"Hospital surfaces serve as persistent reservoirs for clinically relevant pathogens and contribute to ongoing infection risks. While disinfection is routinely applied to reduce microbial burden, its long-term ecological effects on antimicrobial resistance dynamics remains underexplored. Here, we conducted year-long metagenomic surveillance of nearly 200 in situ hospital surface samples under sustained chlorine-based disinfection to investigate temporal changes in bacterial and viral communities, the resistome, and phage-host interactions.","center":"City University of Hong Kong","data_type":"Raw sequence reads","submission_date":"2025/12/24 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN54298364","Metagenome or environmental sample from metagenome","probable_urban","surfaces_infrastructure","2020-04-07",2020,"HK",null,1819729,"Hong Kong","probable",22.3,114.16,"China: Hong Kong","Handrail 2 (near entrance)",null,null,null,"city-level location without sample-site confirmation"],["SAMN54298367","Metagenome or environmental sample from metagenome","probable_urban","surfaces_infrastructure","2020-04-07",2020,"HK",null,1819729,"Hong Kong","probable",22.3,114.16,"China: Hong Kong","Handrail 1 (near toilet)",null,null,null,"city-level location without sample-site confirmation"],["SAMN54298383","Metagenome or environmental sample from metagenome","probable_urban","surfaces_infrastructure","2020-05-05",2020,"HK",null,1819729,"Hong Kong","probable",22.3,114.16,"China: Hong Kong","Handrail 2 (near entrance)",null,null,null,"city-level location without sample-site confirmation"],["SAMN54298385","Metagenome or environmental sample from metagenome","probab