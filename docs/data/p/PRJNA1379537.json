{"v":1,"accession":"PRJNA1379537","title":"Reduced graphene oxide enhances emerging contaminants removal in anaerobic wastewater treatment","description":"The biotransformation pathways of some ECs were activated after the addition of rGO, ultimately leading to their transformation into metabolic intermediates capable of entering the tricarboxylic acid (TCA) cycle. The enhanced syntrophic metabolism, along with the increased abundance of ECs-biotransforming microorganisms and enzymes, collectively confirmed that the addition of rGO provided additional metabolic pathways for ECs removal.","center":"Xian University of Architecture and Technology","data_type":"Raw sequence reads","submission_date":"2025/12/11 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN53882466","Metagenome or environmental sample from metagenome","probable_urban","municipal_wastewater","2024-09-10",2024,"CN","Shaanxi",1790630,"Xi’an","verified",34.25,108.95,"China: Xi_an","sludge1",null,null,null,"city-level location without sample-site confirmation"],["SAMN53882467","Metagenome or environmental sample from metagenome","probable_urban","municipal_wastewater","2024-09-10",2024,"CN","Shaanxi",1790630,"Xi’an","verified",34.25,108.95,"China: Xi_an","sludge2",null,null,null,"city-level location without sample-site confirmation"],["SAMN53882468","Metagenome or environmental sample from metagenome","probable_urban","municipal_wastewater","2024-09-10",2024,"CN","Shaanxi",1790630,"Xi’an","verified",34.25,108.95,"China: Xi_an","sludge3",null,null,null,"city-level location without sample-site confirmation"],["SAMN53882469","Metagenome or environmental sample from metagenome","probable_urban","municipal_wastewater","2024-09-10",2024,"CN","Shaanxi",1790630,"Xi’an","verifi