{"v":1,"accession":"PRJNA1381085","title":"Enhanced hydrogen and vivianite recovery from fermentative waste activated sludge via electrofermentation by sacrificing iron anode","description":"Microbial electrolysis cell has been widely used to recover energy and resources from Waste activate sludge. However, the issues of homoacetogenesis and sacrificial iron anode corrosion rate uncontrollably remain unresolved. This study proposed chloroform as a homoacetogen inhibitor and regulated the iron anode voltage for vivianite and hydrogen production. With the 0.02% concentration of chloroform ceased homoacetogens abundance decreased from 51.1% to 15.8%, thereby enhancing hydrogen production and yield by 52.9% and 178.4%, respectively.","center":"TAI YUAN UNIVERSITY OF TECHNOLOGY","data_type":"Raw sequence reads","submission_date":"2025/12/14 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN53935013","Con_1","uncertain",null,"2025-03-03",2025,null,null,null,null,"unresolved",null,null,null,"1",null,null,null,"environmental sample; urban association not established"],["SAMN53935014","Con_2","uncertain",null,"2025-03-03",2025,null,null,null,null,"unresolved",null,null,null,"2",null,null,null,"environmental sample; urban association not established"],["SAMN53935015","Con_3","uncertain",null,"2025-03-03",2025,null,null,null,null,"unresolved",null,null,null,"3",null,null,null,"environmental sample; urban association not established"],["SAMN53935016","06V_1","uncertain",null,"2025-03-03",2025,null,null,null,null,"unresolved",null,null,null,"4",null,null,null,"environmental sample; urban association not established"],["SAMN53935017","06V_2","uncertain",null,"2025-03-03",2025,null,null,null,null,"unresolved",null,null,null,"5",null,null,null,"