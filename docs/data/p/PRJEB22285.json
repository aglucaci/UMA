{"v":1,"accession":"PRJEB22285","title":"Influence of electron acceptors in transcript diversity of active members of the denitrifying community","description":"The aim of this work was to study the effect of various combinations of electron acceptors, nitrate (NO3-), nitrite (NO2-) and N2O, on the denitrification pathway of a d-EBPR system. Batch tests were performed with different electron acceptor combinations, to explore the denitrification pathway. The changes in community structure were evaluated by MiSeq Illumina high throughput sequencing.","center":"Carvalho","data_type":"Other","submission_date":"2017/09/02 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA104231813","16S PAO reactor","non_environmental",null,null,2014,"PT",null,null,null,"unresolved",null,null,"Portugal",null,null,null,null,"laboratory or culture material"],["SAMEA104231814","16S PAO reactor","non_environmental",null,null,2014,"PT",null,null,null,"unresolved",null,null,"Portugal",null,null,null,null,"laboratory or culture material"],["SAMEA104231815","16S PAO reactor","non_environmental",null,null,2014,"PT",null,null,null,"unresolved",null,null,"Portugal",null,null,null,null,"laboratory or culture material"],["SAMEA104231816","16S PAO reactor","non_environmental",null,null,2014,"PT",null,null,null,"unresolved",null,null,"Portugal",null,null,null,null,"laboratory or culture material"],["SAMEA104231817","16S PAO reactor","non_environmental",null,null,2014,"PT",null,null,null,"unresolved",null,null,"Portugal",null,null,null,null,"laboratory or culture material"],["SAMEA104231818","16S PAO reactor","non_environmental",null,null,2014,"PT",null,null,null,"unresolved",null,null,"Portugal",null,null,null,null,"laboratory or culture material"],["SAMEA104231819