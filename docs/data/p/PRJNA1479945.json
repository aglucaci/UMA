{"v":1,"accession":"PRJNA1479945","title":"Sulfur metabolism shapes AOM efficiency in different media","description":"Anaerobic oxidation of methane (AOM) is a key process mitigating methane emissions. This study compares two long-term enrichment cultures derived from distinct environmental samples: landfill cover soil (reactor P) and reservoir sediment (reactor J). The data include 16S rRNA amplicon sequences (V3-V4 region, bacteria and archaea) and metagenomic sequences from both reactors. These datasets were used to investigate how microbial sulfur metabolic strategies (sulfur recycling vs. sulfur storage) shape AOM efficiency. Raw data are provided for community analysis, metagenome assembly, and functional gene annotation.","center":"jinan university","data_type":"Raw sequence reads","submission_date":"2026/06/19 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN61000736","Metagenome or environmental sample from activated sludge metagenome","probable_urban","municipal_wastewater",null,2022,"CN","Guangdong",1809858,"Guangzhou","verified",23.01,113.41,"China: Guangzhou","reactor",null,null,null,"city-level location without sample-site confirmation"],["SAMN61000737","Metagenome or environmental sample from activated sludge metagenome","probable_urban","municipal_wastewater",null,2022,"CN","Guangdong",1809858,"Guangzhou","verified",23.01,113.41,"China: Guangzhou","reactor",null,null,null,"city-level location without sample-site confirmation"],["SAMN61000738","Metagenome or environmental sample from activated sludge metagenome","probable_urban","municipal_wastewater",null,2022,"CN","Guangdong",1809858,"Guangzhou","verified",23.01,113.41,"China: Guangzhou","reactor",null,null,null,"city-level location without sample-site confirmat