{"v":1,"accession":"PRJNA1125294","title":"Microbial dynamics during aerobic granulation under different phosphate concentration","description":"The structure of the microbial community was followed during the formation of aerobic granule in a sequencing batch reactor. The influence of the phosphate concentration, from high to low, on the microbial community composition and the granule shape was studied. In the first part of the experiment, high concentration of phosphate, the biomass aggregated to form round shape granules along side with the enrichment of Candidatus Accumulibacter. In the second part of the experiment, when reducing the phosphate concentration, Propionivibrio became the most abundant microorganism and the granule remained round and bigger than 1000um.","center":"EPFL","data_type":"Raw sequence reads","submission_date":"2024/06/18 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN41886360","Granulation_day_0","uncertain",null,"2022-09-28",2022,"CH","Vaud",2659994,"Lausanne","probable",46.5201,6.5705,"Switzerland","sequencing batch reactor",null,null,null,"environmental sample; urban association not established"],["SAMN41886361","Granulation_day_5","uncertain",null,"2022-10-03",2022,"CH","Vaud",2659994,"Lausanne","probable",46.5201,6.5705,"Switzerland","sequencing batch reactor",null,null,null,"environmental sample; urban association not established"],["SAMN41886362","Granulation_day_8","uncertain",null,"2022-10-06",2022,"CH","Vaud",2659994,"Lausanne","probable",46.5201,6.5705,"Switzerland","sequencing batch reactor",null,null,null,"environmental sample; urban association not established"],["SAMN41886363","Granulation_day_15","uncertain",null,"2022-10-13",2022,"CH","Vaud",2659994,"Lausanne","probable",46.5201,6.5