{"v":1,"accession":"PRJDB17159","title":"Isolation and characterization of electrochemically active bacteria from an anaerobic digester treating food wastes","description":"Studies have used anaerobic-digester sludge as inoculum for bioelectrochemical systems, such as microbial fuel cells, while limited studies have identified electrochemically active bacteria thriving in anaerobic digesters. In the present work, single-chamber MFCs were operated using anaerobic-digester effluents as the sole source of organics and microbes, and attempts were made to isolate EAB from anode biofilms.","center":"Tokyo University of Pharmacy and Life Sciences","data_type":"Targeted Locus (Loci)","submission_date":"2024/04/03 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00662117","AB5","confirmed_urban","municipal_wastewater",null,2023,"JP","Tokyo",1863440,"Hachiōji","verified",35.6693,139.4257,"Japan:Tokyo, Hachioji",null,"biome","wastewater treatment plant","industrial wastewater","named urban infrastructure at sample level"],["SAMD00662118","AB40","confirmed_urban","municipal_wastewater",null,2022,"JP","Tokyo",1863440,"Hachiōji","verified",35.6693,139.4257,"Japan:Tokyo, Hachioji",null,"biome","wastewater treatment plant","industrial wastewater","named urban infrastructure at sample level"],["SAMD00662119","PM5","confirmed_urban","municipal_wastewater",null,2023,"JP","Tokyo",1863440,"Hachiōji","verified",35.6693,139.4257,"Japan:Tokyo, Hachioji",null,"biome","wastewater treatment plant","industrial wastewater","named urban infrastructure at sample level"],["SAMD00662120","PM40","confirmed_urban","municipal_wastewater",null,2022,"JP","Tokyo",1863440,"Hachiōji","verified",35.6693,139.4257,"Japan:Tokyo, Hachioji",null,"biome","wastewater treatment