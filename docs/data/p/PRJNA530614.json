{"v":1,"accession":"PRJNA530614","title":"Chemostat metagenome Raw sequence reads","description":"Microorganisms are working together in a wide variety of industrial and environmental technologies and require active management. Hence, more research is needed to find factors that influence microbial community structure. In this study, continuous reactors were operated under four different hydraulic retention time (HRT) (i.e., 12h, 24h, 120h and 240 h). Flow cytometric fingerprinting and 16S rRNA gene amplicon sequencing were applied to assess the difference in community structure between the reactors","center":"UGent","data_type":"Raw sequence reads","submission_date":"2019/04/02 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN11334571","Day1","uncertain",null,"2017-06-02",2017,null,null,null,null,"unresolved",null,null,null,"soil",null,null,null,"environmental sample; urban association not established"],["SAMN11334572","R1_day4","uncertain",null,"2017-06-02",2017,null,null,null,null,"unresolved",null,null,null,"soil",null,null,null,"environmental sample; urban association not established"],["SAMN11334573","R2_day4","uncertain",null,"2017-06-02",2017,null,null,null,null,"unresolved",null,null,null,"soil",null,null,null,"environmental sample; urban association not established"],["SAMN11334574","R3_day4","uncertain",null,"2017-06-02",2017,null,null,null,null,"unresolved",null,null,null,"soil",null,null,null,"environmental sample; urban association not established"],["SAMN11334575","R4_day4","uncertain",null,"2017-06-02",2017,null,null,null,null,"unresolved",null,null,null,"soil",null,null,null,"environmental sample; urban association not established"],["SAMN11334576","R1_day8","uncertain",null,"2017-06-02",2017,null,null,null,null