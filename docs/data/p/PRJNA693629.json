{"v":1,"accession":"PRJNA693629","title":"Shotgun Metagenomic Influent and Effluent WWTP in Malaysia","description":"The project has the aim to understand the microbial and related antimicrobial (AMR) genes present in the influent and effluent WWTP in one of the WWTP in Malaysia. This study will provide the performance of the current WWTP process conducted to produce clean and biologically-safe water to the community. Besides that, it would also elucidate co-occurrence interactions between selected species and AMR genes that commonly may deter the communities' health.","center":"Faculty of Biotechnology and Biomolecular Science, UPM","data_type":"Metagenomic assembly","submission_date":"2021/01/21 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN17619787","Microbial community of effluent WWTP 1 reactor, Malaysia","confirmed_urban","municipal_wastewater",null,2020,"MY","Johor",1732752,"Johor Bahru","verified",null,null,"Malaysia: Johore","Effluent WWTP 1",null,null,null,"named urban infrastructure at sample level"],["SAMN17619788","Microbial community of influent WWTP 1 reactor, Malaysia","confirmed_urban","municipal_wastewater",null,2020,"MY","Johor",1732752,"Johor Bahru","verified",null,null,"Malaysia: Johore","Influent WWTP 1",null,null,null,"named urban infrastructure at sample level"],["SAMN17619789","Microbial community of effluent WWTP 2 reactor, Malaysia","confirmed_urban","municipal_wastewater",null,2020,"MY","Johor",1732752,"Johor Bahru","verified",null,null,"Malaysia: Johore","Effluent WWTP 2",null,null,null,"named urban infrastructure at sample level"],["SAMN17619790","Microbial community of influent WWTP 2 reactor, Malaysia","confirmed_urban","municipal_wastewater",null,2020,"MY","Johor",1732752,"Johor Bahru","verifi