{"v":1,"accession":"PRJNA1456810","title":"Dosage and timing both matter: promoting synergism in carrier enhanced microalgal-bacterial granules by external bicarbonate","description":"Microalgal-bacterial biofilm formed on small-sized carriers could develop carrier-enhanced microalgal-bacterial granules (CEMBGs) and overcome the long establishment obstacle in conventional microalgal bacterial granular sludge (MBGS) systems. To unveil the importance of fine-tuning external IC application, this study investigated the influence of both external bicarbonate dosage and addition timing on CEMBGs growth characteristics, microalgal photosynthesis properties, microalgal-bacterial interactions, pollutants removal performances, community shifts, and C/P/N metabolism pathways.","center":"Dalian University of Technology","data_type":"Raw sequence reads","submission_date":"2026/04/23 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN57424882","Metagenome or environmental sample from sludge metagenome","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"activated sludge from a sewage treatment works",null,null,null,"environmental sample; urban association not established"],["SAMN57424883","Metagenome or environmental sample from sludge metagenome","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"carrier-enhanced microalgal-bacterial granules",null,null,null,"environmental sample; urban association not established"],["SAMN57424884","Metagenome or environmental sample from sludge metagenome","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"carrier-enhanced microalgal-bacterial granules",null,null,null,"environmental sample; urban association not established"],["SAMN5742