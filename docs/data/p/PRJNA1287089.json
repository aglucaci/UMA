{"v":1,"accession":"PRJNA1287089","title":"Succession of Microbial Community Structure and Co-occurrence Network Dynamics during the Transition from Anaerobic Sludge to Aerobic Cultivation","description":"The transition between anaerobic and aerobic conditions represents a fundamental ecological process occurring ubiquitously in both natural ecosystems and engineered wastewater treatment systems. The aerobic adaptation process triggers substantial restructuring of microbial community composition in response to environmental gradients, driving functional specialization across diverse microbial taxa. This study employed systematic sampling across critical transition phases: initial anaerobic sludge (D0), early aerobic adaptation (D1, D3, D5), and stabilized aerobic operation (D15, D30), with COD and nitrogen removal efficiencies monitored as key performance metrics throughout the aerobic transition process.","center":"southwest university","data_type":"Raw sequence reads","submission_date":"2025/07/05 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN49812546","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2023-08-25",2023,null,null,null,null,"unresolved",null,null,null,"Anaerobic sludge 0",null,null,null,"environmental sample; urban association not established"],["SAMN49812547","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2023-08-25",2023,null,null,null,null,"unresolved",null,null,null,"Aerobic sludge 1",null,null,null,"environmental sample; urban association not established"],["SAMN49812548","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2023-08-25",2023,null,null,null,null,"unresolved",null,null,null,"Aerobic sludge 2",null,null,null,"