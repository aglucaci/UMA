{"v":1,"accession":"PRJNA1514836","title":"Integrated cross-sectoral surveillance of antimicrobial resistance genotypes and phenotypes across disparate reservoirs","description":"Disparate environmental samples were collected from natural, urban and agricultural settings across Melbourne, VIC, Australia. These samples were subjected to metagenome sequencing, but also used to culture bacterial isolates for genome sequencing with the ultimate goal of understanding AMR distribution in these environments. Here, we demonstrate that, following sample-specific pre-processing, common surveillance approaches can be applied consistently to profile AMR abundance, distribution, and phenotypes across diverse reservoirs from both urban and agricultural settings.","center":"Monash University","data_type":"Raw sequence reads","submission_date":"2026/08/18 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN62523395","Metagenome or environmental sample from soil metagenome","confirmed_urban","soil_greenspace","2020-10-19",2020,"AU","Victoria",2158177,"Melbourne","verified",-37.8719,145.0328,"Australia: Melbourne","urban park soil",null,null,null,"explicit urban setting at sample level"],["SAMN62523396","Metagenome or environmental sample from soil metagenome","confirmed_urban","soil_greenspace","2020-10-19",2020,"AU","Victoria",2158177,"Melbourne","verified",-37.8716,145.0307,"Australia: Melbourne","urban park soil",null,null,null,"explicit urban setting at sample level"],["SAMN62523397","Metagenome or environmental sample from soil metagenome","confirmed_urban","soil_greenspace","2020-10-19",2020,"AU","Victoria",2158177,"Melbourne","verified",-37.8727,145.0301,"Australia: Melbourne","urban park soil",null,null,null,"explicit urban setting at sampl