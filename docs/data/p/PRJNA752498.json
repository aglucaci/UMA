{"v":1,"accession":"PRJNA752498","title":"Alkaline co-fermentation of municipal wastes for volatile fatty acids production","description":"Volatile fatty acid (VFA) production via alkaline co-fermentation is an efficient strategy to maximize resource recovery from organic wastes. This study comprehensively investigated the effect of substrate proportions on alkaline co-fermentation of primary sludge (PS) and external organic waste (OW) at initial pH 10 with OW proportions of 0%, 25%, 50%, 75%, 100% in terms of COD. Subsequently, an up-scaled semi-continuous experiment with 50% OW was performed at a set pH of 10 and 9 for 315 days to elucidate system robustness and microbial community dynamics.","center":"KTH Royal Institute of Technology","data_type":"Raw sequence reads","submission_date":"2021/08/06 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN20599615","D0.1","probable_urban","municipal_wastewater","2019-02-11",2019,"SE","Stockholm",2673730,"Stockholm","verified",59.3097,18.1089,"Sweden: Stockholm",null,"engineered_system","anaerobic_reactor","Sewage_Sludge_food_waste","city-level location without sample-site confirmation"],["SAMN20599616","D0.2","probable_urban","municipal_wastewater","2019-02-11",2019,"SE","Stockholm",2673730,"Stockholm","verified",59.3097,18.1089,"Sweden: Stockholm",null,"engineered_system","anaerobic_reactor","Sewage_Sludge_food_waste","city-level location without sample-site confirmation"],["SAMN20599617","D0.3","probable_urban","municipal_wastewater","2019-02-11",2019,"SE","Stockholm",2673730,"Stockholm","verified",59.3097,18.1089,"Sweden: Stockholm",null,"engineered_system","anaerobic_reactor","Sewage_Sludge_food_waste","city-level location without sample-site confirmation"],["SAMN20599618","D7.1","