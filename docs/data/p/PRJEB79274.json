{"v":1,"accession":"PRJEB79274","title":"Hospital metagenome sewage study","description":"A  better understanding of environmental transmission of antibiotic resistance genes (ARG) is required, to control the spread of MDR bacteria in hospitals. Thus our pilot study is aiming to characterize ARG transmission within a tertiary-care hospital and to evaluate the utility of  wastewater as an indicator of ARG landscape within the hospital.      Carbapenemase-producing Klebsiella pneumoniae were isolated from six patients, ten sinks and two wastewater samples. For ARG environmental reservoir assessment samples from ten sinks in two ICUs and a 24-hour composite wastewater sample was taken from the hospital building's outlet. Bacterial whole genome and metagenomic sequencing was used to evaluate the transmission of ARG from patients through sinks to hospital wastewater. Sequence assemblies were analyzed using Resistance Gene Identifier (RGI) combined with the Comprehensive Antibiotic Resistance Database (CARD), to identify known ARG, and a DeepARG (ML) model to compare its performance against the curated database.","center":"Latvian Biomedical Research and Study Centre","data_type":"Other","submission_date":"2025/03/01 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA115988388","SN_1","uncertain",null,"2023-03-07",2023,"LV",null,null,null,"unresolved",null,null,"Latvia",null,null,null,null,"environmental sample; urban association not established"],["SAMEA115988390","SN_52","uncertain",null,"2024-01-24",2024,"LV",null,null,null,"unresolved",null,null,"Latvia",null,null,null,null,"environmental sample; urban association not established"],["SAMEA115988391","SN_66","uncertain",null,"2024-01-31",2024,"LV",null,null,null,"unresolved",null,nu