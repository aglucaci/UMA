{"v":1,"accession":"PRJDB40348","title":"Hydrogen production using forward osmosis-concentrated municipal sewage","description":"This project investigates hydrogen production from municipal sewage concentrated by forward osmosis (FO). The study evaluates photofermentation by Rhodopseudomonas palustris under pH-controlled conditions and examines microbial community dynamics using full-length 16S rRNA gene amplicon sequencing. The results demonstrate that FO pretreatment enriches biodegradable organic substrates and reduces ammonium inhibition, enabling effective hydrogen production. This project contributes to the development of FO-PNSB hybrid systems for sustainable energy recovery from wastewater.","center":"Faculty of Chemistry and Biochemistry, Kanagawa University","data_type":"Targeted Locus (Loci)","submission_date":"2026/05/25 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD01818151","a-pre","confirmed_urban","municipal_wastewater","2024-01-15",2024,"JP","Kanagawa",1848354,"Yokohama","probable",null,null,"Japan:Yokohama","municipal wastewater",null,null,null,"explicit urban setting at sample level"],["SAMD01818152","a-after","confirmed_urban","municipal_wastewater","2024-01-15",2024,"JP","Kanagawa",1848354,"Yokohama","probable",null,null,"Japan:Yokohama","municipal wastewater",null,null,null,"explicit urban setting at sample level"],["SAMD01818153","b-pre","probable_urban","municipal_wastewater","2024-01-15",2024,"JP","Kanagawa",1848354,"Yokohama","probable",null,null,"Japan:Yokohama","FO-concentrated wastewater",null,null,null,"city-level location without sample-site confirmation"],["SAMD01818154","b-after","probable_urban","municipal_wastewater","2024-01-15",2024,"JP","Kanagawa",1848354,"Yokohama","probable",null,null,"