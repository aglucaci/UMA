{"v":1,"accession":"PRJEB122947","title":"Shifting ammonium loading in rapid sand filters .","description":"Rapid sand filtration is an efficient technology to biologically remove ammonium and manganese during drinking water production. However, when ammonium concentrations are high (>80 µmol L-1), nitrification can interfere with manganese removal. We investigated how variations in ammonium concentration affect the removal of ammonium and manganese and the microbial community composition in two large-scale pilot sand filters filled with either 100% biologically coated sand (“mature filter”) or 83% clean sand supplemented with 17% biologically coated sand (“inoculated filter”).","center":"Radboud University Nijmegen","data_type":"Other","submission_date":"2026/07/29 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA123191793","WO_INOC","uncertain",null,null,2024,"NL",null,null,null,"unresolved",null,null,"Netherlands",null,null,null,null,"environmental sample; urban association not established"],["SAMEA123191794","C1W10B","uncertain",null,null,2024,"NL",null,null,null,"unresolved",null,null,"Netherlands",null,null,null,null,"environmental sample; urban association not established"],["SAMEA123191795","C1W10M","uncertain",null,null,2024,"NL",null,null,null,"unresolved",null,null,"Netherlands",null,null,null,null,"environmental sample; urban association not established"],["SAMEA123191796","C1W10T","uncertain",null,null,2024,"NL",null,null,null,"unresolved",null,null,"Netherlands",null,null,null,null,"environmental sample; urban association not established"],["SAMEA123191797","C1W16B","uncertain",null,null,2024,"NL",null,null,null,"unresolved",null,null,"Netherlands",null,null,null,null,"environmental sample; urban association not e