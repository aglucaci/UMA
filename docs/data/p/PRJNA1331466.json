{"v":1,"accession":"PRJNA1331466","title":"The Impact of Microplastics on RBC Reactors","description":"o address the issue that three-dimensional rotating biological contactors (3D-RBCs) are susceptible to microplastic interference under traditional sludge biofilm colonization conditions, this study adopts the microbial agent biofilm colonization method (referred to as H-3D-RBC) and uses the sludge biofilm colonization system (referred to as A-3D-RBC) as a control. It aims to explore the performance differences between the two systems under the stress of polypropylene microplastics (PP-MPs).","center":"Chongqing University of Technology","data_type":"Raw sequence reads","submission_date":"2025/09/19 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN51603788","s1","uncertain",null,"2024-06-26",2024,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN51603789","s2","uncertain",null,"2024-06-27",2024,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN51603790","s1","uncertain",null,"2024-05-12",2024,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN51603791","s2","uncertain",null,"2024-05-11",2024,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN51603792","s1","uncertain",null,"2024-07-24",2024,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN51603793","s2","unce