{"v":1,"accession":"PRJNA273257","title":"Waste-mixed sludge (WMS) Metagenome","description":"The aim of the present study was to investigate the microbial population of anaerobic co-digestion of Waste-mixed sludge (WMS) with vegetable waste (FVW) at different operating conditions. Using a pilot-scale apparatus, different runs were performed at rising organic loading rates (OLR) and reduced hydraulic retention time (HRT). The microbial guilds were revealed by the Illumina MiSeq high-throughput sequencing and correlated with environmental factors and process performance.","center":"IGA Technology Services Srl","data_type":"Metagenome","submission_date":"2015/01/21 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN03288004","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2013-02-05",2013,"IT","The Marches",3168318,"San Ginesio","probable",43.12,13.35,"Italy","sludge",null,null,null,"environmental sample; urban association not established"],["SAMN03288005","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2013-02-05",2013,"IT","The Marches",3168318,"San Ginesio","probable",43.12,13.35,"Italy","sludge",null,null,null,"environmental sample; urban association not established"],["SAMN03288006","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2013-02-05",2013,"IT","The Marches",3168318,"San Ginesio","probable",43.12,13.35,"Italy","Anaerobic sludge",null,null,null,"environmental sample; urban association not established"],["SAMN03288025","Metagenome or environmental sample from sludge metagenome","non_urban",null,"2013-08-09",2013,"IT","The Marches",3168318,"San Ginesio","probable",43.12,13.35,"Italy","anaerobic sludge +40% Fruit and vegetable waste",nu