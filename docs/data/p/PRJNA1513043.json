{"v":1,"accession":"PRJNA1513043","title":"Bottlenose dolphins (Tursiops truncatus) blow microbiome profiling","description":"This study aimed to characterize the blow-associated microbiome of free-ranging bottlenose dolphins (Tursiops truncatus) inhabiting the Gulf of Ambracia, Greece, using non-invasive unmanned aerial vehicle (UAV)-based sampling. Exhaled breath condensate was collected from wild dolphin groups using different sampling and preservation matrices, together with seawater and air controls, to evaluate methodological reliability and reduce environmental microbial signatures. The study compared the performance of DNA/RNA Shield, QIAcard FTA cards and dry sponge matrices, and then focused on the most reliable approaches to describe the total and core blow microbiomes of this resident dolphin population.","center":"University of Padova","data_type":"Raw sequence reads","submission_date":"2026/08/14 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN62403343","Metagenome or environmental sample from air metagenome","probable_urban","air_dust","2024-06-11",2024,"GR",null,null,null,"unresolved",null,null,"Greece: Ambracian Gulf",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN62403344","Metagenome or environmental sample from air metagenome","probable_urban","air_dust","2024-06-11",2024,"GR",null,null,null,"unresolved",null,null,"Greece: Ambracian Gulf",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN62403345","Metagenome or environmental sample from air metagenome","probable_urban","air_dust","2024-06-11",2024,"GR",null,null,null,"unresolved",null,null,"Greece: Ambracian Gulf",null,null,null,null,"city-level location without sample-site confirmation"],["