{"v":1,"accession":"PRJNA489993","title":"Microbial diversity in one petrochemical wastewater treatment plant","description":"One industrial scale plant was constructed to treat real petrochemical wastewater with 4649 ± 651 mg/L COD and more than 50 mg/L petrochemicals. The system of this industrial scale plant divides into four compartments and the treatment process mainly functions in one 2200 m3 anaerobic expanded granular sludge bed (EGSB) bioreactor and one 10000 m3 aerobic activated sludge (AS) bioreactor with the hydraulic retention time (HRT) of 62.8 hours and 133.3 hours, respectively. The plant has been successfully operated for more than 450 days now.","center":"DeepBiome Co., Ltd","data_type":"Raw sequence reads","submission_date":"2018/09/09 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN10023225","Metagenome or environmental sample from soil metagenome","non_environmental",null,"2018-04-11",2018,"CN","Jiangsu",1799962,"Nanjing","verified",31.95,118.83,"China: Nanjing, Jiangsu","Aerobic bioreactor",null,null,null,"laboratory or culture material"],["SAMN10023226","Metagenome or environmental sample from soil metagenome","non_environmental",null,"2017-04-26",2017,"CN","Jiangsu",1799962,"Nanjing","verified",31.95,118.83,"China: Nanjing, Jiangsu","Anaerobic bioreactor",null,null,null,"laboratory or culture material"],["SAMN10023227","Metagenome or environmental sample from soil metagenome","non_environmental",null,"2018-04-11",2018,"CN","Jiangsu",1799962,"Nanjing","verified",31.95,118.83,"China: Nanjing, Jiangsu","Anaerobic bioreactor",null,null,null,"laboratory or culture material"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_dat