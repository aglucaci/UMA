{"v":1,"accession":"PRJNA1511447","title":"Prokaryotic communities in a two-stage EGSB system treating pig slurry under increasing upflow velocity","description":"This study investigated the effect of upflow velocity on the performance and microbial community dynamics of a pilot-scale two-stage expanded granular sludge bed (EGSB) system treating real pig slurry. Different hydrodynamic conditions were applied while maintaining constant hydraulic retention times to evaluate their influence on reactor performance, biomass retention, granulation, and microbial community structure. Bacterial and archaeal communities were characterized by 16S rRNA gene amplicon sequencing at different operational stages to assess their temporal response to changes in upflow velocity and their differentiation between the hydrolytic/acidogenic and methanogenic reactors.","center":"Univeristy of Granada","data_type":"Raw sequence reads","submission_date":"2026/08/11 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN62355527","anaerobic sludge metganome","uncertain",null,"2025-04-29",2025,"ES","Andalusia",2517117,"Granada","verified",37.13,-3.76,"Spain: Granada, Chimeneas","anaerobic granular sludge from EGSB reactor treating pig slurry",null,null,null,"environmental sample; urban association not established"],["SAMN62355528","anaerobic sludge metganome","uncertain",null,"2025-04-29",2025,"ES","Andalusia",2517117,"Granada","verified",37.13,-3.76,"Spain: Granada, Chimeneas","anaerobic granular sludge from EGSB reactor treating pig slurry",null,null,null,"environmental sample; urban association not established"],["SAMN62355529","anaerobic sludge metganome","uncertain",null,"2025-04-29",2025,"ES","Andalusia",2517117,"Granada","verified",37.13,-3.76,"Spain: Gr