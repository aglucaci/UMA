{"v":1,"accession":"PRJNA315605","title":"Microbiome and transcriptomic analysis of cathodic biofilms of MEC and anaerobic granular sludge of an UASB, with DNA and RNA extraction","description":"The main aim of this study was to assess the performance of the biocathode of a lab-scale MEC to convert CO2 into CH4 as a technology for upgrading the biogas produced in anaerobic digesters, comparing two electromethanogenic biomass enrichment strategies: i) direct biomass enrichment in the biocathode of the MEC; ii) external biomass enrichment in a methanol-fed upflow anaerobic sludge blanket reactor (UASB). The evolution of the microbial community was evaluated in terms of composition and activity by the use of quantitative real-time polymerase chain reaction (qPCR) and high throughput sequencing of DNA and RNA.","center":"IRTA","data_type":"Transcriptome or Gene expression","submission_date":"2016/03/18 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN04566232","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2014-07-27",2014,"ES","Catalonia",3127035,"Caldes de Montbui","verified",41.613,2.17,"Spain: Caldes de Montbui","UASB anaerobic granular sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN04566233","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2014-07-27",2014,"ES","Catalonia",3127035,"Caldes de Montbui","verified",41.613,2.17,"Spain: Caldes de Montbui","UASB anaerobic granular sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN04566236","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2015-06-16",2015,"ES