{"v":1,"accession":"PRJNA939008","title":"Nine activated sludge samples were sequenced for 16S rRNA genes","description":"In order to explore the effects of food waste leachate supplementation on the microbial diversity and community structure stability of activated sludge, the effects on the original sludge T in the SBR pool of the sewage plant and the sludge S1 in the SBR reactor after being mixed with leachate. After the sludge S2 in the SBR reactor was adjusted to adjust the alkalinity of the leachate, 3 parallel and 9 activated sludge samples were treated for 16S rRNA gene sequencing.","center":"china jiliang univercity","data_type":"Raw sequence reads","submission_date":"2023/02/27 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN33453742","activated sludge","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN33453744","activated sludge","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN33453746","activated sludge","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN33453748","activated sludge","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN33453750","activated sludge","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN3345375