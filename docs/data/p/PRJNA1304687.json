{"v":1,"accession":"PRJNA1304687","title":"Metagenomic analysis of microbial communities in a three-dimensional electrode biofilm reactor for wastewater treatment","description":"A three-dimensional electrode biofilm reactor (3D-BER) was constructed using carbon felt and carbon rods as electrodes, inoculated with activated sludge, and applied for nitrate removal from wastewater. The microbial community composition and functional potential were analyzed via metagenomic sequencing to elucidate the key microorganisms and metabolic pathways involved in denitrification.","center":"Changsha University of Science & Technology","data_type":"Raw sequence reads","submission_date":"2025/08/11 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN50566001","BKR1","uncertain",null,"2025-01-05",2025,null,null,null,null,"unresolved",null,null,null,"biofilm in BKR1",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN50566002","R2Y","uncertain",null,"2025-01-05",2025,null,null,null,null,"unresolved",null,null,null,"biofilm in R2anode",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN50566003","R2C","uncertain",null,"2025-01-05",2025,null,null,null,null,"unresolved",null,null,null,"biofilm in R2cathode",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN50566004","R3Y","uncertain",null,"2025-01-05",2025,null,null,null,null,"unresolved",null,null,null,"biofilm in R3anode",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN50566005","R3C","uncertain",null,"2025-01-05",2025,null,null,null,null,"unresolved",null,null,null,"biofilm in R3cathode",null,null,null,"conflicting evidence: environmental and host/clinical"]],"run_cols":["accession","sample