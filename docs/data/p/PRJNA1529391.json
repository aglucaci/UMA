{"v":1,"accession":"PRJNA1529391","title":"Multi-omics analysis of nitrite-driven anaerobic chain-elongation bioreactors","description":"This BioProject contains 16S rRNA gene amplicon, metagenomic and metatranscriptomic sequencing data generated from laboratory-scale anaerobic chain-elongation bioreactors operated with or without low-dose nitrite addition. The study investigates how nitrite-associated nitrogen metabolism affects microbial community structure, carbon metabolism, reducing-power balance, energy conservation and medium-chain carboxylic acid production. Samples were collected from the nitrite-driven chain elongation system (NiCES) and a parallel control reactor during long-term operation.","center":"Nanjing University of Science and Technology","data_type":"Raw sequence reads","submission_date":"2026/09/15 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN63150301","MIMARKS Survey related sample from bioreactor metagenome","non_environmental",null,"2025-01-05",2025,"CN","Jiangsu",1799962,"Nanjing","verified",null,null,"China: Jiangsu, Nanjing",null,"anthropogenic terrestrial biome [ENVO:01000219]","wastewater treatment plant [ENVO:00002275]","anaerobic sludge [ENVO:00002045]","laboratory or culture material"],["SAMN63150302","MIMARKS Survey related sample from bioreactor metagenome","non_environmental",null,"2025-01-05",2025,"CN","Jiangsu",1799962,"Nanjing","verified",null,null,"China: Jiangsu, Nanjing",null,"anthropogenic terrestrial biome [ENVO:01000219]","wastewater treatment plant [ENVO:00002275]","anaerobic sludge [ENVO:00002045]","laboratory or culture material"],["SAMN63150303","MIMARKS Survey related sample from bioreactor metagenome","non_environmental",null,"2025-01-05",2025,"CN","Jiangsu",1799962,"Nanjing"