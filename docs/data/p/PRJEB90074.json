{"v":1,"accession":"PRJEB90074","title":"River_water_and_wastewater_short_read_metagenomics","description":"Short-read metagenomic sequencing of river water and wastewater samples to investigate the transmission dynamics of antimicrobial resistance (AMR) in complex environments. The study includes temporal sampling of river water and hospital wastewater to assess dynamics of vectors of AMR gene transmission through reconstruction of metagenome-assembled genomes (MAGs), and analysis of mobile genetic elements (MGEs) aiming to understand AMR emergence, evolution, and spread. This data is part of a pre-publication release. For information on the proper use of pre-publication data shared by the Wellcome Trust Sanger Institute please see http://www.sanger.ac.uk/datasharing/","center":"Wellcome Sanger Institute","data_type":"Other","submission_date":"2026/07/24 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA118446944","RIVWSRM15752869","uncertain",null,null,2025,"GB",null,null,null,"unresolved",null,null,"United Kingdom",null,null,null,null,"environmental sample; urban association not established"],["SAMEA118446945","RIVWSRM15752870","uncertain",null,null,2025,"GB",null,null,null,"unresolved",null,null,"United Kingdom",null,null,null,null,"environmental sample; urban association not established"],["SAMEA118446946","RIVWSRM15752871","uncertain",null,null,2025,"GB",null,null,null,"unresolved",null,null,"United Kingdom",null,null,null,null,"environmental sample; urban association not established"],["SAMEA118446947","RIVWSRM15752868","uncertain",null,null,2025,"GB",null,null,null,"unresolved",null,null,"United Kingdom",null,null,null,null,"environmental sample; urban association not established"],["SAMEA118446948","RIVWSRM15752872","un