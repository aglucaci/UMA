{"v":1,"accession":"PRJDB13859","title":"Microaerophilic activated sludge for ammonia recovery","description":"This project aims to develop activated sludge-based process to recovery ammonia from high-strength nitrogenous wastewater. The system operation was out-selection of nitrifying bacteria to suppress ammonia oxidation while facilitating oxidation of organic carbon. The study demonstrated the feasibility of the system and revealed the underlying microbial mechanism of ammonia recovery. This technology is significant for sustainable management of nitrogen and minimizing N2O emission.","center":"Nitrogen Circular Technology","data_type":"Targeted Locus (Loci)","submission_date":"2024/07/05 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00509971","Activated sludge R1, operation day 55, 16S rRNA gene V4 region, file id OB210713122","probable_urban","municipal_wastewater","2020-11-09",2020,"JP","Tokyo",1850147,"Tokyo","verified",35.7,139.518,"Japan:Tokyo",null,"sewage, wastewater, sludge","Suspended sludge","Synthetic wastewater","city-level location without sample-site confirmation"],["SAMD00509972","Activated sludge R2, operation day 55, 16S rRNA gene V4 region, file id OB210713123","probable_urban","municipal_wastewater","2020-11-09",2020,"JP","Tokyo",1850147,"Tokyo","verified",35.7,139.519,"Japan:Tokyo",null,"sewage, wastewater, sludge","Suspended sludge","Synthetic wastewater","city-level location without sample-site confirmation"],["SAMD00509973","Activated sludge R1, operation day 63, 16S rRNA gene V4 region, file id OB210713124","probable_urban","municipal_wastewater","2020-11-17",2020,"JP","Tokyo",1850147,"Tokyo","verified",35.7,139.52,"Japan:Tokyo",null,"sewage, wastewater, sludge","Suspended sludge","Synthetic waste