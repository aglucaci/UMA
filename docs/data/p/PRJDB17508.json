{"v":1,"accession":"PRJDB17508","title":"Microbial community structure analysis of microbial fuel cell with intermitted aeration","description":"This project explore the microbial community in microbial fuel cell (MFCs) with intermitted aeration. The sampling sites were selected to represent diverse areas where the presence of microorganisms could impact the performance of MFCs, including anodes of carbon brush (CB), sponges in aeration parts (SP), and the anolyte (AL). Afterward, we determine the function of each microorganism for electricity generation and organic matter removal from sewage.","center":"Nagoya Institute of Technology","data_type":"Targeted Locus (Loci)","submission_date":"2024/02/05 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00738023","Bottom of carbon brush anode","uncertain",null,"2022-08-31",2022,"JP","Aichi",1856057,"Nagoya","verified",35.1268,136.9786,"Japan:Aichi, Nagoya",null,"aquatic biome","seawage","seawage","no environmental-sample evidence"],["SAMD00738024","Middle of carbon brush anode","uncertain",null,"2022-08-31",2022,"JP","Aichi",1856057,"Nagoya","verified",35.1268,136.9786,"Japan:Aichi, Nagoya",null,"aquatic biome","seawage","seawage","no environmental-sample evidence"],["SAMD00738025","Top of carbon brush anode","uncertain",null,"2022-08-31",2022,"JP","Aichi",1856057,"Nagoya","verified",35.1268,136.9786,"Japan:Aichi, Nagoya",null,"aquatic biome","seawage","seawage","no environmental-sample evidence"],["SAMD00738026","Anolyte","uncertain",null,"2022-08-31",2022,"JP","Aichi",1856057,"Nagoya","verified",35.1268,136.9786,"Japan:Aichi, Nagoya",null,"aquatic biome","seawage","seawage","no environmental-sample evidence"],["SAMD00738027","Sponges_1","uncertain",null,"2022-08-31",2022,"JP","Aich