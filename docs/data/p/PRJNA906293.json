{"v":1,"accession":"PRJNA906293","title":"Effect of air mixing on high-solids anaerobic digestion of cow manure and its mechanism","description":"Laboratory tests and engineering application have proved that air mixing can improve methane production in conventional low solid content anaerobic digestion process. In this study, different mixing intensities were adopted under the condition of high-solids. Further, through the analysis of methane yield, organic matter removal efficiency, hydrolysis efficiency, carbon mass balance and microbial community structure, the performance of air mixing on high-solids anaerobic digestion system was clarified.","center":"Southwest University of Science and Technology","data_type":"Raw sequence reads","submission_date":"2022/11/29 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN31914604","R10_1","uncertain",null,"2022-11-26",2022,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN31914605","R10_2","uncertain",null,"2022-11-26",2022,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN31914606","R30_1","uncertain",null,"2022-11-26",2022,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN31914607","R30_2","uncertain",null,"2022-11-26",2022,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN31914608","R50_1","uncertain",null,"2022-11-26",2022,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"en