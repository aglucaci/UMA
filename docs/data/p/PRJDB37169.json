{"v":1,"accession":"PRJDB37169","title":"Metagenomic sequencing of wastewater treatment plant samples from Chongqing, China (PRJCA041825)","description":"This project focuses on metagenomic sequencing of samples collected from municipal wastewater treatment plants in Chongqing, China. The aim is to characterize microbial community composition, functional gene profiles, and the occurrence of antibiotic resistance genes. All samples were sequenced on the BGI T7 platform, with each sample generating over 20 Gb of paired-end data. The dataset supports environmental surveillance and public health risk assessment in urban wastewater systems.","center":"Ecological and Environment Monitoring Center of Chongqing","data_type":"Other","submission_date":"2025/09/24 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD01632666","CQWT-GPas1 (SAMC5317038)","confirmed_urban","municipal_wastewater","2023-07-08",2023,null,null,null,null,"unresolved",null,null,"missing: data agreement established pre-2023",null,"wastewater treatment plant","activated sludge","activated sludge","named urban infrastructure at sample level"],["SAMD01632667","CQWT-GYas1 (SAMC5317039)","confirmed_urban","municipal_wastewater","2023-07-12",2023,null,null,null,null,"unresolved",null,null,"missing: data agreement established pre-2023",null,"wastewater treatment plant","activated sludge","activated sludge","named urban infrastructure at sample level"],["SAMD01632668","CQWT-JQHas1 (SAMC5317040)","confirmed_urban","municipal_wastewater","2023-07-14",2023,null,null,null,null,"unresolved",null,null,"missing: data agreement established pre-2023",null,"wastewater treatment plant","activated sludge","activated sludge","named urban infrastructure at sample level"],["SAMD01632669","CQW