{"v":1,"accession":"PRJDB14325","title":"Developing environmental DNA analysis method to detect arthropods on plant surfaces","description":"This project aims to develop environmental DNA (eDNA) analysis methods to detect arthropods that are/were on plant surfaces. We hypothesized that arthropod DNAs remain on plant surfaces even if they are no longer on the plants and that if we could efficiently collect such DNAs, we could show evidence that the arthropods are/were on the plant surfaces.","center":"Center for Ecological Research/Hakubi Center, Kyoto University","data_type":"Targeted Locus (Loci)","submission_date":"2022/10/03 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00579687","Negative control (air blank) 1","non_urban",null,"2017-10-10",2017,"JP","Nara",1855612,"Nara-shi","verified",34.6694,135.7381,"Japan:Nara, Nara",null,"temperate biome","agriculture","aerosol [ENVO_00010505]","environmental sample from a non-urban site"],["SAMD00579688","Negative control (air blank) 2","non_urban",null,"2017-10-10",2017,"JP","Nara",1855612,"Nara-shi","verified",34.6694,135.7381,"Japan:Nara, Nara",null,"temperate biome","agriculture","aerosol [ENVO_00010505]","environmental sample from a non-urban site"],["SAMD00579689","Negative control (air blank) 3","non_urban",null,"2017-10-10",2017,"JP","Nara",1855612,"Nara-shi","verified",34.6694,135.7381,"Japan:Nara, Nara",null,"temperate biome","agriculture","aerosol [ENVO_00010505]","environmental sample from a non-urban site"],["SAMD00579690","Negative control (air blank) 4","non_urban",null,"2017-10-10",2017,"JP","Nara",1855612,"Nara-shi","verified",34.6694,135.7381,"Japan:Nara, Nara",null,"temperate biome","agriculture","aerosol [ENVO_00010505]","environmental sample from a non-urban si