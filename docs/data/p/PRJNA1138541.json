{"v":1,"accession":"PRJNA1138541","title":"Integrating enhanced biological phosphorus removal in adsorption-stage to treat real domestic sewage","description":"Wastewater treatment innovation toward resource recovery raises concerns about the adsorption and biological process . An A stage sequencing batch reactor employing the short sludge retention time approach to capture carbon and remove phosphorus simultaneously was conducted in this study. The SBR demonstrated remarkable phosphorus, inhibited ammonia, and steady chemical oxygen demand removal over a 102 day operational period. The process resulted in increased sludge yield and organic matter content, which benefitted subsequent anaerobic digestion by enhancing energy recovery efficiency by 1.68 times. The enrichment of phosphorus-accumulating organisms facilitated microbial activities associated with phosphorus metabolism, thereby increasing the phosphorus fractions related to biological accumulation. Biological adsorption significantly contributed to the efficient phosphorus removal, with high phosphorus content found in extracellular polymeric substances. The SBR provides the short sludge retention time an effective strategy for carbon and phosphorus capture in the A stage.","center":"Henan Academy of Sciences","data_type":"Raw sequence reads","submission_date":"2024/07/22 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN42723374","Con0","probable_urban","municipal_wastewater",null,2021,"CN","Heilongjiang",2037013,"Harbin","verified",null,null,"China: Harbin","control reactor sample 0day",null,null,null,"city-level location without sample-site confirmation"],["SAMN42723375","Con50","probable_urban","municipal_wastewater",null,2021,"CN","Heilongjiang",2037013,"Harbin","verified",null,null,"China: Harbin","control reactor sample 50day",null,null,null,"city-level location without sample-site confirmation"],["SAMN42723376","Con102","probable_urban","municipal_wastewater",null,2021,"CN","Heilongjiang",2037013,"Harbin","verified",null,null,"China: Harbin","control reactor sample 102day",null,null,null,"city-level location without sample-site confirmation"],["SAMN42723377","S_SRT0","probable_urban","municipal_wastewater",null,2021,"CN","Heilongjiang",2037013,"Harbin","verified",null,null,"China: Harbin","reactor sample 0day",null,null,null,"city-level location without sample-site confirmation"],["SAMN42723378","S_SRT50","probable_urban","municipal_wastewater",null,2021,"CN","Heilongjiang",2037013,"Harbin","verified",null,null,"China: Harbin","reactor sample 50day",null,null,null,"city-level location without sample-site confirmation"],["SAMN42723379","S_SRT102","probable_urban","municipal_wastewater",null,2021,"CN","Heilongjiang",2037013,"Harbin","verified",null,null,"China: Harbin","reactor sample 102day",null,null,null,"city-level location without sample-site confirmation"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR29911158","SAMN42723379","SRX25406389","Amplicon","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina MiSeq",24920994,41397,"2024-07-22","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos11/sra-pub-zq-1140/SRR029/29911/SRR29911158/SRR29911158.lite.1"],["SRR29911159","SAMN42723378","SRX25406388","Amplicon","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina MiSeq",22049454,36627,"2024-07-22","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos11/sra-pub-zq-1140/SRR029/29911/SRR29911159/SRR29911159.lite.1"],["SRR29911160","SAMN42723377","SRX25406387","Amplicon","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina MiSeq",31226342,51871,"2024-07-22","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos11/sr