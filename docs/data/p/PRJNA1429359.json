{"v":1,"accession":"PRJNA1429359","title":"Metabarcoding stem residue as a novel environmental DNA (eDNA) tool to identify spread of Phragmites australis biological control agents.","description":"We assessed whether environmental DNA (eDNA) metabarcoding of stem residues could be used to detect and distinguish the stem-boring noctuid moths Archanara neurica and Lenisa geminipuncta, biological control agents of introduced Phragmites australis released in Ontario, Canada. Using 16S rDNA metabarcoding supplemented with newly generated reference sequences, we analyzed stem residue samples spanning a gradient of quality, including laboratory culture stems (in which agent larvae were present at the time of sampling), confirmed Canadian release sites, and degraded stems from unmanaged Phragmites stands in western New York, USA.","center":"USACE-Engineer Research and Development Center","data_type":"Raw sequence reads","submission_date":"2026/02/27 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN56007264","MIMS Environmental/Metagenome sample from metagenome","non_environmental",null,"2025-02-05",2025,"CA","Ontario",6167865,"Toronto","probable",43.657,-79.3903,"Canada: Ontario, University of Toronto",null,"built environment","laboratory culture","plant stem residue","laboratory or culture material"],["SAMN56007265","MIMS Environmental/Metagenome sample from metagenome","non_environmental",null,"2024-06-18",2024,"CA","Ontario",6167865,"Toronto","probable",43.657,-79.3903,"Canada: Ontario, University of Toronto",null,"built environment","laboratory culture","plant stem residue","laboratory or culture material"],["SAMN56007266","MIMS Environmental/Metagenome sample from metagenome","non_environmental",null,"2024-06-18",2024,"CA","Ontario