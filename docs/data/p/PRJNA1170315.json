{"v":1,"accession":"PRJNA1170315","title":"Metagenomics Analysis in Architectural Heritage: the Ji family's Residence in the Southeast of Shanxi Province, China","description":"Microbial corrosion poses a significant threat to architectural heritage worldwide. This paper used metagenomics to investigate the microbial diversity and taxonomic groups present in the door walls of the residential houses of Ji family, as well as their biological functions and chemical cycles. Taxonomic annotation revealed the predominant microbial taxa associated with wall corrosion, shedding light on their potential impact on structural integrity.","center":"shanghaibiogenuinetech.co.ltd","data_type":"Raw sequence reads","submission_date":"2024/10/08 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN44103343","DBD","uncertain",null,"2023-04-26",2023,"CN",null,null,null,"unresolved",36.42,113.07,"China: southern region of Shanxi Province","surface of Dwelling-bad-door on ji family",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN44103344","DBW","uncertain",null,"2023-04-26",2023,"CN",null,null,null,"unresolved",36.42,113.07,"China: southern region of Shanxi Province","surface of Dwelling-bad wall on ji family",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN44103345","DGD","uncertain",null,"2023-04-26",2023,"CN",null,null,null,"unresolved",36.42,113.07,"China: southern region of Shanxi Province","surface of Dwelling-good-door on ji family",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN44103346","DGW","uncertain",null,"2023-04-26",2023,"CN",null,null,null,"unresolved",36.42,113.07,"China: southern region of Shanxi Province","surface of Dwelling-good-wall on ji fa