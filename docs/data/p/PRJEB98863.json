{"v":1,"accession":"PRJEB98863","title":"Niche compartmentalization promotes dissolved methane removal and simultaneous nitrification and denitrification in a hybrid MABR","description":"Here, we explore the potential of a hybrid membrane aerated biofilm reactor (MABR) -where suspended biomass and a biofilm co-occur-  to promote the removal of dissolved methane, a greenhouse gas, and the removal of ammonium present in anaerobically treated wastewater.  By amplicon sequencing means, we identify  the coupling of aerobic methane oxidizing bacteria, nitrifying bacteria, and denitrifying bacteria in the hybrid MABR.","center":"WDRC KAUST","data_type":"Other","submission_date":"2026/02/28 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA120311681","R1_inlet","uncertain",null,null,2025,"SA",null,null,null,"unresolved",null,null,"Saudi Arabia",null,null,null,null,"environmental sample; urban association not established"],["SAMEA120311682","R1_middle","uncertain",null,null,2025,"SA",null,null,null,"unresolved",null,null,"Saudi Arabia",null,null,null,null,"environmental sample; urban association not established"],["SAMEA120311683","R1_outlet","uncertain",null,null,2025,"SA",null,null,null,"unresolved",null,null,"Saudi Arabia",null,null,null,null,"environmental sample; urban association not established"],["SAMEA120311684","R1_susp_may","uncertain",null,null,2025,"SA",null,null,null,"unresolved",null,null,"Saudi Arabia",null,null,null,null,"environmental sample; urban association not established"],["SAMEA120311685","R1_susp_feb","uncertain",null,null,2025,"SA",null,null,null,"unresolved",null,null,"Saudi Arabia",null,null,null,null,"environmental sample; urban association not established"],["SAMEA120311686","R1_susp_oct","uncertain",null,n