{"v":1,"accession":"PRJNA1415529","title":"Virome Analysis of Selected Bat Species in Davao City, Philippines","description":"This project aims to characterize the virome of selected bat species using RNA-based shotgun metagenomic sequencing. RNA extracts from pooled swab (rectal and oral) and fecal samples were processed for library preparation using the Illumina Stranded Total RNA Prep Ligation kit with Ribo-Zero Plus and sequenced using NovaSeq 6000 SP reagent kit v1.5 with 100 cycles in a paired end format. Taxonomic profiling was done using Kraken2 standard viral database and abundance refined with Bracken.","center":"Philippine Genome Center Mindanao","data_type":"Raw sequence reads","submission_date":"2026/01/28 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN54938143","MIMS Environmental/Metagenome sample from metagenome","uncertain",null,"2021-06-20",2021,"PH","Davao Region",1715348,"Davao","verified",null,null,"Philippines: Davao City",null,"Urban Green Spaces","Forests and Synanthropic Habitats",null,"conflicting evidence: environmental and host/clinical"],["SAMN54938144","MIMS Environmental/Metagenome sample from metagenome","uncertain",null,"2021-06-20",2021,"PH","Davao Region",1715348,"Davao","verified",null,null,"Philippines: Davao City",null,"Urban Green Spaces","Subterranean Habitats",null,"conflicting evidence: environmental and host/clinical"],["SAMN54938145","MIMS Environmental/Metagenome sample from metagenome","uncertain",null,"2021-06-20",2021,"PH","Davao Region",1715348,"Davao","verified",null,null,"Philippines: Davao City",null,"Urban Green Spaces","Synanthropic Habitats",null,"conflicting evidence: environmental and host/clinical"],["SAMN54938146","MIMS Environmental/Metagenome sample from metagenome",