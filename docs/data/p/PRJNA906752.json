{"v":1,"accession":"PRJNA906752","title":"Constructing artificial biocrusts with municipal wastewater cultured cyanobacterium: a new insight to couple desertification control and wastewater treatment","description":"In this study, the artificial biocrusts are constructed with municipal wastewater cultured N-fixing sand-consolidating cyanobacterium S. hyalinum in Gurbantunggut desert, China, aiming at exploring the feasibility of constructing artificial biocrusts with wastewater cultured cyanobacterium in desert aera and evaluating its ecological safety. The results will provide necessary theoretical basis for the new insights of coupling desertification control and wastewater recycling.","center":"Wuhan University of Technology","data_type":"Raw sequence reads","submission_date":"2022/11/30 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN31937280","soil","probable_urban","soil_greenspace","2022-06-27",2022,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"urban context stated at BioProject level only"],["SAMN31937281","soil","probable_urban","soil_greenspace","2022-06-27",2022,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"urban context stated at BioProject level only"],["SAMN31937282","soil","probable_urban","soil_greenspace","2022-06-27",2022,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"urban context stated at BioProject level only"],["SAMN31937283","soil","probable_urban","soil_greenspace","2022-06-27",2022,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"urban context stated at BioProject level only"],["SAMN31937284","soil","probable_urban","soil_greenspace","2022-06-27",2022,null,null,null,null,"unresolved",null,null,null,null,null,null,nu