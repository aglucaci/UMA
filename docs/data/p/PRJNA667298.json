{"v":1,"accession":"PRJNA667298","title":"Complete Biodegradation of Insensitive High Explosive Compounds","description":"To better understand the environmental fate of insensitive high explosive compounds (IHEs), we developed IHEs-degrading enrichment cultures originated from anaerobic digester sludge and soil, and analyzed the enrichment cultures using cutting-edge metagenomics. One of the most important insensitive munitions compounds is Nitro-1,2,4-triazol-5-one (NTO). We provided metagenome of the NTO enrichment culture and metagenome assembled genomes from that sample.","center":"Georgia Institute of Technology","data_type":"Genome sequencing and assembly","submission_date":"2020/11/23 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN16365028","NTO_EC","non_environmental",null,"2019-07-22",2019,"US","Arizona",5318313,"Tucson","probable",32.33,-111.07,"USA: Tres Rios Wastewater Reclamation Facility in Tucson, Arizona","enrichment culture derived from anaerobic digestion as an inoculum",null,null,null,"laboratory or culture material"],["SAMN28861023","NTO reducing culture biological replicate 1","non_environmental",null,"2019-07-22",2019,"US","Arizona",5318313,"Tucson","probable",32.33,-111.07,"USA: Tres Rios Wastewater Reclamation Facility in Tucson, Arizona","enrichment culture derived from anaerobic digestion as an inoculum",null,null,null,"laboratory or culture material"],["SAMN28861525","NTO reducing culture biological replicate 2","non_environmental",null,"2019-07-22",2019,"US","Arizona",5318313,"Tucson","probable",32.33,-111.07,"USA: Tres Rios Wastewater Reclamation Facility in Tucson, Arizona","enrichment culture derived from anaerobic digestion as an inoculum",null,null,null,"laboratory or culture material"],["SAMN2