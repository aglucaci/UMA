{"v":1,"accession":"PRJNA1120319","title":"Nitrogen removal performance, ammonia oxidation contribution rate and community structure variation of ammonia-oxidizing microorganisms based on pure biofilm system","description":"Nitrification is the key and rate-limiting step in the biological nitrogen removal process of wastewater. In order to quantify the contribution of ammonia-oxidizing microorganisms (AOMs) in the nitrification process and promote cooperation among microorganisms, so as to achieve highly efficient nitrification, this study constructed a kind of pure biofilm system based on anoxic/ oxic (AO) process, and comparatively explored the nitrification performance of four different fillers and the growth and enrichment of related microorganisms.","center":"Qingdao University of Technology","data_type":"Raw sequence reads","submission_date":"2024/06/05 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN41686189","P1-1-D25","uncertain",null,"2023-09-03",2023,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN41686190","P2-1-D25","uncertain",null,"2023-09-03",2023,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN41686191","P3-1-D25","uncertain",null,"2023-09-03",2023,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN41686192","P4-1-D25","uncertain",null,"2023-09-03",2023,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN41686193","P1-2-D81","uncertain",null,"2023-10-29",2023,null,null,null,null,"unresolved",