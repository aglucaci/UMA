{"v":1,"accession":"PRJNA1035928","title":"Stable ammonium assimilation mediates the metabolic adaption of halophilic microbiome to hypo-osmotic stress","description":"Salinity barrier shapes distinct microbial ecology on earth, and applications of microbiomes are frequently hindered by trans-osmotic challenges. As a central nutrient metabolism, nitrogen transformations may contribute to conquering osmotic perturbations in microbiomes, and thus understanding the nitrogen metabolic responses to non-isosmotic exposure is crucial. Here we uncover that ammonium assimilation mediates the maintenance of physicochemical properties in a marine-derived halophilic microbiome when adapting to hypo-osmotic stress from salinity of 3% to 0.5% and recovery.","center":"Shandong University","data_type":"Raw sequence reads","submission_date":"2023/11/05 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN38105955","S1","non_environmental",null,"2021-09-08",2021,"CN","Shandong",1805753,"Jinan","probable",36.7,117.0,"China: Jinan","Bioreactor",null,null,null,"laboratory or culture material"],["SAMN38105956","S2","non_environmental",null,"2021-09-09",2021,"CN","Shandong",1805753,"Jinan","probable",36.7,117.0,"China: Jinan","Bioreactor",null,null,null,"laboratory or culture material"],["SAMN38105957","S3","non_environmental",null,"2021-09-10",2021,"CN","Shandong",1805753,"Jinan","probable",36.7,117.0,"China: Jinan","Bioreactor",null,null,null,"laboratory or culture material"],["SAMN38105958","S4","non_environmental",null,"2021-09-11",2021,"CN","Shandong",1805753,"Jinan","probable",36.7,117.0,"China: Jinan","Bioreactor",null,null,null,"laboratory or culture material"],["SAMN38105959","S5","non_environmental",null,"2021-10-18",2021,"CN","Shandong",1805753