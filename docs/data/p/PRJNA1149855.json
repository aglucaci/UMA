{"v":1,"accession":"PRJNA1149855","title":"Wastewater based surveillance revealed temporal dynamics of gut microbiota and virome during the COVID-19 pandemic","description":"Wastewater microbiome surveillance was used to characterize the temporal dynamics of the gut microbiota during the COVID-19 pandemic. The virome, dominated by temperate bacteriophages, showed high sensitivity to SARS-CoV-2, whereas the bacterial community exhibited greater adaptability and stability. The abundance of antimicrobial resistance genes (ARGs) was significantly and positively correlated with SARS-CoV-2 concentrations. These findings reveal, for the first time, the interaction network among gut bacteria, viruses, and ARGs, underscoring the unique value of wastewater microbiome surveillance in reflecting population health status.","center":"Chinese Academy of Sciences","data_type":"Raw sequence reads","submission_date":"2024/08/19 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN43264761","SARS-CoV-2: wastewater surveillance sample from wastewater metagenome","probable_urban","municipal_wastewater","2022-12-08",2022,"CN",null,null,null,"unresolved",null,null,"China: Bishui WWTP","wastewater",null,null,null,"city-level location without sample-site confirmation"],["SAMN43264762","SARS-CoV-2: wastewater surveillance sample from wastewater metagenome","probable_urban","municipal_wastewater","2022-12-09",2022,"CN",null,null,null,"unresolved",null,null,"China: Bishui WWTP","wastewater",null,null,null,"city-level location without sample-site confirmation"],["SAMN43264763","SARS-CoV-2: wastewater surveillance sample from wastewater metagenome","probable_urban","municipal_wastewater","2022-12-12",2022,"CN",null,null,null,"unresolved",null,null,"China: Bishui