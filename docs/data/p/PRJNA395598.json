{"v":1,"accession":"PRJNA395598","title":"MICROPLASTICS FROM MUNICIPAL WASTEWATER TREATMENT","description":"Microplastics (<5 mm) are a major and growing global pollution problem. Wastewater treatment plants, or water and resource recovery facilities (WRRFs), are suspected as a point source for microplastics, but the fate of microplastics during wastewater treatment is largely unknown. In this study, we estimated the microplastic load to WRRFs across the United States of America (USA). Further, using 16S rRNA gene sequencing, we evaluated the microbial biofilm colonizing the microplastic surface and identified the influence of wasterwater microbial community on biofilm formation.","center":"University of Kansas","data_type":"Raw sequence reads","submission_date":"2017/07/24 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN07375673","Influent after grit","non_environmental",null,"2015-06-01",2015,"US","Kansas",null,null,"unresolved",38.58,-95.13,"USA:Kansas",null,null,null,null,"laboratory or culture material"],["SAMN07375674","Activated_slduge","non_environmental",null,"2015-06-01",2015,"US","Kansas",null,null,"unresolved",38.58,-95.13,"USA:Kansas",null,null,null,null,"laboratory or culture material"],["SAMN07375675","Effluent","non_environmental",null,"2015-06-01",2015,"US","Kansas",null,null,"unresolved",38.58,-95.13,"USA:Kansas",null,null,null,null,"laboratory or culture material"],["SAMN07375676","Microplastic collected from Inffluent","non_environmental",null,"2015-06-01",2015,"US","Kansas",null,null,"unresolved",38.58,-95.13,"USA:Kansas",null,null,null,null,"laboratory or culture material"],["SAMN07375677","Microplastic collected from AS","non_environmental",null,"2015-06-01",2015,"US","Kansas",null,null,"unresolved",38.58