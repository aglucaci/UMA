{"v":1,"accession":"PRJNA1194126","title":"anaerobic sludge from an AnSBBR reactor Metagenome","description":"The soluble coffee industry produces complex wastewater that can significantly impact the environment. The objective of this work was to evaluate the treatment capacity of a system composed of an anaerobic reactor and physico-chemical processes of coagulation, flocculation, and sedimentation. In anaerobic digestion, a sequencing batch reactor with a working volume of 4.0 liters and biomass immobilized on polyurethane foams was used. During operation, different organic loading rates (OLRs) and agitation intensities were applied to the system.","center":"University of Sao Paulo","data_type":"Metagenome","submission_date":"2024/12/04 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN45167144","Metagenome or environmental sample from anaerobic sludge from an AnSBBR reactor","uncertain",null,"2024-05-15",2024,"BR","São Paulo",3449319,"São Carlos","verified",-22.001,-47.93,"Brazil: Sao Carlos","AnSBBR reactor",null,null,null,"conflicting evidence: environmental and host/clinical"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR31668044","SAMN45167144","SRX27030734","Amplicon","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina HiSeq 2500",75343071,125278,"2024-12-10","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos7/sra-pub-zq-41/SRR031/31668/SRR31668044/SRR31668044.lite.1"],["SRR31668045","SAMN45167144","SRX27030733","Amplicon","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina HiSeq 2500",83298060,138506,"2024-12-10","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos7/sra-pub-zq-41/SRR031/31668/SRR31