{"v":1,"accession":"PRJNA1498319","title":"ZVI-amended microalgal-bacterial granular sludge","description":"This study investigated bacterial and phototrophic microbial community succession in an aeration-free microalgae-bacteria granular sludge system treating wastewater with a low carbon-to-nitrogen ratio. Biomass samples were collected from parallel upflow photobioreactors operated with and without zero-valent iron addition at different operational stages. Amplicon sequencing of bacterial 16S rRNA genes and phototrophic 23S rRNA genes was conducted to characterize microbial community composition and diversity and to evaluate microbial responses to zero-valent iron addition, granule development, and reactor operating conditions.","center":"The Hong Kong Polytechnic University","data_type":"Raw sequence reads","submission_date":"2026/07/21 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN61840248","MIMARKS Survey related sample from wastewater metagenome","non_environmental",null,"2025-03-21",2025,"HK",null,1819729,"Hong Kong","probable",22.3058,114.1789,"China: Hong Kong",null,"wastewater treatment system biome [ENVO:01000964]","bioreactor [ENVO:00000073]","activated sludge [ENVO:00002046]","laboratory or culture material"],["SAMN61840249","MIMARKS Survey related sample from wastewater metagenome","non_environmental",null,"2025-04-24",2025,"HK",null,1819729,"Hong Kong","probable",22.3058,114.1789,"China: Hong Kong",null,"wastewater treatment system biome [ENVO:01000964]","bioreactor [ENVO:00000073]","activated sludge [ENVO:00002046]","laboratory or culture material"],["SAMN61840250","MIMARKS Survey related sample from wastewater metagenome","non_environmental",null,"2025-05-27",2025,"HK",null,1819729,"Hong Kong","probable",22.