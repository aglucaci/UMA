{"v":1,"accession":"PRJNA1256363","title":"The operation of the anaerobic ammonium oxidation process when shifted from continuous aeration to intermittent aeration.","description":"The anaerobic ammonium oxidation process, when transitioned from continuous to intermittent aeration, exhibits distinct operational characteristics. This change aims to optimize resource usage and enhance process efficiency. Under intermittent aeration, the system's biological activity and nitrogen removal performance may fluctuate initially. However, over time, it can adapt to the new aeration pattern, potentially achieving comparable or even better treatment results while reducing energy consumption.","center":"Qingdao University","data_type":"Raw sequence reads","submission_date":"2025/04/28 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN48177801","Biofilm_1","probable_urban","municipal_wastewater","2023-05-01",2023,"CN",null,null,null,"conflicting",37.5109,122.1005,"China: qingdao",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN48177802","Biofilm_2","probable_urban","municipal_wastewater","2023-06-12",2023,"CN",null,null,null,"conflicting",37.5109,122.1005,"China: qingdao",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN48177803","Biofilm_3","probable_urban","municipal_wastewater","2023-07-12",2023,"CN",null,null,null,"conflicting",37.5109,122.1005,"China: qingdao",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN48177804","Biofilm_4","probable_urban","municipal_wastewater","2023-08-14",2023,"CN",null,null,null,"conflicting",37.5109,122.1005,"China: qingdao",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN481778