{"v":1,"accession":"PRJNA1125188","title":"Communities in domestic sewage","description":"This project describes the structure of microbial communities nurtured by domestic sewage in Beijing, China. The project is mediated by a sequencing batch bioreactor with an anaerobic-aerobic-anoxic mode of operation. The microorganisms perform carbon, nitrogen nutrient removal in an activated sludge state. The aim of the project is to investigate the metabolic correlation between glycogen-accumulating microorganisms and anammox bacteria in the SBR system.","center":"Beijing University of Technology","data_type":"Raw sequence reads","submission_date":"2024/06/18 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN41885159","Metagenome or environmental sample from activated sludge metagenome","uncertain",null,"2022-12-21",2022,"CN","Beijing",1816670,"Beijing","verified",39.52,116.28,"China: Beijing","Activate sludge",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN41885160","Metagenome or environmental sample from activated sludge metagenome","uncertain",null,"2023-03-03",2023,"CN","Beijing",1816670,"Beijing","verified",39.52,116.28,"China: Beijing","Activate sludge",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN41885161","Metagenome or environmental sample from activated sludge metagenome","uncertain",null,"2023-05-06",2023,"CN","Beijing",1816670,"Beijing","verified",39.52,116.28,"China: Beijing","Activate sludge",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN41885162","Metagenome or environmental sample from activated sludge metagenome","uncertain",null,"2023-07-18",2023,"CN","Beijing",1816670,"Beijing","verified",39.52,116.28,"China: Beijing","Activ