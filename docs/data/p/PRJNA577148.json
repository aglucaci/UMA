{"v":1,"accession":"PRJNA577148","title":"Airborne bacteria confirm the pristine nature of the Southern Ocean boundary layer","description":"Microorganisms are ubiquitous and highly diverse in the atmosphere. Despite airborne bacteria over the Southern Ocean (SO) potentially impact to ecology in isolated Antarctica (barrier and source) and climate (cloud formation), no previous region-wide assessment of bioaerosols over the SO has been reported. To understand latitudinal variations in airborne bacterial communities and to use source tracking to deduce sources of the bacterial communities, we investigated bacterial profiling from air filter samples taken during CAPRICORN-2018 cruise.","center":"Colorado State University","data_type":"Raw sequence reads","submission_date":"2019/10/11 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN13020512","Metagenome or environmental sample from air metagenome","uncertain",null,null,2018,null,null,null,null,"unresolved",-44.9609,146.3052,"Southern Ocean","air",null,null,null,"environmental sample; urban association not established"],["SAMN13020513","Metagenome or environmental sample from air metagenome","uncertain",null,null,2018,null,null,null,null,"unresolved",-47.3393,144.9231,"Southern Ocean","air",null,null,null,"environmental sample; urban association not established"],["SAMN13020514","Metagenome or environmental sample from air metagenome","uncertain",null,null,2018,null,null,null,null,"unresolved",-49.1381,144.1595,"Southern Ocean","air",null,null,null,"environmental sample; urban association not established"],["SAMN13020515","Metagenome or environmental sample from air metagenome","uncertain",null,null,2018,null,null,null,null,"unresolved",-50.5396,143.4763,"Southern Ocean","air",null