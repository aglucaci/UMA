{"v":1,"accession":"PRJNA1482763","title":"Metagenomic and metatranscriptomic profiling of partial nitritation reactors under different ammonia-based F/M ratios","description":"This BioProject contains raw metagenomic and metatranscriptomic sequencing reads from sludge samples collected from partial nitritation reactors operated under different ammonia-based food-to-microorganism (F/M) ratios. The reactors were operated with comparable partial nitritation performance but different MLSS-normalized ammonium loading regimes. These raw sequencing data were generated to support microbial community, functional potential and transcriptional activity analyses associated with reactor-state differences under comparable partial nitritation performance.","center":"Tongji University","data_type":"Raw sequence reads","submission_date":"2026/06/27 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN61134638","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2025-06-20",2025,"CN","Shanghai",1796236,"Shanghai","verified",31.26,121.53,"China: Shanghai",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN61134639","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2025-06-20",2025,"CN","Shanghai",1796236,"Shanghai","verified",31.26,121.53,"China: Shanghai",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN61134640","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2025-06-20",2025,"CN","Shanghai",1796236,"Shanghai","verified",31.26,121.53,"China: Shanghai",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN611