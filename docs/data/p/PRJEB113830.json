{"v":1,"accession":"PRJEB113830","title":"Metagenomic investigation of side-stream PN/A disturbance in a full-scale wastewater treatment plant","description":"This study investigated the impacts of stable and disturbed side-stream partial nitritation–anammox (PN/A) operation on nitrogen removal performance, greenhouse gas emissions, and microbial community dynamics in a full-scale municipal wastewater treatment plant in the United Kingdom. The plant employed an integrated Anoxic–Aerobic–Anaerobic Digestion (AD)–PN/A configuration, and disturbance of the PN/A process was associated with increased organic loading from AD dewatering liquor. Shotgun metagenomic sequencing was performed on samples collected from the AD unit, PN/A reactor, Anoxic tank, and Aerobic tank during both operational phases. The dataset was generated to characterize microbial community composition, functional gene profiles, and putative nitrogen- and methane-cycling pathways associated with process deterioration and greenhouse gas emission potential. These data support analyses of microbial ecology and process performance in full-scale wastewater treatment systems under changing operational conditions.","center":"University of Surrey","data_type":"Other","submission_date":"2026/09/04 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA122737190","TW01","probable_urban","municipal_wastewater","2023-03-07",2023,"GB",null,null,null,"unresolved",null,null,"United Kingdom",null,null,null,null,"urban context stated at BioProject level only"],["SAMEA122737191","TW02","probable_urban","municipal_wastewater","2023-03-07",2023,"GB",null,null,null,"unresolved",null,null,"United Kingdom",null,null,null,null,"urban context stated at BioProject level only"],["SAMEA122737192"