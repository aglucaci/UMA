{"v":1,"accession":"PRJNA189333","title":"Geographic Sewage Study Targeted Locus (Loci)","description":"We are using microbiological and molecular techniques to identify sources of fecal bacteria in the surface waters of the Milwaukee River Basin. The purpose of these studies is to provide a more detailed assessment of water quality so efforts to improve water quality can be directed to the major sources of pollution in our waterways. Results from these studies provide a more accurate picture of the extent of contamination in local surface waters and the sources of contamination.  Raw sewage microbiomes from 13 geographic locations.","center":"Marine Biological Laboratory","data_type":"Targeted Locus (Loci)","submission_date":"2013/02/13 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN01915770","FT03660","confirmed_urban","municipal_wastewater","2007-08-21",2007,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"explicit urban setting at sample level"],["SAMN01915771","FT03661","confirmed_urban","municipal_wastewater","2007-08-21",2007,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"explicit urban setting at sample level"],["SAMN01915772","FT13523","confirmed_urban","municipal_wastewater","2006-05-10",2006,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"explicit urban setting at sample level"],["SAMN01915773","FT13524","confirmed_urban","municipal_wastewater","2006-05-17",2006,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"explicit urban setting at sample level"],["SAMN01915774","FT13525","confirmed_urban","municipal_wastewater","2006-06-06",2006,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"explicit urban setting at sample 