{"v":1,"accession":"PRJNA407631","title":"16S Amplicon Analysis of Microbial Communities in Laboratory-Scale, Temperature-Phased Biogas Reactors","description":"This study examined the microbial communities in laboratory-scale biogas reactors digesting food waste in a temperature-phased digestion system consisting of a thermophilic, hydrolysis phase followed by a mesophilic, methanogenic phase. The effect of 2 factors were examined: 1) temperature (either 55 or 65°C) in the hydrolysis phase and 2) lowered hydraulic retention time in the methanogenic phase. This dataset consists of 16S amplicon data that was obtained at several timepoints during steady-state operation of the reactors, and it includes matched metadata such as pH, chemical oxygen demand, volatile fatty acid and ammonium concentrations, alkalinity, volatile solids, and biogas production.","center":"NMBU","data_type":"Targeted loci environmental","submission_date":"2017/09/16 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN07691008","Mesophilic Digestion System 1 Timepoint 1 (day 112)","non_environmental",null,"2015-06-23",2015,"NO","Akershus",3162797,"Ås","verified",59.6623,10.7511,"Norway: As",null,"anthropogenic","anaerobic bioreactor","anaerobic digester sludge","laboratory or culture material"],["SAMN07691009","Mesophilic Digestion System 1 Timepoint 2 (day 116)","non_environmental",null,"2015-06-27",2015,"NO","Akershus",3162797,"Ås","verified",59.6623,10.7511,"Norway: As",null,"anthropogenic","anaerobic bioreactor","anaerobic digester sludge","laboratory or culture material"],["SAMN07691010","Mesophilic Digestion System 1 Timepoint 3 (day 120)","non_environmental",null,"2015-07-01",2015,"NO","Akershus",3162797,"Ås","verified",59.6623,10.7511,"Norway: As",null,