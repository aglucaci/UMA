{"v":1,"accession":"PRJNA783505","title":"Study on the microbial community of BR-TFCW","description":"The main colonies of BR-TFCW are Proteobacteria, Bacteroidota, Actinobacteriota and Firmicutes. They are mainly related to the degradation of organic matter, the fight against dehydration, and the fight against nutrient insufficiency. Among the top ten species in relative abundance, Propioniciclava, TM7a, unclassified_f__Propionibacteriaceae, Candidatus_Competibacter, norank_f__norank_o__Saccharimonadales and Flavobacterium have significant differences between CG1 and EG (p<0.001). CG1 has no oxygen supply link, which leads to the microbial community mostly anaerobic bacteria. They are related to fermentation and methane production.","center":"Chongqing University","data_type":"Raw sequence reads","submission_date":"2021/11/25 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN23435342","sludge","uncertain",null,"2021-06-25",2021,"CN",null,null,null,"unresolved",null,null,"China","Artificial wetland1",null,null,null,"environmental sample; urban association not established"],["SAMN23435343","sludge","uncertain",null,"2021-06-25",2021,"CN",null,null,null,"unresolved",null,null,"China","Artificial wetland2",null,null,null,"environmental sample; urban association not established"],["SAMN23435344","sludge","uncertain",null,"2021-06-25",2021,"CN",null,null,null,"unresolved",null,null,"China","Artificial wetland3",null,null,null,"environmental sample; urban association not established"],["SAMN23435345","sludge","uncertain",null,"2021-06-25",2021,"CN",null,null,null,"unresolved",null,null,"China","Artificial wetland4",null,null,null,"environmental sample; urban association not established"],["SAMN23435346","sludge","uncertain",null,"2021-