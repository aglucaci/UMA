{"v":1,"accession":"PRJNA1387377","title":"Study of microalgae growth in reclaimed wastewater treatment plants","description":"The aims of this study were to: (1) determine the diversity of microalgal and bacterial communities in reclaimed wastewater treatment plants (RWWTPs) influent; (2) analyze variations of microalgal and bacterial communities in different temporal and spatial conditions; (3) explore the interactions between bacteria and microalgae; (4) identify whether microalgae are prevalent in RWWTPs and the effects of technological types on bacterial and microalgal community structures.","center":"Beijing University of Technology","data_type":"Raw sequence reads","submission_date":"2025/12/16 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN54137984","23S0","probable_urban","municipal_wastewater",null,2022,null,null,null,null,"unresolved",null,null,null,"RWWTP sample",null,null,null,"urban context stated at BioProject level only"],["SAMN54137985","16S1","probable_urban","municipal_wastewater",null,2022,null,null,null,null,"unresolved",null,null,null,"RWWTP sample",null,null,null,"urban context stated at BioProject level only"],["SAMN54137986","23S2","probable_urban","municipal_wastewater",null,2022,null,null,null,null,"unresolved",null,null,null,"RWWTP sample",null,null,null,"urban context stated at BioProject level only"],["SAMN54137987","16S3","probable_urban","municipal_wastewater",null,2022,null,null,null,null,"unresolved",null,null,null,"RWWTP sample",null,null,null,"urban context stated at BioProject level only"],["SAMN54137988","23S4","probable_urban","municipal_wastewater",null,2022,null,null,null,null,"unresolved",null,null,null,"RWWTP sample",null,null,null,"urban context stated at BioProject level only"],["SA