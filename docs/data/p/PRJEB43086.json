{"v":1,"accession":"PRJEB43086","title":"Particle-associated bacteria from sediment trap samples deployed at Fram Strait (Arctic Ocean)","description":"The data set comprise 25 archived sinking particle samples from moored sediment traps deployed between ~ 80 – 280 m water depth in Fram Strait (Arctic Ocean), which were obtained in the framework of the Long-Term Ecological Research Site HAUSGARTEN and the Helmholtz infrastructure program FRAM. The samples correspond to those obtained during the highest particulate organic carbon (POC) flux in spring and summer, we used the data to investigate variations in bacterial community structure over a period of 12 years (2000 – 2012).","center":"German Federation for Biological Data","data_type":"Other","submission_date":"2022/07/20 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA8060545","FEVI_24_Oben_14","non_urban",null,"2012-04-30",2012,null,null,null,null,"unresolved",null,null,"Arctic Ocean",null,null,null,null,"environmental sample from a non-urban site"],["SAMEA8060546","FEVI_24_Oben_3","non_urban",null,"2011-08-31",2011,null,null,null,null,"unresolved",null,null,"Arctic Ocean",null,null,null,null,"environmental sample from a non-urban site"],["SAMEA8060547","FEVI_22_Oben_16","non_urban",null,"2011-04-30",2011,null,null,null,null,"unresolved",null,null,"Arctic Ocean",null,null,null,null,"environmental sample from a non-urban site"],["SAMEA8060548","FEVI_20_Oben_19","non_urban",null,"2010-06-15",2010,null,null,null,null,"unresolved",null,null,"Arctic Ocean",null,null,null,null,"environmental sample from a non-urban site"],["SAMEA8060549","FEVI_20_Oben_3","non_urban",null,"2009-08-10",2009,null,null,null,null,"unresolved",null,null,"Arctic Ocean",null,null,null,null,"environmenta