{"v":1,"accession":"PRJEB70517","title":"Supplementation with the short-chain fatty acid acetate for improving age-associated arterial dysfunction in mice","description":"Our overall purpose is to investigate the efficacy of acetate supplementation for treating age-related arterial dysfunction in mice. We are secondarily interested in the relative efficacy of acetate supplementation compared to consumption of a high-fiber diet. We are interested in determining gut microbiome composition (fecal samples), as acetate supplementation has been shown to increase abundance of acetate-producing bacteria, and high-fiber diets increase abundance of overall SCFA-producing bacteria.","center":"University of California San Diego Microbiome Initiative","data_type":"Other","submission_date":"2024/11/13 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA114720095",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evidence"],["SAMEA114720096",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evidence"],["SAMEA114720097",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evidence"],["SAMEA114720098",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evidence"],["SAMEA114720099",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evidence"],["SAMEA114720100",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evi