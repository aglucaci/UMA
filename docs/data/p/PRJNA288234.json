{"v":1,"accession":"PRJNA288234","title":"\"Metagenomic analysis of a wastewater recycling consortia\"","description":"To determine the optimum conditions to establish a nitrification in a biological water processor. These sequences were obtained through a time-course sampling of six subscale, batch water reclamation reactors. Inoculated with a urine-fed, nitrifying inoculum, two groups of reactors (triplicate) were fed either urine or wastewater (consisting of urine, humidity condensate, laundry, shower, shave, oral hygiene and handwash water) and observed to determine which feed water conditions cultivated a nitrifying consortia.","center":"University of Houston","data_type":"Metagenome","submission_date":"2015/06/25 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN03800326","8-30I","uncertain",null,"2013-08-30",2013,"US","Texas",4705692,"League City","probable",29.563,-95.091,"USA: Texas",null,"urine","urine","urine","environmental sample; urban association not established"],["SAMN03800327","9-2A1-1","uncertain",null,"2013-09-02",2013,"US","Texas",4705692,"League City","probable",29.563,-95.091,"USA: Texas",null,"urine","urine","urine","environmental sample; urban association not established"],["SAMN03800328","9-2A2-1","uncertain",null,"2013-09-02",2013,"US","Texas",4705692,"League City","probable",29.563,-95.091,"USA: Texas",null,"urine","urine","urine","environmental sample; urban association not established"],["SAMN03800329","9-2A3-1","uncertain",null,"2013-09-02",2013,"US","Texas",4705692,"League City","probable",29.563,-95.091,"USA: Texas",null,"urine","urine","urine","environmental sample; urban association not established"],["SAMN03800330","9-2B1-1","uncertain",null,"2013-09-02",2013,"US","Texas",4705692,"League City",