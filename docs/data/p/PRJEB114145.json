{"v":1,"accession":"PRJEB114145","title":"Municipal wastewater treatment plants (WWTPs) for surveying microbial and viral dynamics","description":"The reuse of treated wastewater is now a major environmental and socio-economic challenge. It represents an alternative water resource that can help address increasing water shortages and better preserve natural resources by reducing water withdrawals from already vulnerable ecosystems. However, the development of this more sustainable water management strategy still requires several constraints to be overcome, including public health and environmental risks associated with pathogens and potential micro- pollutants present in treated wastewater, technological challenges related to the implementation of reliable remediation processes that can be applied at large scale and at an acceptable cost, and societal acceptance of wastewater reuse.","center":"universite clermont-auvergne","data_type":"Other","submission_date":"2026/07/02 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA122765723","20240404 WWTP entry point","confirmed_urban","municipal_wastewater","2024-04-04",2024,"FR",null,null,null,"unresolved",null,null,"France",null,null,null,null,"named urban infrastructure at sample level"],["SAMEA122765724","20240404 WWTP exit point","confirmed_urban","municipal_wastewater","2024-04-04",2024,"FR",null,null,null,"unresolved",null,null,"France",null,null,null,null,"named urban infrastructure at sample level"],["SAMEA122765725","20240416 WWTP entry point","confirmed_urban","municipal_wastewater","2024-04-16",2024,"FR",null,null,null,"unresolved",null,null,"France",null,null,null,null,"named urban infrastructure at sample level"],["SAMEA122765726","20240416 WWTP exit point","confirmed_urban