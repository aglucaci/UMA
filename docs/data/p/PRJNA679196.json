{"v":1,"accession":"PRJNA679196","title":"Quantifying the effects of hydrogen on carbon assimilation in a marine microbial community associated with ultramafic rocks","description":"The aerobic oxidation of molecular hydrogen (H2) is a thermodynamically favorable energy-yielding process for microbial communities, but how H2 oxidation is connected to anabolic processes in marine microbial communities is poorly understood. We quantified the effects of H2 on carbon utilization using quantitative DNA stable isotope probing (DNA-qSIP), which revealed that H2 utilization increased carbon assimilation by diverse microbial taxa synthesizing 13C-labeled DNA associated with ultramafic rocks at the Mid-Atlantic Ridge.","center":"Ludwig-Maximilian University","data_type":"Genome sequencing and assembly","submission_date":"2021/04/08 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN16829313","qSIP from marine settings 388","non_urban",null,null,2016,"BR",null,null,null,"unresolved",0.55,-29.21,"Brazil: Saint Peter and Saint Paul' Rocks","Laboratory dust",null,null,null,"environmental sample from a non-urban site"],["SAMN16829314","qSIP from marine settings 389","non_urban",null,null,2016,"BR",null,null,null,"unresolved",0.55,-29.21,"Brazil: Saint Peter and Saint Paul' Rocks","Laboratory dust",null,null,null,"environmental sample from a non-urban site"],["SAMN16829315","qSIP from marine settings 390","non_urban",null,null,2016,"BR",null,null,null,"unresolved",0.55,-29.21,"Brazil: Saint Peter and Saint Paul' Rocks","Laboratory dust",null,null,null,"environmental sample from a non-urban site"],["SAMN16829316","qSIP from marine settings 391","non_urban",null,null,2016,"BR",null,null,null,"unresolved",0.55,-29.21,"Brazil: Saint Peter and Saint Pa