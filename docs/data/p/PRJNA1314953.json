{"v":1,"accession":"PRJNA1314953","title":"CPE from wastewater","description":"The CPE have been isolated from hospital wastewater, sewers and wastewater treatment plants. The goal of the study was to determine the origin of CPE at municipal WWTP and the contribution of hospitals and households to the CPE load in WWTP influents. Measurements in WWTP influents are used for wastrewater-based surveillance of CPE, which is based on the assumption that the enterobacterial content in wastewater reflects human carriage. Influence of hospital wastewater could disrupt this association.","center":"RIVM","data_type":"Raw sequence reads","submission_date":"2025/09/04 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN51025488","Pathogen: environmental/food/other sample from Escherichia coli","uncertain",null,"2017-09-26",2017,"NL",null,null,null,"unresolved",null,null,"Netherlands","WWTP influent",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN51025489","Pathogen: environmental/food/other sample from Escherichia coli","uncertain",null,"2017-09-26",2017,"NL",null,null,null,"unresolved",null,null,"Netherlands","WWTP influent",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN51025491","Pathogen: environmental/food/other sample from Escherichia coli","uncertain",null,"2017-10-10",2017,"NL",null,null,null,"unresolved",null,null,"Netherlands","WWTP influent",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN51025492","Pathogen: environmental/food/other sample from Escherichia coli","uncertain",null,"2017-10-10",2017,"NL",null,null,null,"unresolved",null,null,"Netherlands","WWTP influent",null,null,null,"conflicting evidence: environmental and host/clinical"],["S