{"v":1,"accession":"PRJEB22193","title":"Microbial communities in drinking water systems","description":"This study contains five samples from different drinking water microbial communities. Each sample is an aggregate sample of several biological replicates. Three samples are bulk water samples (one cold-water and two warm-water communities) and two are biofilms samples.The goal of this study was to complement a 16S marker-gene based study. In this study we have investigated the differences in microbial community between hot and cold water systems and between two buildings receiving the same incoming water.","center":"NORWEGIAN INSTITUTE OF PUBLIC HEALTH","data_type":"Other","submission_date":"2019/09/20 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA104228697","Shower hose biofilm metagenomics","uncertain",null,null,2015,"NO",null,null,null,"unresolved",null,null,"Norway",null,null,null,null,"environmental sample; urban association not established"],["SAMEA104228698","Shower hose biofilm metagenomics","uncertain",null,null,2015,"NO",null,null,null,"unresolved",null,null,"Norway",null,null,null,null,"environmental sample; urban association not established"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["ERR2105752","SAMEA104228698","ERX2163030","WGS","WGS","METAGENOMIC","PAIRED","ILLUMINA","Illumina HiSeq 3000",19578052074,64827987,"2019-09-11","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos9/sra-pub-zq-922/ERR002/105/ERR2105752.sralite.1"],["ERR2105756","SAMEA104228697","ERX2163034","WGS","WGS","METAGENOMIC","PAIRED","ILLUMINA","Illumina HiSeq 3000",20893571926,69184013,"2019-09-11","https://sra-downloadb.