{"v":1,"accession":"PRJNA772528","title":"Zero-valent iron (ZVI)-Fenton based process affects the total load of human pathogenic bacteria in secondary treated municipal wastewater","description":"We carried out a series of experiments testing the efficacy of ZVI-Fenton vs. treatment with H2O2 alone in the removal of potentially pathogenic bacteria from secondary treated wastewater acidified at pH 5 with H3PO4. Treatments were compared in terms of bacterial community composition and relative abundance of human potentially pathogenic bacteria. Negative controls are filtration controls.","center":"CNR","data_type":"Raw sequence reads","submission_date":"2021/10/19 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN22374976","PA1","confirmed_urban","municipal_wastewater","2020-02-06",2020,"IT","Piedmont",6457398,"Verbania","probable",45.9413,8.5737,"Italy","Municipal wastewater",null,null,null,"explicit urban setting at sample level"],["SAMN22374977","PA2","confirmed_urban","municipal_wastewater","2020-02-06",2020,"IT","Piedmont",6457398,"Verbania","probable",45.9413,8.5737,"Italy","Municipal wastewater",null,null,null,"explicit urban setting at sample level"],["SAMN22374978","PA3","confirmed_urban","municipal_wastewater","2020-02-06",2020,"IT","Piedmont",6457398,"Verbania","probable",45.9413,8.5737,"Italy","Municipal wastewater",null,null,null,"explicit urban setting at sample level"],["SAMN22374979","HP1","confirmed_urban","municipal_wastewater","2020-02-06",2020,"IT","Piedmont",6457398,"Verbania","probable",45.9413,8.5737,"Italy","Municipal wastewater",null,null,null,"explicit urban setting at sample level"],["SAMN22374980","HP2","confirmed_urban","municipal_wastewater","2020-02-06",2020,"IT","Piedmont",6457398,"Verbania","probable