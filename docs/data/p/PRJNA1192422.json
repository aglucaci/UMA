{"v":1,"accession":"PRJNA1192422","title":"Mechanistic insight into oily sludge treatment by high-temperature biofortification: petroleum components degradation and microbial community regulation","description":"Thermochemical washing of oily sludge is a highly effective strategy for resource recovery. However, the lingering petroleum components within washed sludge still pose considerable environmental pollution risks. In this study, the potential of high-temperature biofortification for the deep treatment of washed oily sludge was investigated, including petroleum component degradation, microbial community regulation, and the potential enhancement mechanism.","center":"China University of Petroleum-Beijing","data_type":"Raw sequence reads","submission_date":"2024/11/30 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN45108824","A","uncertain",null,"2024-03-10",2024,null,null,null,null,"unresolved",null,null,null,"reactor sample 1",null,null,null,"environmental sample; urban association not established"],["SAMN45108825","B","uncertain",null,"2024-03-14",2024,null,null,null,null,"unresolved",null,null,null,"reactor sample 2",null,null,null,"environmental sample; urban association not established"],["SAMN45108826","C","uncertain",null,"2024-03-17",2024,null,null,null,null,"unresolved",null,null,null,"reactor sample 3",null,null,null,"environmental sample; urban association not established"],["SAMN45108827","D","uncertain",null,"2024-03-14",2024,null,null,null,null,"unresolved",null,null,null,"reactor sample 4",null,null,null,"environmental sample; urban association not established"],["SAMN45108828","E","uncertain",null,"2024-03-17",2024,null,null,null,null,"unresolved",null,null,null,"reactor sample 5",null,null,null,"environment