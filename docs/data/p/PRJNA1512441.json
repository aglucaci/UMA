{"v":1,"accession":"PRJNA1512441","title":"Kombucha Microbiome as a Potential Plant Architecture-Supporting Biostimulant: Metabarcoding Characterization of Its Bacterial and Fungal Community Structure","description":"This study characterizes the bacterial, eukaryotic, and fungal community structure of Kombucha using 16S rRNA, 18S rRNA, and ITS amplicon sequencing. Dried cellulosic pellicle (KP) and fermentation liquid (KS) fractions derived from three independent fermentations were analyzed as composite samples. The project aims to establish the taxonomic and phylogenetic structure of the Kombucha microbiome and to provide a microbiological basis for evaluating its potential as a plant architecture-supporting biostimulant.","center":"Erciyes University","data_type":"Raw sequence reads","submission_date":"2026/08/13 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN62382234","Kombucha dried cellulosic pellicle composite","non_environmental",null,"2025-06-15",2025,"TR","Kayseri",308464,"Kayseri","verified",38.7079,35.53,"Turkey: Kayseri",null,"built environment","research laboratory","Kombucha cellulosic pellicle (biofilm)","laboratory or culture material"],["SAMN62382235","Kombucha fermentation liquid composite","non_environmental",null,"2025-06-15",2025,"TR","Kayseri",308464,"Kayseri","verified",38.7079,35.53,"Turkey: Kayseri",null,"built environment","research laboratory","Kombucha fermentation liquid","laboratory or culture material"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR40152192","SAMN62382235","SRX34786605","ITS","AMPLICON","METAGENOMIC","PAIRED","DNBSEQ","DNBSEQ-T7",302767007,1109652,"2026-09-12"