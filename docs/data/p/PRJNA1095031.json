{"v":1,"accession":"PRJNA1095031","title":"Benchmarking Quantitative Metagenomics for Wastewater-Based Surveillance of AMR","description":"Wastewater samples from a local VA WWTP were uniformly processed, extracted, and spiked with logarithmically decreasing concentrations of synthetic DNA standards (sequins) to evaluate the quantitative capacity of the Illumina platform. The samples were then used to explore the technical boundaries of wastewater-based surveillance of antibiotic resistance genes by establishing the limit of quantification and detection for the workflow. Each sample was sequenced at approximately 100 Gb to achieve near 100% metagenomic coverage. The dataset includes 10 influent, 10 activated sludge, and 10 secondary effluent samples each spiked with standards in a uniform manner to increase the statistical power.","center":"Virginia Tech","data_type":"Raw sequence reads","submission_date":"2024/04/01 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN40711988","Metagenome or environmental sample from wastewater metagenome","confirmed_urban","municipal_wastewater","2021-09-21",2021,"US","Virginia",4752665,"Christiansburg","probable",37.15,-80.47,"USA: Virginia","raw influent to wastewater treatment plant",null,null,null,"named urban infrastructure at sample level"],["SAMN40711989","Metagenome or environmental sample from wastewater metagenome","confirmed_urban","municipal_wastewater","2021-09-21",2021,"US","Virginia",4752665,"Christiansburg","probable",37.15,-80.47,"USA: Virginia","raw influent to wastewater treatment plant",null,null,null,"named urban infrastructure at sample level"],["SAMN40711990","Metagenome or environmental sample from wastewater metagenome","confirmed_urban","municipal_wastewater","2021-09-21