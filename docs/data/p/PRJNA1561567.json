{"v":1,"accession":"PRJNA1561567","title":"Modulating microalgae- bacteria consortia for efficient wastewater remediation","description":"This study aimed to demonstrate the potential of upcycling dairy side-streams into premium animal feed ingredients via the microalga Nannochloropsis limnetica. The 16S rRNA data provided here characterises the bacterial communities associated with Nannochloropsis limnetica during a two-stage cultivation experiment. During the first stage either Bold's Basal Medium or dairy wastewater used as a growth medium, and in the second stage whey permeate was used as a growth medium. Bacterial samples were collected across multiple days.","center":"UCD","data_type":"Raw sequence reads","submission_date":"2026/11/13 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN65290242",null,"non_urban",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN65290243",null,"non_urban",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN65290244",null,"non_urban",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN65290245",null,"non_urban",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN65290246",null,"non_urban",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN65290247",null,"non_urban",null,null,null,null,null,null,null,"unresolved