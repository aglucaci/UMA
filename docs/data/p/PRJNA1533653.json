{"v":1,"accession":"PRJNA1533653","title":"Antibiotic resistance genes and their bacterial hosts in bioelectrochemically treated hospital wastewater","description":"Hospital wastewater contains a complex mixture of pharmaceuticals and antibiotic-resistant bacteria, posing challenges for conventional and advanced treatment technologies. This project investigates the microbial community composition and antibiotic resistance gene (ARG) dynamics in hospital wastewater treated using a fixed-bed bioelectrochemical reactor (FBER), compared with a non-electrochemical open-circuit voltage (OCV) control. Shotgun metagenomic sequencing was performed on inoculum, biofilm, and effluent samples collected throughout 128 days of reactor operation under continuous pharmaceutical exposure, enabling both community-level taxonomic and functional profiling, as well as the recovery of metagenome-assembled genomes (MAGs) to resolve ARG-host identity, virulence factors, and mobile genetic element associations.","center":"Helmholtz Centre for Environmental Research","data_type":"Raw sequence reads","submission_date":"2026/09/23 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN63375386","MIMS Environmental/Metagenome sample from wastewater metagenome","uncertain",null,"2025-07-07",2025,null,null,null,null,"unresolved",null,null,null,null,"ENVO:00002030","ENVO:06105300","ENVO:00010483","environmental sample; urban association not established"],["SAMN63375387","MIMS Environmental/Metagenome sample from wastewater metagenome","uncertain",null,"2025-07-07",2025,null,null,null,null,"unresolved",null,null,null,null,"ENVO:00002030",null,"ENVO:00010483","environmental sample; urban association not established"],["SAMN63375388","MIMS Environmental/Metagenome samp