{"v":1,"accession":"PRJNA605245","title":"Fermentative biohydrogen production from complex substrates","description":"Fermentative microorganisms are capable of produce hydrogen, a promising fuel, using complex organic substrates. To increase the knowledge about the hydrogen-producing processes using bacterial communities, several studies of optimization, the effect of substrate composition and the presence of inhibitory compounds have been carried out. The community analysis is performed by high-throughput sequencing approach of the 16S rRNA gene with universal primers.","center":"Instituto de Ingenieria, Universidad Nacional Autonoma de Mexico","data_type":"Raw sequence reads","submission_date":"2020/02/06 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN14052593","MIMARKS Survey related sample from biofilm metagenome","probable_urban",null,"2018-02-01",2018,"MX","Querétaro",3991164,"Santiago de Querétaro","probable",20.703,-100.446,"Mexico:Queretaro",null,"ENVO:01000254","ENVO:01000315","ENVO:01000315","city-level location without sample-site confirmation"],["SAMN14052594","MIMARKS Survey related sample from biofilm metagenome","probable_urban",null,"2018-02-01",2018,"MX","Querétaro",3991164,"Santiago de Querétaro","probable",20.703,-100.446,"Mexico:Queretaro",null,"ENVO:01000254","ENVO:01000315","ENVO:01000315","city-level location without sample-site confirmation"],["SAMN14052595","MIMARKS Survey related sample from biofilm metagenome","probable_urban",null,"2018-02-01",2018,"MX","Querétaro",3991164,"Santiago de Querétaro","probable",20.703,-100.446,"Mexico:Queretaro",null,"ENVO:01000254","ENVO:01000315","ENVO:01000315","city-level location without sample-site confirmation"],["SAMN14052596","MIMARKS Survey related sample fr