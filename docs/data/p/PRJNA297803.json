{"v":1,"accession":"PRJNA297803","title":"Enriched Fermenting and Methanogenic Microbial Communities raw sequence reads","description":"Inoculum from an anaerobic digester was exposed to different concentrations of different fermentable substrates under anaerobic batch conditions in order to understand how loading rate shifts the products of fermentation between methane and volatile fatty acids and what effect this shift has on the fermenting microbial community. This work illustrates how loading rates can effect the distribution of products and community members in various fields where fermentation plays a key role including waste water treatment, biological chemical production, and the human microbiome.","center":"Arizona State University","data_type":"Raw sequence reads","submission_date":"2015/10/05 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN04146735","Ethanol 100 me- eq./L","confirmed_urban","municipal_wastewater","2013-03-21",2013,"US","Arizona",5304391,"Mesa","verified",33.4336,-111.8805,"USA: Mesa, Arizona",null,"desert","anaerobic digester sludge","municipal wastewater","explicit urban setting at sample level"],["SAMN04146736","Ethanol 200 me- eq./L","confirmed_urban","municipal_wastewater","2013-03-21",2013,"US","Arizona",5304391,"Mesa","verified",33.4336,-111.8805,"USA: Mesa, Arizona",null,"desert","anaerobic digester sludge","municipal wastewater","explicit urban setting at sample level"],["SAMN04146737","Ethanol 400 me- eq./L","confirmed_urban","municipal_wastewater","2013-03-21",2013,"US","Arizona",5304391,"Mesa","verified",33.4336,-111.8805,"USA: Mesa, Arizona",null,"desert","anaerobic digester sludge","municipal wastewater","explicit urban setting at sample level"],["SAMN04146738","Lactate 100 me- eq./L","c