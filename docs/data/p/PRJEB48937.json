{"v":1,"accession":"PRJEB48937","title":"Honeybee hive bacteriome characterization","description":"Characterization of the bacterial consortia of the worker gut, bee bread, hive entrance and internal hive air of honey bee colonies under contrasting environments, through 16S rRNA amplicon sequencing. Contrasting environments consisted of an agricultural, a semi-natural and a pristine habitat. The semi-natural apiary was located at the edges of both agricultural and natural areas. Hives were established on spring, and sampled 17 days after hive formation. Characterization was performed via amplification of the V4 rergion of the 16S rRNA gene (\"Earth Microbiome Project\" protocol) using an Illumina MiSeq sequencer with a v2 PE 2x150bp kit.","center":"University of California San Diego Microbiome Initiative","data_type":"Other","submission_date":"2021/11/24 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA11294335","14084.S3.B10.F; Intermediate honeybee hive bacteriome","non_urban",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,"air","environmental sample from a non-urban site"],["SAMEA11294338","14084.S3.B11.F; Intermediate honeybee hive bacteriome","non_urban",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,"air","environmental sample from a non-urban site"],["SAMEA11294342","14084.S3.B12.F; Intermediate honeybee hive bacteriome","non_urban",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,"air","environmental sample from a non-urban site"],["SAMEA11294345","14084.S3.B13.F; Intermediate honeybee hive bacteriome","non_urban",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,"air","environmental sample from a non-u