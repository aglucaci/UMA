{"v":1,"accession":"PRJNA1441486","title":"Target-enriched metagenomic sequencing improves detection and provides consistent resistome characterization across library preparation protocols and DNA inputs","description":"This study evaluated targeted sequencing strategies using fecal microbial communities from multiple host species to determine whether they improve characterization of resistance genes and produce consistent results across different laboratory methods. Target-enriched sequencing detected substantially more resistance genes than conventional shotgun sequencing and produced highly comparable results across library preparation kits and DNA input amounts, even when limited DNA was available.","center":"Texas A&M University","data_type":"Raw sequence reads","submission_date":"2026/03/23 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN56655774","Metagenome or environmental sample from wastewater metagenome","uncertain",null,null,null,"US",null,null,null,"unresolved",null,null,"USA","waster water treatment plant effluent",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN56655775","Metagenome or environmental sample from wastewater metagenome","uncertain",null,null,null,"US",null,null,null,"unresolved",null,null,"USA","waster water treatment plant effluent",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN56655776","Metagenome or environmental sample from wastewater metagenome","uncertain",null,null,null,"US",null,null,null,"unresolved",null,null,"USA","waster water treatment plant effluent",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN56655777","Metagenome or environmental sample from wastewater metagenome","uncertain",null,null,n