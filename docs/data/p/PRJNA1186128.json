{"v":1,"accession":"PRJNA1186128","title":"Metagenomic Analysis of Airborne Microbial Communities across Altitudinal Gradients in the Piduruthalagala Mountain Region, Sri Lanka","description":"The study investigates airborne microbial diversity in the Piduruthalagala Mountain region, Sri Lanka, by analyzing air samples collected from two altitudes: 1868 m (bottom level) and 2524 m (highest point). The research uses culture-independent metagenomic techniques to identify bacterial communities and assess how altitude influences their composition and ecological roles. This work enhances the understanding of microbial biodiversity in tropical montane ecosystems and its potential environmental implications.","center":"National Institute of Fundamental Studies","data_type":"Metagenome","submission_date":"2024/11/14 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN44768584","Air Sample from Bottom Level of Piduruthalagala Mountatin (PB1)","probable_urban","air_dust","2023-11-27",2023,"LK","Central Province",1232783,"Nuwara Eliya","verified",7.0,80.77,"Sri Lanka:Nuwara Eliya","air","ENVO:00000428","[ENVO:00000428]|Troposphere[ENVO:00000429]","[ENVO:00000050]","city-level location without sample-site confirmation"],["SAMN44768585","Air Sample from Bottom Level of Piduruthalagala Mountatin (PB2)","probable_urban","air_dust","2023-11-27",2023,"LK","Central Province",1232783,"Nuwara Eliya","verified",7.0,80.77,"Sri Lanka:Nuwara Eliya","air","ENVO:00000428","[ENVO:00000428]|Troposphere[ENVO:00000429]","[ENVO:00000050]","city-level location without sample-site confirmation"],["SAMN44768586","Air Sample from Highest Altitude of Piduruthalagala Mountatin (PT1)","probable_urban","air_dust","2023-11-27",2023,"LK","Central Province",1232783,"Nuwara