{"v":1,"accession":"PRJNA245474","title":"Activated Sludge Samples","description":"Here we employed eight lab-scale SBRs seeded with either acclimated or non-acclimated sludge with the objective of (i) assessing the effect of SRT on diversity of total bacterial taxa; (ii) investigating community dynamics of total, dominant and rare bacterial taxa under stable process performance; and iii) evaluating reproducibility in bacterial community structure between replicate SBRs. We combined 16S rRNA gene pyrosequencing with multivariate statistical analysis for an in-depth understanding of community diversity, dynamics and reproducibility.","center":"King Abdullah University of Science and Technology (KAUST)","data_type":"Other","submission_date":"2014/04/27 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN02838511","B2","non_environmental",null,null,null,"SA","Mecca Region",409682,"Thuwal","probable",22.2833,39.1,"Saudi Arabia: GAZ",null,"ENVO:wastewater treatment plant","ENVO:aerobic bioreactor","ENVO:activated sludge","laboratory or culture material"],["SAMN02838512","B3","non_environmental",null,null,null,"SA",null,null,null,"unresolved",22.2833,39.2,"Saudi Arabia: GAZ",null,"ENVO:wastewater treatment plant","ENVO:aerobic bioreactor","ENVO:activated sludge","laboratory or culture material"],["SAMN02838513","B4","non_environmental",null,null,null,"SA",null,null,null,"unresolved",22.2833,39.3,"Saudi Arabia: GAZ",null,"ENVO:wastewater treatment plant","ENVO:aerobic bioreactor","ENVO:activated sludge","laboratory or culture material"],["SAMN02838514","B5","non_environmental",null,null,null,"SA",null,null,null,"unresolved",22.2833,39.4,"Saudi Arabia: GAZ",null,"ENVO:wastewater treatment plant","ENVO:aerobic bioreactor","ENVO:activated sl