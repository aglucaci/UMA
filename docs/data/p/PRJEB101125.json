{"v":1,"accession":"PRJEB101125","title":"Wastewater-based epidemiology for public health– benefits and trade-offs of di#erent molecular methods for the generation of actionable data in a small-town context","description":"This project evaluated the integration of wastewater-based epidemiology (WBE) into public health surveillance in a small town in northern Germany. Over six weeks, composite wastewater samples were analyzed using qPCR and metagenomic sequencing to detect pathogens and antimicrobial resistance genes. The findings were compared with routine clinical reports in close collaboration with local health authorities. The study demonstrated that WBE can identify pathogens earlier and more broadly than traditional systems, providing timely, population-level insights that support more informed and proactive public health responses.","center":"Institute for Artificial Intelligence in Medicine","data_type":"Other","submission_date":"2025/11/30 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA120401852","WWMM2401_m","probable_urban","municipal_wastewater","2024-08-20",2024,"DE",null,null,null,"unresolved",null,null,"Germany",null,null,null,null,"urban context stated at BioProject level only"],["SAMEA120401853","WWMM2402_m","probable_urban","municipal_wastewater","2024-08-26",2024,"DE",null,null,null,"unresolved",null,null,"Germany",null,null,null,null,"urban context stated at BioProject level only"],["SAMEA120401854","WWMM2403_m","probable_urban","municipal_wastewater","2024-09-02",2024,"DE",null,null,null,"unresolved",null,null,"Germany",null,null,null,null,"urban context stated at BioProject level only"],["SAMEA120401855","WWMM2404_m","probable_urban","municipal_wastewater","2024-09-09",2024,"DE",null,null,null,"unresolved