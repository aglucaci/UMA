{"v":1,"accession":"PRJNA861729","title":"Groundwater microbial communities in an unconfined nitrogen contaminated aquifer","description":"Microbial community data sequenced from samples taken from groundwater bores within and surrounding a wastewater treatment plant (WWTP). The sampled aquifer is known to have multiple sources of nitrogen contamination from the WWTP and surrounding agricultural region. These samples were taken with the intent to determine how the different sources of nitrogen contamination effected the groundwater microbial communities.","center":"RMIT University","data_type":"Raw sequence reads","submission_date":"2022/07/24 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN29926972","MIMARKS Survey related sample from freshwater metagenome","confirmed_urban","water_drainage","2018-08-01",2018,"AU","Victoria",null,null,"unresolved",-38.4081,144.879,"Australia: Boneo, Victoria",null,"Wastewater treatment plant","Unconfined shallow sandy aquifer","Groundwater","named urban infrastructure at sample level"],["SAMN29926973","MIMARKS Survey related sample from freshwater metagenome","confirmed_urban","water_drainage","2018-11-01",2018,"AU","Victoria",null,null,"unresolved",-38.4081,144.879,"Australia: Boneo, Victoria",null,"Wastewater treatment plant","Unconfined shallow sandy aquifer","Groundwater","named urban infrastructure at sample level"],["SAMN29926974","MIMARKS Survey related sample from freshwater metagenome","confirmed_urban","water_drainage","2019-05-01",2019,"AU","Victoria",null,null,"unresolved",-38.4081,144.879,"Australia: Boneo, Victoria",null,"Wastewater treatment plant","Unconfined shallow sandy aquifer","Groundwater","named urban infrastructure at sample level"],["SAMN29926975","MIMARKS Survey relat