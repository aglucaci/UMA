{"v":1,"accession":"PRJNA189662","title":"Influence of wastewater treatment plant effluents on bacterial community composition and antibiotic resistance in the environment","description":"In this study, we used culture-independent approaches to determine the prevalence of antibiotic resistance genes and examine how bacterial communities from biofilm and sediment respond to the discharge of WWTP effluents in the receiving river. Antibiotic resistance genes and bacterial community composition in the upstream river were also analyzed to determine the contribution of wastewater discharge to antibiotic resistance in the downstream river samples.","center":"Catalan Institute for Water Research (ICRA)","data_type":"Metagenome","submission_date":"2013/02/18 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN01923051","Generic sample from Bacteria","probable_urban","municipal_wastewater",null,2010,null,null,null,null,"unresolved",null,null,null,"biofilm",null,null,null,"urban context stated at BioProject level only"],["SAMN01923052","Generic sample from Bacteria","probable_urban","municipal_wastewater",null,2010,null,null,null,null,"unresolved",null,null,null,"biofilm",null,null,null,"urban context stated at BioProject level only"],["SAMN01923053","Generic sample from Bacteria","probable_urban","municipal_wastewater",null,2010,null,null,null,null,"unresolved",null,null,null,"biofilm",null,null,null,"urban context stated at BioProject level only"],["SAMN01923054","Generic sample from Bacteria","probable_urban","municipal_wastewater",null,2010,null,null,null,null,"unresolved",null,null,null,"sediment",null,null,null,"urban context stated at BioProject level only"],["SAMN01923055","Generic sample from Bacteria","probable_urban","municipal_was