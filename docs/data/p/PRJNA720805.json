{"v":1,"accession":"PRJNA720805","title":"Mesocosm sludge bioreactors under sustained 3-chloroaniline (3-CA) stress (with controls) Metagenome and Metatranscriptome","description":"This study demonstrated the impact of a sustained stress on activated sludge community and wastewater treatment process and its subsequent recovery. Using a combination of techniques in a controlled and replicated experiment, it was shown that microbial communities can evolve degradative capacity following a sustained xenobiotic input, specific functions like nitrification can fully or partially recover and targeted culture-independent approaches can be used to elucidate the mechanisms of adaptation.","center":"NTU","data_type":"Metagenomic assembly","submission_date":"2021/04/09 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN28196509","HSLTS_1705_R2","uncertain",null,"2014-05-17",2014,"SG",null,1880252,"Singapore","probable",1.3451,103.6798,"Singapore",null,"anthropogenic environmental material","activated sludge","waste material","environmental sample; urban association not established"],["SAMN28196510","HSLTS_1705_R4","uncertain",null,"2014-05-17",2014,"SG",null,1880252,"Singapore","probable",1.3451,103.6798,"Singapore",null,"anthropogenic environmental material","activated sludge","waste material","environmental sample; urban association not established"],["SAMN28196511","HSLTS_1705_R5","uncertain",null,"2014-05-17",2014,"SG",null,1880252,"Singapore","probable",1.3451,103.6798,"Singapore",null,"anthropogenic environmental material","activated sludge","waste material","environmental sample; urban association not established"],["SAMN28196512","HSLTS_1705_R1","uncertain",null,"2014-05-17",2014,"SG",null,1880252,"Singapore","probable",1.3451,103.679