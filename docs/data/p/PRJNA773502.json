{"v":1,"accession":"PRJNA773502","title":"Oxidative stress enhances integrase activity during wastewater treatment","description":"We analyzed the prevalence of bacterial resistance to inhibitors of folate biosynthesis in treatment wetlands, a nature-based technology often used for decentralised wastewater treatment. Over a four-year period, we compared an aerated and a non-aerated horizontal subsurface flow wetland receiving the same pre-treated municipal wastewater. We found that while aeration lowers AR gene abundances in the effluent, it also resulted in a transient increase of class 1 integrons copy numbers and integrase activity.","center":"Karlsruhe Institute of Technology","data_type":"Raw sequence reads","submission_date":"2021/10/21 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN22487514","MIMARKS Survey related sample from wastewater metagenome","probable_urban","municipal_wastewater",null,2014,"DE",null,null,null,"unresolved",51.5061,12.8976,"Germany: ecotechnology research facility in Langenreichenbach",null,"ENVO:00002043","primary treatment effluent","wastewater","city-level location without sample-site confirmation"],["SAMN22487515","MIMARKS Survey related sample from wastewater metagenome","probable_urban","municipal_wastewater",null,2014,"DE",null,null,null,"unresolved",51.5061,12.8976,"Germany: ecotechnology research facility in Langenreichenbach",null,"ENVO:00002043","horizontal sub-surface constructed wetland, fractional length 0.12","wastewater","city-level location without sample-site confirmation"],["SAMN22487516","MIMARKS Survey related sample from wastewater metagenome","probable_urban","municipal_wastewater",null,2014,"DE",null,null,null,"unresolved",51.5061,12.8976,"Germany: ecotechnology research f