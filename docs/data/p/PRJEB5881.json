{"v":1,"accession":"PRJEB5881","title":"Volatile fatty acids (VFAs) production through anaerobic fermentation","description":"Volatile fatty acids (VFAs) production through anaerobic fermentation is an effective way. Microbes in active sludge play key roles in VFAs production. In present study, VFAs were produced by sludge from five representative waste organic materials. We investigated prokaryotic community structure and diversity in sludge samples using 454 pyrosequencing technique based on 16S rRNA gene. Samples were collected as replicate samples for every waste organic material.","center":"XIAMEN UNIVERSITY","data_type":"Other","submission_date":"2014/04/01 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA2417017","XMX13","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMEA2417018","XMX14","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMEA2417019","XMX15","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMEA2417020","XMX16","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMEA2417021","XMX17","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMEA2417022","XMX18","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban assoc