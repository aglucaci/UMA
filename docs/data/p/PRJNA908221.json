{"v":1,"accession":"PRJNA908221","title":"Co-occurrence and cooperation between comammox and anammox bacteria in full scale municipal wastewater treatment system.","description":"Cooperation between comammox and anammox bacteria for wastewater treatment has been recently reported in lab-scale systems including synthetic community constructs. However, there are no reports of full-scale municipal wastewater treatment systems with co-occurrence and co-operation between comammox and anammox bacteria. Here, we report intrinsic and extant kinetics as well as genome-resolved microbial community characterization of a full-scale integrated fixed film activated sludge (IFAS) system where comammox and anammox bacteria co-occur and appear to drive nitrogen removal and loss.","center":"Northeastern University","data_type":"Genome sequencing and assembly","submission_date":"2023/01/30 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN32031799","IFA1","confirmed_urban","municipal_wastewater",null,2021,"US","Virginia",null,null,"unresolved",null,null,"USA: Virginia","wastewater treatment plant",null,null,null,"named urban infrastructure at sample level"],["SAMN32031800","IFA2","confirmed_urban","municipal_wastewater",null,2021,"US","Virginia",null,null,"unresolved",null,null,"USA: Virginia","JAMMSM wastewater treatment plant",null,null,null,"named urban infrastructure at sample level"],["SAMN32031801","IFA3","confirmed_urban","municipal_wastewater",null,2021,"US","Virginia",null,null,"unresolved",null,null,"USA: Virginia","wastewater treatment plant",null,null,null,"named urban infrastructure at sample level"],["SAMN32031802","IFA4","confirmed_urban","municipal_wastewater",null,2021,"US","Virginia",null,null,"unresolved",null,null,"USA: Virginia