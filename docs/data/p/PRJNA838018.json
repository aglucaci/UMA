{"v":1,"accession":"PRJNA838018","title":"Rumen Nasal Uterine and Vaginal samples Targeted loci","description":"A growing number of studies have investigated the viability of feeding hemp by-products as livestock feedstuffs; however, their impact on livestock microbiomes remains unexplored. Here, we evaluated the effects of feeding hempseed cake (HSC) as a protein source on the gastrointestinal, respiratory, and reproductive microbiota in beef heifers. Angus-crossbred heifers (19-months old) were fed a corn-based finishing diet containing either 20% HSC (n = 15) or 20% corn distillers grains (Control, n = 16) for 111 days until slaughter. Rumen fluid and deep nasopharyngeal swabs (days 0 7, 42, 70 and 98), and vaginal and uterine swabs (at slaughter) were collected and the microbiota assessed using 16S rRNA gene sequencing.","center":"Agriculture and Agri-Food Canada","data_type":"Targeted Locus (Loci)","submission_date":"2022/05/13 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN29632666","A1","non_urban",null,"2020-11-20",2020,"US","North Dakota",5059163,"Fargo","verified",46.903,-96.842,"USA:Fargo",null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN29632667","A2","non_urban",null,"2020-11-20",2020,"US","North Dakota",5059163,"Fargo","verified",46.903,-96.842,"USA:Fargo",null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN29632668","A3","non_urban",null,"2020-11-20",2020,"US","North Dakota",5059163,"Fargo","verified",46.903,-96.842,"USA:Fargo",null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN29632669","A4","non_urban",null,"2020-11-20",2020,"US","North Dakota",5059163,"Fargo","verified",46.903,-96.842,"USA:Fargo",null,