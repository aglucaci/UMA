{"v":1,"accession":"PRJNA687334","title":"Plant-parasitic nematode field sampling","description":"Plant-parasitic nematodes cause damage to agriculture occur in soils and roots globally. Several species possess microbial associations, including endosymbionts. This study examined symbionts in field-collected nematodes from several U.S. states. Nematodes were extracted from roots and soils as bulk communities and community DNA was sequenced with Illumina HiSeq/NovaSeq, and nematode and symbiont genomes were assembled and analyzed.","center":"Texas Tech University","data_type":"Raw sequence reads","submission_date":"2020/12/23 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN17141339","Metagenome or environmental sample from invertebrate metagenome","uncertain",null,"2018-05-25",2018,"US","Texas",5531255,"Sonora","verified",30.5666,-100.6437,"USA: Sonora, Texas","roadside",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN17141340","Metagenome or environmental sample from invertebrate metagenome","uncertain",null,"2018-05-25",2018,"US","Texas",4707932,"Los Fresnos","verified",26.1326,-97.4739,"USA: Los Fresnos, Texas","roadside",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN17141341","Metagenome or environmental sample from invertebrate metagenome","uncertain",null,"2018-05-25",2018,"US","Texas",4699066,"Houston","probable",29.6625,-95.3769,"USA: La Prior, Texas","roadside",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN17141342","Metagenome or environmental sample from invertebrate metagenome","uncertain",null,"2018-05-25",2018,"US","Texas",4679148,"Carrizo Springs","verified",28.5243,-99.8586,"USA: Carrizo Springs, Texas","roadside",null,nu