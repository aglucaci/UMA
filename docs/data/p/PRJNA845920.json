{"v":1,"accession":"PRJNA845920","title":"Sequence of fungal community during composting","description":"The succession of fungal community and the effect of heavy metals on fungi during full-scale hyperthermophilic composting of municipal sludge remain unclear. We aim to explore the dynamic change of fungal community structure, ecological assembly and the linkage between environmental factors and fungal community during hyperthermophilic composting and reveal the essential influencing factors on fungal community by comparing physical-chemical properties and pollutants (heavy metals and organic pollutants) based on multiple statistical analysis.","center":"envirnmental college","data_type":"Raw sequence reads","submission_date":"2022/06/04 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN28864992","MIMARKS Specimen sample from compost metagenome","probable_urban","municipal_wastewater",null,2018,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"urban context stated at BioProject level only"],["SAMN28864993","MIMARKS Specimen sample from compost metagenome","probable_urban","municipal_wastewater",null,2018,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"urban context stated at BioProject level only"],["SAMN28864994","MIMARKS Specimen sample from compost metagenome","probable_urban","municipal_wastewater",null,2018,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"urban context stated at BioProject level only"],["SAMN28864995","MIMARKS Specimen sample from compost metagenome","probable_urban","municipal_wastewater",null,2018,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"urban context stated at BioProject level only"],["SAMN28864996","MIMARKS Specimen