{"v":1,"accession":"PRJNA1452936","title":"Lytic phages enrich antibiotic-resistant bacteria in activated sludge through preferential infection of antibiotic-susceptible bacteria","description":"This project investigates the contribution of lytic phages to the propagation of antibiotic resistance genes (ARGs) within activated sludge microbiomes. Experimental co-cultures were conducted with varying initial phage-to-bacteria ratios (from 10 to 10000) alongside a control group with no phage addition. Shotgun metagenomic sequencing was performed to evaluate how elevated phage predation pressure drives shifts in bacterial community composition and enriches the abundance of ARGs and mobile genetic elements (MGEs).","center":"University of Science and Technology BeijingUniversity of Science and Technology Beijing","data_type":"Raw sequence reads","submission_date":"2026/04/13 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN57246157","CK","confirmed_urban","municipal_wastewater",null,2022,"CN","Beijing",1816670,"Beijing","verified",39.9,116.53,"China: Beijing",null,"urban biome","wastewater treatment plant","activated sludge","explicit urban setting at sample level"],["SAMN57246158","S10","confirmed_urban","municipal_wastewater",null,2022,"CN","Beijing",1816670,"Beijing","verified",39.9,116.53,"China: Beijing",null,"urban biome","wastewater treatment plant","activated sludge","explicit urban setting at sample level"],["SAMN57246159","S100","confirmed_urban","municipal_wastewater",null,2022,"CN","Beijing",1816670,"Beijing","verified",39.9,116.53,"China: Beijing",null,"urban biome","wastewater treatment plant","activated sludge","explicit urban setting at sample level"],["SAMN57246160","S1000","confirmed_urban","municipal_wastewater",nul