{"v":1,"accession":"PRJNA1241133","title":"Biomass of anaerobic batch reactors subjected to different concentrations of caffeine. Metagenome","description":"Caffeine (CAF) is one of the most consumed alkaloids in the world with numerous applications in the pharmaceutical and food industries. As a consequence, CAF has been frequently detected in several environmental matrices, since it is a compound that is difficult to remove in sewage treatment plants (STPs), in addition to presenting deleterious effects to the environment. In this study, the effects of different CAF concentration were investigated in anaerobic batch reactors using sanitary sewage from the sewage treatment plant (STP) of Sao Carlos/SP.","center":"University of Sao Paulo","data_type":"Metagenome","submission_date":"2025/03/24 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN47545971","Metagenome or environmental sample from Biomass of anaerobic batch reactors subjected to different concentrations of caffeine.","non_environmental",null,"2023-09-25",2023,"BR","São Paulo",3449319,"São Carlos","verified",-22.001,-47.93,"Brazil: Sao Carlos, SP","batch reactors",null,null,null,"laboratory or culture material"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR32853211","SAMN47545971","SRX28135565","Amplicon","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina HiSeq 2500",84352376,140445,"2025-03-25","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos7/sra-pub-zq-41/SRR032/32853/SRR32853211/SRR32853211.lite.1"],["SRR32853212","SAMN47545971","SRX28135564","Amplicon","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina HiSeq 2500",73055764,121632,"2025