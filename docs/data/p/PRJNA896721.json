{"v":1,"accession":"PRJNA896721","title":"Microbiological impacts of blending advanced-treated wastewater in pipe loops","description":"Direct potable reuse offers water-scarce regions a local and reliable source of drinking water through advanced treatment of wastewater, but few studies have investigated the microbial water quality impacts of introducing advanced-treated wastewater to drinking water distribution systems. The microbial water quality was characterized throughout an advanced wastewater treatment train and in pilot-scale simulated drinking water distribution systems. Drinking water distribution systems were simulated as pipe loops that recirculated 100 L of either conventional drinking water or blends of advanced-treated wastewater and conventional drinking water. Microbial water quality was assessed via 16S rRNA gene amplicon sequencing as well as flow cytometry-based cell counts, adenosine triphosphate concentration, and qPCR.","center":"University of California, Berkeley","data_type":"Raw sequence reads","submission_date":"2022/11/02 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN41934921","field sampling blank for biofilm","uncertain",null,"2018-01-10",2018,"US","California",5391959,"San Francisco","probable",37.8719,-122.2585,"USA: California","control",null,null,null,"environmental sample; urban association not established"],["SAMN41934922","field sampling blank for bulk water","uncertain",null,"2018-03-13",2018,"US","California",5391959,"San Francisco","probable",37.8719,-122.2585,"USA: California","control",null,null,null,"no environmental-sample evidence"],["SAMN41934923","positive extraction control 1e3.4","non_environmental",null,"2018-09-13",2018,"US","California",5391959,"San Francisco","probable",37