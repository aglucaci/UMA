{"v":1,"accession":"PRJNA1330136","title":"16S rRNA gene sequencing of soils along a two-year recovery gradient after low-temperature thermal desorption remediation","description":"This dataset contains the raw sequencing data of 16S rRNA gene amplicons generated from soil samples collected in an urban brownfield site following low-temperature desorption (LTTD) remediation. The samples were collected over a two-year period to track the recovery of soil chemistry and microbial communities after remediation treatment. The data include sequences from multiple time points, providing insights into changes in microbial diversity, community structure, and predicted functional profiles in response to the remediation process.","center":"Peking University","data_type":"Raw sequence reads","submission_date":"2025/09/17 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN51437921","P1","confirmed_urban","soil_greenspace",null,2025,"CN",null,null,null,"ambiguous",null,null,"China: Rudong","Urban Soil",null,null,null,"explicit urban setting at sample level"],["SAMN51437922","P2","confirmed_urban","soil_greenspace",null,2025,"CN",null,null,null,"ambiguous",null,null,"China: Rudong","Urban Soil",null,null,null,"explicit urban setting at sample level"],["SAMN51437923","P3","confirmed_urban","soil_greenspace",null,2025,"CN",null,null,null,"ambiguous",null,null,"China: Rudong","Urban Soil",null,null,null,"explicit urban setting at sample level"],["SAMN51437924","P4","confirmed_urban","soil_greenspace",null,2025,"CN",null,null,null,"ambiguous",null,null,"China: Rudong","Urban Soil",null,null,null,"explicit urban setting at sample level"],["SAMN51437925","P5","confirmed_urban","soil_greenspace",null,2025,"CN",null,null,null,"ambiguous",null,null,"China