{"v":1,"accession":"PRJNA1014771","title":"The sulfur disproportionation culture is utilized for the treatment of mercury-contaminated wastewater without generating methylmercury.","description":"We collected inoculants from two wastewater treatment plants and estuarine sediments, respectively. Elemental sulfur and sodium bicarbonate were added to cultivate and acclimate sulfur-disproportionating bacteria (SDB), while sulfate and organic carbon sources were added to cultivate and acclimate sulfate-reducing bacteria (SRB). After 30 days of acclimation, metagenomic sequencing was performed.","center":"Sun Yat-sen University","data_type":"Raw sequence reads","submission_date":"2023/09/09 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN37341191","NJ_SDB","probable_urban","municipal_wastewater","2023-06-30",2023,null,null,null,null,"unresolved",null,null,null,null,"Sludge","Sludge","NJ_SDB cultures","urban context stated at BioProject level only"],["SAMN37341192","LJ_SDB","probable_urban","municipal_wastewater","2023-06-30",2023,null,null,null,null,"unresolved",null,null,null,null,"Sludge","Sludge","LJ_SDB cultures","urban context stated at BioProject level only"],["SAMN37341194","NJ_SRB","probable_urban","municipal_wastewater","2023-06-30",2023,null,null,null,null,"unresolved",null,null,null,null,"Sludge","Sludge","NJ_SRB cultures","urban context stated at BioProject level only"],["SAMN37341195","LJ_SRB","probable_urban","municipal_wastewater","2023-06-30",2023,null,null,null,null,"unresolved",null,null,null,null,"Sludge","Sludge","LJ_SRB cultures","urban context stated at BioProject level only"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date