{"v":1,"accession":"PRJNA221118","title":"Microbial community diversity of activated sludge from different wastewater treatment plant & sediments from the pollutants receiving estuary","description":"Ammonia oxidizing prokaryotes (AOP) community structures and the environmental variables which can influence the community in wastewater treatment plant, as well as the effect of wastewater receiving to the community of pollutants receiving natural environment were still not clear. This project was supposed to expand the knowledge of AOP community structure in different WWTPs, to compare the communities between WWTPs and the wastewater receiving estuary, and to explore the potential influence of wastewater discharge on the community of the estuary.","center":"college of environmental sciences and engineering, peking university","data_type":"Metagenome","submission_date":"2013/09/21 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN02361045","Generic sample from activatied suldge","probable_urban","municipal_wastewater","2012-02-24",2012,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"urban context stated at BioProject level only"],["SAMN02361046","Generic sample from activatied suldge","probable_urban","municipal_wastewater","2012-02-24",2012,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"urban context stated at BioProject level only"],["SAMN02361047","Generic sample from activatied suldge","probable_urban","municipal_wastewater","2012-02-24",2012,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"urban context stated at BioProject level only"],["SAMN02361048","Generic sample from sediment","probable_urban","municipal_wastewater","2012-02-24",2012,null,null,null,null,"unres