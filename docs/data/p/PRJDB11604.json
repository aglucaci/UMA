{"v":1,"accession":"PRJDB11604","title":"Autothermal thermophilic aerobic digestion for human excreta treatment","description":"Autothermal thermophilic aerobic digestion (ATAD) is used to treat human excreta hygienically. We previously reported a unique full-scale ATAD, showing distinctive bacterial community transitions and producing high-nitrogen-content liquid fertilizer; nevertheless, the mechanism remains unclear. One hypothesis involves using a gas-inducing (GI) agitator. We designed a lab-scale GI system and compared it with a disk-turbine (DT) agitator system by mimicking the temperature shift of full-scale ATAD. The agitation system and its agitation speed greatly affected physicochemical properties and bacterial community structure.","center":"Kyushu university","data_type":"Metagenome","submission_date":"2025/09/29 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00319306","raw human excreta sludge","uncertain",null,"2019-06-10",2019,"JP","Fukuoka",null,null,"conflicting",33.5939,130.2135,"Japan:Fukuoka, Chikujo",null,"waste treatment plant","seaside","human excreta sludge","conflicting evidence: environmental and host/clinical"],["SAMD00319307","human excreta sludge after digested for 1 day","uncertain",null,"2019-06-10",2019,"JP","Fukuoka",null,null,"conflicting",33.5939,130.2136,"Japan:Fukuoka, Chikujo",null,"waste treatment plant","seaside","human excreta sludge","conflicting evidence: environmental and host/clinical"],["SAMD00319308","human excreta sludge after digested for 2 day","uncertain",null,"2019-06-10",2019,"JP","Fukuoka",null,null,"conflicting",33.5939,130.2137,"Japan:Fukuoka, Chikujo",null,"waste treatment plant","seaside","human excreta sludge","conflicting evidence: environmental and host/clinical"],