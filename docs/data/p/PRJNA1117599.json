{"v":1,"accession":"PRJNA1117599","title":"Nitrogen removal performance, ammonia oxidation contribution rate and community structure variation of ammonia-oxidizing microorganisms based on pure biofilm system","description":"Nitrification is the key and rate-limiting step in the biological nitrogen removal process of wastewater. In order to quantify the contribution of ammonia-oxidizing microorganisms (AOMs) in the nitrification process and promote cooperation among microorganisms, so as to achieve highly efficient nitrification, this study constructed a kind of pure biofilm system based on anoxic/ oxic (AO) process, and comparatively explored the nitrification performance of four different fillers and the growth and enrichment of related microorganisms. The system has been running for 165 days.","center":"Qingdao University of Technology","data_type":"Raw sequence reads","submission_date":"2024/05/29 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN41576595","sludge-1","uncertain",null,"2023-09-03",2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN41576596","sludge-2","uncertain",null,"2023-09-03",2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN41576597","sludge-3","uncertain",null,"2023-09-03",2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN41576598","sludge-4","uncertain",null,"2023-09-03",2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established