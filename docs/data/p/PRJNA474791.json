{"v":1,"accession":"PRJNA474791","title":"activated sludge Genome sequencing and assembly","description":"A novel ABS system based on SBSBR was developed for domestic wastewater treatment. Introducing algae to sequencing batch suspended biofilm reactor enhanced both TN and TP removal, with the effluent concentration of 12.44 ± 0.21 and 0.26 ± 0.12 mg/L. The novel A-SBSBR achieved TN and TP removal improvement by enhancing the removal contribution of both sludge and biofilm, and the algae and bacteria related to nutrients removal were enriched in A-SBSBR. It was noted that the accumulation enhancement of algae could achieve nutrients removal improvement from wastewater.","center":"HIT","data_type":"Genome sequencing and assembly","submission_date":"2018/06/06 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN09381410","sludge","uncertain",null,"2017-11-30",2017,null,null,null,null,"unresolved",null,null,null,"sludge sample1",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN09381411","sludge","uncertain",null,"2017-11-30",2017,null,null,null,null,"unresolved",null,null,null,"sludge sample2",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN09381412","sludge","uncertain",null,"2017-11-30",2017,null,null,null,null,"unresolved",null,null,null,"sludge sample3",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN09381413","sludge","uncertain",null,"2017-11-30",2017,null,null,null,null,"unresolved",null,null,null,"sludge sample4",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN09381414","sludge","uncertain",null,"2017-11-30",2017,null,null,null,null,"unresolved",null,null,null,"sludge sample5",null,null,null,"conflicting evide