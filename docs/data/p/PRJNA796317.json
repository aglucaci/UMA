{"v":1,"accession":"PRJNA796317","title":"Pond B (Savannah River Site) Microbial Community of the Water Column and Sediment","description":"Pond B at Savannah River Site (SRS; South Carolina, USA) is a man-made, warm monomictic pond that received nuclear reactor cooling water between 1961-1964. The pond is contaminated with trace amounts of Cs-137, Sr-90, Am-241, Cm-244, and Pu-238,239,240. Since 1964, Pond B has remained relatively isolated except for a few radiological and macro ecological research studies, which demonstrated Pu redox cycling with seasonal anoxia. However, the microbial mechanism(s) involved in Pu cycling remains unknown. The objective of this study was to evaluate the biogeochemical factors that influence Pu redox cycling in Pond B, including identifying the bacterial and archaeal community through 16S rRNA amplicon sequencing.","center":"Lawrence Livermore National Lab","data_type":"Raw sequence reads","submission_date":"2022/01/11 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN24846776","Site_Air_Control","probable_urban","air_dust","2019-06-25",2019,"US","South Carolina",null,null,"unresolved",33.2972,-81.5434,"USA: Savannah River Site, South Carolina",null,"ENVO:00002005",null,"ENVO:00002005","city-level location without sample-site confirmation"],["SAMN24846777","Biosafety Cabinet Batch 1","probable_urban","air_dust","2019-10-24",2019,"US","California",5367440,"Livermore","verified",37.6875,-121.7065,"USA: Livermore, California",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN24846778","Biosafety Cabinet Batch 2","probable_urban","air_dust","2020-09-16",2020,"US","California",5367440,"Livermore","verified",37.6875,-121.7065,"USA: Livermore, California",null,null,null,n