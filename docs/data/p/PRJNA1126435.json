{"v":1,"accession":"PRJNA1126435","title":"Microbial exposure in shrimp processing industry","description":"This project entails investigating microbial exposure in the seafood industry by employing Next-Generation Sequencing (NGS) to identify present species. By characterizing the microbial composition, the aim is to discern high-risk work groups with regards to worker exposure. Through the use of advanced genetic analysis, the study seeks to uncover the specific microbial species present in the workplace environment and their potential impact on the workers' health. The findings obtained from this project will provide valuable insights into the identification and assessment of occupational health risks, enabling targeted interventions to enhance workplace safety for employees in the seafood industry.","center":"National Institute of Occupational Health (STAMI)","data_type":"Raw sequence reads","submission_date":"2024/06/21 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN41942305","Metagenome or environmental sample from air metagenome","uncertain",null,"2022-05-10",2022,"NO",null,null,null,"unresolved",null,null,"Norway","air",null,null,null,"environmental sample; urban association not established"],["SAMN41942306","Metagenome or environmental sample from air metagenome","uncertain",null,"2022-05-10",2022,"NO",null,null,null,"unresolved",null,null,"Norway","air",null,null,null,"environmental sample; urban association not established"],["SAMN41942307","Metagenome or environmental sample from air metagenome","uncertain",null,"2022-05-10",2022,"NO",null,null,null,"unresolved",null,null,"Norway","air",null,null,null,"environmental sample; urban association not established"],["SAMN41942308","Metagenome or environmental sample from