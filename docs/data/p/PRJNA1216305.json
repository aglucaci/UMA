{"v":1,"accession":"PRJNA1216305","title":"Study of the antibiotic resistant bacterial community in an urban stream","description":"The study aims to investigate the presence of antibiotic-resistant bacteria in an urban stream located in Sao Paulo, Brazil. The objectives of the project include assessing the presence of antibiotic-resistant bacteria and resistance genes in water samples using molecular techniques. Additionally, it seeks to identify the genetic profiles of the bacterial isolates through whole genome sequencing, analyze the bacterial community structure of the stream via microbiome analysis, and evaluate the presence of antimicrobial residues, such as antibiotics and chlorhexidine.","center":"FMUSP","data_type":"Raw sequence reads","submission_date":"2025/01/27 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN46432332","MIGS Cultured Bacterial/Archaeal sample from Escherichia coli","uncertain",null,"2021-07-26",2021,"BR",null,null,null,"unresolved",null,null,"Brazil: So Paulo",null,"wastewater",null,"sewage water","conflicting evidence: environmental and host/clinical"],["SAMN46432333","MIGS Cultured Bacterial/Archaeal sample from Klebsiella pneumoniae","uncertain",null,"2021-07-26",2021,"BR",null,null,null,"unresolved",null,null,"Brazil: So Paulo",null,"wastewater",null,"sewage water","conflicting evidence: environmental and host/clinical"],["SAMN46432334","MIGS Cultured Bacterial/Archaeal sample from Aeromonas caviae","uncertain",null,"2021-07-26",2021,"BR",null,null,null,"unresolved",null,null,"Brazil: So Paulo",null,"wastewater",null,"sewage water","conflicting evidence: environmental and host/clinical"],["SAMN46432335","MIGS Cultured Bacterial/Archaeal sample from Citrobacter amalonaticus","uncertain",null,"20