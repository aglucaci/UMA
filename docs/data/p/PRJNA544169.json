{"v":1,"accession":"PRJNA544169","title":"Mircrobial community in MEC biogas upgrading system","description":"In the Microbial electrolysis cell (MEC), the biogas upgrading process was carried out by applying the cathode potential of -500 mV (vs. standard hydrogen electrode). Microbial community analysis was used to study the microbial mechanism. Sludge samples (2.0 g) and graphite plate (cathode) biofilm samples from different periods were collected when the reactor was in stable condition (power-on period on day 112 and power-off period on day 138).","center":"Beijing Forestry University","data_type":"Raw sequence reads","submission_date":"2019/05/22 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN11812230","sludge","uncertain",null,"2019-01-03",2019,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN11812232","sludge","uncertain",null,"2019-01-29",2019,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN11812234","sludge","uncertain",null,"2019-01-03",2019,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN11812236","sludge","uncertain",null,"2019-01-29",2019,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR9109034","SAMN11812234","SRX5883535","Amplicon","AMPLICON","METAGENOMIC","PAIRED","ILLUMIN