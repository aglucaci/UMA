{"v":1,"accession":"PRJNA388376","title":"Toxicity assessment of pharmaceutical compounds on mixed microbial culture using respirometric technique:  the role of microbial community structure","description":"The toxicity of three pharmaceutical compounds (caffeine, sulfamethoxazole and carbamazepine) commonly found in municipal wastewater was evaluated by a simple respirometric procedure using mixed microbial culture enriched from activated sludge. Three (SP1, SP2, VM2) microbial cultures were used to assess whether or not the long term exposure to a toxicant could affect microbial resistance. The composition and diversity of bacterial communities were determined by targeting the hypervariable V6–V8 regions of the 16S ribosomal RNA gene using bar-coded pyrosequencing.","center":"University of Patras","data_type":"Raw sequence reads","submission_date":"2017/05/30 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN07176093","Sample Control culture","uncertain",null,null,null,"ES","Madrid",3117735,"Madrid","probable",null,null,"Spain: Madrid","activated sludge","WWTPs",null,"activated sludge","conflicting evidence: environmental and host/clinical"],["SAMN07176094","Sample Acclimated culture","uncertain",null,null,null,"ES","Madrid",3117735,"Madrid","probable",null,null,"Spain: Madrid","activated sludge","WWTPs",null,"activated sludge","conflicting evidence: environmental and host/clinical"],["SAMN07176095","Sample Reactor","uncertain",null,null,null,"ES","Madrid",3117735,"Madrid","probable",null,null,"Spain: Madrid","activated sludge","WWTPs",null,"activated sludge","conflicting evidence: environmental and host/clinical"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases