{"v":1,"accession":"PRJNA1050769","title":"Enhancing Nitrogen Removal Efficiency through Partial Nitrification-Denitrification in the integrated internal circulation aerated reactor: Microbial Evolution.","description":"An integrated internal circulation aerated bioreactor, possessing a high circulation ratio and the capability to generate oxygen gradients, was optimized and developed in this study, using an air-lift circulating reactor as a foundation, for the treatment of urban sewage. Under the optimal conditions (sludge concentration of 5000 mg/L, HRT of 8 h , and aeration rate of 0.6 L/min), The ammonia oxidation rate and nitrite reduction rate have increased by 35.0% and 213.3%, respectively, significantly improving the nitrogen removal efficiency. The biological samples were 16S sequencing data of sludge samples before and after reactor domestication, which revealed the changing pattern of microbial community inside the reactor.","center":"Huazhong University of Science and Technology","data_type":"Raw sequence reads","submission_date":"2023/12/10 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN38751013","Original one","probable_urban","municipal_wastewater","2021-09-06",2021,"CN","Hubei",1791247,"Wuhan","verified",null,null,"China: Wuhan","reactor samples",null,null,null,"city-level location without sample-site confirmation"],["SAMN38751014","Original two","probable_urban","municipal_wastewater","2021-09-06",2021,"CN","Hubei",1791247,"Wuhan","verified",null,null,"China: Wuhan","reactor samples",null,null,null,"city-level location without sample-site confirmation"],["SAMN38751015","Original three","probable_urban","municipal_wastewater","2021-09-06",2021,"CN","Hubei",1791247,"Wuhan","verified",null,null,"China: Wuhan","r