{"v":1,"accession":"PRJNA1290527","title":"Biofilter packing material","description":"This study evaluates a novel combined process, iron-carbon micro-electrolysis (IC-ME) coupled with a deepbed denitrification filter (DBDF), for the advanced treatment of secondary effluent from a sewage treatmentplant. The core objective is to achieve efficient and simultaneous removal of total nitrogen (TN), nitrate(NO3--N), total phosphorus (TP), and chemical oxygen demand (COD) to meet stringent discharge standards. The significance of this research lies in offering a promising and effective tertiary treatment technology to address the critical issue of eutrophication caused by nutrient-rich effluent.","center":"NUIST","data_type":"Raw sequence reads","submission_date":"2025/07/12 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN49922881","biofilter metagenome","confirmed_urban","municipal_wastewater","2021-03-31",2021,"CN","Jiangsu",1799962,"Nanjing","verified",32.0617,118.7778,"China:Nanjing",null,"wastewater treatment plant biome [ENVO:01001407]","iron-containing material [ENVO:00002134], waste water [ENVO:00002001]","treated waste water [ENVO:00002018]","named urban infrastructure at sample level"],["SAMN49922882","biofilter metagenome","confirmed_urban","municipal_wastewater","2021-03-31",2021,"CN","Jiangsu",1799962,"Nanjing","verified",32.0617,118.7778,"China:Nanjing",null,"wastewater treatment plant biome [ENVO:01001407]","iron-containing material [ENVO:00002134], waste water [ENVO:00002001]","treated waste water [ENVO:00002018]","named urban infrastructure at sample level"],["SAMN49922883","biofilter metagenome","confirmed_urban","municipal_wastewater","2021-03-31",2021,"CN","Jiangsu",1799962,"Nanjing","verified",32.0617,118.7778,"Ch