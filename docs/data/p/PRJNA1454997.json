{"v":1,"accession":"PRJNA1454997","title":"Legionella community dynamics in activated sludge sysems of wastewater treatment plants","description":"This study aimed to determine whether Legionella species are consistent members of the activated sludge community by examining variations in the community with beta- and zeta-diversity metrics. Sampling was conducted across five aerobic activated sludge systems, which included both activated sludge (AS) and treated wastewater (TWW) samples. These systems were located in industrial wastewater treatment plants in Germany, selected for having conditions favorable to the presence of Legionella spp. (specifically, wastewater temperatures above 20 C and aerobic environments). Samples were collected over five different months.","center":"Leibniz University Hannover","data_type":"Raw sequence reads","submission_date":"2026/04/17 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN57335596","Metagenome or environmental sample from activated sludge metagenome","non_urban",null,"2024-06-10",2024,"DE",null,null,null,"unresolved",52.0,9.0,"Germany","industrial wastewate treatment plant",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN57335597","Metagenome or environmental sample from activated sludge metagenome","non_urban",null,"2024-06-10",2024,"DE",null,null,null,"unresolved",52.0,9.0,"Germany","industrial wastewate treatment plant",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN57335598","Metagenome or environmental sample from activated sludge metagenome","non_urban",null,"2024-07-04",2024,"DE",null,null,null,"unresolved",52.0,9.0,"Germany","industrial wastewate treatment plant",null,null,null,"BioProject indicates an agricultu