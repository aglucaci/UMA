{"v":1,"accession":"PRJEB20771","title":"Ultrasonic treatment was used treat the CEPT sludge. Metatranscriptomic analysis was used to characterize the microbial community of anaerobic digestion of Ultrasonic-treated CEPT sludge","description":"Hong Kong has the world's largest scale application of Chemical Enhanced Primary Treatment process. The CEPT sludge was collected from local treatment facility. Ultrasonic treatment was applied to enhance the hydrolysis of the CEPT sludge before anaerobic digestion. In order to investigate the effect of ultrasonic treatment on the digestibility of CEPT sludge and corresponding microbial community, anaerobic digestion of ultrasound-treated CEPT sludge was carried out in lab-scale sequential batch reactors. Metatranscriptomes and metagenomes were constructed for the community in the batch reactor at three independent cycles.","center":"shuixia100","data_type":"Other","submission_date":"2018/07/08 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA104055885","metatranscriptome of CEPT sludge digestion","uncertain",null,"2014-03-01",2014,"HK",null,1819729,"Hong Kong","probable",null,null,"Hong Kong",null,null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMEA104055886","metatranscriptome of CEPT sludge digestion","uncertain",null,"2014-03-01",2014,"HK",null,1819729,"Hong Kong","probable",null,null,"Hong Kong",null,null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMEA104055887","metatranscriptome of CEPT sludge digestion","uncertain",null,"2014-03-01",2014,"HK",null,1819729,"Hong Kong","probable",null,null,"Hong Kong",null,null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMEA104055888","metagenome of CEPT sludge","uncert