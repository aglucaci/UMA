{"v":1,"accession":"PRJNA1498309","title":"Bifunctional Humic Acid Governs Synchronous Al- and Fe-bound P Mobilization: Coupled Ligand Competition with Biotic Reduction","description":"Fe-Al composite flocculants applied for wastewater phosphorus (P) removal produce a large amount of Fe-Al co-precipitated sludge. However, the stable lattice structure of Fe/Al-bound P and the distinct mobilization pathways severely restrict the transformation of solid-phase P. In this study, humic acid (HA) was employed as a bifunctional natural mediator to simultaneously destabilize Al-bound P and activate Fe-bound P, bridging the persistent decoupling between these two release pathways.","center":"TAI YUAN UNIVERSITY OF TECHNOLOGY","data_type":"Raw sequence reads","submission_date":"2026/07/21 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN61838451","Sludge","uncertain",null,"2025-06-18",2025,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN61838452","Sludge","uncertain",null,"2025-06-16",2025,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN61838453","Sludge","uncertain",null,"2025-06-15",2025,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN61838454","Sludge","uncertain",null,"2025-06-14",2025,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN61838455","Sludge","uncertain",null,"2025-06-13",2025,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,