{"v":1,"accession":"PRJNA1419905","title":"Study of cave microbiomes","description":"We conducted a broad survey of microbial diversity in three natural limestone caves and two abandoned mines spanning continental, subtropical, and arid climates in the United States. Using amplicon sequencing of samples composed of soil, rock, water, air, and guano, microbiome composition was found to be primarily structured by cave location, followed by environmental matrix, and transect distance from the cave entrance. Significant heterogeneity was observed both between and within caves, underscoring the need for spatially explicit and multi-matrix sampling to capture representative community profiles.","center":"U.S. Army Engineer Research and Development Center","data_type":"Raw sequence reads","submission_date":"2026/02/06 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN55200728","Metagenome or environmental sample from air metagenome","probable_urban","air_dust",null,2022,"US","New York",null,null,"unresolved",42.39,-74.01,"USA: Hailes Cave, New York","Cave",null,null,null,"city-level location without sample-site confirmation"],["SAMN55200745","Metagenome or environmental sample from air metagenome","probable_urban","air_dust",null,2022,"US","New York",null,null,"unresolved",42.39,-74.01,"USA: Hailes Cave, New York","Cave",null,null,null,"city-level location without sample-site confirmation"],["SAMN55200762","Metagenome or environmental sample from air metagenome","probable_urban","air_dust",null,2022,"US","New York",null,null,"unresolved",42.39,-74.01,"USA: Hailes Cave, New York","Cave",null,null,null,"city-level location without sample-site confirmation"],["SAMN55200807","Metagenome or environmental sample from air metagenome","probable