{"v":1,"accession":"PRJNA375957","title":"atmospheric bacterial and fungal communities","description":"Biomass burning in North China Plain has been urgent issues in recent years due to the severe environmental impaction. Bacteria and fungi are ubiquitous in particulate matter, and their taxonomic composition, concentration, ecophysiological function have potentially important implications in atmospheric biochemical cycle and human health. Here we examine bacteria and fungi community composition, abundance and potential function in Yucheng, the center of the North China Plain during summer harvest season in 2014.","center":"University of Shandong University","data_type":"Raw sequence reads","submission_date":"2017/02/20 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN06348397","Metagenome or environmental sample from air metagenome","probable_urban","air_dust",null,2014,"CN","Shandong",1793724,"Tai’an","probable",36.3,117.22,"China:Yucheng city","air",null,null,null,"city-level location without sample-site confirmation"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR7543956","SAMN06348397","SRX4410162","Amplicon","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina MiSeq",822875606,1366903,"2019-07-17","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos12/sra-pub-zq-1214/SRR007/543/SRR7543956.sralite.1"],["SRR7543961","SAMN06348397","SRX4410162","Amplicon","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina MiSeq",332061996,551598,"2019-07-17","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos12/sra-pub-zq-1216/SRR007/543/SRR7543961.sralite.1"],["SRR7543972","SAMN06348397","SRX4407894","Amplicon","AMPLICON