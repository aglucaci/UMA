{"v":1,"accession":"PRJNA451405","title":"Microbial diversity in anaerobic digestion of sludge at different temperature regimes","description":"Biological treatment i.e anaerobic digestion of sludge has been considered as most efficient, environmentally sustainable and cost effective setup. However environmental conditions specifically temperature plays a crucial role on the microbial diversity. A complete knowledge of microbial profile is essentially required to develop operating strategies and to further improve process performance. It is crucially vital to associate the microbial community structures with the sludge treatment efficiency involving anaerobic digestion of organics.Moreover, the changing dynamics of a microbial community has been believed to affect the efficiency, robustness, and stability of wastewater treatment systems.","center":"Quaid-I-Azam University","data_type":"Raw sequence reads","submission_date":"2018/04/23 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN08969920","35C. A","probable_urban","municipal_wastewater","2013-12-03",2013,"US","District of Columbia",4140963,"Washington","verified",38.9072,-77.0369,"USA:Washington DC","Anerobically digested Sludge at 35C",null,null,null,"city-level location without sample-site confirmation"],["SAMN08969921","35C. B","probable_urban","municipal_wastewater","2014-01-30",2014,"US","District of Columbia",4140963,"Washington","verified",38.9072,-77.0369,"USA:Washington DC","Anerobically digested Sludge at 35C",null,null,null,"city-level location without sample-site confirmation"],["SAMN08969922","45C. A","probable_urban","municipal_wastewater","2013-12-03",2013,"US","District of Columbia",4140963,"Washington","verified",38.9072,-77.0369,"USA:Washington DC","Anerobi