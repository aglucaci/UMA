{"v":1,"accession":"PRJNA430066","title":"16S rRNA sequencing of a nitrous oxide reducing chemostat enrichment culture","description":"The aim of the study was to compare nitrous oxide reducing communities selected in chemostat enrichment cultures, inoculated with activated sludge, fed with nitrous oxide as a sole electron acceptor and growth limiting factor, and acetate as electron donor. It was of particular interest to determine the physiological and bioenergetic implications of microorganisms possessing either of the two N2O reductase genes (nosZ), as nitrous oxide reducing microorganisms may be key in the mitigation of nitrous oxide emissions from managed ecosystems.","center":"Swedish University of Agricultural Sciences","data_type":"Raw sequence reads","submission_date":"2018/01/15 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN08365388","Nitrous oxide reducing community from a chemostat enrichment culture","non_environmental",null,null,2016,"NL","South Holland",2757345,"Delft","verified",null,null,"Netherlands: Delft","activated sludge",null,null,null,"laboratory or culture material"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR6479446","SAMN08365388","SRX3569315","16S","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina MiSeq",14047878,28096,"2019-02-28","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos12/sra-pub-zq-1211/SRR006/479/SRR6479446/SRR6479446.sralite.1"],["SRR6479447","SAMN08365388","SRX3569314","16S","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina MiSeq",15184820,30370,"2019-02-28","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos12/sra-pub-zq-1214/SRR006/479/SRR6479447.sral