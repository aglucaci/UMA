{"v":1,"accession":"PRJEB56005","title":"18S rRNA amplicon sequencing from the Ocean Sampling Day (OSD) campaign June 2019","description":"Ocean Sampling Day was initiated by the EU-funded Micro B3 (Marine Microbial Biodiversity, Bioinformatics, Biotechnology) project to obtain a snapshot of the marine microbial biodiversity and function of the world’s oceans. It is a simultaneous global mega-sequencing campaign aiming to generate the largest standardized microbial data set in a single day. This will be achievable only through the coordinated efforts of an Ocean Sampling Day Consortium, supportive partnerships and networks between sites. The OSD2019 event is a continuation of the successful OSD events of Micro B3 project (https://www.microb3.eu/osd.html).","center":"German Federation for Biological Data","data_type":"Other","submission_date":"2022/09/16 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA111347409","OSD60_2019-06_1a_NPL022","non_urban",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample from a non-urban site"],["SAMEA111347410","OSD39_2019-06_1a_NPL022","non_urban",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample from a non-urban site"],["SAMEA7422946","OSD223_2019-06_1_NPL022","non_urban",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample from a non-urban site"],["SAMEA7422958","OSD159_2019-06_1_NPL022","non_urban",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample from a non-urban site"],["SAMEA7422963","OSD99_2019-06_1_NPL022","non_urban",null,null,null,null,null,null,null,"unresolved",null,null,nu