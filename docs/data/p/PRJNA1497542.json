{"v":1,"accession":"PRJNA1497542","title":"Microbial community analysis of ethanol- and methanol-fed partial denitrification-anammox MBBR systems treating real municipal wastewater","description":"16S/18S rRNA gene amplicon sequencing (V4-V8 regions, Oxford Nanopore PromethION) of biofilm samples scraped from AnoxKaldnes K5 carriers in two parallel moving bed bioreactor (MBBR) systems. The reactors were operated for 156 days comparing ethanol and methanol as external carbon sources for a single-stage partial denitrification-anammox (PdNA) process treating real municipal secondary effluent. Biofilm was sampled at three timepoints: inoculation (day 0), end of 20 degrees Celsius operation (day 127), and end of 15 degrees Celsius operation (day 156).","center":"University of Bologna","data_type":"Raw sequence reads","submission_date":"2026/07/19 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN61810786","MBBR inoculum biofilm day 0","non_environmental",null,"2024-03-28",2024,"SE","Skåne",2693678,"Lund","verified",55.7227,13.2243,"Sweden: Lund",null,"urban biome [ENVO:01000249]","anaerobic bioreactor [ENVO:00002124]","biofilm [ENVO:00002034]","laboratory or culture material"],["SAMN61810787","Methanol PdNA biofilm day 127","non_environmental",null,"2024-08-02",2024,"SE","Skåne",2693678,"Lund","verified",55.7227,13.2243,"Sweden: Lund",null,"urban biome [ENVO:01000249]","anaerobic bioreactor [ENVO:00002124]","biofilm [ENVO:00002034]","laboratory or culture material"],["SAMN61810788","Ethanol PdNA biofilm day 127","non_environmental",null,"2024-08-02",2024,"SE","Skåne",2693678,"Lund","verified",55.7227,13.2243,"Sweden: Lund",null,"urban biome [ENVO:01000249]","anaerobic bioreactor [ENVO:00002124]","biofilm [ENVO:00002034]","laboratory o