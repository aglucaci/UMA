{"v":1,"accession":"PRJNA1218774","title":"Algae-bacterial consortium","description":"Algae-bacterial consortia in granular form represent an emerging biotechnology for sustainable wastewater treatment, integrating microbial granulation with biological nutrient removal (BNR). These self-aggregating microbial structures combine phototrophic algae with heterotrophic and autotrophic bacteria, facilitating efficient carbon, nitrogen, and phosphorus removal. The synergistic interactions within the granules enhance pollutant degradation through mechanisms such as oxygenic photosynthesis, nitrification-denitrification, and enhanced biological phosphorus removal (EBPR). Additionally, the granular morphology provides high biomass retention, improved settleability, and resilience to environmental fluctuations. This approach offers a promising alternative to conventional wastewater treatment processes, reducing aeration costs and enabling resource recovery.","center":"King Abdullah University of Science and Technology","data_type":"Raw sequence reads","submission_date":"2025/02/03 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN46533216","1","uncertain",null,null,2023,"SA","Mecca Region",409682,"Thuwal","probable",22.3095,39.1047,"Saudi Arabia","environmental",null,null,null,"environmental sample; urban association not established"],["SAMN46533217","2","uncertain",null,null,2023,"SA","Mecca Region",409682,"Thuwal","probable",22.3095,39.1047,"Saudi Arabia","environmental",null,null,null,"environmental sample; urban association not established"],["SAMN46533218","3","uncertain",null,null,2023,"SA","Mecca Region",409682,"Thuwal","probable",22.3095,39.1047,"Saudi Arabia","environmental",null,null,null,"environmental sample; urban association n