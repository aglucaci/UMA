{"v":1,"accession":"PRJDB6227","title":"Microbial composition of anaerobic packed bed reactors","description":"Anaerobic packed bed reactors have advantages in treating high-strength wastewater over other technologies, in term of organics removal and biogas production. Property of bed packing materials could influence on microbial metabolism and reactor performance. Especially, conductive materials have been reported to facilitate direct interspecies electron transfer, thus the promotion of reactor performance and methane production are evaluated in this study.","center":"Civil and Environmental Engineering, University of Illinois at Urbana-Champaign","data_type":"Targeted Locus (Loci)","submission_date":"2018/08/19 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00090267","Seed for reactor 040916","non_environmental",null,"2016-04-09",2016,"US","Illinois",4914570,"Urbana","verified",40.11,-88.22,"USA:IL, Urbana",null,"sludge","anaerobic","Water","laboratory or culture material"],["SAMD00090268","Reactor1 0416","non_environmental",null,"2016-04-15",2016,"US","Illinois",4914570,"Urbana","verified",40.11,-88.22,"USA:IL, Urbana",null,"sludge","anaerobic","Water","laboratory or culture material"],["SAMD00090269","Reactor2 0416","non_environmental",null,"2016-04-15",2016,"US","Illinois",4914570,"Urbana","verified",40.11,-88.22,"USA:IL, Urbana",null,"sludge","anaerobic","Water","laboratory or culture material"],["SAMD00090270","Reactor3 0416","non_environmental",null,"2016-04-15",2016,"US","Illinois",4914570,"Urbana","verified",40.11,-88.22,"USA:IL, Urbana",null,"sludge","anaerobic","Water","laboratory or culture material"],["SAMD00090271","Reactor1 0516","non_environmental",null,"2016-05-23",2016,"US","Illinois",4914570,"Urbana","ve