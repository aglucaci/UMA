{"v":1,"accession":"PRJNA1260143","title":"Pilot system","description":"The pilot system uses short-range nitrification endogenous denitrification process to remove nitrogen, which is a low carbon and low energy consumption sewage treatment method. In wastewater treatment, nitrification and denitrification process has the problems of low efficiency and high energy consumption, the fundamental reason is that there are many reaction steps and intermediate products. If the intermediate steps of the reaction can be reduced, it has the potential to improve the efficiency of nitrogen removal. Therefore, this experiment significantly improved nitrogen removal efficiency and reduced energy consumption through short-cut nitrification and endogenous denitrification.","center":"hainanu","data_type":"Raw sequence reads","submission_date":"2025/05/07 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN48386792","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2024-12-21",2024,"CN","Hainan",1809078,"Haikou","verified",20.06,110.33,"China: haikou","WWTP-1",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN48386793","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2024-12-21",2024,"CN","Hainan",1809078,"Haikou","verified",20.06,110.33,"China: haikou","WWTP-2",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN48386794","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2024-12-21",2024,"CN","Hainan",1809078,"Haikou","verified",20.06,110.33,"China: haikou","WWTP-3",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN48386795","Metagenome or environmental sample from sludge metagenome",