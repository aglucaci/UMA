{"v":1,"accession":"PRJNA954821","title":"Microbial community of drinking water ozone contactor in Michigan","description":"Drinking water ozone contactor influent and effluent water samples were collected bi-weekly for 40 days to analyze differences in the microbial communities. Samples (3-10L) were filtered onto sterile 0.2 micron cartridge filters. DNA was extracted using a modified protocol for the QIAGEN DNeasy PowerWater kit (Vosloo et al. 2019; dx.doi.org/10.17504/protocols.io.66khhcw). Library preparation was conducted using a PCR assay targeting the V4 region of the 16S rRNA gene and a dual-indexing sequencing strategy (Kozich et al. 2013; https://doi.org/10.1128/AEM.01043-13). Sequencing was performed using an Illumina MiSeq using 250 base pair paired-end reads and the MiSeq Reagent Kit V2 500 cycles.","center":"University of Michigan","data_type":"Raw sequence reads","submission_date":"2023/04/12 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN34156243","16s rRNA gene sequences of drinking water ozone contactor sample","uncertain",null,"2021-04-30",2021,"US","Michigan",null,null,"unresolved",null,null,"USA: Michigan",null,"drinking water","drinking water ozone contactor","drinking water","no environmental-sample evidence"],["SAMN34156245","16s rRNA gene sequences of drinking water ozone contactor sample","uncertain",null,"2021-05-04",2021,"US","Michigan",null,null,"unresolved",null,null,"USA: Michigan",null,"drinking water","drinking water ozone contactor","drinking water","no environmental-sample evidence"],["SAMN34156247","16s rRNA gene sequences of drinking water ozone contactor sample","uncertain",null,"2021-05-07",2021,"US","Michigan",null,null,"unresolved",null,null,"USA: Michigan",null,"drinking water","drinki