{"v":1,"accession":"PRJEB52062","title":"Bacterial communities and culturable Legionella in premise plumbing systems in four European cities","description":"Legionella spp. are Gram-negative, facultative, intracellular bacteria ubiquitous in freshwater and man-made water systems. Understanding the bacterial interactions underlying Legionella's success in aquatic environments could be beneficial for control. The aim of this study was to analyse by 16S rRNA amplicon sequencing the bacterial communities of premise plumbing systems located in four European countries (Denmark, Poland, Italy and Greece) in relation to the presence or absence of culturable Legionella species.","center":"scottish microbiology reference laboratories","data_type":"Other","submission_date":"2022/08/30 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA14391558","Premise plumbing water, Warsaw building 1, municipal water, winter 2017","confirmed_urban","built_environment",null,2017,"PL",null,null,null,"unresolved",null,null,"Poland",null,null,null,null,"explicit urban setting at sample level"],["SAMEA14391559","Premise plumbing water, Warsaw building 1, hot recirc water, winter 2017","probable_urban","built_environment",null,2017,"PL",null,null,null,"unresolved",null,null,"Poland",null,null,null,null,"urban context stated at BioProject level only"],["SAMEA14391560","Premise plumbing water, Warsaw building 1, farthest point from boiler, winter 2017","probable_urban","built_environment",null,2017,"PL",null,null,null,"unresolved",null,null,"Poland",null,null,null,null,"urban context stated at BioProject level only"],["SAMEA14391566","Premise plumbing water, Warsaw building 1, municipal water, summer 2017","confirmed_urban","built_environment",null,2017,"PL",nul