{"v":1,"accession":"PRJNA1358828","title":"Novel insight into the diversities of active tetracycline-resistant bacteria and genes in the activated sludge as revealed by in situ microcapsule-entrapped cultivation (IMEC)","description":"This public dataset contains 16S rRNA gene sequencing data of tetracycline-resistant microorganisms in activated sludge analyzed via three methods (conventional isolation, direct sequencing, and in situ microcapsule-entrapped cultivation), along with PCR-amplified sequencing data of resistance genes tetC, tetG, tetM, and tetX from microbial genomes obtained by direct sequencing and in situ microcapsule-entrapped cultivation, all supporting research on tetracycline resistance in sludge microbiomes.","center":"Jilin University","data_type":"Raw sequence reads","submission_date":"2025/11/10 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN53128880","Metagenome or environmental sample from activated sludge metagenome","confirmed_urban","municipal_wastewater","2022-10-12",2022,"CN","Anhui",1791236,"Wuhu","verified",31.3536,118.4277,"China: Wuhu, Anhui","activated sludge from a municipal wastewater treatment plant",null,null,null,"explicit urban setting at sample level"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR35978702","SAMN53128880","SRX31028035","Amplicon","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina HiSeq 2000",96284792,459670,"2026-07-01","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos13/sra-pub-zq-1305/SRR035/35978/SRR35978702/SRR35978702.lite.1"],["SRR35978703","SAMN53128880","SRX31028034","Amplicon","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina HiSeq