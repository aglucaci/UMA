{"v":1,"accession":"PRJDB17448","title":"Metagenom analysis of grape, raisin, and fermented raisin water","description":"In this study we conducted metagenomic analysis targeting fungi (ITS region) and bacteria (16S rRNA V3-V4 region) colonized on raw grapes and raisins. We also examined changes of microbiome along with fermentation of raisin in sterile water. In addition, we dried raw grapes with three ways (sun dry, sun and oven dry, and oven dry) and compared their microbiome.","center":"Kyoto University","data_type":"Targeted Locus (Loci)","submission_date":"2024/01/30 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00735727","Air_vacuum_ITS","uncertain",null,"2023-09-24",2023,"JP","Kyoto",1849372,"Uji","verified",34.91,135.8,"Japan:Kyoto, Uji",null,null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMD00735743","Air_vacuum_16S","uncertain",null,"2023-09-24",2023,"JP","Kyoto",1849372,"Uji","verified",34.91,135.8,"Japan:Kyoto, Uji",null,null,null,null,"conflicting evidence: environmental and host/clinical"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["DRR527940","SAMD00735727","DRX511818","Amplicon","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina MiSeq",52940645,88805,"2024-01-30","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos9/sra-pub-zq-924/DRR000/527/DRR527940/DRR527940.lite.1"],["DRR527956","SAMD00735743","DRX511834","Amplicon","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina MiSeq",22296751,37213,"2024-01-30","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos9/sra-pub-zq-924/DRR000/527/DRR527956/DRR527956.lite.1"]],"sample_projects":{}}