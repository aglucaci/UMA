{"v":1,"accession":"PRJDB16903","title":"Microbial community structure analysis of  microbial fuel cell operated in sewage wastewater","description":"This project aims to explore the microbial composition within the anodic chamber of a microbial fuel cell (MFC) that is operated using sewage wastewater. The study focuses on three distinct components: two types of anodes, specifically nonwoven graphite fabric (NWGF) and carbon brush (CB), as well as the anolyte, which consists of wastewater (WW). The NWGF serves as the anode surrounding the core of the air-cathode, while the CB functions as an additional anode positioned within the anolyte in close proximity to the air-core.","center":"Nagoya Institute of Technology","data_type":"Targeted Locus (Loci)","submission_date":"2023/11/02 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00654808","Nonwoven_graphite_fabric_anode_1","uncertain",null,"2022-01-07",2022,"JP","Aichi",1856057,"Nagoya","verified",35.1268,136.9786,"Japan:Aichi, Nagoya",null,"aquatic biome","sewage","sewage","environmental sample; urban association not established"],["SAMD00654809","Nonwoven_graphite_fabric_anode_2","uncertain",null,"2022-01-07",2022,"JP","Aichi",1856057,"Nagoya","verified",35.1268,136.9786,"Japan:Aichi, Nagoya",null,"aquatic biome","sewage","sewage","environmental sample; urban association not established"],["SAMD00654810","Carbon_brush_anode_1","uncertain",null,"2022-01-07",2022,"JP","Aichi",1856057,"Nagoya","verified",35.1268,136.9786,"Japan:Aichi, Nagoya",null,"aquatic biome","sewage","sewage","environmental sample; urban association not established"],["SAMD00654811","Carbon_brush_anode_2","uncertain",null,"2022-01-07",2022,"JP","Aichi",1856057,"Nagoya","verified",35.1268,136.9786,"Japan:Aichi