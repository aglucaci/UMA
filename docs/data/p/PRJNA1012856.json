{"v":1,"accession":"PRJNA1012856","title":"Host range of antibiotic resistance genes in Croatian wastewater","description":"Influent and effluent from two wastewater treatment plants (WWTPs) in Croatia were studied to identify bacterial hosts of clinically important beta-lactamase genes (blaTEM, blaVIM, blaOXA-48-like) and observe how their composition changes during the treatment process. EpicPCR was used to identify the hosts of antibiotic resistance genes , and 16S rRNA amplicon sequencing to study the entire bacterial community. Different wastewater sources contributed to the significant differences in bacterial composition of the wastewater between the two WWTPs studied. The number of hosts carrying investigated antibiotic resistance genes was reduced by wastewater treatment.","center":"University of Helsinki","data_type":"Raw sequence reads","submission_date":"2023/09/05 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN37277959","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater",null,2021,"HR","Zagreb",3186886,"Zagreb","probable",45.7897,16.089,"Croatia: Zagreb","raw wastewater",null,null,null,"city-level location without sample-site confirmation"],["SAMN37277960","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater",null,2021,"HR","Zagreb",3186886,"Zagreb","probable",45.7897,16.089,"Croatia: Zagreb","raw wastewater",null,null,null,"city-level location without sample-site confirmation"],["SAMN37277961","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater",null,2021,"HR","Zagreb",3186886,"Zagreb","probable",45.7897,16.089,"Croatia: Zagreb","raw wastewater",null,null,null,"c