{"v":1,"accession":"PRJNA638613","title":"Wastewater microplastic microbiome characterization","description":"The goal of the study was to quantify and characterize microplastics in three critical stages of wastewater treatment, and to analyze bacterial assemblages attached to microplastics to determine if the composition of these assemblages changes during transport through domestic WWTPs. We sampled two activated sludge WWTPs in Illinois that are point sources of microplastics to their receiving streams. For each plant we characterized microplastics and associated bacterial assemblages in raw sewage, effluent water, and sludge.","center":"Loyola University Chicago","data_type":"Targeted loci environmental","submission_date":"2020/06/10 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN15214591","Bartlett Sludge Microplastic Biofilm","confirmed_urban","municipal_wastewater","2014-11-21",2014,"US","Illinois",4890864,"Elgin","probable",41.9684,-88.1651,"USA: Illinois","sewage sludge","Wastewater Treatment Plant","Sludge","Microplastic","named urban infrastructure at sample level"],["SAMN15214592","Bartlett Sludge Microplastic Biofilm","confirmed_urban","municipal_wastewater","2014-11-21",2014,"US","Illinois",4890864,"Elgin","probable",41.9684,-88.1651,"USA: Illinois","sewage sludge","Wastewater Treatment Plant","Sludge","Microplastic","named urban infrastructure at sample level"],["SAMN15214593","Bartlett Sludge Microplastic Biofilm","confirmed_urban","municipal_wastewater","2014-11-21",2014,"US","Illinois",4890864,"Elgin","probable",41.9684,-88.1651,"USA: Illinois","sewage sludge","Wastewater Treatment Plant","Sludge","Microplastic","named urban infrastructure at sample level"],["SAMN15214595","Bartlett Effluent Microplastic Biof