{"v":1,"accession":"PRJDB4257","title":"Miseq Sequencing Analysis of Microbial Communities in Different Membrane Bioreactors","description":"Membrane bioreactors (MBR) for wastewater treatment are hampered particularly by membrane biofouling, resulting from microbial growth. Although the biological understanding of biofouling mechanism is crucial for the development of biofouling control strategies, the information of the microbial ecology is not sufficient. In this study, we studied microbial communities from 10 full-scale MBR plants with different membrane modules and wastewaters using 16S rRNA genes Miseq sequencing analysis.","center":"School of chemical and Biological enginnering, Seoul National Univeristy","data_type":"Targeted Locus (Loci)","submission_date":"2017/09/25 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00041518","Gangwon_A_sludge_1","confirmed_urban","municipal_wastewater","2015-02-12",2015,"KR","Gangwon-do",null,null,"unresolved",null,null,"South Korea:Gangwon-do",null,null,"wastewater treatment plant","sludge","named urban infrastructure at sample level"],["SAMD00041519","Gangwon_A_sludge_2","confirmed_urban","municipal_wastewater","2015-02-12",2015,"KR","Gangwon-do",null,null,"unresolved",null,null,"South Korea:Gangwon-do",null,null,"wastewater treatment plant","sludge","named urban infrastructure at sample level"],["SAMD00041520","Gangwon_A_sludge_3","confirmed_urban","municipal_wastewater","2015-02-12",2015,"KR","Gangwon-do",null,null,"unresolved",null,null,"South Korea:Gangwon-do",null,null,"wastewater treatment plant","sludge","named urban infrastructure at sample level"],["SAMD00041521","Gangwon_A_biofilm_1","confirmed_urban","municipal_wastewater","2015-02-12",2015,"KR","Gangwon-do",null,null,"unr