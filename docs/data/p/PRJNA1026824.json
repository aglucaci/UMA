{"v":1,"accession":"PRJNA1026824","title":"Intracellular and Extracellular Sequenced DNA from Urban Stormwater","description":"Stormwater grab samples were collected at four locations: a stormwater inlet, stormwater outfall, a river, and lake. Each site was sampled on three instances, corresponding to the fall, winter, and spring seasons. In addition, triplicate baseline grab samples were collected at the outfall, river, and lake prior to each storm event. iDNA was extracted via MP Biomedicals FastDNA Spin Kit and eDNA was extracted by a previously published protocol (DOI: https://doi.org/10.1061/(ASCE)EE.1943-7870.0001993). A composite sample of the extracts was prepared for each site and sampling event by combining the triplicate samples by an equal DNA mass. Metagenomic sequencing completed on Illumina NextSeq 2000 platform (151 bp paired end) at a sequencing depth of 650 Mbp. Deposited sequences are full-length, untrimmed reads.","center":"Marquette University","data_type":"Raw sequence reads","submission_date":"2023/10/11 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN37764633","FBOI","probable_urban","water_drainage","2020-11-05",2020,"US","Wisconsin",5263045,"Milwaukee","probable",43.0436,-87.9888,"USA:Wisconsin","stormwater outfall",null,null,null,"urban context stated at BioProject level only"],["SAMN37764634","FBRI","probable_urban","water_drainage","2020-11-05",2020,"US","Wisconsin",5263045,"Milwaukee","probable",43.0422,-87.9878,"USA:Wisconsin","river",null,null,null,"urban context stated at BioProject level only"],["SAMN37764635","FBLI","probable_urban","water_drainage","2020-11-05",2020,"US","Wisconsin",5263045,"Milwaukee","probable",43.0254,-87.8963,"USA:Wisconsin","lake",null,null,null,"urban context stated at 