{"v":1,"accession":"PRJNA1453751","title":"Characterisation of Microbial Communities Captured by Traffic-Exposed Outdoor Air Filters in the Klang Valley, Malaysia Using 16S rRNA Gene Sequencing","description":"This study characterizes the atmospheric microbiome in the Klang Valley, Malaysia, an area with high urban density and significant traffic exposure. Using 16S rRNA gene amplicon sequencing, we analyzed microbial communities captured by outdoor air filters to establish a baseline for tropical urban bioaerosols. The dataset provides a critical resource for understanding the interplay between urban traffic emissions and airborne microbial diversity in a tropical climate, supporting future research in environmental health and atmospheric ecology.","center":"Sunway University","data_type":"Raw sequence reads","submission_date":"2026/04/15 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN57273392","Traffic-exposed air sample - Meru area","confirmed_urban","air_dust","2025-10-21",2025,"MY","Selangor",1732902,"Meru","verified",3.13,101.44,"Malaysia: Selangor, Meru",null,"air [ENVO:00002005]","Meru urban school environment","air [ENVO:00002005]","explicit urban setting at sample level"],["SAMN57273393","Traffic-exposed air sample - Damansara area","confirmed_urban","air_dust","2025-11-03",2025,"MY","Kuala Lumpur",12750576,"Bukit Damansara","verified",3.12,101.62,"Malaysia: Selangor, Damansara",null,"air [ENVO:00002005]","Damansara urban school environment","air [ENVO:00002005]","explicit urban setting at sample level"],["SAMN57273394","Traffic-exposed air sample - Kuala Selangor area","probable_urban","air_dust","2025-11-09",2025,"MY","Selangor",1732891,"Kuala Selangor","verified",3.34,101.25,"Malaysia: Selangor, Kuala Selangor",nu