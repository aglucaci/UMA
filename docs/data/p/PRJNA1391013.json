{"v":1,"accession":"PRJNA1391013","title":"A Novel Cylindrical Sulfur-Based Carrier (Kaldnes-S) Mediating Diverse S0/HS-/Sn2- Pathways for Enhanced Autotrophic Denitrification: From Lab-Scale Biofilters to Pilot-Scale Applications","description":"Sulfur autotrophic denitrification is a promising biotechnology, and the development of novel sulfur-based biofilm carriers is crucial for its integration into existing wastewater treatment processes. In this study, a novel sulfur carrier (Kaldnes-S) with a cylindrical, hollow structure was developed, and its performance was evaluated in laboratory-scale biofilters and pilot-scale anaerobic baffle biofilm reactors for treating low carbon-to-nitrogen ratio wastewater.","center":"Beijing Normal University","data_type":"Raw sequence reads","submission_date":"2025/12/19 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN54210920","MIGS Cultured Bacterial/Archaeal sample from Anaerolineaceae","uncertain",null,null,2025,null,null,null,null,"unresolved",null,null,null,null,"wastewater treatment plant","wastewater treatment plant","Secondary effluent from wastewater treatment plant","conflicting evidence: environmental and host/clinical"],["SAMN54210921","MIGS Cultured Bacterial/Archaeal sample from Thiobacillus","uncertain",null,null,2022,null,null,null,null,"unresolved",null,null,null,null,"wastewater treatment plant","wastewater treatment plant","Secondary effluent from wastewater treatment plant","conflicting evidence: environmental and host/clinical"],["SAMN54210922","MIGS Cultured Bacterial/Archaeal sample from Thiobacillus","uncertain",null,null,2022,null,null,null,null,"unresolved",null,null,null,null,"wastewater treatment plant","wastewater treatment plant","Secondary effluent from waste