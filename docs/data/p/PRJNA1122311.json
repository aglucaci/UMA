{"v":1,"accession":"PRJNA1122311","title":"Choline chloride assisted thermal hydrolysis pretreatment improves short-chain fatty acid yield in anaerobic fermentation of sludge","description":"Slow dissolution/hydrolysis efficiency has been widely recognized as a limiting factor for the production of short chain fatty acids (SCFAs) from anaerobic fermentation of waste activated sludge (WAS). In this study, the application of choline chloride (ChCl) assisted thermal hydrolysis (TH) pretreatment was proposed for the first time for the treatment of WAS, and its effectiveness in improving SCFA yield was evaluated.","center":"Xiangtan University","data_type":"Raw sequence reads","submission_date":"2024/06/10 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN41782759","raw.split.C1.1","uncertain",null,"2024-04-11",2024,"CN","Hunan",1802875,"Guankou","probable",28.24,113.49,"China: Hunan","Waste activated sludge",null,null,null,"environmental sample; urban association not established"],["SAMN41782761","raw.split.C2.1","uncertain",null,"2024-04-11",2024,"CN","Hunan",1802875,"Guankou","probable",28.24,113.49,"China: Hunan","Waste activated sludge",null,null,null,"environmental sample; urban association not established"],["SAMN41782763","raw.split.C3.1","uncertain",null,"2024-04-11",2024,"CN","Hunan",1802875,"Guankou","probable",28.24,113.49,"China: Hunan","Waste activated sludge",null,null,null,"environmental sample; urban association not established"],["SAMN41782765","raw.split.C4.1","uncertain",null,"2024-04-11",2024,"CN","Hunan",1802875,"Guankou","probable",28.24,113.49,"China: Hunan","Waste activated sludge",null,null,null,"environmental sample; urban association not established"]],"run_cols":["accession","sample","experiment","assay","