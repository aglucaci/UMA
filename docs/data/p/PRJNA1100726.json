{"v":1,"accession":"PRJNA1100726","title":"Insight into the Impact of Air Flow Rate on Algal-Bacterial Granules","description":"Algal-bacterial granules have been drawing attention in wastewater treatment due to their rapid settling ability and efficient nutrient removal performance. This study evaluated the impact of air flow rates on nitrogen removal and the formation of algal-bacterial granules in domestic wastewater treatment. The findings suggest that the lower air flow rate is the optimal choice, as it resulted in similar nutrient removal performance and granular properties, while significantly reducing energy costs. Moreover, the study highlights the importance of understanding the interplay between operational conditions, microbial community dynamics, and granular properties to optimize these systems' performance and stability.","center":"Penn State University","data_type":"Raw sequence reads","submission_date":"2024/04/15 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN40976878","MIMS Environmental/Metagenome sample from wastewater metagenome","uncertain",null,"2021-09-25",2021,"US",null,null,null,"unresolved",null,null,"USA",null,"ENVO:01000020","ENVO:00000468","ENVO:00002160","environmental sample; urban association not established"],["SAMN40976879","MIMS Environmental/Metagenome sample from wastewater metagenome","uncertain",null,"2021-10-25",2021,"US",null,null,null,"unresolved",null,null,"USA",null,"ENVO:01000020","ENVO:00000468","ENVO:00002160","environmental sample; urban association not established"],["SAMN40976880","MIMS Environmental/Metagenome sample from wastewater metagenome","uncertain",null,"2021-10-26",2021,"US",null,null,null,"unresolved",null,null,"USA",null,"ENVO:01000020","ENVO:00000468","ENVO:00002