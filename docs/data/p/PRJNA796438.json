{"v":1,"accession":"PRJNA796438","title":"Bacterial Community Structure in the Main City Section of Chongqing","description":"In order to understand the diversity and influencing factors of microbial community in watershed that heavily affected by anthropogenic activities, Chongqing's central urban area in the upper section of the Three Gorges Reservoir were selected to be the study area in this research. High-throughput sequencing technology were used to measure statistical analysis of biological information; Student's T-test were used to test the difference of diversity index and correlation analysis was used to study influencing factors. We hope it could provide referencefor a influence mechanism of Bacteria Community changes in water.","center":"Chongqing Jiaotong Universaty","data_type":"Raw sequence reads","submission_date":"2022/01/12 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN24857021","Metagenome or environmental sample from urban metagenome","confirmed_urban",null,"2020-06-23",2020,"CN","Chongqing",1814906,"Chongqing","verified",29.28,106.32,"China:Chongqing","water environmental sample",null,null,null,"explicit urban setting at sample level"],["SAMN24857022","Metagenome or environmental sample from urban metagenome","confirmed_urban",null,"2020-09-15",2020,"CN","Chongqing",1814906,"Chongqing","verified",29.28,106.32,"China:Chongqing","water environmental sample",null,null,null,"explicit urban setting at sample level"],["SAMN24857023","Metagenome or environmental sample from urban metagenome","confirmed_urban",null,"2020-06-25",2020,"CN","Chongqing",1814906,"Chongqing","verified",29.34,106.33,"China:Chongqing","water environmental sample",null,null,null,"explicit urban setting at sample level"],["SAMN24857024","M