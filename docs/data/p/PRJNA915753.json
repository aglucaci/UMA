{"v":1,"accession":"PRJNA915753","title":"Fuel-synthesis wastewater treatment and PHA production using purple non-sulfur bacteria: Effect of nitrogen and phosphorus concentrations","description":"Purple non-sulphur bacteria are abundant in nature and participate in a wide variety of environmental processes. They are photosynthetic organisms that utilize organic substrates and have the potential for the production of polyhydroxyalkanoates (PHAs). This study focuses on the application of these organisms for PHA production during simultaneous treatment of fuel synthesis water, an organic rich byproduct of the Fischer-Tropsch process.","center":"Carnegie Mellon University Qatar","data_type":"Raw sequence reads","submission_date":"2022/12/25 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN32405770","Replicate 1 of phototrophic mixed culture grown in Nitrogen plus testing condition.","uncertain",null,"2021-01-11",2021,"QA","Baladiyat ad Dawhah",290030,"Doha","verified",25.3154,51.4342,"Qatar: Liberal Arts and Science (LAS) building, Education City, Doha","Mixed Culture",null,null,null,"no environmental-sample evidence"],["SAMN32405771","Replicate 2 of phototrophic mixed culture grown in Nitrogen plus testing condition.","uncertain",null,"2021-01-11",2021,"QA","Baladiyat ad Dawhah",290030,"Doha","verified",25.3154,51.4342,"Qatar: Liberal Arts and Science (LAS) building, Education City, Doha","Mixed Culture",null,null,null,"no environmental-sample evidence"],["SAMN32405772","Replicate 1 of phototrophic mixed culture grown in Nitrogen minus testing condition.","uncertain",null,"2021-01-11",2021,"QA","Baladiyat ad Dawhah",290030,"Doha","verified",25.3154,51.4342,"Qatar: Liberal Arts and Science (LAS) building, Education City, Doha","Mixe