{"v":1,"accession":"PRJDB42481","title":"Hybridization-capture sequencing for SARS-CoV-2 variant estimation in wastewater genomic surveillance","description":"This study aimed to evaluate the feasibility of a hybridization-capture sequencing approach for wastewater genomic surveillance. Hybridization-capture sequencing was applied to wastewater samples to obtain single-nucleotide variant (SNV) frequencies across the whole SARS-CoV-2 genome. We refined an iterative matrix reduction (IMR) algorithm to estimate the relative abundance of SARS-CoV-2 lineages based on these SNV frequencies from whole-genome sequence data.","center":"Faculty of Geosciences and Civil Engineering, Kanazawa University","data_type":"Metagenomic assembly","submission_date":"2026/06/11 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD01928392","SARS-CoV-2 wastewater genomic surveillance sample of inlet 2 on 2023-05-12","confirmed_urban","municipal_wastewater","2023-05-12",2023,"JP","Ishikawa",1858910,"Komatsu","verified",null,null,"Japan:Ishikawa, Komatsu","municipal wastewater influent",null,null,null,"explicit urban setting at sample level"],["SAMD01928393","SARS-CoV-2 wastewater genomic surveillance sample of inlet 2 on 2023-05-17","confirmed_urban","municipal_wastewater","2023-05-17",2023,"JP","Ishikawa",1858910,"Komatsu","verified",null,null,"Japan:Ishikawa, Komatsu","municipal wastewater influent",null,null,null,"explicit urban setting at sample level"],["SAMD01928394","SARS-CoV-2 wastewater genomic surveillance sample of inlet 1 on 2023-05-19","confirmed_urban","municipal_wastewater","2023-05-19",2023,"JP","Ishikawa",1858910,"Komatsu","verified",null,null,"Japan:Ishikawa, Komatsu","municipal wastewater influent",null,null,null,"explicit urban setting 