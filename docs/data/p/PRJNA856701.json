{"v":1,"accession":"PRJNA856701","title":"Skin microbiome of forehead in children with and without acne","description":"Whole genome sequencing of 48 volunteers, males and females, ages 7-17 years of age with and without acne. Tanner staging was used to assess pubertal development, IGA score assessed acne severity. A 7cm2 area of the forehead was scrubbed with a pre-moistened sterile, synthetic fiber swab for 30 seconds. Positive and negative sampling controls also included. Sequencing was performed by Illumina NextSeq sequencing (2x150 paired end reads).","center":"Penn State College of Medicine","data_type":"Raw sequence reads","submission_date":"2022/07/07 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN29584297","049_NegCtrl_1","uncertain",null,"2018-04-03",2018,"US","Pennsylvania",5193342,"Hershey","verified",40.28,-76.65,"USA: Hershey, PA","air",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN29584298","050_NegCtrl_2","uncertain",null,"2019-03-08",2019,"US","Pennsylvania",5193342,"Hershey","verified",40.28,-76.65,"USA: Hershey, PA","air",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN29584299","051_NegCtrl_3","uncertain",null,"2018-08-27",2018,"US","Pennsylvania",5193342,"Hershey","verified",40.28,-76.65,"USA: Hershey, PA","air",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN29584300","052_NegCtrl_4","uncertain",null,"2019-03-14",2019,"US","Pennsylvania",5193342,"Hershey","verified",40.28,-76.65,"USA: Hershey, PA","air",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN29584301","053_NegCtrl_5","uncertain",null,"2018-09-05",2018,"US","Pennsylvania",5193342,"Hershey","verified",40.28,-76.65,"USA: Hershey,