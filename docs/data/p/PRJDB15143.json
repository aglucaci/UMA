{"v":1,"accession":"PRJDB15143","title":"Use of microbial fuel cells for the treatment of residue effluents discharged from an anaerobic digester treating food wastes","description":"One of practical challenges in the anaerobic-digestion (AD) technology would be cost-effective treatment of residue effluents containing high concentrations of organics, nitrogen and phosphorus (CNP). In order to evaluate the utility of microbial fuel cells (MFCs) for treating anaerobic-digester effluents (ADEs) and generating power from them, laboratory-scale single-chamber MFCs were filled with ADE obtained from a commercial AD plant treating food wastes and thereafter operated by routinely supplying ADE at different hydraulic residence times (HRTs, 5 to 20 days).","center":"Tokyo University of Pharmacy and Life Sciences","data_type":"Targeted Locus (Loci)","submission_date":"2023/01/20 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00574215","ADE","confirmed_urban","municipal_wastewater",null,2022,"JP","Tokyo",1863440,"Hachiōji","verified",35.6693,139.4257,"Japan:Tokyo, Hachioji",null,"biome","wastewater treatment plant","industrial wastewater","named urban infrastructure at sample level"],["SAMD00574216","AB5","confirmed_urban","municipal_wastewater",null,2022,"JP","Tokyo",1863440,"Hachiōji","verified",35.6693,139.4257,"Japan:Tokyo, Hachioji",null,"biome","wastewater treatment plant","industrial wastewater","named urban infrastructure at sample level"],["SAMD00574217","AB10","confirmed_urban","municipal_wastewater",null,2022,"JP","Tokyo",1863440,"Hachiōji","verified",35.6693,139.4257,"Japan:Tokyo, Hachioji",null,"biome","wastewater treatment plant","industrial wastewater","named urban infrastructure at sample level"],["SAMD00574218","AB20","co