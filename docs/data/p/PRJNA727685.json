{"v":1,"accession":"PRJNA727685","title":"Mobile phones as Fomites_ Community derived","description":"A study was undertaken to profile 5 phones swabbed through shotgun metagenome sequencing runs. Of note, the 5 phone swabs were each plated into three different agar media plates (Horse blood agar plate, MacConkey agar plate, Nutrient agar plate ; Therefore 15 plates in total were grown. All colonies from each type of plates (HBA or MAC or NA), were pooled together and therefore resulted into three pools (HBA pooled colonies, MAC pooled colonies and NA pooled colonies). These three pools were subject to individual metagenome shotgun sequencing on Illumina NEXT SEQ 550 platform.","center":null,"data_type":"Raw sequence reads","submission_date":"2021/05/06 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN19030067","HBA Pooled_R1","uncertain",null,"2020-09-26",2020,"AU","Queensland",2165087,"Gold Coast","verified",-28.0167,153.4,"Australia: Gold Coast","Community-HBA-1",null,null,null,"no environmental-sample evidence"],["SAMN19030069","MAC Pooled_R1","uncertain",null,"2020-09-26",2020,"AU","Queensland",2165087,"Gold Coast","verified",-28.0167,153.4,"Australia: Gold Coast","Community-MAC-1",null,null,null,"no environmental-sample evidence"],["SAMN19030071","NUT Pooled_R1","uncertain",null,"2020-09-26",2020,"AU","Queensland",2165087,"Gold Coast","verified",-28.0167,153.4,"Australia: Gold Coast","Community-NUT-1",null,null,null,"no environmental-sample evidence"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR14483470","SAMN19030071","SRX10831027","WGS","WGS","METAGENOMIC","PAIRED","ILLUMINA","NextSeq 550",282775264