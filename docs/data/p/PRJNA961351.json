{"v":1,"accession":"PRJNA961351","title":"1234 Raw sequence reads","description":"In this study, the effects of roxarsone on anammox process performance were systemically investigated through continuous-flow experiments, aiming to reveal the inhibitory mechanism of roxarsone on anammox consortia. Based on the above summary, it was speculated that oxidative stress involves in the responding process. Thus, the abundance of key genes and oxidative stress levels were further quantified. In addition, roxarsone-induced microbial community evolution was evaluated, and the potential mechanism of anammox consortia in responding to roxarsone was finally illustrated.","center":"Hangzhou Normal University","data_type":"Raw sequence reads","submission_date":"2023/04/25 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN34360705","R1","uncertain",null,"2022-03-20",2022,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN34360706","R1","uncertain",null,"2022-03-20",2022,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN34360707","R1","uncertain",null,"2022-03-20",2022,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN34360708","R1","uncertain",null,"2022-03-20",2022,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR24298229","SAMN34360708","SRX20093621","Amplicon