{"v":1,"accession":"PRJNA594186","title":"Metagenome for anaerobic digestion","description":"PacBio long reads sequencing presents several potential advantages for DNA assembly and providing more complete gene profiling of metagenomic samples, however, lower single-pass accuracy can make gene discovery and assembly for low-abundance organisms difficult. To evaluate the application and performance of PacBio long reads and Illumina HiSeq short reads for metagenomics, we directly compared various assemblies with PacBio and Illumina sequencing reads on several anaerobic digestion microbiome samples.","center":"Southwest University","data_type":"Raw sequence reads","submission_date":"2019/12/08 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN13507465","anaerobic sludge AS_M_HiSeq","probable_urban","municipal_wastewater","2015-03-20",2015,"CN","Chongqing",1814906,"Chongqing","probable",null,null,"China:Chongqing",null,"anaerobic sludge",null,null,"city-level location without sample-site confirmation"],["SAMN13507467","anaerobic sludge AS_M_PacBio","probable_urban","municipal_wastewater","2015-03-20",2015,"CN","Chongqing",1814906,"Chongqing","probable",null,null,"China:Chongqing",null,"anaerobic sludge",null,null,"city-level location without sample-site confirmation"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR10608980","SAMN13507467","SRX7288257","WGS","WGA","METAGENOMIC","SINGLE","PACBIO_SMRT","PacBio RS II",11267839513,1207984,"2019-12-18","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos9/sra-pub-zq-924/SRR010/10608/SRR10608980/SRR10608980.lite.1"],["SRR10608982","SAMN13507465","SRX7288255","WGS","WGS","META