{"v":1,"accession":"PRJNA1263049","title":"SGV &  IFAS","description":"Integrated fixed-film activated sludge (IFAS) systems provide an energy-efficient method for nitrogen removal in aniline wastewater treatment. To further improve energy and carbon efficiency, low superficial gas velocity (SGV) is recommended to optimize biofilm-sludge interactions and regulate electron transfer. However, the effects of low SGV on microbial community dynamics and electron transfer under aniline stress in continuous-flow IFAS systems remain insufficiently understood. Herein, IFAS in continuous-flow mode under different SGVs (0.15, 0.10, and 0.04 cm/s) were set up to investigate it.","center":"China Institute of Water Resources and Hydropower Research","data_type":"Raw sequence reads","submission_date":"2025/05/14 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN48509215","sludge","uncertain",null,null,2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN48509216","sludge","uncertain",null,null,2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN48509217","sludge","uncertain",null,null,2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN48509219","sludge","uncertain",null,null,2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN48509220","sludge","uncertain",null,null,2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environme