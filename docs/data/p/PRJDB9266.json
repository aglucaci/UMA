{"v":1,"accession":"PRJDB9266","title":"Microbial community structure of mesh rotating biological reactor (MRBR) treating sewage","description":"Mesh rotating biological reactor (MRBR) is a new type of rotational biological contactor (RBC) reactor for wastewater treatment, which have advantages of compactness, easy operation, low excess sludge, and low energy consumption. Microbial community information is important basic data and relevant to treatment performance, however there is no microbial information regarding MRBR biofilms. In this study, microbial community structure of sludge on the mesh media was analyzed based on the 16S rRNA gene sequence.","center":"Department of Civil and Environmental Engineering, Nagaoka University of Technology","data_type":"Metagenome","submission_date":"2020/06/17 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00202834","MRBR mesh influent side center sample, no.1 reactor","confirmed_urban","municipal_wastewater","2018-11-06",2018,"JP","Niigata",1856199,"Nagaoka","probable",null,null,"Japan:Nagaoka",null,null,"sewage treatment plant","activated sludge biofilm","named urban infrastructure at sample level"],["SAMD00202835","MRBR mesh effluent side center sample, no.1 reactor","confirmed_urban","municipal_wastewater","2018-11-06",2018,"JP","Niigata",1856199,"Nagaoka","probable",null,null,"Japan:Nagaoka",null,null,"sewage treatment plant","activated sludge biofilm","named urban infrastructure at sample level"],["SAMD00202836","MRBR mesh effluent side outer sample, no.1 reactor","confirmed_urban","municipal_wastewater","2018-11-06",2018,"JP","Niigata",1856199,"Nagaoka","probable",null,null,"Japan:Nagaoka",null,null,"sewage treatment plant","activated sludge biofilm","named urban infrastructure at