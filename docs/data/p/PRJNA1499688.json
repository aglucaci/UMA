{"v":1,"accession":"PRJNA1499688","title":"aerobic granular sludge sequencing","description":"We demonstrate that retained centrate solids can serve as a slow-release internal carbon pool. During 120 days of granular sludge reactor operation, influent solids increased from 1.0 to 3.0 g/L while the C/N ratio decreased from 2.8 to 1.5. The reactor nevertheless maintained greater than 99% ammonia removal and greater than 95% total inorganic nitrogen removal at a hydraulic retention time of only 6 h.","center":"QUT","data_type":"Raw sequence reads","submission_date":"2026/07/23 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN61886272","Granular sludge at the end of Stage I 16s","probable_urban","municipal_wastewater","2025-06-10",2025,"AU","Queensland",2174003,"Brisbane","probable",-27.4772,153.0281,"Australia: Queensland","REACTOR",null,null,null,"city-level location without sample-site confirmation"],["SAMN61886273","Granular sludge at the end of Stage I 16s","probable_urban","municipal_wastewater","2025-06-10",2025,"AU","Queensland",2174003,"Brisbane","probable",-27.4772,153.0281,"Australia: Queensland","REACTOR",null,null,null,"city-level location without sample-site confirmation"],["SAMN61886274","Granular sludge at the end of Stage II 16s","probable_urban","municipal_wastewater","2025-07-20",2025,"AU","Queensland",2174003,"Brisbane","probable",-27.4772,153.0281,"Australia: Queensland","REACTOR",null,null,null,"city-level location without sample-site confirmation"],["SAMN61886275","Granular sludge at the end of Stage II 16s","probable_urban","municipal_wastewater","2025-07-20",2025,"AU","Queensland",2174003,"Brisbane","probable",-27.4772,153.0281,"Australia: Queensland","REACTOR",null,null,null,"city-level location without sam