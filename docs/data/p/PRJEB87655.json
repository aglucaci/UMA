{"v":1,"accession":"PRJEB87655","title":"Sequencing of anaerobic digestion sludges","description":"Anaerobic digestion (AD) reactors across the Netherlands were sampled to analyse their microbial community composition. 16S rRNA gene sequencing analysis was done on a total of 114 anaerobic sludge samples, with varying operation temperature, pH and feedstock. Fourteen of the collected samples, including both suspended and granular sludges, were also analyzed by metagenomic sequencing, generating of total of 743 High-Completion Metagenome Assembled Genomes.","center":"Wageningen University and research Microbiology","data_type":"Other","submission_date":"2025/04/03 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA117871721",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evidence"],["SAMEA117871722",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evidence"],["SAMEA117871723",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evidence"],["SAMEA117871724",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evidence"],["SAMEA117871725",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evidence"],["SAMEA117871726",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evidence"],["SAMEA117871727",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"n