{"v":1,"accession":"PRJNA1431591","title":"Manganese Toxicity Reshapes Fungal Community in the Rhizosphere of Sugarcane and Impairs Nitrification and Nitrogen Utilization","description":"Sugarcane (Saccharum spp.) is an economically vital crop for sugar and bioethanol production. In southern China, sugarcane cultivated in acidic soils often exhibits severe leaf chlorosis due to excessive soil manganese (Mn). This study aimed to explore the effects of Mn toxicity on the physicochemical properties and fungal communities of sugarcane rhizosphere soil, as well as on sugarcane growth and nitrogen (N) uptake and utilization.","center":"Guangxi University","data_type":"Raw sequence reads","submission_date":"2026/03/03 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN56315043","T1_1.fastq.gz","uncertain",null,"2020-11-01",2020,null,null,null,null,"unresolved",null,null,null,"fungi",null,null,null,"environmental sample; urban association not established"],["SAMN56315044","T1_2.fastq.gz","uncertain",null,"2020-11-02",2020,null,null,null,null,"unresolved",null,null,null,"fungi",null,null,null,"environmental sample; urban association not established"],["SAMN56315045","T1_3.fastq.gz","uncertain",null,"2020-11-03",2020,null,null,null,null,"unresolved",null,null,null,"fungi",null,null,null,"environmental sample; urban association not established"],["SAMN56315046","T2_1.fastq.gz","uncertain",null,"2020-11-04",2020,null,null,null,null,"unresolved",null,null,null,"fungi",null,null,null,"environmental sample; urban association not established"],["SAMN56315047","T2_2.fastq.gz","uncertain",null,"2020-11-05",2020,null,null,null,null,"unresolved",null,null,null,"fungi",null,null,null,"environmental sample; urban association not established"],["SAMN563