{"v":1,"accession":"PRJNA1232257","title":"food watse","description":"In this study, a comprehensive survey of the microbial community in the food waste treatment park was carried out using high-throughput sequencing of 16S rRNA genes. A series of key microorganisms were successfully screened by analysing the microbial diversity of key facilities such as biofilter beds, deodorisation towers and anaerobic fermentation tanks. These microorganisms play an important role in the waste treatment process and are expected to provide technical support at the microbiological level for improving the quality and efficiency of the park. At present, we have accumulated 40 amplicon sequencing data from the above facilities, which lays a solid foundation for further optimising the microbial treatment process in the park.","center":"central south university","data_type":"Raw sequence reads","submission_date":"2025/03/05 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN47223449","Metagenome or environmental sample from wastewater metagenome","uncertain",null,"2024-07-30",2024,"CN","Hunan",null,null,"unresolved",28.13,112.57,"China:Hunan","wastewater",null,null,null,"environmental sample; urban association not established"],["SAMN47223450","Metagenome or environmental sample from wastewater metagenome","uncertain",null,"2024-07-30",2024,"CN","Hunan",null,null,"unresolved",28.13,112.57,"China:Hunan","wastewater",null,null,null,"environmental sample; urban association not established"],["SAMN47223451","Metagenome or environmental sample from wastewater metagenome","uncertain",null,"2024-07-30",2024,"CN","Hunan",null,null,"unresolved",28.13,112.57,"China:Hunan","wastewater",null,null,null,"environmental sample; urban association not established"],["S