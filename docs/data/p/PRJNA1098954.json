{"v":1,"accession":"PRJNA1098954","title":"Danish study on Aeromonas spp. from WWTP inlet to river outflow.","description":"Investigating the abundance, diversity, and antimicrobial resistance (AMR) profile of Aeromonas isolates in wastewater and receiving water bodies of Danish treatment plants, this study aims to evaluate the efficacy of culture-based methods in capturing their role in AMR dissemination. By comparing cultivation results with community-wide 16S RNA gene amplicon sequencing, we seek to determine the utility of Aeromonas-targeted cultivation in assessing AMR fluxes at wastewater/environment interfaces. Understanding the contribution of treatment plant discharges to the dissemination of antibiotic-resistant aeromonads into river water is important for assessing and mitigating AMR risks in aquatic environments","center":"University of Copenhagen","data_type":"Raw sequence reads","submission_date":"2024/04/11 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN40925300","Ejby Moelle WWTP inlet","confirmed_urban","municipal_wastewater","2022-06-08",2022,"DK",null,null,null,"unresolved",null,null,"Denmark","water",null,null,null,"named urban infrastructure at sample level"],["SAMN40925301","Ejby Moelle WWTP outlet","confirmed_urban","municipal_wastewater","2022-06-09",2022,"DK",null,null,null,"unresolved",null,null,"Denmark","water",null,null,null,"named urban infrastructure at sample level"],["SAMN40925302","Upstream discharge point Ejby Moelle WWTP","confirmed_urban","municipal_wastewater","2022-06-10",2022,"DK",null,null,null,"unresolved",null,null,"Denmark","water",null,null,null,"named urban infrastructure at sample level"],["SAMN40925303","Downstream discharge point Ejby Moelle WWTP","confirmed_urban","municipal_wa