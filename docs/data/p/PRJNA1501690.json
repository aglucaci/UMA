{"v":1,"accession":"PRJNA1501690","title":"A hybridization capture-based workflow for enhanced viral sequencing from wastewater","description":"Wastewater surveillance has become an essential approach for monitoring viruses in communities. Nevertheless, viral sequencing from wastewater remains challenging due to the low concentration and abundance of viruses, which constrains the performance of current methods. In this study, we developed a hybridization capture-based workflow to enhance viral sequencing from wastewater. By comparing different pretreatment strategies, we found that elevating viral abundance is critical for achieving sufficient coverage and depth. The optimized workflow effectively addresses low nucleic acid input and demonstrates reliable sequencing performance across a range of viruses. This work offers an efficient and robust technical solution to support genomic surveillance of viruses in wastewater.","center":"Tsinghua university","data_type":"Raw sequence reads","submission_date":"2026/07/25 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN61955461","DC-Control","probable_urban","municipal_wastewater","2024-02-07",2024,"CN","Beijing",1816670,"Beijing","verified",39.91,116.39,"China: Beijing","influent wastewater",null,null,null,"city-level location without sample-site confirmation"],["SAMN61955462","DC-Dnase","probable_urban","municipal_wastewater","2024-02-07",2024,"CN","Beijing",1816670,"Beijing","verified",39.91,116.39,"China: Beijing","influent wastewater",null,null,null,"city-level location without sample-site confirmation"],["SAMN61955463","FC- Control","probable_urban","municipal_wastewater","2024-02-07",2024,"CN","Beijing",1816670,"Beijing","verified",39.91,116.39,"China: Beijing","influent wastewat