{"v":1,"accession":"PRJNA635011","title":"An electrochemical membrane biofilm reactor for removing sulfonamides from wastewater","description":"Sulfonamides, such as sulfadiazine (SDZ), are frequently detected in water and wastewater, and their toxicity and persistence nature arouses much concern. In this study, a novel electrochemical membrane biofilm reactor (EMBfR) was developed for removing SDZ and suppressing the production of antibiotic resistance genes (ARGs). The presence of electric field significantly affected the microbial community, leading to the enrichment of potential aromatic-degrading microorganism (e.g., Rhodococcus accounting for 51.0% in EMBfR compared 10.0% in MBfR).","center":"Tongji University","data_type":"Raw sequence reads","submission_date":"2020/05/26 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN15015156","Metagenome or environmental sample from activated sludge metagenome","probable_urban","municipal_wastewater","2019-10-06",2019,"CN","Shanghai",1796236,"Shanghai","verified",31.28,121.5,"China: Shanghai","pilot-scale membrane bio-reactor",null,null,null,"city-level location without sample-site confirmation"],["SAMN15015157","Metagenome or environmental sample from activated sludge metagenome","probable_urban","municipal_wastewater","2019-10-06",2019,"CN","Shanghai",1796236,"Shanghai","verified",31.28,121.5,"China: Shanghai","pilot-scale membrane bio-reactor",null,null,null,"city-level location without sample-site confirmation"],["SAMN15015158","Metagenome or environmental sample from activated sludge metagenome","probable_urban","municipal_wastewater","2019-10-06",2019,"CN","Shanghai",1796236,"Shanghai","verified",31.28,121.5,"China: Shanghai","pilot-scale membrane bio-reactor",null,null,null,"ci