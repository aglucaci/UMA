{"v":1,"accession":"PRJNA1552810","title":"Multi-omics sequencing of sludge samples","description":"Using phenol in sulfate-rich wastewater as an electron donor to drive sulfate reduction is a promising waste-to-resource strategy, but its efficiency and stability remain constrained by limited understanding of how phenol-derived reducing equivalents are partitioned among microbial populations and metabolic pathways. Here, a long-term continuous-flow sulfate-reducing reactor was operated with phenol as the sole external electron donor, and batch inhibition experiments were integrated with genome-resolved metagenomics, meta-transcriptomics, and metabolomics.","center":"Shanxi University","data_type":"Raw sequence reads","submission_date":"2026/10/29 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN64520814","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2025-09-12",2025,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN64520815","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2025-09-13",2025,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN64520816","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2025-09-14",2025,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN64520817","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2025-09-15",2025,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN