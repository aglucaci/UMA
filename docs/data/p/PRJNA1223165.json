{"v":1,"accession":"PRJNA1223165","title":"Metagenomic analysis of coral-pyrite substrate electroactive constructed wetland","description":"We developed a coral sand-pyrite substrate E-CW system that accomplished simultaneous pollutants removal and OM sequestration. This system primarily harnessed the superior adsorption capabilities of coral sand, along with the iron redox cycling driven by associated microorganisms facilitated by pyrite, to enhance OM sequestration. Furthermore, the incorporation of the BES fostered the enrichment of EAB, which also constituted the main body of DIRB. This process promoted the degradation of OM and the biochemical transformation of iron oxides, thereby amplifying the effectiveness of OM sequestration.","center":"Chongqing University","data_type":"Raw sequence reads","submission_date":"2025/02/13 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN46800171","control1","uncertain",null,"2024-09-06",2024,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN46800173","control2","uncertain",null,"2024-09-06",2024,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN46800175","control3","uncertain",null,"2024-09-06",2024,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN46800177","test1","uncertain",null,"2024-09-06",2024,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN46800179","test2","uncertain",null,"2024-09-06",2024,null,null