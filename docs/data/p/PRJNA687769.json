{"v":1,"accession":"PRJNA687769","title":"Communities of active and inactive fractions of anammox consortia","description":"Deciphering active and dormant populations is crucial to the understanding of how microorganisms function in their native environment. In this study, we propose a rapid, sensitive and cost-effective approach to isolating and characterizing translationally active and inactive fractions of anammox consortia using a combination of bioorthogonal non-canonical amino acid tagging (BONCAT), fluorescence activated cell sorting (FACS) and 16S rRNA gene sequencing methods.","center":"Peking University","data_type":"Raw sequence reads","submission_date":"2020/12/24 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN17153986","anaerobic sludge","uncertain",null,"2020-10-30",2020,null,null,null,null,"unresolved",null,null,null,"sludge sample",null,null,null,"environmental sample; urban association not established"],["SAMN17153987","anaerobic sludge","uncertain",null,"2020-10-30",2020,null,null,null,null,"unresolved",null,null,null,"sludge sample",null,null,null,"environmental sample; urban association not established"],["SAMN17153988","anaerobic sludge","uncertain",null,"2020-10-30",2020,null,null,null,null,"unresolved",null,null,null,"sludge sample",null,null,null,"environmental sample; urban association not established"],["SAMN17153989","anaerobic sludge","uncertain",null,"2020-10-30",2020,null,null,null,null,"unresolved",null,null,null,"sludge sample",null,null,null,"environmental sample; urban association not established"],["SAMN17153990","anaerobic sludge","uncertain",null,"2020-10-30",2020,null,null,null,null,"unresolved",null,null,null,"sludge sample",null,null,null,"environmental sample; urban association not esta