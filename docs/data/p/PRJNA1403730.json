{"v":1,"accession":"PRJNA1403730","title":"Free Ammonia Disrupts Quorum Sensing-Mediated Metabolic Cooperation and Energy Homeostasis in Oxygenic Photogranules","description":"Free ammonia (FA) is widely recognized as a key inhibitor in biological nitrogen removal systems, yet its impacts are predominantly interpreted through a direct toxicity perspective. Here, we demonstrate that FA stress fundamentally reshapes microbial community function by reprogramming quorum sensing (QS), metabolic cooperation, and cellular energy allocation in oxygenic photogranules (OPGs).","center":"Chongqing University","data_type":"Raw sequence reads","submission_date":"2026/01/15 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN54686751","sludge","uncertain",null,"2025-02-28",2025,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN54686752","sludge","uncertain",null,"2025-04-03",2025,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN54686753","sludge","uncertain",null,"2025-05-07",2025,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN54686754","sludge","uncertain",null,"2025-06-13",2025,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR36863589","SAMN54686754","SRX31835962","WGS","OTHER","METAGENOMIC","SINGLE","ILLUM