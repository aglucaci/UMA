{"v":1,"accession":"PRJNA1338947","title":"Manganese Toxicity Impairs Soil Nitrification and Sugarcane Nitrogen Utilization by Inhibiting Rhizosphere Ammonia-Oxidizing Microorganisms","description":"Sugarcane (Saccharum spp.) is an economically vital crop cultivated primarily for sugar and bioethanol production. In southern China, sugarcane grown in acidic soils often exhibits severe leaf chlorosis due to excessive soil manganese (Mn) levels. However, the mechanisms by which Mn toxicity disrupts soil nitrogen (N) cycling, particularly the roles of ammonia-oxidizing bacteria (AOB) and archaea (AOA) in regulating nitrification and N availability for sugarcane remain underexplored.","center":"Guangxi University","data_type":"Raw sequence reads","submission_date":"2025/10/09 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN52588526","T1","uncertain",null,"2022-10-01",2022,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN52588527","T2","uncertain",null,"2022-10-02",2022,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN52588528","T3","uncertain",null,"2022-10-03",2022,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN52588529","T4","uncertain",null,"2022-10-04",2022,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN52588530","T5","uncertain",null,"2022-10-05",2022,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sa