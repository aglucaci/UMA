{"v":1,"accession":"PRJNA1143708","title":"The mechanisms of microalgal-bacterial granular sludge formation and application for aquaculture wastewater treatment","description":"In recent years, aquaculture wastewater discharge pollution has been widely concerned. Microalgal-bacterial system has been considered as one of the most promising methods to treat aquaculture wastewater with high concentration of COD, NH4+-N, PO43--P, and antibiotics. This study provided a novel insight into the advantage and potential of the optimized microalgal-bacterial granulation sludge in aquaculture wastewater treatment within salinity and antibiotic contamination.","center":"Sun Yat-sen University","data_type":"Raw sequence reads","submission_date":"2024/08/03 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN43017308","s0-1-1","non_urban",null,"2023-03-30",2023,"CN","Guangdong",1795565,"Shenzhen","probable",22.62,114.07,"China:Guangdong",null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN43017309","s0-1-2","non_urban",null,"2023-03-30",2023,"CN","Guangdong",1795565,"Shenzhen","probable",22.62,114.07,"China:Guangdong",null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN43017310","s0-1-3","non_urban",null,"2023-03-30",2023,"CN","Guangdong",1795565,"Shenzhen","probable",22.62,114.07,"China:Guangdong",null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN43017311","s0-2-1","non_urban",null,"2023-03-30",2023,"CN","Guangdong",1795565,"Shenzhen","probable",22.62,114.07,"China:Guangdong",null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN43017312","s0-2-2","non_urban",null,"2023-03-30",2023,"CN","Guangdong",1795565,"