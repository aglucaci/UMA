{"v":1,"accession":"PRJNA238951","title":"Saline wastewater Targeted Locus (Loci)","description":"Study was carried out in vitro treating domestic wastewater with a saline concentrate typical of that found in arid regions. The research objective is to determine the viability of applying brine backwash from water purification processes to septic wastewater systems in a domestic setting. Effects on microbial populations in septic wastewater is of concern and has not been explored. This study examines this aspect.","center":"New Mexico State University","data_type":"Targeted Locus (Loci)","submission_date":"2014/02/20 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN02647051","Environmental/Metagenome sample for wastewater metagenome","probable_urban","municipal_wastewater","2013-08-24",2013,"US","New Mexico",5475352,"Las Cruces","verified",32.2822,-106.757,"USA: Las Cruces, NM",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN02647052","Environmental/Metagenome sample for metagenome","probable_urban","municipal_wastewater","2013-08-24",2013,"US","New Mexico",5475352,"Las Cruces","verified",32.2822,-106.757,"USA: Las Cruces, NM",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN02647055","Environmental/Metagenome sample for wastewater metagenome","probable_urban","municipal_wastewater","2013-08-24",2013,"US","New Mexico",5475352,"Las Cruces","verified",32.2822,-106.757,"USA: Las Cruces, NM",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN02689079","Environmental/Metagenome sample for wastewater metagenome","probable_urban","municipal_wastewater","2013-08-24",2013,"US","New Mexico",5475352,"Las Cruces","verified",32.2822,-106.757,"USA: