{"v":1,"accession":"PRJNA1295377","title":"Deciphering the Metabolisms of Nitrogen and Carbon Driven by Alkaline Sludge Fermentation Liquor: Insights into Physiological Responses and Functional Genes","description":"In response to the global demand for carbon-neutral and energy-efficient wastewater treatment, this study explores the application of alkaline sludge fermentation liquor as a sustainable carbon and nitrogen source to drive partial nitrification-denitrification-anammox processes in real low C/N municipal sewage. The proposed strategy achieves ultra-high nitrogen removal efficiency (98.0%) in a single-stage sequencing batch reactor, addressing critical challenges in conventional biological nitrogen removal.","center":"Beijing University of Technology","data_type":"Raw sequence reads","submission_date":"2025/07/23 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN50168165","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater","2024-05-16",2024,"CN","Beijing",1816670,"Beijing","probable",null,null,"China: Beijing","reactor",null,null,null,"city-level location without sample-site confirmation"],["SAMN50168166","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater","2024-08-16",2024,"CN","Beijing",1816670,"Beijing","probable",null,null,"China: Beijing","reactor",null,null,null,"city-level location without sample-site confirmation"],["SAMN50168167","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater","2024-10-16",2024,"CN","Beijing",1816670,"Beijing","probable",null,null,"China: Beijing","reactor",null,null,null,"city-level location without sample-site confirmation"]],"run_cols