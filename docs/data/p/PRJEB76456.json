{"v":1,"accession":"PRJEB76456","title":"Discovery of V. cholerae in Copenhagen sewage","description":"We report the unexpected discovery of a persistance low abundance of Vibrio cholerae of a single wastewater treatment plant in  Copenhagen, Denmark at least since 2015. Remarkably, no environmental or locally transmitted clinical case of V. cholerae has been reported in Denmark for more than 100 years. This presence was initially overlooked during routine metagenomic analyses because of the low abundance and large mixing of false-positive reads. We, however, have recovered a near-complete genome out of 100+ sewage samples taken over the past 8 years. The  recovered genome lacks the gene responsible for cholerae toxin production. Our finding illustrates the importance, challenges and effectiveness of wastewater-based pathogen surveillance.","center":"Centre for Genomic Epidemiology, National Food Institute, Technical University of Denmark (DTU), Denmark","data_type":"Other","submission_date":"2024/06/12 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA115717951","DTU_2023_1016970_1_MG_RA_CPH_Sewage_1029","probable_urban","municipal_wastewater","2022-11-09",2022,"DK",null,null,null,"unresolved",null,null,"Denmark",null,null,null,null,"urban context stated at BioProject level only"],["SAMEA115717952","DTU_2023_1016975_1_MG_RA_CPH_Sewage_1040","probable_urban","municipal_wastewater","2022-12-09",2022,"DK",null,null,null,"unresolved",null,null,"Denmark",null,null,null,null,"urban context stated at BioProject level only"],["SAMEA115717953","DTU_2023_1016972_1_MG_RA_CPH_Sewage_1049","probable_urban","municipal_wastewater","2023-01-15",2023,"DK",null,null,null,"unresolved",null,null,"Denmark",null,null,null,null,"urban context stated 