{"v":1,"accession":"PRJNA1427297","title":"Airborne microbial metagenomes of Sudwala Caves, South Africa","description":"This project investigates the composition and functional potential of airborne microbial communities within Sudwala Caves, South Africa, using long-read PacBio HiFi metagenomic sequencing. Air samples were collected from multiple internal cave compartments and external reference sites across two seasonal periods and enriched prior to DNA extraction. Metagenomic sequencing data are accompanied by physicochemical air quality measurements, including particulate matter fractions, formaldehyde concentration, ambient temperature, and relative humidity. The resulting datasets provide a reference resource for studying airborne microbiomes in subterranean environments and support comparative analyses of microbial diversity, functional gene content, and environmental associations.","center":"University of South Africa","data_type":"Raw sequence reads","submission_date":"2026/02/23 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN55910676","Metagenome or environmental sample from metagenome","probable_urban","air_dust",null,2024,"ZA","Mpumalanga",null,null,"unresolved",-25.3699,30.6998,"South Africa: Mankelele Mountains, Mpumalanga Province","Cave: Air",null,null,null,"city-level location without sample-site confirmation"],["SAMN55910677","Metagenome or environmental sample from metagenome","probable_urban","air_dust",null,2024,"ZA","Mpumalanga",null,null,"unresolved",-25.3699,30.6998,"South Africa: Mankelele Mountains, Mpumalanga Province","Cave: Air",null,null,null,"city-level location without sample-site confirmation"],["SAMN55910678","Metagenome or environmental sample from metagenome","probable_urban","air_dust",nul