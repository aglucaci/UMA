{"v":1,"accession":"PRJNA807537","title":"shotgun sequencing for UASB reactor operated under different temperatures","description":"The sequencing results were from UASB reactors operated under room temperature(20 celsius), mesophilic (35 celsius) and thermophilic conditions (52 celsius). Under room temperature and mesophilic condition. One reactor was amened with granular activated carbon (GAC), and another was not and served as a control. The sequencing data sets were used to examine the dominant methanogens and fermenters under different temperatures. DNA were also extracted from GAC to differentiated the presence of biofilm formation related genes on GAC and suspended sludge.","center":"University of Alberta","data_type":"Raw sequence reads","submission_date":"2022/02/16 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN25995536","No-GAC sludge","probable_urban","municipal_wastewater",null,2020,"CA","Alberta",5946768,"Edmonton","verified",53.52,-113.52,"Canada: Edmonton",null,"wastewater biome","wastewater UASB reactor No GAC","suspended sludge","city-level location without sample-site confirmation"],["SAMN25995537","GAC sludge","probable_urban","municipal_wastewater",null,2020,"CA","Alberta",5946768,"Edmonton","verified",53.52,-113.52,"Canada: Edmonton",null,"wastewater biome","wastewater UASB reactor with GAC","suspended sludge","city-level location without sample-site confirmation"],["SAMN25995538","GAC biofilm","probable_urban","municipal_wastewater",null,2020,"CA","Alberta",5946768,"Edmonton","verified",53.52,-113.52,"Canada: Edmonton",null,"wastewater biofilm","wastewater UASB reactor with GAC","wastewater biofilm","city-level location without sample-site confirmation"],["SAMN48674740","Thermophilic No-GAC sludge","prob