{"v":1,"accession":"PRJNA1402763","title":"Antibiotic resistance surveillance in Indian Rivers and Wastewater Treatment plants","description":"The goal of this study is to investigate the diversity, abundance, and distribution of antimicrobial resistance genes (ARGs) in different aquatic matrices including riverine surface waters and wastewater treatment plants using shotgun metagenomic sequencing. The study aims to generate baseline data for environmental antimicrobial resistance surveillance and to evaluate fresh and wastewater ecosystems as potential reservoirs and dissemination pathways of resistance determinants under a One Health framework. This BioProject includes samples generated under the support of funding agencies like Ministry of Micro, Small, and Medium Enterprises and Department of Science &amp; Technology, Government of India as well as some samples were generated without any external funding as part of institutional research activities.","center":"National Institute of Technology Agartala","data_type":"Raw sequence reads","submission_date":"2026/01/14 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN54604951","Antibiotic resistance Surveillance in the Haora River, Tripura, India","probable_urban","water_drainage","2025-06-26",2025,"IN","Tripura",1279290,"Agartala","probable",23.8288,91.264,"India: Tripura, Haora River, Dashamighat",null,"freshwater biome","river","surface water","urban context stated at BioProject level only"],["SAMN54604952","Antibiotic resistance Surveillance in the Haora River, Tripura, India","probable_urban","water_drainage","2025-06-26",2025,"IN","Tripura",1279290,"Agartala","probable",23.8361,91.3086,"India: Tripura, Haora River, Chandrapur",null,"freshwater biome","river","surface water"