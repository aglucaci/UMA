{"v":1,"accession":"PRJDB44334","title":"Indoor dust microbiome profiling across residential and public microenvironments (PRJCA055034)","description":"This project provides 16S rRNA gene amplicon sequencing data for indoor dust samples collected from multiple microenvironments, including residences and public venues (e.g., offices and recreational spaces). The data are intended to characterize bacterial community composition and explore statistical associations between indoor chemical contamination profiles and dust microbiome patterns across different indoor settings. All sequence reads and associated sample metadata are deposited to support transparency and reproducibility of the microbiome analyses reported in the related study.","center":"South China Institute of Environmental Sciences, Ministry of Ecology and Environment","data_type":"Other","submission_date":"2026/10/28 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD01973996","S1 (SAMC6519194)","probable_urban","air_dust","2024-05-08",2024,null,null,null,null,"unresolved",null,null,"missing: data agreement established pre-2023","Indoor dust",null,null,null,"city-level location without sample-site confirmation"],["SAMD01973997","S2 (SAMC6519195)","probable_urban","air_dust","2024-05-08",2024,null,null,null,null,"unresolved",null,null,"missing: data agreement established pre-2023","Indoor dust",null,null,null,"city-level location without sample-site confirmation"],["SAMD01973998","S3 (SAMC6519196)","probable_urban","air_dust","2024-05-08",2024,null,null,null,null,"unresolved",null,null,"missing: data agreement established pre-2023","Indoor dust",null,null,null,"city-level location without sample-site confirmation"],["SAMD01973999","S4 (SAMC6519197)","probable_urban","air_