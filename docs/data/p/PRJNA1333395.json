{"v":1,"accession":"PRJNA1333395","title":"The Influence of Irisin on Gut Microbiota in Septic Mice","description":"The protective effects of irisin against lipopolysaccharide (LPS)-induced septic intestinal injury and its impact on gut microbiota in mice were investigated. The study demonstrated that irisin treatment significantly alleviated intestinal damage caused by LPS, including reduced inflammatory markers, improved intestinal permeability, and enhanced gut barrier function. Additionally, irisin was found to modulate the composition of the gut microbiota, promoting the growth of beneficial microbial populations while suppressing the expansion of harmful bacteria. These findings suggest that irisin may offer a therapeutic strategy for managing septic intestinal injury by targeting both the inflammatory response and gut microbiota.","center":"The Affiliated Hospital, Southwest Medical University","data_type":"Raw sequence reads","submission_date":"2025/09/23 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN51795117","1Contrl","uncertain",null,"2024-03-16",2024,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN51795118","2Contrl","uncertain",null,"2024-03-16",2024,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN51795119","3Contrl","uncertain",null,"2024-03-16",2024,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN51795120","4Contrl","uncertain",null,"2024-03-16",2024,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,nu