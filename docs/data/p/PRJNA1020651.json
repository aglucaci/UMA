{"v":1,"accession":"PRJNA1020651","title":"Microbial consortium from extremely effective sugar factory wastewater treatment plant","description":"The on-site wastewater treatment plant in Dobrzelin sugar factory is a closed system efficiently treating wastewater generated as a result of sugar production process in self-sustainable water circuit. Modernization efforts have been undertaken to enable the use of the resulting bio-methane for energy purposes in its entirety.In this study we characterize the microbial community from the Dobrzelin sugar factory wastewater treatment plant and indicate modernization efforts undertaken to enable its operation in self-sustainable energy and water circuits.","center":"Institute of Biochemistry and Biophysics Polish Academy of Sciences","data_type":"Raw sequence reads","submission_date":"2023/09/25 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN37527267","before_modernization 1","probable_urban","municipal_wastewater","2017-10-26",2017,"PL","Łódź Voivodeship",3079897,"Żychlin","probable",52.2273,19.6002,"Poland:Dobrzelin",null,"Waste treatment plant","[ENVO:00002043]","[ENVO:2000003]","city-level location without sample-site confirmation"],["SAMN37527268","before_modernization 2","probable_urban","municipal_wastewater","2017-10-26",2017,"PL","Łódź Voivodeship",3079897,"Żychlin","probable",52.2273,19.6002,"Poland:Dobrzelin",null,"Waste treatment plant","[ENVO:00002043]","[ENVO:2000003]","city-level location without sample-site confirmation"],["SAMN37527269","before_modernization 3","probable_urban","municipal_wastewater","2017-10-26",2017,"PL","Łódź Voivodeship",3079897,"Żychlin","probable",52.2273,19.6002,"Poland:Dobrzelin",null,"Waste treatment plant","[ENVO:00002043]","[ENVO:2000003]","c