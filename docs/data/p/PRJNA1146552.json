{"v":1,"accession":"PRJNA1146552","title":"Anode Potential Regulates the Gas Composition and Microbiome in Anaerobic Electrochemical Digestion","description":"Anaerobic electrochemical digestion (AED) is an effective system for recovering biogas from organic wastes. However, it is unclear how anode potentials affect the gas production in anaerobic activated sludge. Here, we conducted the research to explore how the anode potential affects the microbiome and gas composition. This study provides insights into the regulatory strategies of MEC technology during anaerobic digestion, which plays a decisive role in determining the composition of biogas.","center":"Nankai University","data_type":"Raw sequence reads","submission_date":"2024/08/09 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN43104350","sludge","probable_urban","municipal_wastewater","2023-12-20",2023,"CN","Tianjin",1792947,"Tianjin","verified",39.08,117.2,"China: Tianjin","reactor sample_1",null,null,null,"city-level location without sample-site confirmation"],["SAMN43104351","sludge","probable_urban","municipal_wastewater","2023-12-20",2023,"CN","Tianjin",1792947,"Tianjin","verified",39.08,117.2,"China: Tianjin","reactor sample_2",null,null,null,"city-level location without sample-site confirmation"],["SAMN43104352","sludge","probable_urban","municipal_wastewater","2023-12-20",2023,"CN","Tianjin",1792947,"Tianjin","verified",39.08,117.2,"China: Tianjin","reactor sample_3",null,null,null,"city-level location without sample-site confirmation"],["SAMN43104353","sludge","probable_urban","municipal_wastewater","2023-12-20",2023,"CN","Tianjin",1792947,"Tianjin","verified",39.08,117.2,"China: Tianjin","reactor sample_4",null,null,null,"city-level location without sample-sit