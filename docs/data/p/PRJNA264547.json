{"v":1,"accession":"PRJNA264547","title":"Laundry Machine Microbiome Targeted Locus (Loci)","description":"Household washing machines launder soiled clothes and textiles, but do not sterilize them. We investigated the microbial exchange streams occurring in five different household washing machines. Samples from a new cotton T-shirt were laundered together with a normal laundry load. Analysis was performed on the influent water and the ingoing cotton samples, as well as the greywater and the washed cotton samples.","center":"Helmholtz Zentrum Muenchen","data_type":"Targeted Locus (Loci)","submission_date":"2014/10/22 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN03135295","M2M7","probable_urban","built_environment","2012-09-27",2012,"BE","Flanders",2797656,"Gent","verified",null,null,"Belgium: Gent","Washing machine grey water","Laundry machine biome","Household","Greywater","city-level location without sample-site confirmation"],["SAMN03135296","M3M5","probable_urban","built_environment","2012-09-27",2012,"BE","Flanders",2783773,"Westrozebeke","verified",null,null,"Belgium: Westrozebeke","Washing machine grey water","Laundry machine biome","Household","Greywater","city-level location without sample-site confirmation"],["SAMN03135297","M3M18","probable_urban","built_environment","2012-09-27",2012,"BE","Flanders",2786777,"Sijsele","verified",null,null,"Belgium: Sijsele","Washing machine grey water","Laundry machine biome","Household","Greywater","city-level location without sample-site confirmation"],["SAMN03135298","M2M6","probable_urban","municipal_wastewater","2012-09-27",2012,"BE","Flanders",2797656,"Gent","verified",null,null,"Belgium: Gent","Influent water","Laundry machine biome","Household","Water","city-level location