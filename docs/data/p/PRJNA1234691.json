{"v":1,"accession":"PRJNA1234691","title":"Kitchen waste composting leachate stimulate endogenous simultaneous nitrifying and denitrifying pathways in WWTP","description":"Kitchen waste composting leachate (CL) is rich in organics with high potential of external carbon source for wastewater treatment plant (WWTP). This study investigated the effect of CL on simultaneous nitrifying and denitrifying accoupling with external carbon source by using sequencing batch reactors (SBRs). It shows that CL greatly promoted the removal rates of N and increased the relative abundance of the denitrification pathway with mixing ratio of no more than 1.5%.","center":"China Jiliang University","data_type":"Raw sequence reads","submission_date":"2025/03/11 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN47307605","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2023-07-12",2023,null,null,null,null,"unresolved",null,null,null,"CK SBR_1",null,null,null,"urban context stated at BioProject level only"],["SAMN47307606","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2023-07-12",2023,null,null,null,null,"unresolved",null,null,null,"CK SBR_2",null,null,null,"urban context stated at BioProject level only"],["SAMN47307607","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2023-07-26",2023,null,null,null,null,"unresolved",null,null,null,"CK SBR_3",null,null,null,"urban context stated at BioProject level only"],["SAMN47307608","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2023-07-26",2023,null,null,null,null,"unresolved",null,null,null,"CK SBR_4",nul