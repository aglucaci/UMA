{"v":1,"accession":"PRJNA994532","title":"Interactive effects of herbivory, nutrient enrichment, and temperature on coral reefs and their microbiomes in Moorea, French Polynesia","description":"This is the public repository for any sequencing data generated under NSF award OCE-2023424 granted to Deron E. Burkepile, Rebecca Vega Thurber, and Thomas C. Adam. This project is a long term factorial time series experiment on the Moorea, French Polynesia north shore, ongoing since July 2018. The project investigates the interactive effects of nutrient enrichment, herbivore and corallivore exclusion, and temperature on coral holobionts and benthic communities for both intact and initially disturbed communities. The project also investigates a recovery period from nutrient enrichment, which started in July 2022.","center":"Oregon State University","data_type":"Raw sequence reads","submission_date":"2023/07/13 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN36436801","MIMARKS Survey related sample from indoor metagenome","probable_urban","built_environment",null,2021,"US","Oregon",5720727,"Corvallis","verified",44.5663,-123.2829,"USA: Oregon State University, Corvallis, Oregon",null,"Research Laboratory","Reagent control","PCR water","city-level location without sample-site confirmation"],["SAMN36436802","MIMARKS Survey related sample from indoor metagenome","probable_urban","built_environment",null,2021,"US","Oregon",5720727,"Corvallis","verified",44.5663,-123.2829,"USA: Oregon State University, Corvallis, Oregon",null,"Research Laboratory","Reagent control","PCR water","city-level location without sample-site confirmation"],["SAMN36436803","MIMARKS Survey related sample from indoor metagenome","probable_urban","built_environment",null,