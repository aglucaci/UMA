{"v":1,"accession":"PRJNA1045714","title":"XQ-20231007-00089_A-20231024-00432","description":"Anaerobic ammonia oxidation granular sludge (AnGS) stands out as a highly promising technology for wastewater treatment. However, in the realm of municipal and industrial wastewater treatment facilities, where diverse nanoplastic pollutants such as polyethylene, polystyrene, and polypropylene abound, the specific impact of one of the most prevalent plastics, polystyrene nanoplastics (PS-NPs), remains underexplored. Consequently, our study aimed to meticulously assess the effects of 100 nm-sized PS-NPs at varying concentrations (0.1, 0.5, and 2 mg L-1) on the performance of the mainstream anammox reactors.","center":"Hangzhou Normal University","data_type":"Raw sequence reads","submission_date":"2023/11/27 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN38453668","P01","non_urban",null,"2023-07-24",2023,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN38453669","P11","non_urban",null,"2023-07-25",2023,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN38453670","P21","non_urban",null,"2023-07-26",2023,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN38453671","P31","non_urban",null,"2023-07-27",2023,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN38453672","P00","non_urban",null,"2023-07-28",2023,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"BioProject indicates an agricultural