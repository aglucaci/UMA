{"v":1,"accession":"PRJNA1264682","title":"Evolution of Plasmid-Harboring E. coli under Ciprofloxacin Stress","description":"This project contains genomic and transcriptomic data from Escherichia coli clones. The original E. coli strain was isolated from the environment and introduced with a plasmid. It was evolved under IC50 ciprofloxacin stress for 60 days. At the endpoint, highly resistant clones - either plasmid-harboring or plasmid-free - were randomly selected and subjected to whole-genome resequencing. Additionally, transcriptomic data were generated from two highly resistant clones after short-term exposure to IC50 ciprofloxacin.","center":"Zhejiang University","data_type":"Raw sequence reads","submission_date":"2025/05/18 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN53716723","metagenome of CIP1","non_environmental",null,null,2025,"CN","Zhejiang",1808926,"Hangzhou","verified",30.249,120.2052,"China:Hangzhou","Activated sludge under CIP stress in bioreactor CIP1",null,null,null,"laboratory or culture material"],["SAMN53716724","metagenome of CIP2","non_environmental",null,null,2025,"CN","Zhejiang",1808926,"Hangzhou","verified",30.249,120.2052,"China:Hangzhou","Activated sludge under CIP stress in bioreactor CIP2",null,null,null,"laboratory or culture material"],["SAMN53716725","metagenome of CIP3","non_environmental",null,null,2025,"CN","Zhejiang",1808926,"Hangzhou","verified",30.249,120.2052,"China:Hangzhou","Activated sludge under CIP stress in bioreactor CIP3",null,null,null,"laboratory or culture material"],["SAMN53716726","metagenome of CK1","non_environmental",null,null,2025,"CN","Zhejiang",1808926,"Hangzhou","verified",30.249,120.2052,"China:Hangzhou","Activated sludge without CIP stress in bioreactor CK1",nul