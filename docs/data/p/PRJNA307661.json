{"v":1,"accession":"PRJNA307661","title":"Microbial community from low-temperature anaerobic digestor treating synthetic sewage (raw sequence reads)","description":"Two granular sludges showing optimum performance on simple substrates at lower temperature (therefore previously acclimated and psychrotolerant) were chosen to seed a hybrid granular sludge bed fixed-film (fixed-film composed of granular pumice stone) treating reactor synthetic domestic sewage. In this experiment, the efficiency of long-term (732 days) cold (12°C) anaerobic treatment of this substrate was tested. The hydraulic retention time (HRT) was decreased from 36 to 8hr over the trial. The microbial community was assessed over the course of the trial in order to link process parameters to microbial community function.Our hypotheses were that high levels of P removal during AD would be achievable during high-rate treatment of synthetic sewage at low-temperature, in conjunction with highly efficient, low-temperature methanogenic biodegradation of the solid, colloidal and soluble fractions of a sewage wastewater: (i) at loading rates >1 kg total COD m-3 day-1; (ii) while producing an effluent quality of <125 mg total COD l-1; (iii) with microbial community development resulting in increased hydrolytic, acidogenic and methanogenic activity at low-temperatures.","center":"NUI Galway","data_type":"Raw sequence reads","submission_date":"2016/01/05 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN04384533","Seed inoculum biomass","non_environmental",null,"2010-06-14",2010,"IE","Connacht",2964180,"Galway","verified",53.2719,-9.0489,"Ireland: Galway","Low-temperature anaerobic bioreactor",null,null,null,"laboratory or culture material"],["SAMN04384534","Biomass from Phase 1","non_environmental",null,"2010-09-20",2010,"IE","Connacht",2964180,"Galway","verified",53.2719,-9.0489,"Ireland: Galway","Low-temperature anaerobic bioreactor",null,null,null,"laboratory or culture material"],["SAMN04384535","Biomass from Phase 3","non_environmental",null,"2011-04-04",2011,"IE","Connacht",2964180,"Galway","verified",53.2719,-9.0489,"Ireland: Galway","Low-temperature anaerobic bioreactor",null,null,null,"laboratory or culture material"],["SAMN04384536","Biomass from Phase 4A.c","non_environmental",null,"2011-09-03",2011,"IE","Connacht",2964180,"Galway","verified",53.2719,-9.0489,"Ireland: Galway","Low-temperature anaerobic bioreactor",null,null,null,"laboratory or culture material"],["SAMN04384537","Biomass from the end of the trail","non_environmental",null,"2012-06-14",2012,"IE","Connacht",2964180,"Galway","verified",53.2719,-9.0489,"Ireland: Galway","Low-temperature anaerobic bioreactor",null,null,null,"laboratory or culture material"],["SAMN04384538","Pumice stone filter","non_environmental",null,"2012-06-15",2012,"IE","Connacht",2964180,"Galway","verified",53.2719,-9.0489,"Ireland: Galway","Low-temperature anaerobic bioreactor",null,null,null,"laboratory or culture material"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR3096666","SAMN04384533","SRX1526958","WGS","Tn-Seq","METAGENOMIC","SINGLE","ILLUMINA","Illumina MiSeq",21090817,70491,"2016-01-19","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos12/sra-pub-zq-1211/SRR003/096/SRR3096666/SRR3096666.sralite.1"],["SRR3096668","SAMN04384534","SRX1534157","WGS","Tn-Seq","METAGENOMIC","SINGLE","ILLUMINA","Illumina MiSeq",11222982,37509,"2016-04-01","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos12/sra-pub-zq-1211/SRR003/096/SRR3096668/SRR3096668.sralite.1"],["SRR3096670","SAMN04384535","SRX1534158","WGS","Tn-Seq","METAGENOMIC","SINGLE","ILLUMINA","Illumina MiSeq",13447969,4