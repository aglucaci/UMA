{"v":1,"accession":"PRJNA1431916","title":"Shotgun metagenomes of extracellular vesicle-associated DNA from municipal wastewater treatment plant effluents","description":"This BioProject provides shotgun metagenomic sequencing data generated from DNA extracted from extracellular vesicles (EVs) isolated from municipal wastewater treatment plant process effluent samples. EVs were recovered from wastewater using size-based filtration and/or centrifugation-based concentration, followed by EV-associated DNA extraction. The purpose of this dataset is to characterize the taxonomic composition and functional gene content (including antibiotic resistance genes) associated with EV DNA in treated wastewater. The raw sequence reads are deposited in the Sequence Read Archive (SRA) to support reuse in environmental microbiome, wastewater surveillance, and resistome studies.","center":"Inner Mongolia University","data_type":"Raw sequence reads","submission_date":"2026/03/04 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN56331214","extracellular vesicles (EVs) isolated from raw wastewater (influent)","probable_urban","municipal_wastewater",null,2025,"CN","Inner Mongolia",2036892,"Hohhot","verified",40.8426,111.7492,"China: Inner Mongolia, Hohhot",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN56331215","extracellular vesicles (EVs) isolated from AAO process effluent","probable_urban","municipal_wastewater",null,2025,"CN","Inner Mongolia",2036892,"Hohhot","verified",40.8426,111.7492,"China: Inner Mongolia, Hohhot",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN56331216","extracellular vesicles (EVs) isolated from secondary sedimentation effluent","probable_urban","municipal_