{"v":1,"accession":"PRJDB18087","title":"Characterization of Microbial Communities and Antimicrobial Resistance Genes in Urban Wastewater in Different Cities in Vietnam","description":"The inappropriate usage of antibiotics is accelerating the prevalence of antimicrobial resistant bacteria (ARB) and antimicrobial resistance genes (ARGs) in Vietnam. Wastewater surveillance is a promising approach to monitor the status of ARB and ARGs in urban cities. Domestic wastewater samples were collected from three major cities (Hanoi, Hai Phong, and Bac Ninh) in northern Vietnam in November 2022. Microbial communities were characterized using 16S rRNA gene amplicon sequencing. To enrich carbapenem resistant bacteria, domestic wastewater samples were further enriched with 4 mg/L of meropenem in tryptic soy broth overnight. PCR screening revealed that the enriched cultures had clinically important carbapenemase genes.","center":"The University of Tokyo","data_type":"Other","submission_date":"2024/05/14 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00777081","Wastewater collected from To Lich river","probable_urban","municipal_wastewater","2022-11-22",2022,"VN","Hanoi",8616121,"Đống Đa","verified",null,null,"Viet Nam:Hanoi, Dong Da","wastewater",null,null,null,"urban context stated at BioProject level only"],["SAMD00777082","Wastewater collected from Kim Nguu river","probable_urban","municipal_wastewater","2022-11-22",2022,"VN","Hanoi",8616127,"Hai Bà Trưng","verified",null,null,"Viet Nam:Hanoi, Hai Ba Trung","wastewater",null,null,null,"urban context stated at BioProject level only"],["SAMD00777083","Influent from wastewater treatment plant in Bac Ninh","confirmed_urban","municipal_wastewater","2022-11-22",2022,"VN","Bac Ninh",1591449,"Bắc