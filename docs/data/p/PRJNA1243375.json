{"v":1,"accession":"PRJNA1243375","title":"Dissolved oxygen control in photosynthetic-oxygen supported algal-bacterial granule","description":"Algal-bacterial granule (ABG) process is a promising biotechnology for carbon emission reduction, especially for photosynthetic O2-supported ABG (POS-ABG) systems without mechanical aeration. However, the roles of dissolved oxygen (DO) generated by coexisting algae remain unclear in this POS-ABG system. This study aimed to explore the effects of different DO control levels (0.5-1.0, 1.0-1.5, 2.0-2.5 mg/L) on POS-ABG system performance, in which DO levels were automatically controlled via a feedback control unit between DO concentration and light duration.","center":"Shanghai Academy of Environmental Sciences","data_type":"Raw sequence reads","submission_date":"2025/03/28 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN47619291","Sludge","uncertain",null,"2023-03-20",2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN47619292","Sludge","uncertain",null,"2023-03-20",2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN47619293","Sludge","uncertain",null,"2023-03-20",2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN47619294","Sludge","uncertain",null,"2023-03-20",2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN47619295","Sludge","uncertain",null,"2023-03-20",2023,null,null,null,null,"unresolved",nul