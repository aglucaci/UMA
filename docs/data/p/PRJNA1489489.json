{"v":1,"accession":"PRJNA1489489","title":"Aerobic biotransformation of 8 2 FTCA in activated sludge Carbon source dependence and multiple transformation pathways","description":"8 2 fluorotelomer carboxylic acid, an alternative for PFOA, is detected across various environmental matrices and biota. However, the mechanisms underlying its aerobic biodegradation are not fully elucidated. In this study, 30 day microcosm experiments were conducted to investigate the degradation kinetics, transformation pathways, and microbial mechanisms of 8 2 FTCA in activated sludge, comparing its metabolic fate under carbon-limited and carbon-amended conditions.","center":"Zhejiang University","data_type":"Raw sequence reads","submission_date":"2026/07/03 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN61351275","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2025-04-10",2025,"CN","Zhejiang",1808926,"Hangzhou","probable",30.24,120.21,"China: Zhejiang","sludge_1",null,null,null,"environmental sample; urban association not established"],["SAMN61351276","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2025-05-10",2025,"CN","Zhejiang",1808926,"Hangzhou","probable",30.24,120.21,"China: Zhejiang","sludge_2",null,null,null,"environmental sample; urban association not established"],["SAMN61351277","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2025-05-10",2025,"CN","Zhejiang",1808926,"Hangzhou","probable",30.24,120.21,"China: Zhejiang","sludge_3",null,null,null,"environmental sample; urban association not established"],["SAMN61351278","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2025-05-10",2025,"CN","Zhejiang",1808926,"Hangzhou","pr