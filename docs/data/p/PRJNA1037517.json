{"v":1,"accession":"PRJNA1037517","title":"Unveiling the hidden diversity and functional role of Chloroflexota in full-scale wastewater treatment plants through genome-centric analyses","description":"The phylum Chloroflexota has been found to exhibit high abundance in wastewater treatment plants (WWTPs). However, its metabolic role has not been fully explored due to the lack of cultured isolates. To address this gap, we report the taxonomic analysis of 314 dereplicated, medium- and high-quality metagenome-assembled genomes (MAGs)","center":"Biological Research Institute \"Clemente Estable\"","data_type":"Raw sequence reads","submission_date":"2023/11/09 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN38182211","RH9","probable_urban","municipal_wastewater",null,null,null,null,null,null,"unresolved",20.42,-100.27,"Uruguay:Montevideo","activated sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN38182212","RH10","probable_urban","municipal_wastewater",null,null,null,null,null,null,"unresolved",20.42,-100.27,"Uruguay:Montevideo","activated sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN38182213","CO1","probable_urban","municipal_wastewater",null,null,null,null,null,null,"unresolved",20.42,-100.27,"Uruguay:Montevideo","activated sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN38182214","CO2","probable_urban","municipal_wastewater",null,null,null,null,null,null,"unresolved",20.42,-100.27,"Uruguay:Montevideo","activated sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN38182215","MO4","non_environmental",null,null,null,null,null,null,null,"unresolved",20.42,-100.27,"Uruguay:Montevideo","Metha