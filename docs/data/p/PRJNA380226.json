{"v":1,"accession":"PRJNA380226","title":"Microbial diversity (16S rRNA gene) at different stages of a wastewater treatment plant","description":"Unveiling the relationships between bacterial populations and ARGs variations over wastewater treatment may contribute to improve the processes and, therefore, ARG control. In this study, conducted at a full-scale UWTP, the bacterial community and ARGs variations as well as the associations between both were characterized over treatment. Bacterial community composition (16S rRNA Illumina sequencing) and ARGs abundance (real-time PCR) were characterized in raw wastewater, secondary effluent and after UV disinfection samples.","center":"ESB-UCP","data_type":"Targeted loci environmental","submission_date":"2017/03/23 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN06640824","Metagenome or environmental sample from wastewater metagenome","confirmed_urban","municipal_wastewater","2015-06-16",2015,"PT","Porto",2735943,"Porto","verified",41.1746,-8.6115,"Portugal: Porto","wastewater treatment plant",null,null,null,"named urban infrastructure at sample level"],["SAMN06640825","Metagenome or environmental sample from wastewater metagenome","confirmed_urban","municipal_wastewater","2015-07-14",2015,"PT","Porto",2735943,"Porto","verified",41.1746,-8.6115,"Portugal: Porto","wastewater treatment plant",null,null,null,"named urban infrastructure at sample level"],["SAMN06640826","Metagenome or environmental sample from wastewater metagenome","confirmed_urban","municipal_wastewater","2015-09-15",2015,"PT","Porto",2735943,"Porto","verified",41.1746,-8.6115,"Portugal: Porto","wastewater treatment plant",null,null,null,"named urban infrastructure at sample level"],["SAMN06640827","Metagenome or environ