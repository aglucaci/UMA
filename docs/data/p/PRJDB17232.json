{"v":1,"accession":"PRJDB17232","title":"16S rRNA gene sequencing, bacterial diversity in surface water samples.","description":"We conducted amplicon sequencing analysis, targeting full-length 16S rRNA genes, on various surface water samples. The primary goal was to elucidate the bacterial community composition and identify potential pathogenic bacteria. The MinION MK1b sequencing platform from Oxford Nanopore Technologies (ONT) was utilized, and the DNA library was prepared using the SQK-16S024 kit (ONT). Raw sequencing data in fast5 format were basecalled using Guppy v.5.0.16 (ONT) with the super high accuracy mode and a Q-score threshold of 10.","center":"Urban Sanitary Department of Environmental Engineering Graduate School of Engineering, Kyoto University","data_type":"Targeted Locus (Loci)","submission_date":"2024/02/06 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00731736","Sewage effluent collected at 2021-10-25","confirmed_urban","municipal_wastewater","2021-10-25",2021,"JP","Kyoto",1857910,"Kyoto","probable",null,null,"Japan:Kyoto",null,"freshwater biome [ENVO:00000873]","wastewater treatment plant [ENVO:00002043]","treated wastewater [ENVO:06105268]","named urban infrastructure at sample level"],["SAMD00731739","Sewage effluent collected at 2021-11-15","confirmed_urban","municipal_wastewater","2021-11-15",2021,"JP","Kyoto",1857910,"Kyoto","probable",null,null,"Japan:Kyoto",null,"freshwater biome [ENVO:00000873]","wastewater treatment plant [ENVO:00002043]","treated wastewater [ENVO:06105268]","named urban infrastructure at sample level"],["SAMD00731743","Sewage effluent collected at 2021-11-29","confirmed_urban","municipal_wastewater","2021-11-29",2021,"JP","Kyoto",1857910,"Kyoto","probable",null,null,"Japan:Kyot