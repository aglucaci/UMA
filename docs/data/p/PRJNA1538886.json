{"v":1,"accession":"PRJNA1538886","title":"16S rRNA gene profiling of aerobic granular sludge in reactors treating rare-earth tailwater","description":"This study characterizes bacterial communities in aerobic granular sludge from four laboratory sequencing batch reactors (R1-R4) used to evaluate the treatment of rare-earth tailwater. At the end of reactor operation, three sludge samples were independently collected from each reactor, yielding 12 samples in total. Sampling was conducted on 29 April 2026 at Jiangxi University of Science and Technology in Ganzhou, Jiangxi, China. The V3-V4 region of the bacterial 16S rRNA gene was amplified using primers 338F and 806R and subjected to paired-end sequencing. This project provides the raw sequencing reads to support characterization and comparison of bacterial communities among the four reactors.","center":"Jiangxi University of Science and Technology","data_type":"Raw sequence reads","submission_date":"2026/10/04 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN63971788","AGS sample R1_1","probable_urban","municipal_wastewater","2026-04-29",2026,"CN","Jiangxi",1810638,"Ganzhou","probable",null,null,"China: Jiangxi, Ganzhou","aerobic granular sludge from reactor R1, independent sample 1",null,null,null,"city-level location without sample-site confirmation"],["SAMN63971789","AGS sample R1_2","probable_urban","municipal_wastewater","2026-04-29",2026,"CN","Jiangxi",1810638,"Ganzhou","probable",null,null,"China: Jiangxi, Ganzhou","aerobic granular sludge from reactor R1, independent sample 2",null,null,null,"city-level location without sample-site confirmation"],["SAMN63971790","AGS sample R1_3","probable_urban","municipal_wastewater","2026-04-29",2026,"CN","Jiangxi",1810638,"Ganzhou","