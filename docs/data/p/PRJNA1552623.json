{"v":1,"accession":"PRJNA1552623","title":"Study on the Removal of Quinolone Antibiotics from Water by Microorganisms Immobilized on Polyurethane Carriers","description":"Quinolone antibiotics are widely present in various water bodies and resistant to natural degradation, making effective treatment urgent. Immobilized biological technology shows significant potential for low-concentration pollutant removal, but optimal operating conditions and microbial mechanisms under different environmental factors remain insufficiently understood. In this study, polyurethane (PU) was employed as a carrier to investigate the removal efficiency of quinolone antibiotics (ciprofloxacin, norfloxacin, and enoxacin) and the underlying evolution of microbial communities.","center":"NJU","data_type":"Raw sequence reads","submission_date":"2026/10/29 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN64511604","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2024-05-10",2024,"CN","Jiangsu",1799962,"Nanjing","verified",32.1196,118.9584,"China: Nanjing","sludge derived resin attached biofilm metagenome",null,null,null,"city-level location without sample-site confirmation"],["SAMN64511605","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2024-05-10",2024,"CN","Jiangsu",1799962,"Nanjing","verified",32.1196,118.9584,"China: Nanjing","sludge derived resin attached biofilm metagenome",null,null,null,"city-level location without sample-site confirmation"],["SAMN64511606","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2024-05-10",2024,"CN","Jiangsu",1799962,"Nanjing","verified",32.1196,118.9584,"China: Nan