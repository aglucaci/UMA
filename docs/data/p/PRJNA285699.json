{"v":1,"accession":"PRJNA285699","title":"Bacterial 16S rRNA gene amplicon 454 pyrosequencing of municipal wastewater treatment plant effluent samples Raw sequence reads","description":"The goal of this study was to establish basic knowledge regarding the persistenceof microbial communities, focusing on standard bacterial fecal indicators and Bacteroidetes genetic microbial source tracking markers in municipal wastewaterin order to evaluate their suitability for automated sampling. Secondary treated wastewater of municipal origin from a representative and well-characterizedbiological WWTP without disinfection (organic carbon and nutrient removal) was investigated in microcosm experiments at 5and 21°C. The main focus of the experiments was on persistence with a total storage time of 32 h (including a 24-h autosampling component and an 8-h postsampling phase). Additionally, some points of observation were also selected at incubation times of >32 h (up to 264 h) to achieve a reference for longer-term storage.","center":"Interuniversity Cooperation Centre Water & Health","data_type":"Raw sequence reads","submission_date":"2015/06/02 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN03757643","MIMARKS Survey related sample from wastewater metagenome","confirmed_urban","municipal_wastewater","2011-11-24",2011,"AT",null,null,null,"unresolved",null,null,"Austria",null,"municipal wastewater treatment plant effluent","secondary treated wastewater without disinfection","wastewater","explicit urban setting at sample level"],["SAMN03757644","MIMARKS Survey related sample from wastewater metagenome","confirmed_urban","municipal_wastewater","2011-11-24",2011,"AT",null,null,null,"unresolved",null,null,"Austria",null,"municipal wastewater treatme