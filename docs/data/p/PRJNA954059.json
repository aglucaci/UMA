{"v":1,"accession":"PRJNA954059","title":"Information storage across a microbial community using universal RNA barcoding","description":"A synthetic catalytic RNA was used to write information in conserved 16S ribosomal RNA (rRNA) sequences about gene transfer host range. By reading out native and modified rRNA using amplicon sequencing, we were able to simultaneously determine the composition of a microbial community, identify the members that participate in conjugation, and observe differences in information storage across amplicon sequence variants. This sensitive, autonomous, and reversible RNA-addressable memory (RAM) will enable cellular programming and biosurveillance across communities within diverse ecological settings and fundamental studies that examine the environmental controls on conjugation, transduction, and transformation.","center":"Rice University","data_type":"Raw sequence reads","submission_date":"2023/04/10 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN34133563","Barcoded 16S rRNA","confirmed_urban","municipal_wastewater","2022-03-08",2022,"US","Texas",4699066,"Houston","verified",29.7,-95.42,"USA: Houston, West University Wastewater Treatment Plant",null,"Wastewater Treatment Plant [ENVO:00002043]","Wastewater Treatment Plant [ENVO:00002043]","Mixed Liquor [ENVO:00002043]","named urban infrastructure at sample level"],["SAMN34133564","Barcoded 16S rRNA","confirmed_urban","municipal_wastewater","2022-03-08",2022,"US","Texas",4699066,"Houston","verified",29.7,-95.42,"USA: Houston, West University Wastewater Treatment Plant",null,"Wastewater Treatment Plant [ENVO:00002043]","Wastewater Treatment Plant [ENVO:00002043]","Mixed Liquor [ENVO:00002043]","named urban infrastructure at sample level"],["SAMN341335