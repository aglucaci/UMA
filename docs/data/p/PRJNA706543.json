{"v":1,"accession":"PRJNA706543","title":"Microbial community during bioaugmentation  in a wastewater treatment reactor","description":"The carbon nitrogen ratio of urban sewage is usually low, and the carbon source is relatively insufficient for the process of denitrification in urban sewage treatment plants. To enhance the efficiency of traditional denitrification at low carbon nitrogen ratios, a strain of denitrifying bacteria, Pseudomonas sp., was isolated from activated sludge at a sewage treatment plant in Xiamen. At low carbon nitrogen ratio, Pseudomonas sp. showed excellent denitrification ability.","center":"National Research Centre (Egypt) & Institute of Urban Environment (China)","data_type":"Raw sequence reads","submission_date":"2021/03/04 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN18137752","Metagenome or environmental sample from bioreactor metagenome","non_environmental",null,null,2018,"CN","Fujian",1790645,"Xiamen","probable",24.6108,118.058,"China: Fujian Province, laboratory","Reactor1_s1",null,null,null,"laboratory or culture material"],["SAMN18137753","Metagenome or environmental sample from bioreactor metagenome","non_environmental",null,null,2018,"CN","Fujian",1790645,"Xiamen","probable",24.6108,118.058,"China: Fujian Province, laboratory","Reactor1_s2",null,null,null,"laboratory or culture material"],["SAMN18137754","Metagenome or environmental sample from bioreactor metagenome","non_environmental",null,null,2018,"CN","Fujian",1790645,"Xiamen","probable",24.6108,118.058,"China: Fujian Province, laboratory","Reactor1_s3",null,null,null,"laboratory or culture material"],["SAMN18137755","Metagenome or environmental sample from bioreactor metagenome","non_environmental",null,null,2018,"CN","Fujian",1790