{"v":1,"accession":"PRJNA1072816","title":"Microbial Indicators of Latent Dampness (MOLD)","description":"The aim of the Microbial Indicators of Latent Dampness (MOLD) was to test the utility of DNA-based (i.e., species, etc.) versus RNA-based approaches to identification of dampness and mold growth. House dust was solicited from across the United States and incubated in chambers at different relative humidity levels (i.e., 50%, 85%, and 100%) for one week. Both DNA and RNA were extracted from incubated dusts and then sequenced. Analyses were conducted to 1) compare efficacy of DNA versus RNA-based approaches and 2) to identify RNA targets potentially useful for detection of mold growth in buildings.","center":"The Ohio State University","data_type":"Raw sequence reads","submission_date":"2024/02/02 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN39753216","Metagenome or environmental sample from dust metagenome","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"House dust",null,null,null,"environmental sample; urban association not established"],["SAMN39753217","Metagenome or environmental sample from dust metagenome","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"House dust",null,null,null,"environmental sample; urban association not established"],["SAMN39753218","Metagenome or environmental sample from dust metagenome","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"House dust",null,null,null,"environmental sample; urban association not established"],["SAMN39753219","Metagenome or environmental sample from dust metagenome","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"House dust",null,null,null,"environmental samp