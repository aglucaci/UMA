{"v":1,"accession":"PRJNA1328428","title":"Microbial community in anaerobic wastewater treatment with electrogenerated iron carbonate","description":"This project investigates microbial community composition in upflow anaerobic sludge blanket (UASB) reactors treating domestic wastewater with and without electrogenerated iron carbonate (FeCO3). Using 16S rRNA sequencing, we profiled microbial dynamics under different FeCO3 doses to understand how sulfide and phosphate removal strategies influence anaerobic digestion performance and biogas quality.","center":"The University of Queensland","data_type":"Raw sequence reads","submission_date":"2025/09/15 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN51335504","CUASB 40 dose 1","uncertain",null,null,2023,"AU","Queensland",2174003,"Brisbane","verified",-27.4977,153.0129,"Australia: Brisbane","WWTP and domestic wastewater",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN51335505","CUASB 40 dose 2","uncertain",null,null,2023,"AU","Queensland",2174003,"Brisbane","verified",-27.4977,153.0129,"Australia: Brisbane","WWTP and domestic wastewater",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN51335506","CUASB 40 dose 3","uncertain",null,null,2023,"AU","Queensland",2174003,"Brisbane","verified",-27.4977,153.0129,"Australia: Brisbane","WWTP and domestic wastewater",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN51335507","EUASB 40 dose 1","uncertain",null,null,2023,"AU","Queensland",2174003,"Brisbane","verified",-27.4977,153.0129,"Australia: Brisbane","WWTP and domestic wastewater",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN51335508","EUASB 40 dose 2","uncertain",null