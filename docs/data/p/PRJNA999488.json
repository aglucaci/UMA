{"v":1,"accession":"PRJNA999488","title":"Hospital wastewater metagenome- the impact of wastewater disinfection on the wastewater microbiome and resistome","description":"The project aims to completely understand the metagenome of hospital wastewater and to determine the effect of chemical disinfection (chlorination) on changes in the metagenome of hospital wastewater. The results will indicate whether hospital wastewater is a reservoir of ARGs and groups of microorganisms with an increased hazardous and importance status.The research will help to better understand the nature and threats posed by hospital wastewater and itsdisinfection. The results could increase the significance of hospital wastewater analysis as an alternativeprogram to monitor specific microbial resistance mechanisms within individual medical units, regions or countries.","center":"Uniwersytet Warminsko-Mazurski w Olsztynie","data_type":"Raw sequence reads","submission_date":"2023/07/28 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN36736192","hospital wastewater metagenome: untreated M2_1","probable_urban","municipal_wastewater","2021-04-20",2021,"PL","Warmia-Masuria",763166,"Olsztyn","verified",53.77,20.48,"Poland:Olsztyn",null,"hospital wastewater metagenome","untreated hospital wastewater","Wastewater","city-level location without sample-site confirmation"],["SAMN36736193","hospital wastewater metagenome: untreated M2_2","probable_urban","municipal_wastewater","2021-08-24",2021,"PL","Warmia-Masuria",763166,"Olsztyn","verified",53.77,20.48,"Poland:Olsztyn",null,"hospital wastewater metagenome","untreated hospital wastewater","Wastewater","city-level location without sample-site confirmation"],["SAMN36736194","hospital wastewater metagenome: untreated M2_