{"v":1,"accession":"PRJNA1083991","title":"Impact of Nitrate Dosing and Conductive Media on Anaerobic Fluidised-bed Treatment of Low-Strength Wastewater","description":"The purpose of this study is to study the chemical and biological impacts of nitrate dosing on anaerobic fluidised-bed reactors treating a low-strength synthetic wastewater. To do so, two lab-scale reactors were operated, one containing non-conductive PVDF media, the other containing the same media with a polyaniline coating applied. Samples were taken at two time points from both the media biofilm and the bulk suspension from each reactor. This study forms part of a PhD thesis of the same title.","center":"Imperial College London","data_type":"Raw sequence reads","submission_date":"2024/03/05 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN40265679","GR1P1biofilm","uncertain",null,"2023-03-02",2023,"GB","England",2643743,"London","probable",51.5,-0.18,"United Kingdom","biofilm of conductive media",null,null,null,"environmental sample; urban association not established"],["SAMN40265680","GR1P1bulk","uncertain",null,"2023-03-02",2023,"GB","England",2643743,"London","probable",51.5,-0.18,"United Kingdom","bulk suspension of conductive reactor",null,null,null,"no environmental-sample evidence"],["SAMN40265681","GR1P2biofilm","uncertain",null,"2023-06-07",2023,"GB","England",2643743,"London","probable",51.5,-0.18,"United Kingdom","biofilm of conductive media",null,null,null,"environmental sample; urban association not established"],["SAMN40265682","GR1P2bulk","uncertain",null,"2023-06-07",2023,"GB","England",2643743,"London","probable",51.5,-0.18,"United Kingdom","bulk suspension of conductive reactor",null,null,null,"no environmental-sample evidence"],["SAMN4026568