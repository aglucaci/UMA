{"v":1,"accession":"PRJNA1499387","title":"Long-term humic substances exposure favoring chain elongation rather than methanogenesis during anaerobic digestion","description":"This project investigates the effects of fulvic acid (FA) and humic acid (HA) on anaerobic digestion using a lab-scale IC reactor. Results show that FA/HA exposure redirects carbon flow from methanogenesis to chain elongation, promoting caproic acid production while suppressing methane yield. Microbial community and metagenomic analyses reveal enrichment of chain-elongating bacteria and suppression of methanogenesis pathways. These findings provide insights into resource recovery from humic-rich landfill leachate. 16S rRNA data are included.","center":"Jiangnan University","data_type":"Raw sequence reads","submission_date":"2026/07/23 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN61877904","sludge","non_urban",null,"2023-09-01",2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN61877905","sludge","non_urban",null,"2023-10-01",2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN61877906","sludge","non_urban",null,"2013-11-01",2013,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN61877907","sludge","non_urban",null,"2023-12-01",2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN61877908","sludge","non_urban",null,"2024-01-01",2024,null,null,null,null,"unresolved",