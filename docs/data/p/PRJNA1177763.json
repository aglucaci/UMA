{"v":1,"accession":"PRJNA1177763","title":"Identification of Wastewater Treatment Plant-Specific Microbial Markers Using 16S rRNA Sequencing","description":"We collected 57 effluent samples for 16S rRNA v4 sequencing from six treatment plants in the Tampere region of Finland between 2016 and 2018. Characterising the microbiome revealed that although each plant had unique microbial profiles, their overall diversity and richness were similar. This provided a robust foundation for identifying plant-specific microbes. Using ANOVA-F for feature selection, we focused on the genus level due to its informative prevalence. Among various models tested, the Gaussian Naive Bayes model yielded the highest accuracy with the fewest relevant microbes. We identified nine bacterial genera and one archaeon, whose relative abundances predicted the origin of the effluent with 92% accuracy.","center":"Tampere University","data_type":"Raw sequence reads","submission_date":"2024/10/25 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN44450032","Wastewater effluent WWTP2","probable_urban","municipal_wastewater","2018-07-04",2018,"FI","Pirkanmaa",634963,"Tampere","probable",61.49,23.76,"Finland: Pirkanmaa","Wastewater effluent",null,null,null,"city-level location without sample-site confirmation"],["SAMN44450033","Wastewater effluent WWTP2","probable_urban","municipal_wastewater","2018-08-15",2018,"FI","Pirkanmaa",634963,"Tampere","probable",61.49,23.76,"Finland: Pirkanmaa","Wastewater effluent",null,null,null,"city-level location without sample-site confirmation"],["SAMN44450034","Wastewater effluent WWTP2","probable_urban","municipal_wastewater","2018-06-06",2018,"FI","Pirkanmaa",634963,"Tampere","probable",61.49,23.76,"Finland: Pirkanmaa","Wastewater e