{"v":1,"accession":"PRJNA1285338","title":"DPAO-anammox coupling in A2/O system with sidestream phosphorus release for nutrient removal","description":"Microbial community analysis of a modified A2/O wastewater treatment system implementing sidestream phosphorus release to enable simultaneous DPAO-anammox coupling. The system maintained ultra-long SRT (180 days) for anammox while achieving >99% phosphorus removal through metabolic rejuvenation of DPAOs. 16S rRNA and metagenomic sequencing revealed Dechloromonas enrichment and its synergistic interaction with Candidatus Brocadia, enabling efficient nutrient removal under carbon-limited conditions (COD/N=2.5) with 90% phosphorus recovery as vivianite.","center":"Beijing University of Technology","data_type":"Raw sequence reads","submission_date":"2025/07/02 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN49762074","1","probable_urban","municipal_wastewater","2024-01-01",2024,"CN","Beijing",1816670,"Beijing","verified",39.92,116.43,"China:Beijing","1",null,null,null,"city-level location without sample-site confirmation"],["SAMN49762075","2","probable_urban","municipal_wastewater","2024-04-10",2024,"CN","Beijing",1816670,"Beijing","verified",39.92,116.43,"China:Beijing","2",null,null,null,"city-level location without sample-site confirmation"],["SAMN49762076","3","probable_urban","municipal_wastewater","2024-07-19",2024,"CN","Beijing",1816670,"Beijing","verified",39.92,116.43,"China:Beijing","3",null,null,null,"city-level location without sample-site confirmation"],["SAMN49762077","4","probable_urban","municipal_wastewater","2024-10-27",2024,"CN","Beijing",1816670,"Beijing","verified",39.92,116.43,"China:Beijing","4",null,null,null,"city-level location without sample-site confirmat