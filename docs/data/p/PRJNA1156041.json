{"v":1,"accession":"PRJNA1156041","title":"Improving hydrogen and vivianite synchronous recovery from waste activated sludge: Role of sacrificial iron anode in double-anode electro-fermentation system","description":"Electro-fermentation (EF) has become a promising technology for both energy and resource recovery from waste activated sludge (WAS), while the low energy/resource recovery caused by the limited extracellular electron transfer further restricts its implementation. This study investigated the feasibility and the mechanism on the intermittent power supply of iron-carbon double-anode microbial electrolysis cell (Fe-C-MEC) on synchronous recovery of hydrogen and vivianite from WAS.","center":"TAI YUAN UNIVERSITY OF TECHNOLOGY","data_type":"Raw sequence reads","submission_date":"2024/09/03 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN43479495","G2041","uncertain",null,"2023-07-19",2023,null,null,null,null,"unresolved",null,null,null,"G2041",null,null,null,"environmental sample; urban association not established"],["SAMN43479496","G103","uncertain",null,"2023-07-19",2023,null,null,null,null,"unresolved",null,null,null,"G103",null,null,null,"environmental sample; urban association not established"],["SAMN43479497","G1351","uncertain",null,"2023-07-19",2023,null,null,null,null,"unresolved",null,null,null,"G1351",null,null,null,"environmental sample; urban association not established"],["SAMN43479498","G1091","uncertain",null,"2023-07-19",2023,null,null,null,null,"unresolved",null,null,null,"G1091",null,null,null,"environmental sample; urban association not established"],["SAMN43479499","G135","uncertain",null,"2023-07-19",2023,null,null,null,null,"unresolved",null,null,null,"G135",null,null,null,"environmental sample; ur