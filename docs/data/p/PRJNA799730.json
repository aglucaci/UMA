{"v":1,"accession":"PRJNA799730","title":"Acid coal mine Microbial community Genome sequencing and assembly","description":"Acid mine drainage (AMD) is a contaminated water body left after coal mining. In the Shanxi Province (China), we collected acid mine drainage surrounding water, sediment and soil sample microbial community with high-throughput sequencing. The 16S rRNA genes specific for bacteria analysis could help to deepen the understanding of microbial communities in coal AMD ecosystem, which was important for the treatment and protection of polluted water.","center":"China University of Geosciences","data_type":"Genome sequencing and assembly","submission_date":"2022/01/23 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN25209731","Metagenome or environmental sample from sludge metagenome","non_urban",null,"2020-08-24",2020,"CN","Shanxi",1787351,"Yangquan","probable",38.02,113.5,"China: Shanxi","sediment",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN25692539","Metagenome or environmental sample from sludge metagenome","non_urban",null,"2020-08-24",2020,"CN","Shanxi",1787351,"Yangquan","verified",38.02,113.5,"China:Yangquan","sediment",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN25692540","Metagenome or environmental sample from sludge metagenome","non_urban",null,"2020-08-24",2020,"CN","Shanxi",1787351,"Yangquan","verified",38.02,113.5,"China:Yangquan","sediment",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN25692541","Metagenome or environmental sample from sludge metagenome","non_urban",null,"2020-08-24",2020,"CN","Shanxi",1787351,"Yangquan","verified",38.02,113.5,"China:Yangquan","sediment",null,null,null,"B