{"v":1,"accession":"PRJNA1301052","title":"Gut microbiota changes following PM2.5 exposure in allergic airway inflammation","description":"The goal was to assess the impact of particulate matter 2.5 (PM2.5) exposure on gut microbiota composition in BALB/c mice using an ovalbumin (OVA)-induced allergic airway inflammation model. Fecal pellets were collected at the end of the experimental period to evaluate compositional changes in the gut microbiota among four groups: naive mice, OVA-sensitized mice, PM2.5-exposed mice, and OVA-sensitized mice exposed to PM2.5.","center":"National Taiwan University","data_type":"Raw sequence reads","submission_date":"2025/08/04 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN50434178","PBS01","non_environmental",null,null,2022,"TW","Taiwan",1668341,"Taipei","probable",25.0355,121.5183,"Taiwan:Taipei","feces",null,null,null,"host-derived or clinical material"],["SAMN50434179","PBS02","non_environmental",null,null,2022,"TW","Taiwan",1668341,"Taipei","probable",25.0355,121.5183,"Taiwan:Taipei","feces",null,null,null,"host-derived or clinical material"],["SAMN50434180","PBS03","non_environmental",null,null,2022,"TW","Taiwan",1668341,"Taipei","probable",25.0355,121.5183,"Taiwan:Taipei","feces",null,null,null,"host-derived or clinical material"],["SAMN50434181","PBS04","non_environmental",null,null,2022,"TW","Taiwan",1668341,"Taipei","probable",25.0355,121.5183,"Taiwan:Taipei","feces",null,null,null,"host-derived or clinical material"],["SAMN50434182","PBS05","non_environmental",null,null,2022,"TW","Taiwan",1668341,"Taipei","probable",25.0355,121.5183,"Taiwan:Taipei","feces",null,null,null,"host-derived or clinical material"],["SAMN50434183","PBS06","non_environmental",null,null,2022,"TW","Taiwan",166