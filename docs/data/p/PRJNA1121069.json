{"v":1,"accession":"PRJNA1121069","title":"Microorganisms in two UMSRs","description":"Up-flow microaerobic sludge reactor (UMSR) can effectively remove pollutants such as COD, ammonia, and antibiotics from manure-free piggery wastewater. To investigate the impact of multiple antibiotics on the performance of UMSR, two identical reactors were operated in parallel. Twelve antibiotics were introduced into the feed of one reactor (marked as R2), while the other reactor (marked as R1) functioned as a control. We investigated the succession of microbial communities during the operation of two reactors.","center":"Harbin Institute of Technology","data_type":"Raw sequence reads","submission_date":"2024/06/07 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN41725983","sludge","non_urban",null,"2020-07-18",2020,null,null,null,null,"unresolved",null,null,null,"reactor R1 sample",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN41725984","sludge","non_urban",null,"2020-08-16",2020,null,null,null,null,"unresolved",null,null,null,"reactor R1 sample",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN41725985","sludge","non_urban",null,"2020-09-15",2020,null,null,null,null,"unresolved",null,null,null,"reactor R1 sample",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN41725986","sludge","non_urban",null,"2020-10-16",2020,null,null,null,null,"unresolved",null,null,null,"reactor R1 sample",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN41725987","sludge","non_urban",null,"2020-11-16",2020,null,null,null,null,"unresolved",null,null,null,"reactor R1 sample",null,null,null,"BioProject indicates an agricultural or indu