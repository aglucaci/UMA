{"v":1,"accession":"PRJNA755805","title":"Bacterial communities of sludge affected by PFOA Raw sequence reads","description":"Per- and polyfluoroalkyl substances (PFASs) have received increasing attention due to their widespread presence in diverse environments including wastewater treatment plants (WWTPs) and their potential adverse health effects. PFOA is one of the most detected forms of PFASs in WWTPs. However, there is still a paucity of knowledge about the effect of PFASs on microorganisms of the key component of WWTP, activated sludge. In this study, lab-scale microcosm experiments were established to evaluate the influences of PFOA on activated sludge microbes under aerobic and anaerobic conditions.","center":"Institute of Eco-environmental and Soil Sciences, Guangdong Academy of Sciences","data_type":"Raw sequence reads","submission_date":"2021/08/18 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN20842154","sludge1","probable_urban","municipal_wastewater","2021-01-01",2021,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"urban context stated at BioProject level only"],["SAMN20842155","sludge2","probable_urban","municipal_wastewater","2021-01-01",2021,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"urban context stated at BioProject level only"],["SAMN20842156","sludge3","probable_urban","municipal_wastewater","2021-01-01",2021,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"urban context stated at BioProject level only"],["SAMN20842157","sludge4","probable_urban","municipal_wastewater","2021-01-01",2021,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"urban context stated at BioProject level only"],["SAMN20842158","sludge5","probable_urb