{"v":1,"accession":"PRJEB98077","title":"Metagenomics of water and lake sediments, wastewater treatment plant and farm pond in the states of Berlin-Brandenburg","description":"In this study water and sediment samples from 5 lakes were collected, together with one sample from the Inflow and one from the Outflow of a wastewater treatment plant close to Berlin. In addition, a water sample from a farm pond in Grosskreutz was also collected. The main aim of the study was to evaluate if significant differences in the antimicrobial resistance (AMR) gene abundance and diversity could be observed for those lakes that were in closer contact to urban areas compared to those lakes found in less urbanized environments. The wastewater treatment plant would be expected to harbor the highest abundance and diversity of AMR genes whereas the farm pond should host a mixture of clinical and environmental AMR genes.","center":"Leibniz Institute for Freshwater Ecology and Inland Fisheries","data_type":"Other","submission_date":"2025/10/27 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA120250172","Stechlin_Wat","probable_urban","water_drainage",null,2016,"DE",null,null,null,"unresolved",null,null,"Germany",null,null,null,null,"urban context stated at BioProject level only"],["SAMEA120250173","Stechlin_Sed","probable_urban","water_drainage",null,2016,"DE",null,null,null,"unresolved",null,null,"Germany",null,null,null,null,"urban context stated at BioProject level only"],["SAMEA120250174","Dagow_Wat","probable_urban","water_drainage",null,2016,"DE",null,null,null,"unresolved",null,null,"Germany",null,null,null,null,"urban context stated at BioProject level only"],["SAMEA120250175","Dagow_Sed","probable_urban","water_drainage",null,2016,"DE",null,null