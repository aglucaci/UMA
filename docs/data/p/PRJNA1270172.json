{"v":1,"accession":"PRJNA1270172","title":"Metagenomic sequencing of wastewater microbial communities under nanoplastic and shear stress exposure","description":"This project aims to investigate the effects of nanoplastic exposure and fluid shear stress on microbial community structure and antibiotic resistance gene (ARG) dissemination in wastewater environments using high-throughput metagenomic sequencing. Wastewater samples were subjected to different concentrations of polystyrene nanoparticles and variable shaking speeds to simulate environmental shear forces. The metagenomic datasets generated in this project provide a comprehensive resource for analyzing shifts in microbial composition, metabolic pathways, and ARG profiles under combined chemical and physical stressors, facilitating ecological risk assessment of emerging pollutants in aquatic systems.","center":"guangzhou university","data_type":"Raw sequence reads","submission_date":"2025/05/31 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN48819552","ST Con replicate 1","uncertain",null,"2024-04-25",2024,"CN","Guangdong",1809858,"Guangzhou","verified",23.12,113.22,"China: Guangzhou, Datansha Wastewater Treatment Plant","screened influent wastewater",null,null,null,"environmental sample; urban association not established"],["SAMN48819553","ST Con replicate 2","uncertain",null,"2024-04-25",2024,"CN","Guangdong",1809858,"Guangzhou","verified",23.12,113.22,"China: Guangzhou, Datansha Wastewater Treatment Plant","screened influent wastewater",null,null,null,"environmental sample; urban association not established"],["SAMN48819554","ST Con replicate 3","uncertain",null,"2024-04-25",2024,"CN","Guangdong",1809858,"Guangzhou","verified",23.12,113.22,"China: Guangzhou, Datansha W