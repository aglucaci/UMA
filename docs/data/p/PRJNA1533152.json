{"v":1,"accession":"PRJNA1533152","title":"EPS remodeling links carbon conversion and phosphorus mobilization during anaerobic co-fermentation of waste activated sludge and ensiled straw","description":"This project investigates the effects of co-fermentation of waste activated sludge (WAS) and ensiled straw (ES) on carboxylate production and phosphorus release during anaerobic fermentation. Metagenomic sequencing was performed to characterize microbial community composition and functional potential under different WAS-to-ES mixing ratios. The resulting datasets provide insights into microbial community dynamics and metabolic pathways associated with organic matter degradation, carboxylate production, and phosphorus transformation during anaerobic co-fermentation.","center":"Harbin Institute of Technology, School of Environment","data_type":"Raw sequence reads","submission_date":"2026/09/22 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN63301791","Anaerobic fermentation of waste activated sludge (C1)","probable_urban","municipal_wastewater","2025-09-09",2025,"CN","Heilongjiang",2037013,"Harbin","verified",45.7432,126.6326,"China: Harbin",null,"engineered wastewater treatment system","laboratory-scale anaerobic fermentation reactor","anaerobic fermentation slurry","city-level location without sample-site confirmation"],["SAMN63301792","Anaerobic co-fermentation of WAS and ES at a 3:1 ratio (C2)","probable_urban","municipal_wastewater","2025-09-09",2025,"CN","Heilongjiang",2037013,"Harbin","verified",45.7432,126.6326,"China: Harbin",null,"engineered wastewater treatment system","laboratory-scale anaerobic fermentation reactor","anaerobic fermentation slurry","city-level location without sample-site confirmation"],["SAMN63301793"