{"v":1,"accession":"PRJEB109263","title":"Micro and nanoplastics on synthetic wastewater treatment","description":"This study evaluates the long-term accumulation impact of a mixture of micro and nanoplastics (MNPs)—specifically polyethylene, polypropylene, and polystyrene—on a pilot-scale submerged membrane bioreactor (MBR). The results demonstrate high system resilience, maintaining 97% organic matter removal and achieving over 99.99% nanoplastic removal efficiency. MNPs exposure was found to mitigate membrane fouling, likely due to a mechanical scouring effect. While the microbial community structure and diversity experienced moderate shifts, the system showed gradual adaptation to the plastic-induced stress. These findings highlight the suitability of MBR systems for producing high-quality effluent for water reuse applications, even under prolonged MNP loads.","center":"Instituto IMDEA Agua","data_type":"Other","submission_date":"2026/07/02 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA121929605","barcode01","uncertain",null,"2024-06-25",2024,"ES",null,null,null,"unresolved",null,null,"Spain",null,null,null,null,"environmental sample; urban association not established"],["SAMEA121929606","barcode03","uncertain",null,"2024-07-08",2024,"ES",null,null,null,"unresolved",null,null,"Spain",null,null,null,null,"environmental sample; urban association not established"],["SAMEA121929607","barcode05","uncertain",null,"2024-07-22",2024,"ES",null,null,null,"unresolved",null,null,"Spain",null,null,null,null,"environmental sample; urban association not established"],["SAMEA121929608","barcode19","uncertain",null,"2024-08-05",2024,"ES",null,null,null,"unresolved",null,null,"Spain",null,null,null,null,"environmental sample; urban associ