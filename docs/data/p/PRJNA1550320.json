{"v":1,"accession":"PRJNA1550320","title":"Seasonal 16S rRNA and ITS1 amplicon survey of an office building ventilation system in Wroclaw Poland","description":"This study characterizes microbial communities across airflow compartments and a surface habitat in the heating, ventilation and air-conditioning system of an office building on the campus of Wroclaw University of Science and Technology, Wroclaw, Poland. Samples represent outdoor air (ODA), primary supply air (P-SUP), supply air (SUP), indoor air (IDA), extract air (ETA), and a surface swab from the heat exchanger of a cooling and heating beam (SWAB). Two sampling campaigns were conducted on 6 March 2024 and 19 June 2024, representing winter and summer HVAC operating conditions. The dataset comprises 12 physical environmental samples, each analyzed using prokaryotic 16S rRNA gene V3-V4 and fungal ITS1 amplicon sequencing. Libraries were sequenced on an Illumina MiSeq at Genomed S.A., Warsaw, Poland. This submission contains 24 paired-end sequencing libraries and 48 original demultiplexed FASTQ.gz files from the selected study samples. These raw data support community profiling and reproducible analysis of spatial and seasonal patterns in HVAC-associated microbiomes.","center":"Wroclaw University of Science and Technology","data_type":"Raw sequence reads","submission_date":"2026/10/25 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN64430024","Indoor air at IDA during winter HVAC operation in Wroclaw 2024","uncertain",null,"2024-03-06",2024,"PL","Lower Silesia",3081368,"Wrocław","verified",51.1039,17.0544,"Poland: Wroclaw, Na Grobli 15","indoor air in an occupied office room served by the building HVAC system",null,null,null,"environmental sample; urban association not established"],["SAMN64430025","Extract air at ETA during winter HVAC operation in Wroclaw 2024","uncertain",null,"2024-03-06",2024,"PL","Lower Silesia",3081368,"Wrocław","verified",51.1039,17.0544,"Poland: Wroclaw, Na Grobli 15","extract air from an occupied office room in the building HVAC system",null,null,null,"environmental sample; urban association not established"],["SAMN64430026","HVAC heat exchanger surface swab at SWAB during winter HVAC operation in Wroclaw 2024","uncertain",null,"2024-03-06",2024,"PL","Lower Silesia",3081368,"Wrocław","verified",51.1039,17.0544,"Poland: Wroclaw, Na Grobli 15","surface swab from the heat exchanger of an HVAC cooling and heating beam",null,null,null,"environmental sample; urban association not established"],["SAMN64430027","Supply air at SUP during winter HVAC operation in Wroclaw 2024","uncertain",null,"2024-03-06",2024,"PL","Lower Silesia",3081368,"Wrocław","verified",51.1039,17.0544,"Poland: Wroclaw, Na Grobli 15","supply air delivered from an HVAC active beam to an occupied office room",null,null,null,"environmental sample; urban association not established"],["SAMN64430028","Primary supply air at P-SUP during winter HVAC operation in Wroclaw 2024","uncertain",null,"2024-03-06",2024,"PL","Lower Silesia",3081368,"Wrocław","verified",51.1039,17.0544,"Poland: Wroclaw, Na Grobli 15","primary supply air in the building HVAC system upstream of the active beam",null,null,null,"environmental sample; urban association not established"],["SAMN64430029","Outdoor air at ODA during winter HVAC operation in Wroclaw 2024","uncertain",null,"2024-03-06",2024,"PL","Lower Silesia",3081368,"Wrocław","verified",51.1039,17.0544,"Poland: Wroclaw, Na Grobli 15","outdoor air at the outdoor-air intake of the building HVAC system",null,null,null,"environmental sample; urban association not established"],["SAMN64430030","Indoor air at IDA during summer HVAC operation in Wroclaw 2024","uncertain",null,"2024-06-19",2024,"PL","Lower Silesia",3081368,"W