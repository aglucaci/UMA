{"v":1,"accession":"PRJNA1302381","title":"Viral and Prokaryotic Communities under Stresses Raw sequence reads","description":"This study aims to explore the adaptive strategies of microbial and viral communities in real environmental samples under different environmental stressors. Representative environmental samples were selected and analyzed under various stress gradients. By extracting DNA and RNA from the samples, metagenomic and metatranscriptomic sequencing technologies were employed to comprehensively understand the genomic and transcriptomic dynamics of microbes and viruses under stress. The study also focuses on the interactions between microbial and viral communities, investigating how viruses influence host gene expression and participate in the adaptation of microbial communities under stress.","center":"Tongji University","data_type":"Raw sequence reads","submission_date":"2025/08/06 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN50475656","Metagenome or environmental sample from solid waste metagenome","confirmed_urban",null,"2024-01-05",2024,"CN","Zhejiang",null,null,"unresolved",29.88,119.89,"China:Zhejiang","Municipal organic solid waste",null,null,null,"explicit urban setting at sample level"],["SAMN50475657","Metagenome or environmental sample from solid waste metagenome","confirmed_urban",null,"2024-01-05",2024,"CN","Zhejiang",null,null,"unresolved",29.89,119.89,"China:Zhejiang","Municipal organic solid waste",null,null,null,"explicit urban setting at sample level"],["SAMN50475658","Metagenome or environmental sample from solid waste metagenome","confirmed_urban",null,"2024-01-05",2024,"CN","Zhejiang",null,null,"unresolved",29.9,119.89,"China:Zhejiang","Municipal organic solid waste",null,null,null,"expli