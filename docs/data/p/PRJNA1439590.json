{"v":1,"accession":"PRJNA1439590","title":"16S rRNA amplicon sequencing of wastewater microbial communities","description":"This project aims to characterize the microbial community composition of wastewater samples using 16S rRNA gene amplicon sequencing. Wastewater environments harbor diverse microbial populations that play important roles in nutrient cycling, pollutant degradation, and public health monitoring. By analyzing the taxonomic profiles of these microbial communities, this study provides insights into microbial diversity, environmental dynamics, and potential indicators of contamination or ecosystem changes. The generated data will contribute to a better understanding of wastewater microbiomes and support future environmental and epidemiological studies.","center":"Gyeongsang National University","data_type":"Targeted loci environmental","submission_date":"2026/03/19 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN56587575","MIMARKS Survey related sample from wastewater metagenome","confirmed_urban","municipal_wastewater","2025-05-12",2025,"KR","Gyeongsangnam-do",1846052,"Chinju","probable",35.2047,128.1243,"South Korea: wastewater treatment plant",null,"South Korea: Jinju Domestic wastewater treatment plant","activated sludge","sludge","named urban infrastructure at sample level"],["SAMN56587576","MIMARKS Survey related sample from wastewater metagenome","confirmed_urban","municipal_wastewater","2025-05-12",2025,"KR","Gyeongsangnam-do",1846052,"Chinju","probable",35.2047,128.1243,"South Korea: wastewater treatment plant",null,"South Korea: Jinju Domestic wastewater treatment plant","activated sludge","sludge","named urban infrastructure at sample level"],["SAMN56587577","MIMARKS Survey related sample from wastewat