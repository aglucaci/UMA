{"v":1,"accession":"PRJNA1465617","title":"Metagenomic analysis of the effect of different iron forms on microbial community in MBGS for wastewater treatment","description":"This project aims to investigate the impact of different iron forms on the performance, microbial community structure, and functional metabolic pathways of Microalgal-Bacterial Granular Sludge (MBGS) in wastewater treatment systems. The metagenomic sequencing data will reveal key functional microorganisms, iron-related metabolic genes, and nitrogen/carbon removal mechanisms under different iron conditions, providing theoretical support for the optimization and stable operation of MBGS processes.","center":"Wuhan University of Science and Technology","data_type":"Raw sequence reads","submission_date":"2026/05/13 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN59749975","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater","2025-12-21",2025,"CN","Hubei",1791247,"Wuhan","verified",30.44,114.263,"China:Wuhan",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN59749976","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater","2025-12-21",2025,"CN","Hubei",1791247,"Wuhan","verified",30.44,114.263,"China:Wuhan",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN59749977","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater","2025-12-21",2025,"CN","Hubei",1791247,"Wuhan","verified",30.44,114.263,"China:Wuhan",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN59749978","Metagenome or environmental sample from wastewater metageno