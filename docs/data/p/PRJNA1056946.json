{"v":1,"accession":"PRJNA1056946","title":"Enhancement effect of nanobubble water addition on anaerobic digestion of rice straw under biogas digestate soaking pretreatment","description":"This study investigated the enhancement effect of nanobubble water on pretreatment efficiency and biogas production of rice straw. Different types of NW (CO2NW and O2NW) with biogas digestate were used to soak rice straw for 1, 2, 3, 5, and 7 d.This study provides new insights into soaking pretreatment of combined NW addition and digestate and present a low-cost pretreatment method of rice straw.","center":"China Agricultural University","data_type":"Raw sequence reads","submission_date":"2023/12/26 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN39114333","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2023-05-23",2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN39114334","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2023-05-23",2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN39114335","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2023-05-23",2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN39114336","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2023-05-23",2023,null,null,null,null,"unresolved",null,null,null,"reactor sample",null,null,null,"environmental sample; urban association not established"],["SAMN39114337","Metag