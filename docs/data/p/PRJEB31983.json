{"v":1,"accession":"PRJEB31983","title":"Naturally-diverse aerobiology and mice gut microbiota","description":"We subjected 54 x 3-5 week old inbred BALB/C mice (27 female, 27 male) to a 7 week exposure to airborne environmental microbiota treatments in the form of light soil dust, using soils from a high biodiversity woodland, a low biodiversity grassland, and no soil (control).  We tracked changes in soil microbiota, air (dust) microbiota, and mice gut microbiota. Specifically, we targeted the bacterial 16S rRNA V3-V4 gene region using forward primer 341F (CCTAYGGGRBGCASCAG) and reverse primer 806R (GGACTACNNGGGTATCTAAT). PCR and sequencing was performed by the Australian Genome Research Facility (AGRF) using the Illumina Miseq plaftorm.","center":"THE UNIVERSITY OF ADELAIDE","data_type":"Other","submission_date":"2019/11/02 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA5554622","ABLK1w6-16S_V3-V4","uncertain",null,"2018-10-08",2018,"AU",null,null,null,"unresolved",null,null,"Australia",null,null,null,null,"environmental sample; urban association not established"],["SAMEA5554623","ABLK2w6-16S_V3-V4","uncertain",null,"2018-10-08",2018,"AU",null,null,null,"unresolved",null,null,"Australia",null,null,null,null,"environmental sample; urban association not established"],["SAMEA5554624","bat11blk-16S_V3-V4","uncertain",null,"2018-10-22",2018,"AU",null,null,null,"unresolved",null,null,"Australia",null,null,null,null,"environmental sample; urban association not established"],["SAMEA5554625","bat12blk-16S_V3-V4","uncertain",null,"2018-10-10",2018,"AU",null,null,null,"unresolved",null,null,"Australia",null,null,null,null,"environmental sample; urban association not established"],["SAMEA5554626","bat13blk-16S_V3-V4","uncertain",null,