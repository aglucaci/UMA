{"v":1,"accession":"PRJNA497280","title":"Microbial Tracking 2 - Flights 4, 5","description":"Microbial Tracking-2 is the first Space Biology human related investigation that seeks to catalog and characterize potential disease-causing microorganisms aboard the International Space Station (ISS). Crew samples from pre-flight, in-flight, and post-flight times in addition to environmental samples from ISS surface and air locations will be collected to analyze any associations between the samples, as well as potential health effects. [source: https://www.nasa.gov/ames/research/space-biosciences/microbial-tracking-2]","center":"Lawrence Livermore National Laboratory","data_type":"Raw sequence reads","submission_date":"2018/10/17 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN10252955","Metagenome or environmental sample from indoor metagenome","non_urban",null,null,null,"US",null,null,null,"unresolved",null,null,"USA: International Space Station","port_panel",null,null,null,"environmental sample from a non-urban site"],["SAMN10252956","Metagenome or environmental sample from indoor metagenome","non_urban",null,null,null,"US",null,null,null,"unresolved",null,null,"USA: International Space Station","port_panel",null,null,null,"environmental sample from a non-urban site"],["SAMN10252957","Metagenome or environmental sample from indoor metagenome","non_urban",null,null,null,"US",null,null,null,"unresolved",null,null,"USA: International Space Station","WHC",null,null,null,"environmental sample from a non-urban site"],["SAMN10252958","Metagenome or environmental sample from indoor metagenome","non_urban",null,null,null,"US",null,null,null,"unresolved",null,null,"USA: International Space Station","WHC",null,null,null,"environmental sample 