{"v":1,"accession":"PRJNA1433190","title":"Single-cell transcriptomics of bacterial and microalgal functional heterogeneity in driving wastewater treatment","description":"Single-cell transcriptomic data were generated from wastewater samples collected from a representative recirculating aquaculture treatment system (three ponds and two dams, 3P-2D). Microbial cells, including bacteria and microalgae, were profiled using a droplet-based single-cell RNA sequencing workflow. Libraries were prepared with the VITApilote PFT1200 kit (M20 Genomics) and sequenced on an Illumina NovaSeq 6000 platform with 150-bp paired-end reads, generating approximately 1.8 Tb of raw data from nine samples. Raw reads were processed using VITAbasic (v1.4) to remove adaptor and dA-tailing sequences, followed by extraction of cell barcodes (20 bp) and unique molecular identifiers (8 bp) for downstream analysis.","center":"Liangzhu Laboratory","data_type":"Raw sequence reads","submission_date":"2026/03/06 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN56357988","Sedimentation pond wastewater sample","non_urban",null,"2025-03-07",2025,"CN","Zhejiang",1799384,"Ninghai","verified",29.151,121.519,"China: Ninghai County, Zhejiang Province","Sedimentation pond aquaculture wastewater",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN56357989","Aeration pond wastewater sample","non_urban",null,"2025-03-07",2025,"CN","Zhejiang",1799384,"Ninghai","verified",29.151,121.519,"China: Ninghai County, Zhejiang Province","Aeration pond aquaculture wastewater",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN56357990","Ecological pond wastewater sample","non_urban",null,"2025-03-07",2025,"CN","Zhejiang",179