{"v":1,"accession":"PRJEB58100","title":"Microbial composition and antibiotic resistance profiles in water sources from cholera outbreak sites in Tanzania reveals prevalence of rare zoonotic pathogens and bacteriophage-carried ESBL plasmids","description":"Contaminated water sources remain a global health problem leading to high incidences of morbidity and mortality in the population, in particular in developing countries where sanitation and access to clean water is limited. In this study, we characterized the microbiota in both drinking water and wastewater in Tanzania. All sources of water had high levels of fecal contamination, with Vibrio metcshnikovii a likely source of a local cholera outbreak. Finally, we could demonstrate the enrichment of ESBL-plasmids within a bacteriophage population.","center":"STATENS SERUM INSTITUT","data_type":"Other","submission_date":"2023/10/31 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA112198621","water sample - Tww_1-bact","uncertain",null,"2019-05-20",2019,"TZ",null,null,null,"unresolved",null,null,"Tanzania",null,null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMEA112198622","water sample - Tww_1-phage","uncertain",null,"2019-05-20",2019,"TZ",null,null,null,"unresolved",null,null,"Tanzania",null,null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMEA112198623","water sample - Tww_2-bact","uncertain",null,"2019-05-20",2019,"TZ",null,null,null,"unresolved",null,null,"Tanzania",null,null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMEA112198624","water sample - Tww_2-phage","uncertain",null,"2019-05-20",2019,"TZ",null,null,null,"unresolved",null,null,"Tanzania",null,null,null,null,"conflicting evidence: enviro