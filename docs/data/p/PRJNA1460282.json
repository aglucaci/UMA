{"v":1,"accession":"PRJNA1460282","title":"Microbial Mechanisms of Differential Denitrification Recovery in Anaerobic-Anoxic-Oxic and Air-Lift Internal Circulation Reactors under Ultra-Low Carbon-to-Nitrogen Ratios","description":"This project focuses on the challenge of low nitrogen removal efficiency in wastewater biological treatment under ultra-low carbon-to-nitrogen (C/N) ratios. Long-term continuous flow experiments were conducted in both Anaerobic-Anoxic-Oxic (A/A/O) and Air-Lift Internal Circulation (AICR) reactors to compare their differential denitrification recovery performance. Combined with 16S rRNA high-throughput sequencing, functional gene quantification, and key enzyme activity assays, this study revealed the succession patterns of functional microbial communities and the regulatory mechanisms of denitrification metabolic pathways in different reactors. The findings provide theoretical support and technical references for the engineering application of high-efficiency denitrification processes for low C/N wastewater.","center":"Chengdu University of Technology","data_type":"Raw sequence reads","submission_date":"2026/04/30 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN57589264","A/A/O reactor anaerobic zone sludge replicate 1","probable_urban","municipal_wastewater","2025-08-26",2025,"CN","Sichuan",1815286,"Chengdu","verified",30.8109,104.3645,"China: Chengdu","wastewater sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN57589265","A/A/O reactor anaerobic zone sludge replicate 2","probable_urban","municipal_wastewater","2025-08-26",2025,"CN","Sichuan",1815286,"Chengdu","verified",30.8109,104.3645,"China: Chengdu","wastewater sludge",null,null,null,"city-level location withou