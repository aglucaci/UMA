{"v":1,"accession":"PRJNA1287549","title":"Greenland Ice Sheet air and snow microbial community composition","description":"The surface of the Greenland Ice Sheet (GrIS) is one of the largest supraglacial habitats in the world, and the biogeochemical processes that occur on and near the ice surface impact albedo, surface melting, and the resultant sea level rise. This habitat hosts pigmented glacier ice and snow algae that grow in blooms on the surface during the summer melt season. Here we characterize the microbial communities of air and snow samples from a location in the southwest of the GrIS and connect these results to other geochemical and atmospheric measurements. The bacterial and eukaryotic community compositions were characterized using 16S and 18S rRNA amplicon sequencing.","center":"University of Waterloo","data_type":"Raw sequence reads","submission_date":"2025/07/07 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN49823914","Metagenome or environmental sample from air metagenome","probable_urban","air_dust","2016-07-29",2016,"GL",null,null,null,"unresolved",67.07,-49.36,"Greenland: SW Greenland Ice Sheet","air",null,null,null,"city-level location without sample-site confirmation"],["SAMN49823915","Metagenome or environmental sample from air metagenome","probable_urban","air_dust","2016-07-30",2016,"GL",null,null,null,"unresolved",67.07,-49.36,"Greenland: SW Greenland Ice Sheet","air",null,null,null,"city-level location without sample-site confirmation"],["SAMN49823916","Metagenome or environmental sample from air metagenome","probable_urban","air_dust","2016-07-31",2016,"GL",null,null,null,"unresolved",67.07,-49.36,"Greenland: SW Greenland Ice Sheet","air",null,null,null,"city-level location without sample-site co