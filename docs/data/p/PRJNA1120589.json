{"v":1,"accession":"PRJNA1120589","title":"Microbial community of dyeing wastewater treatment process","description":"The study investigated the microbial community in an Upflow Anaerobic Sludge Blanket (UASB) system coupled with a biocarrier named PVA/Fe/Starch gel bead treating azo dye Reactive Black 5. The PVA/Fe/Starch gel bead is a spherical mixed gel bead created by combining polyvinyl alcohol (PVA) gel with magnetite and starch. The microbial community groups were measured according to the height of the UASB system and in the forms of gel bead-attached and suspended sludge.","center":"Nagaoka University of Technology","data_type":"Raw sequence reads","submission_date":"2024/06/06 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN41704378","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2022-08-22",2022,"JP","Niigata",1856199,"Nagaoka","verified",37.4453,138.8575,"Japan: Nagaoka, Niigata","anaerobic sludge",null,null,null,"environmental sample; urban association not established"],["SAMN41704379","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2022-08-22",2022,"JP","Niigata",1856199,"Nagaoka","verified",37.4453,138.8575,"Japan: Nagaoka, Niigata","anaerobic sludge",null,null,null,"environmental sample; urban association not established"],["SAMN41704380","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2022-08-22",2022,"JP","Niigata",1856199,"Nagaoka","verified",37.4453,138.8575,"Japan: Nagaoka, Niigata","anaerobic sludge",null,null,null,"environmental sample; urban association not established"],["SAMN41704381","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2022-08-22",2022,"JP","Niigata",1856199,"Nagaoka","v