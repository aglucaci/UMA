{"v":1,"accession":"PRJNA1381586","title":"Activated sludge treatment for high ammonium nitrogen wastewater: performance and microbial adaptation","description":"This project investigates the microbial community structure of activated sludge systems treating wastewater with elevated ammonium nitrogen concentrations. The study focuses on comparing control reactors without synthetic media and reactors equipped with synthetic spiral media, assessing microbial adaptation under different ammonium loading conditions. High-throughput 16S rRNA gene amplicon sequencing was used to characterize environmental microbiota associated with activated sludge samples collected during reactor operation.","center":"Wroclaw University of Environmental and Life Sciences","data_type":"Raw sequence reads","submission_date":"2025/12/15 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN54112289","Metagenome or environmental sample from activated sludge metagenome","probable_urban","municipal_wastewater","2024-02-14",2024,"PL","Lower Silesia",3081368,"Wrocław","verified",51.1079,17.0385,"Poland: Wroclaw","activated sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN54112290","Metagenome or environmental sample from activated sludge metagenome","probable_urban","municipal_wastewater","2024-02-14",2024,"PL","Lower Silesia",3081368,"Wrocław","verified",51.1079,17.0385,"Poland: Wroclaw","activated sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN54112291","Metagenome or environmental sample from activated sludge metagenome","probable_urban","municipal_wastewater","2024-02-14",2024,"PL","Lower Silesia",3081368,"Wrocław","verified",51.1079,17.0385,"Poland: Wroclaw","activated sludge",null,null