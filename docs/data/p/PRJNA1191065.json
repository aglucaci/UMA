{"v":1,"accession":"PRJNA1191065","title":"Resistance of alfalfa rhizosphere soil microbial structure and functions to temperature changes","description":"This study revealed the changes in the rhizosphere soil microbial community, physicochemical properties, and enzyme activity of alfalfa under temperature fluctuations, providing new insights into the impact of temperature fluctuations on plant rhizosphere soil micro-ecology and their effects on plant growth. Exploring the changes in the rhizosphere soil micro-ecology of alfalfa under temperature fluctuations is of great practical significance for the overwintering process of alfalfa fields and the development and utilization of cold resistant microbial resources in the rhizosphere soil.","center":"Harbin Normal university","data_type":"Raw sequence reads","submission_date":"2024/11/26 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN45068558","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2021-04-13",2021,"CN","Heilongjiang",2037013,"Harbin","verified",45.8674,126.5569,"China: Harbin","reactor sample",null,null,null,"city-level location without sample-site confirmation"],["SAMN45068559","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2021-04-13",2021,"CN","Heilongjiang",2037013,"Harbin","verified",45.8674,126.5569,"China: Harbin","reactor sample",null,null,null,"city-level location without sample-site confirmation"],["SAMN45068560","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2021-04-13",2021,"CN","Heilongjiang",2037013,"Harbin","verified",45.8674,126.5569,"China: Harbin","reactor sample",null,null,null,"city-level l