{"v":1,"accession":"PRJNA1483601","title":"16S rRNA gene sequencing of soybean meal before and after fermentation","description":"This study aims to investigate the microbial community composition and dynamics of soybean meal during the fermentation process. 16S rRNA gene amplicon sequencing was performed on soybean meal samples collected before and after fermentation to characterize the bacterial diversity and identify key microbial populations involved in the fermentation. The results will provide insights into the role of microorganisms in improving the nutritional quality of soybean meal.","center":"China Agricultural University","data_type":"Raw sequence reads","submission_date":"2026/06/29 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN61185302","MIMARKS Survey related sample from fermentation metagenome","uncertain",null,null,2024,"CN","Hainan",1796556,"Sanya","probable",18.25,109.5,"China",null,"built environment","laboratory environment","fermentation medium","environmental sample; urban association not established"],["SAMN61185303","MIMARKS Survey related sample from fermentation metagenome","uncertain",null,null,2024,"CN","Hainan",1796556,"Sanya","probable",18.25,109.5,"China",null,"built environment","laboratory environment","fermentation medium","environmental sample; urban association not established"],["SAMN61185304","MIMARKS Survey related sample from fermentation metagenome","uncertain",null,null,2024,"CN","Hainan",1796556,"Sanya","probable",18.25,109.5,"China",null,"built environment","laboratory environment","fermentation medium","environmental sample; urban association not established"],["SAMN61185305","MIMARKS Survey related sample from fermentation metagenome","uncertain",null,null,2024,"CN","Hainan",1796