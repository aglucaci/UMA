{"v":1,"accession":"PRJNA1044270","title":"Effect of different operating stages of dry continuous anaerobic digestion on microbial community mechanisms","description":"In this study, the vertical continuous push-flow dry anaerobic digestion reactor was developed independently. Typical agricultural organic waste straw and cow dung were used as raw materials in this paper to carry out long-term continuous mixed dry anaerobic digestion experiments on a controlled laboratory scale. The system performance at this stage was in the best condition in the whole set of experiments. The study of microbial community succession and metabolic mechanisms showed that the increased abundance and dominance of hydrogen methanogens implies that methane is produced via the hydrogen methanogenic pathway under high organic loading conditions.","center":"Chinese Academy of Sciences","data_type":"Raw sequence reads","submission_date":"2023/11/23 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN38378235","anaerobic sludge Z1228_1","probable_urban","municipal_wastewater","2021-12-28",2021,"CN","Guangdong",1809858,"Guangzhou","verified",null,null,"China: Guangzhou","reactor saample",null,null,null,"city-level location without sample-site confirmation"],["SAMN38378236","anaerobic sludge Z1228_2","probable_urban","municipal_wastewater","2021-12-28",2021,"CN","Guangdong",1809858,"Guangzhou","verified",null,null,"China: Guangzhou","reactor saample",null,null,null,"city-level location without sample-site confirmation"],["SAMN38378237","anaerobic sludge Z1228_3","probable_urban","municipal_wastewater","2021-12-28",2021,"CN","Guangdong",1809858,"Guangzhou","verified",null,null,"China: Guangzhou","reactor saample",null,null,null,"city-level location without sample