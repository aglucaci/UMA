{"v":1,"accession":"PRJNA1023249","title":"cultivated microbial species from anaerobic digester sludge and goat feces","description":"Anaerobic microbial communities were cultivated from anaerobic digester sludge and goat feces. These communities were cultivated with synthetic plastic (except inoculated controls without plastic), and different antibiotic treatments were used (no antibiotics or penicillin + streptomycin). Goals included cultivating potential plastic-associating microbes as well as characterizing more microbes from anaerobic digester and goat gut environments as these locations have not been sufficiently studied.","center":"University of California, Santa Barbara","data_type":"Genome sequencing","submission_date":"2023/10/02 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN37735132","community cultivated from anaerobic digester sludge","confirmed_urban","municipal_wastewater","2020-11-30",2020,"US","California",5392952,"Santa Barbara","probable",34.4174,-119.6852,"USA: California",null,"wastewater treatment plant","anaerobic digester","anaerobic digester sludge","named urban infrastructure at sample level"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR26328473","SAMN37735132","SRX22036510","WGS","WGS","METAGENOMIC","PAIRED","ILLUMINA","NextSeq 500",1934023239,6480622,"2024-05-28","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos11/sra-pub-zq-1140/SRR026/26328/SRR26328473/SRR26328473.lite.1"],["SRR26328474","SAMN37735132","SRX22036509","WGS","WGS","METAGENOMIC","PAIRED","ILLUMINA","NextSeq 500",1950709092,6524975,"2024-05-28","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos11/sra-pub-zq-1140/S