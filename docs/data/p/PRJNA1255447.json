{"v":1,"accession":"PRJNA1255447","title":"Mechanism Analysis of Multi-pathway Electron Transfer in Anaerobic Ammonia-oxidizing Bacteria Enhanced by Synergistic Fermentation Microbial Consortia","description":"This study delves into the mechanism of multi-pathway electron transfer in anaerobic ammonium-oxidizing bacteria. It particularly emphasizes how fermentation microbial communities can synergistically enhance this process. By exploring the interactions between different microbial groups and their impact on electron transfer pathways, this research aims to provide deeper insights into the functioning of anaerobic ammonium-oxidizing bacteria. Such knowledge is valuable for improving our understanding of microbial processes in environmental biotechnology and related fields.","center":"Qingdao University","data_type":"Raw sequence reads","submission_date":"2025/04/25 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN48144233","Biofilm_1","probable_urban","municipal_wastewater","2023-07-01",2023,"CN",null,null,null,"conflicting",37.5109,122.1005,"China: qingdao",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN48144234","Biofilm_2","probable_urban","municipal_wastewater","2023-08-01",2023,"CN",null,null,null,"conflicting",37.5109,122.1005,"China: qingdao",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN48144235","Biofilm_3","probable_urban","municipal_wastewater","2023-09-23",2023,"CN",null,null,null,"conflicting",37.5109,122.1005,"China: qingdao",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN48144236","Biofilm_4","probable_urban","municipal_wastewater","2023-11-11",2023,"CN",null,null,null,"conflicting",37.5109,122.1005,"China: