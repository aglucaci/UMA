{"v":1,"accession":"PRJNA1390755","title":"Fecal source tracking in the Lower Raritan River, NJ","description":"Pathogen pollution is a widespread water quality issue motivating fecal source trackingefforts to inform mitigation strategies. The objectives of this study were to compare the resultsfrom total and propidium monoazide (PMA)-DNA for human fecal marker genes via qPCR and Nanopore sequencing, library-based fecal source tracking. Water samples with prepared by filtering or centrifuge concentrating cells. Centrifuge concentrated cells either had DNA directly extracted or were treated with PMA prior to extraction. A local fecal library was created with wastewater influent samples along with feces from domestic pets, wildlife, and agricultural animals. 10.1016/j.scitotenv.2025.181271","center":"Rutgers University","data_type":"Raw sequence reads","submission_date":"2025/12/18 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN54199618","human1","uncertain",null,null,2020,"US","New Jersey",null,null,"unresolved",null,null,"USA:New Jersey","wastewater influent",null,null,null,"environmental sample; urban association not established"],["SAMN54199619","human2","uncertain",null,null,2020,"US","New Jersey",null,null,"unresolved",null,null,"USA:New Jersey","wastewater influent",null,null,null,"environmental sample; urban association not established"],["SAMN54199620","human3","uncertain",null,null,2020,"US","New Jersey",null,null,"unresolved",null,null,"USA:New Jersey","wastewater influent",null,null,null,"environmental sample; urban association not established"],["SAMN54199621","human4","uncertain",null,null,2020,"US","New Jersey",null,null,"unresolved",null,null,"USA:New Jersey","wastewater influent",null,null,null,"environmental sa