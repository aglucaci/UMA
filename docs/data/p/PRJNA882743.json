{"v":1,"accession":"PRJNA882743","title":"Anaerobic digestion of kitchen waste with hyperthermophilically pretreated grass for biohydrogen and biomethane production","description":"The study investigates the semi-continuous co-digestion experiments using kitchen waste and grass after hyperthermophilic pretreatment. Grass was preliminary treated at 70 Celsius degrees and then mixed with kitchen waste for anaerobic digestion in the second step, performed under mesophilic and thermophilic conditions. Simultaneously, pretreated grass was also treated in mono-digestion experiments at the same temperatures. Each experimental run was operated at two retention times of 30 and 20 days, and the digestate were collected twice a week for chemical analyses. The biogas was monitored daily with measurement of its composition, including contents of methane and hydrogen. At the end of each experimental run, the samples of the digestate were collected for metagenomic analysis","center":"Lodz University of Technology","data_type":"Raw sequence reads","submission_date":"2022/09/21 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN30948435","digestate kitchen waste and grass thermophilic 30 days","uncertain",null,null,2021,"PL",null,null,null,"unresolved",51.0,20.0,"Poland",null,"anaerobic digestate","anaerobic digester effluent","digested material","environmental sample; urban association not established"],["SAMN30948436","digestate grass thermophilic 30 days","uncertain",null,null,2021,"PL",null,null,null,"unresolved",51.0,20.0,"Poland",null,"anaerobic digestate","anaerobic digester effluent","digested material","environmental sample; urban association not established"],["SAMN30948437","digestate grass mezophilic 30 days","uncertain",null,null,2021