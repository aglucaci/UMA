{"v":1,"accession":"PRJNA1224811","title":"Aerobic granular sludge from wastewater treatment Raw sequence reads","description":"This study investigates the impact of intermittent aeration on the structure and microbial community of aerobic granular sludge in wastewater treatment. Four reactors were operated under different aeration strategies to evaluate the effects on granule compactness, organic matter, and nitrogen removal efficiency. The microbial diversity and abundance were assessed using 16S rDNA sequencing, with taxonomic classification based on the SILVA database. The findings contribute to understanding how operational conditions influence sludge granulation and microbial composition, providing insights for optimizing wastewater treatment processes.","center":"Federal University of Rio de Janeiro","data_type":"Raw sequence reads","submission_date":"2025/02/17 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN46867490","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2023-08-07",2023,"ES","Andalusia",2517117,"Granada","verified",37.1832,-3.6157,"Spain: Granada, Granada","wastewater",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN46867543","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2023-08-17",2023,"ES","Andalusia",2517117,"Granada","verified",37.1832,-3.6157,"Spain: Granada, Granada","wastewater",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN46867552","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2023-08-17",2023,"ES","Andalusia",2517117,"Granada","verified",37.1832,-3.6157,"Spain: Granada, Granada","wastewater",null,null,null,"conflicting evidence: environmental a