{"v":1,"accession":"PRJNA817560","title":"Antibiotic resistomes and microbial communities in biosolid fertilizers collected from two Canadian wastewater treatment plants in a 10-year interval","description":"Dissemination of microorganisms with antimicrobial resistance genes (ARGs) through the food chain has been recognized as a growing public health concern worldwide. Biosolids from wastewater treatment plants (WWTPs), commonly used as fertilizers in agriculture globally, have been considered a potential source of pathogens and ARGs for agriculture and environments. This project characterizes antibiotic resistomes and microbiota in biosolid samples collected from two Canadian WWTPs in different cities in 2009 and 2019.","center":"Canadian Food Inspection Agency","data_type":"Raw sequence reads","submission_date":"2022/03/18 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN26795495","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater",null,2019,"CA",null,null,null,"unresolved",null,null,"Canada","wastewater",null,null,null,"urban context stated at BioProject level only"],["SAMN26795496","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater",null,2019,"CA",null,null,null,"unresolved",null,null,"Canada","wastewater",null,null,null,"urban context stated at BioProject level only"],["SAMN26795497","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater",null,2019,"CA",null,null,null,"unresolved",null,null,"Canada","wastewater",null,null,null,"urban context stated at BioProject level only"],["SAMN26795498","Metagenome or environmental sample from wastewater metagenome","probable_urban","mun