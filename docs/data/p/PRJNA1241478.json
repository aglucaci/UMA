{"v":1,"accession":"PRJNA1241478","title":"Anaerobic digestion sludge metagenome","description":"In this study, two anaerobic membrane bioreactors were operated in parallel: one conventional (R1) and one integrated electrochemical components (R2). Both bioreactor systems featured a submerged membrane unit within a cylindrical anaerobic digester. The biofilm cake layer samples of the bioreactor membranes were gathered and freeze-dried for 48 h for metagenomic analysis from the viewpoint of microorganisms and genes. The abundance of genes was summed to calculate the abundance of functional categories.","center":"Tongji University","data_type":"Metagenome","submission_date":"2025/03/25 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN47543396","Microbe sample from Methanobacteriaceae archaeon","uncertain",null,"2024-08-08",2024,"CN","Shanghai",1796236,"Shanghai","verified",31.28,121.5,"China: Shanghai","wastewater treatment process",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN47543397","Microbe sample from archaeon","uncertain",null,"2024-08-08",2024,"CN","Shanghai",1796236,"Shanghai","verified",31.28,121.5,"China: Shanghai","wastewater treatment process",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN47543398","Microbe sample from Methanothrix sp.","uncertain",null,"2024-08-08",2024,"CN","Shanghai",1796236,"Shanghai","verified",31.28,121.5,"China: Shanghai","wastewater treatment process",null,null,null,"conflicting evidence: environmental and host/clinical"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR32844785","SAMN47543398","SRX28127322","WGS"