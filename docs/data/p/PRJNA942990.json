{"v":1,"accession":"PRJNA942990","title":"UASB sludge Raw sequence reads","description":"This study was to elucidate the multiple strategies employed by microbes, especially the AHL-mediated QS, to form anaerobic granular sludge. To this end, a laboratory UASB reactor was operated with synthetic feed to allow the formation of granular sludge; AHLs and EPS concentrations, granule sizes, and microbial community structure in the UASB were continuously monitored to reveal the correlation between AHL and anaerobic sludge granulation. This study sheds new light in the mechanism of anaerobic sludge granulation, and opens up new operating strategies for fast and stable bioprocesses engaging granular sludge.","center":"Shantou University","data_type":"Raw sequence reads","submission_date":"2023/03/09 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN33707185","D0A","uncertain",null,"2019-01-01",2019,null,null,null,null,"unresolved",null,null,null,"anaerobic sludge",null,null,null,"environmental sample; urban association not established"],["SAMN33707186","D0B","uncertain",null,"2019-01-01",2019,null,null,null,null,"unresolved",null,null,null,"anaerobic sludge",null,null,null,"environmental sample; urban association not established"],["SAMN33707187","D0C","uncertain",null,"2019-01-01",2019,null,null,null,null,"unresolved",null,null,null,"anaerobic sludge",null,null,null,"environmental sample; urban association not established"],["SAMN33707188","D1A","uncertain",null,"2019-01-02",2019,null,null,null,null,"unresolved",null,null,null,"anaerobic sludge",null,null,null,"environmental sample; urban association not established"],["SAMN33707189","D1B","uncertain",null,"2019-01-02",2019,null,null,null,null,"unresolved",null,null,null,"anaerobic slud