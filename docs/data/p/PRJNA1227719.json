{"v":1,"accession":"PRJNA1227719","title":"16S rRNA Gene Sequencing of Throat Swabs, Feces, and Environmental Samples from Farmers, Pigs, and Controls for Microbial Community Profiling","description":"This project involves the analysis of microbiomes from diverse samples, including throat swabs from farmers, control populations, pig feces, wastewater, and bioaerosols. The samples were collected to investigate the microbial diversity and potential pathogen reservoirs in agricultural and environmental settings. Full-length 16S rRNA gene sequencing was employed to characterize the bacterial communities present in these samples. The study aims to enhance our understanding of the relationship between farm environments, human populations, and animal microbiomes, with a particular focus on identifying potential zoonotic pathogens and environmental factors influencing microbial communities.","center":"Sun Yat-Sen University","data_type":"Raw sequence reads","submission_date":"2025/02/25 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN46991277","Wastewater samples for 16S rRNA gene sequencing in Guilin","probable_urban","municipal_wastewater","2020-11-01",2020,"CN","Guangxi",1809498,"Guilin","verified",25.27,110.34,"China:Guilin","wastewater",null,null,null,"city-level location without sample-site confirmation"],["SAMN46991278","Wastewater samples for 16S rRNA gene sequencing in Guilin","probable_urban","municipal_wastewater","2020-11-01",2020,"CN","Guangxi",1809498,"Guilin","verified",25.27,110.35,"China:Guilin","wastewater",null,null,null,"city-level location without sample-site confirmation"],["SAMN46991279","Wastewater samples for 16S rRNA gene sequencing in Guilin","probable_urban","municipal_wastewater","2020-11-01",2020,"CN","Gua