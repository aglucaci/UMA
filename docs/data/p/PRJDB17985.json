{"v":1,"accession":"PRJDB17985","title":"microbial community of activated sludge in municipal wastewater treatment plants","description":"We developed a model to detect protozoa and metazoa living in activated sludge from microscopic images, and applied this model to multiple samples of activated sludge. Furthermore, we performed 16S rRNA amplicon sequencing and 18S rRNA amplicon sequencing on the activated sludge samples, and compared the diversity obtained from the amplicon sequencing with the diversity obtained from the image analysis. This data is the genetic data obtained from the experiments.","center":"The University of Tokyo","data_type":"Targeted Locus (Loci)","submission_date":"2024/04/23 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00770506","ActivatedSludge-A-20211013","probable_urban","municipal_wastewater","2021-10-13",2021,"JP","Tokyo",1850147,"Tokyo","probable",null,null,"Japan:Tokyo",null,"sludge [ENVO:00002044]","wastewater [ENVO:00002001]","activated sludge [ENVO:00002046]","city-level location without sample-site confirmation"],["SAMD00770507","ActivatedSludge-A-20211026","probable_urban","municipal_wastewater","2021-10-26",2021,"JP","Tokyo",1850147,"Tokyo","probable",null,null,"Japan:Tokyo",null,"sludge [ENVO:00002044]","wastewater [ENVO:00002001]","activated sludge [ENVO:00002046]","city-level location without sample-site confirmation"],["SAMD00770508","ActivatedSludge-A-20211108","probable_urban","municipal_wastewater","2021-11-08",2021,"JP","Tokyo",1850147,"Tokyo","probable",null,null,"Japan:Tokyo",null,"sludge [ENVO:00002044]","wastewater [ENVO:00002001]","activated sludge [ENVO:00002046]","city-level location without sample-site confirmation"],["SAMD00770509","ActivatedSludge-A-20211117","probable_u