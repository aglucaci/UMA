{"v":1,"accession":"PRJNA925793","title":"Dust from waste-sorting plants","description":"This data belongs to the manuscript: \"Divergent TLR2 and TLR4 activation by fungal spores and species diversity in dust from waste-sorting plants\". This manuscript presents the results of an exploratory study on the relationships between NFkB (Nuclear Factor Kappa Chain Enhancer of B-cells) response through toll-like receptors (TLRs) activation by dust characterized by fungal spore concentrations and species diversity. Personal total dust samples were collected from Norwegian waste sorting plants and then characterized for fungal spores and fungal species diversity, as well as for other bioaerosol components, including endotoxins and actinobacteria.","center":"National Institute of Occupational Health","data_type":"Raw sequence reads","submission_date":"2023/01/20 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN32807644","D1","uncertain",null,null,2017,"NO",null,null,null,"unresolved",null,null,"Norway","Filter_1","Air biome","Waste-sorting plant","Dust","environmental sample; urban association not established"],["SAMN32807645","D2","uncertain",null,null,2017,"NO",null,null,null,"unresolved",null,null,"Norway","Filter_2","Air biome","Waste-sorting plant","Dust","environmental sample; urban association not established"],["SAMN32807646","D3","uncertain",null,null,2017,"NO",null,null,null,"unresolved",null,null,"Norway","Filter_3","Air biome","Waste-sorting plant","Dust","environmental sample; urban association not established"],["SAMN32807647","D4","uncertain",null,null,2017,"NO",null,null,null,"unresolved",null,null,"Norway","Filter_4","Air biome","Waste-sorting plant","Dust","environmental sample; urban association not established"],["SAM