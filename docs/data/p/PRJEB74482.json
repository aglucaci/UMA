{"v":1,"accession":"PRJEB74482","title":"Effects of mouse-to-mouse fecal microbiota transplantation on vascular function with age and diet","description":"Transplantation of fecal microbiota from young mice into old mice improved endothelium-dependent dilation to acetylcholine (P = 0.05) and reduced aortic stiffness (P = 0.005), whereas transplanting old microbiota into young mice had the opposite effect. Collectively, these findings implicate the gut microbiome as a contributor to vascular dysfunction with aging, possibly via activation of proinflammatory pathways.","center":"University of California San Diego Microbiome Initiative","data_type":"Other","submission_date":"2024/04/05 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA115463530",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evidence"],["SAMEA115463531",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evidence"],["SAMEA115463532",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evidence"],["SAMEA115463533",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evidence"],["SAMEA115463534",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evidence"],["SAMEA115463535",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evidence"],["SAMEA115463536",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,n