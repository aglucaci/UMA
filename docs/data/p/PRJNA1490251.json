{"v":1,"accession":"PRJNA1490251","title":"Microalgal-bacterial granular sludge (MBGS) under different light/dark cycles","description":"This dataset provides metagenomic sequencing information from microalgal-bacterial granular sludge (MBGS) systems operated under different light/dark cycles (LDCs) (12 h/12 h, 4 h/4 h, and 2 h/2 h). It was generated to elucidate LDC-driven microbial selection, functional differentiation, and nitrogen transformation pathways in algal-bacterial wastewater treatment systems. This dataset may facilitate further studies on microbial ecology and metabolic regulation in light-driven biological wastewater treatment processes.","center":"chongqing university","data_type":"Raw sequence reads","submission_date":"2026/07/05 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN61419146","Y1_2.R1","probable_urban","municipal_wastewater",null,2024,"CN","Chongqing",1814906,"Chongqing","probable",null,null,"China: Chongqing","reactor samples",null,null,null,"city-level location without sample-site confirmation"],["SAMN61419148","Y1_3.R1","probable_urban","municipal_wastewater",null,2025,"CN","Chongqing",1814906,"Chongqing","probable",null,null,"China: Chongqing","reactor samples",null,null,null,"city-level location without sample-site confirmation"],["SAMN61419150","Y2_2.R1","probable_urban","municipal_wastewater",null,2024,"CN","Chongqing",1814906,"Chongqing","probable",null,null,"China: Chongqing","reactor samples",null,null,null,"city-level location without sample-site confirmation"],["SAMN61419152","Y2_3.R1","probable_urban","municipal_wastewater",null,2025,"CN","Chongqing",1814906,"Chongqing","probable",null,null,"China: Chongqing","reactor samples",null,null,null,"city-level location without sample-site confi