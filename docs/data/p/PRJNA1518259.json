{"v":1,"accession":"PRJNA1518259","title":"Metagenomic and single-cell genomic dynamics of hospital wastewater under short-term meropenem exposure","description":"This project investigates antimicrobial resistance (ARG) and mobile genetic element (MGE) dynamics in hospital wastewater during short-term meropenem exposure. Using combined metagenomics and single-cell genomics (SAGs), we track community- and host-level responses across a three-hour time course. The dataset provides high-resolution insights into resistance contraction, ARG-MGE co-carriage turnover, and the distribution of blaKPC-2-associated genetic structures across diverse bacterial hosts.","center":"MobiDrop (Shanghai) Co., Ltd.","data_type":"Raw sequence reads","submission_date":"2026/08/25 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN62683948","Hospital wastewater single-cell sample, T0 (0 h, pre-meropenem)","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"hospital wastewater",null,null,null,"environmental sample; urban association not established"],["SAMN62683949","Hospital wastewater single-cell sample, T1 (1 h meropenem exposure)","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"hospital wastewater",null,null,null,"environmental sample; urban association not established"],["SAMN62683950","Hospital wastewater single-cell sample, T3 (3 h meropenem exposure)","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"hospital wastewater",null,null,null,"environmental sample; urban association not established"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR40338698","SA