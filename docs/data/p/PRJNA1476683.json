{"v":1,"accession":"PRJNA1476683","title":"Microbial community analysis of anaerobic digestion under trace element supplementation","description":"This project investigates microbial community structures in anaerobic digestion systems using 16S rRNA gene amplicon sequencing. The study aims to evaluate the effects of trace element (Ni and Co) supplementation on microbial community composition, process stability, and methane production. High-throughput sequencing was applied to characterize bacterial and archaeal populations associated with different experimental conditions. The generated data provide insights into the microbial mechanisms underlying anaerobic digestion performance and support the reproducibility and transparency of the study.","center":"JEJU NATIONAL UNIVERSITY","data_type":"Raw sequence reads","submission_date":"2026/06/09 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN60724631","MIMARKS Survey related sample from anaerobic digester metagenome","probable_urban","municipal_wastewater",null,2025,"KR","Jeju-do",1846266,"Jeju City","verified",null,null,"South Korea: Jeju",null,"engineered environment","anaerobic digester","anaerobic sludge","city-level location without sample-site confirmation"],["SAMN60724632","MIMARKS Survey related sample from anaerobic digester metagenome","probable_urban","municipal_wastewater",null,2025,"KR","Jeju-do",1846266,"Jeju City","verified",null,null,"South Korea: Jeju",null,"engineered environment","anaerobic digester","anaerobic sludge","city-level location without sample-site confirmation"],["SAMN60724633","MIMARKS Survey related sample from anaerobic digester metagenome","probable_urban","municipal_wastewater",null,2025,"KR","Jeju-do",1846266,"Jeju City","verified",null,null,"Sou