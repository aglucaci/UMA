{"v":1,"accession":"PRJNA1477390","title":"Shotgun metagenomics and metatranscriptomics of naproxen-metabolizing microbial consortia enriched from WWTPs","description":"This BioProject includes shotgun metagenomic and metatranscriptomic sequencing data generated from microbial consortia enriched from wastewater treatment plants (WWTPs) using naproxen as the target substrate. The datasets were produced to characterize the microbial community structure, functional gene content, and gene expression profiles associated with naproxen metabolism. Metagenomic sequencing was used to assess the taxonomic and functional composition of the consortia, while metatranscriptomic sequencing was performed to identify genes and pathways actively expressed during naproxen degradation. The resulting datasets provide a comprehensive resource for investigating microbial processes involved in the biodegradation of pharmaceutical pollutants in wastewater environments.","center":"Universidad de Salamanca","data_type":"Raw sequence reads","submission_date":"2026/06/11 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN60754766","Consortium MPO979","confirmed_urban","municipal_wastewater",null,2021,"ES","Andalusia",2510911,"Sevilla","verified",37.31,-5.99,"Spain: Seville","Wastewater treatment plant",null,null,null,"named urban infrastructure at sample level"],["SAMN60754767","Consortium MPO981","confirmed_urban","municipal_wastewater",null,2021,"ES","Andalusia",2510911,"Sevilla","verified",37.31,-5.99,"Spain: Seville","Wastewater treatment plant",null,null,null,"named urban infrastructure at sample level"],["SAMN60754768","Consortium 2npx","confirmed_urban","municipal_wastewater",null,2021,"ES","Andalusia",2510911,"Sevilla","verified",37.31,-5.99,"Spain: S