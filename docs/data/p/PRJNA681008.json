{"v":1,"accession":"PRJNA681008","title":"Metagenome of the built environment: Cleanrooms and spacecraft assembly facilities at the Jet Propulsion Laboratory","description":"The Jet Propulsion Laboratory (JPL) Biotechnology and Planetary Protection Group has been monitoring the microbial burden of spacecraft since the Viking mission. Originally, culture-based techniques were used. More recently, amplicon-based and metagenomics approaches are being applied to increase the sensitivity of surveillance. We applied whole metagenomic sequencing to a variety of ISO cleanroom samples at the JPL, including the spacecraft assembly facility (SAF). These included samples from HEPA and ULPA filters and surface wipe samples.","center":"Translational Genomics","data_type":"Raw sequence reads","submission_date":"2020/11/26 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN16929104","Metagenome or environmental sample from indoor metagenome","non_urban",null,"2019-04-02",2019,"US","California",5368361,"Los Angeles","probable",34.2,-118.17,"USA","Cleanroom 170_213",null,null,null,"environmental sample from a non-urban site"],["SAMN16929105","Metagenome or environmental sample from indoor metagenome","non_urban",null,"2019-04-02",2019,"US","California",5368361,"Los Angeles","probable",34.2,-118.17,"USA","Facility Control",null,null,null,"environmental sample from a non-urban site"],["SAMN16929106","Metagenome or environmental sample from indoor metagenome","non_urban",null,"2019-04-01",2019,"US","California",5368361,"Los Angeles","probable",34.2,-118.17,"USA","Cleanroom 233_151",null,null,null,"environmental sample from a non-urban site"],["SAMN16929107","Metagenome or environmental sample from indoor metagenome","non_urban",null,"2019-04-12",2019,