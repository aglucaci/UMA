{"v":1,"accession":"PRJNA759379","title":"Air metagenome during and after the 2014 Beijing APEC Summit","description":"During the APEC conference in Beijing, the government made the air quality assurance program, including imposing the odd-even traffic rule for motor vehicles and reducing or halting production in factories. To investigate changes in atmospheric bacteria when human activities were partially restricted, we collected a total of 29 PM2.5 samples aside from the traffic road in Beijing. Seventeen samples were collected continuously during and after the 2014 Beijing APEC summit. Twelve samples were collected in 2015, covering Spring, Autumn, and Winter seasons.","center":"Peking University","data_type":"Targeted loci environmental","submission_date":"2021/09/01 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN21165718","MIMS Environmental/Metagenome sample from air metagenome","confirmed_urban","air_dust","2014-11-10",2014,"CN","Beijing",1816670,"Beijing","verified",39.9832,116.3155,"China: Beijing",null,"Urban","Peking University Campus","air","explicit urban setting at sample level"],["SAMN21165719","MIMS Environmental/Metagenome sample from air metagenome","confirmed_urban","air_dust","2014-11-11",2014,"CN","Beijing",1816670,"Beijing","verified",39.9832,116.3155,"China: Beijing",null,"Urban","Peking University Campus","air","explicit urban setting at sample level"],["SAMN21165720","MIMS Environmental/Metagenome sample from air metagenome","confirmed_urban","air_dust","2014-11-12",2014,"CN","Beijing",1816670,"Beijing","verified",39.9832,116.3155,"China: Beijing",null,"Urban","Peking University Campus","air","explicit urban setting at sample level"],["SAMN21165721","MIMS Environmental/Metagenome sample from air metage