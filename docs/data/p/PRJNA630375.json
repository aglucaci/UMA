{"v":1,"accession":"PRJNA630375","title":"Sewage sludge compost influences the soil microbiome","description":"Recently, composted sewage sludge (CSS) gained attention as a potential fertilizer in agriculture. Application of CSS increases soil microbial activity and microbial biomass, however, it could also lead to increased chemical and microbiological risks. In this study, we performed microcosm experiments to assess how CSS reshapes the microbial community of diluvial sand (DS) soil.","center":"Institute of Agriculture and Tourism","data_type":"Raw sequence reads","submission_date":"2020/05/05 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN14833192","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2017-07-17",2017,"HR","Istria",3203090,"Buje","verified",45.41,13.63,"Croatia: Buje","Croatia: Buje",null,null,null,"city-level location without sample-site confirmation"],["SAMN14833193","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2017-07-17",2017,"HR","Istria",3203090,"Buje","verified",45.41,13.63,"Croatia: Buje","Croatia: Buje",null,null,null,"city-level location without sample-site confirmation"],["SAMN14833194","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2017-07-17",2017,"HR","Istria",3203090,"Buje","verified",45.41,13.63,"Croatia: Buje","Croatia: Buje",null,null,null,"city-level location without sample-site confirmation"],["SAMN14833195","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2017-07-17",2017,"HR","Istria",3203090,"Buje","verified",45.41,13.63,"Croatia: Buje","Croatia: Buje",null,null,null,"city-level