{"v":1,"accession":"PRJDB7446","title":"Effects of conductive carbon nanomaterials on methanogens","description":"Nano-sized conductive carbon materials have been reported to stimulate methanogenesis by anaerobic microbiomes, while other studies have shown their antibiotic effects on methanogenic and other microbes. The present study examined effects of conductive carbon nanoparticles (carbon black Valcan, CB) on methanogenesis by anaerobic-digester sludge. We found that a high concentration (2% w/v) of CB substantially inhibited methanogenesis from glucose, where acetate was accumulated. Pyrosequencing of 16S rRNA gene fragments amplified from methanogenic sludge samples revealed that methanogens specifically decreased in the presence of CB, suggesting that methanogens are severely damaged by CB.","center":"Tokyo University of Pharmacy and Life Sciences","data_type":"Targeted Locus (Loci)","submission_date":"2019/06/13 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00138520","CB1","uncertain",null,null,2016,"JP","Tokyo",1863440,"Hachiōji","verified",35.6693,139.4257,"Japan:Tokyo, Hachioji",null,"anaerobic","anaerobic sludge","water","environmental sample; urban association not established"],["SAMD00138521","CB2","uncertain",null,null,2016,"JP","Tokyo",1863440,"Hachiōji","verified",35.6693,139.4257,"Japan:Tokyo, Hachioji",null,"anaerobic","anaerobic sludge","water","environmental sample; urban association not established"],["SAMD00138522","CB3","uncertain",null,null,2016,"JP","Tokyo",1863440,"Hachiōji","verified",35.6693,139.4257,"Japan:Tokyo, Hachioji",null,"anaerobic","anaerobic sludge","water","environmental sample; urban association not established"],["SAMD00138523","CB4","uncertain",null,null,2016,"JP","Tokyo",1863440,"Ha