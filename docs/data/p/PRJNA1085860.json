{"v":1,"accession":"PRJNA1085860","title":"A synthetic biofilm community for efficient phosphorus removal from high-salinity wastewater","description":"Using bioinformatics methods, 12 potential phosphorus-removing bacterial strains were screened from the existing marine biofilm germplasm bank in the laboratory and synthesized into a community. The community was cultured in normal 2216 liquid medium and 2216 liquid medium with 20 mg/L P-PO4- for 24 h respectively, and then the metatranscriptome was extracted to explore the metabolic changes of the community in a phosphorus-rich environment.","center":"Ocean University of China","data_type":"Raw sequence reads","submission_date":"2024/03/09 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN40348676","Microbe sample from Psychrobacter","uncertain",null,"2023-08-15",2023,"CN","Shandong",1797929,"Qingdao","verified",null,null,"China:Qingdao","marine biofilm",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN40348677","Microbe sample from Psychrobacter","uncertain",null,"2023-08-15",2023,"CN","Shandong",1797929,"Qingdao","verified",null,null,"China:Qingdao","marine biofilm",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN40348678","Microbe sample from Psychrobacter","uncertain",null,"2023-08-15",2023,"CN","Shandong",1797929,"Qingdao","verified",null,null,"China:Qingdao","marine biofilm",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN40348679","Microbe sample from Psychrobacter","uncertain",null,"2023-08-15",2023,"CN","Shandong",1797929,"Qingdao","verified",null,null,"China:Qingdao","marine biofilm",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN40348680","Microbe sam