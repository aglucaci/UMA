{"v":1,"accession":"PRJNA1489350","title":"Microbial community dynamics of reactor sludge under low-temperature bioaugmentation","description":"This study aims to investigate the dynamic succession of microbial communities in reactor sludge during a bioaugmentation process under low-temperature conditions. To understand the temporal effects of bioaugmentation, sludge samples were collected from both a control reactor (stable phase) and an experimental reactor at different time points (days 1, 3, 5, 10, 15, 20, and 30). High-throughput sequencing was employed to analyze the microbial composition and diversity of these samples in biological triplicates. The findings of this project will provide valuable insights into the ecological mechanisms of low-temperature bioaugmentation and its potential application in enhancing reactor performance in cold environments.","center":"Taiyuan University of Technology","data_type":"Raw sequence reads","submission_date":"2026/07/03 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN61286359","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2024-02-19",2024,"CN","Shanxi",1793511,"Taiyuan","verified",37.87,112.55,"China: Shanxi, Taiyuan",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN61286360","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2024-02-19",2024,"CN","Shanxi",1793511,"Taiyuan","verified",37.87,112.56,"China: Shanxi, Taiyuan",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN61286361","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2024-02-19",2024,"CN","Shanxi",179351