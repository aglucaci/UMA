{"v":1,"accession":"PRJNA319356","title":"International Space Station Microbial Observatory - Antimicrobial Resistance Study","description":"The environmental samples were collected with the polyester wipes from eight different locations in the International Space Station (ISS) during two consecutive sampling sessions (two months apart) within the ISS Microbial Observatory Experiment. DNA extracted from each of the samples was used to create amplicon libraries based on customized panel of 500 antimicrobial resistance genes followed by next-generation sequencing. This is the first study of that shows the reservoir of antimicrobial genes in the ISS.","center":"Jet Propulsion Laboratory, California Institute of Technology","data_type":"Raw sequence reads","submission_date":"2016/04/22 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN05581696","Flight 1, location 1","non_urban",null,"2015-03-05",2015,"US",null,null,null,"unresolved",null,null,"USA: International Space Station","International Space Station, environmental surface",null,null,null,"environmental sample from a non-urban site"],["SAMN05581697","Flight 1, location 2","non_urban",null,"2015-03-05",2015,"US",null,null,null,"unresolved",null,null,"USA: International Space Station","Waste and hygiene compartment Node 3 'F4'",null,null,null,"environmental sample from a non-urban site"],["SAMN05581698","Flight 1, location 3","non_urban",null,"2015-03-05",2015,null,null,null,null,"unresolved",null,null,null,"International Space Station, environmental surface",null,null,null,"environmental sample from a non-urban site"],["SAMN05581699","Flight 1, location 4","non_urban",null,"2015-03-05",2015,"US",null,null,null,"unresolved",null,null,"USA: International Space Station","Dining tab