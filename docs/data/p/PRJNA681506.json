{"v":1,"accession":"PRJNA681506","title":"The influence of organic fertilizers on soil microbiota within 2 years","description":"We hypothesized that organic fertilizers increase the abundance of pathogenic microorganisms in amended soil; however, their occurrence might be just temporary, and their levels decreased within the time from the last fertilization. To prove this hypothesis, we used field trials established in 1996, where the sewage sludge and manure amendments were regularly applied every third year. We monitored the levels of potentially pathogenic microorganisms at different times since the fertilizer application in September 2015.","center":"University of chemistry and technology Prague","data_type":"Raw sequence reads","submission_date":"2020/11/30 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN16955082","sewage sludge applied on soil in 2015","non_urban",null,null,2015,"CZ","Prague",3067696,"Prague","probable",50.1278,14.3758,"Czech Republic",null,"farm","sewage sludge","sewage sludge","environmental sample from a non-urban site"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR13165730","SAMN16955082","SRX9604642","Amplicon","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina MiSeq",4895435,9084,"2022-01-21","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos1/sra-pub-zq-38/SRR013/13165/SRR13165730/SRR13165730.lite.1"],["SRR13165731","SAMN16955082","SRX9604641","Amplicon","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina MiSeq",4380330,8140,"2022-01-21","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos1/sra-pub-zq-38/SRR013/13165/SRR13165731/SRR13165731.lite.1"],["SRR13165732","SAMN1695