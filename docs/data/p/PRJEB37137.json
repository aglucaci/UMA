{"v":1,"accession":"PRJEB37137","title":"Microbiological cycling ofmethane and Nitrogen in a wastewater treatment plant in The Netherlands","description":"The efficient removal of nitrogen from wastewater is of key importance to prevent deoxygenation and eutrophication of the receiving water bodies. Traditionally, nitrogenous compounds have been removed by a combination of nitrification and denitrification. More recently, the anaerobic ammonium oxidation (anammox) process has been applied in wastewater treatment plants. In addition to nitrogen, the concentration of dissolved methane can also be high in these systems. Methane is a potent greenhouse gas and emission to the atmosphere has to be minimized in order to reduce global warming.","center":"RADBOUD UNIVERSITY NIJMEGEN","data_type":"Other","submission_date":"2020/05/09 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA6614921","nitrogen and methane in a WWTP, starting sludge","confirmed_urban","municipal_wastewater",null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"named urban infrastructure at sample level"],["SAMEA6614922","nitrogen and methane in a WWTP, 4 mnths","confirmed_urban","municipal_wastewater",null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"named urban infrastructure at sample level"],["SAMEA6614923","nitrogen and methane in a WWTP, 14 mnths","confirmed_urban","municipal_wastewater",null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"named urban infrastructure at sample level"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["ERR3981082","SAMEA6614923","ERX39834