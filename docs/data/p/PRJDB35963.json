{"v":1,"accession":"PRJDB35963","title":"Quantification of Cefotaxime-Resistant Escherichia coli and Class 1 Integron Integrase Genes as Key Indicators of Antimicrobial Resistance in Urban Wastewater in Two Cities in Japan","description":"Antimicrobial resistance (AMR) is a pressing global health threat. Wastewater surveillance is a promising approach to comprehensively evaluate the prevalence of antimicrobial resistant bacteria and antimicrobial resistance genes in the urban areas. Although cefotaxime-resistant E. coli and class 1 integron integrase gene were proposed as key indicators of AMR, their levels in wastewater in Japan remain unknown. This study quantified these parameters in wastewater samples collected every two months from two cities in Japan. Metagenomic analysis with hybrid capture enrichment identified dominant genes conferring resistance to tetracyclines, aminoglycosides, beta-lactams, and macrolides, with a particular focus on ESBL, carbapenemase, and colistin resistance genes.","center":"The University of Tokyo","data_type":"Other","submission_date":"2025/08/27 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD01614213","Influent_City_A_Jun_2024","probable_urban","municipal_wastewater","2024-06-27",2024,"JP",null,null,null,"unresolved",null,null,"Japan","domestic wastewater",null,null,null,"urban context stated at BioProject level only"],["SAMD01614214","Influent_City_A_Aug_2024","probable_urban","municipal_wastewater","2024-08-22",2024,"JP",null,null,null,"unresolved",null,null,"Japan","domestic wastewater",null,null,null,"urban context stated at BioProject level only"],["SAMD01614215","Influent_City_A_Oct_2024","probable_urban","municipal_wastewater","2024-10-17",2024,"JP",null,null,null,"unresolved",null,nu