{"v":1,"accession":"PRJNA485391","title":"Response of acetate-degrading methanogenic microbial community to inhibitors","description":"Investigating the effects of kinds of inhibitors on the activity of the acetate-degrading microbial community in methane fermentation is critically important for making countermeasures to decrease inhibition and keep stable operation. In this study, a mesophilic chemostat fed with acetate as the sole carbon source was construct and the dynamic change of acetate-degrading microbial community under the conditions with different concentrations of inhibitors (sulfide, ammonium, chlortetracycline and enrofloxacin) were investigated by using high-throughput sequencing.","center":"Sichuan University","data_type":"Raw sequence reads","submission_date":"2018/08/10 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN09789173","AML-N","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"anaerobic sludge sample",null,null,null,"environmental sample; urban association not established"],["SAMN09789174","AN-18(1)","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"anaerobic sludge sample",null,null,null,"environmental sample; urban association not established"],["SAMN09789175","AN-18(2)","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"anaerobic sludge sample",null,null,null,"environmental sample; urban association not established"],["SAMN09789176","N1-18(1)","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"anaerobic sludge sample",null,null,null,"environmental sample; urban association not established"],["SAMN09789177","N1-18(2)","uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,"anaerobi