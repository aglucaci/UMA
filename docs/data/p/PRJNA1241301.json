{"v":1,"accession":"PRJNA1241301","title":"Metagenomic Whole Genome Shotgun Analysis of the Airway Microbiome in Laryngotracheal Stenosis: A Pilot study","description":"The airway microbiome has been implicated in the pathogenesis of laryngotracheal stenosis (LTS), yet studies using amplicon-based 16S rRNA sequencing are limited to sub-genus level resolution. Metagenomic whole genome shotgun sequencing (mWGS) allows for strain-level taxonomic and functional genomic analysis, providing detailed insights into the specific organisms and pathways involved. A pilot study was conducted to explore the feasibility, advantages, and challenges of mWGS in investigating the airway metagenome in LTS","center":"University of Cincinnati","data_type":"Metagenome","submission_date":"2025/03/24 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN47552728","Human Airway Metagenome - Control_1","non_environmental",null,"2022-12-22",2022,"US","Ohio",4508722,"Cincinnati","verified",39.1393,-84.506,"USA: Ohio, Cincinnati",null,"human respiratory system biome [ENVO:01001779]|host-associated biome [ENVO:00002030]|mucosal surface biome [ENVO:01000254]","hospital building [ENVO:01000254]|mucosal surface [ENVO:01000254]","host-associated material [ENVO:00002006]","host-derived or clinical material"],["SAMN47552729","Human Airway Metagenome - Stenotic Airway_3","non_environmental",null,"2023-10-05",2023,"US","Ohio",4508722,"Cincinnati","verified",39.1393,-84.506,"USA: Ohio, Cincinnati",null,"human respiratory system biome [ENVO:01001779]|host-associated biome [ENVO:00002030]|mucosal surface biome [ENVO:01000254]","hospital building [ENVO:01000254]|mucosal surface [ENVO:01000254]","host-associated material [ENVO:00002006]","host-derived or clinical material"],[