{"v":1,"accession":"PRJDB20552","title":"Analysis of microbial community structure in a photosynthetic reactor used for secondary treatment in microbial fuel cells","description":"This project explore the microbial community in two photosynthesis reactors. Sampling sites were chosen to represent diverse areas where microbial presence could influence the performance of the photosynthetic process, including site B-F1-IN, B-F1-S, B-F1-FB, B-F1-W; B-F2-IN, B-F2-S, B-F2-FB, B-F2-W; A-F1-IN, A-F1-S, A-F1-FB, A-F1-W; and A-F2-IN, A-F2-S, A-F2-FB, A-F2-W. In this notation, B and A referred to samples taken Phase I and Phase II of reactors, respectively; F1 and F2 represented photosynthesis reactors 1 and 2; and IN, S, FB, and W indicated that the samples were collected from the influent, solution, fibers, and walls of the reactors, respectively. including","center":"Nagoya Institute of Technology","data_type":"Targeted Locus (Loci)","submission_date":"2025/04/21 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00896959","Influence of reactor 1-before removing biomass 16S","uncertain",null,"2024-03-11",2024,"JP","Aichi",1856057,"Nagoya","verified",35.1268,136.9786,"Japan:Aichi, Nagoya",null,"aquatic biome","seawage","seawage","no environmental-sample evidence"],["SAMD00896960","In sollution of reactor 1-before removing biomass 16S","uncertain",null,"2024-03-11",2024,"JP","Aichi",1856057,"Nagoya","verified",35.1268,136.9786,"Japan:Aichi, Nagoya",null,"aquatic biome","seawage","seawage","no environmental-sample evidence"],["SAMD00896961","On the wall of reactor 1-before removing biomass 16S","uncertain",null,"2024-03-11",2024,"JP","Aichi",1856057,"Nagoya","verified",35.1268,136.9786,"Japan:Aichi, Nagoya",null,"aquatic biome","seawage","sea