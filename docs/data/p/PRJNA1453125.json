{"v":1,"accession":"PRJNA1453125","title":"Microbial community dynamics in microalgae-bacteria systems for wastewater treatment","description":"This study investigates the microbial community dynamics in engineered microalgae-bacteria systems for wastewater treatment. High-throughput sequencing was performed to characterize microbial community structure and its response to varying operational conditions, including nutrient loading, hydraulic retention time, and chemical amendments. The generated dataset provides insights into microbial community assembly and functional adaptation in microalgae-bacteria consortia, supporting the development of more efficient and stable biological wastewater treatment processes.","center":"The Hong Kong Polytechnic University","data_type":"Raw sequence reads","submission_date":"2026/04/13 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN57254614","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater","2025-03-21",2025,"HK",null,1819729,"Hong Kong","probable",22.3058,114.1789,"China: Hong Kong",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN57254615","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater","2025-04-24",2025,"HK",null,1819729,"Hong Kong","probable",22.3058,114.1789,"China: Hong Kong",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN57254616","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater","2025-05-27",2025,"HK",null,1819729,"Hong Kong","probable",22.3058,114.1789,"China: Hong Kong",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN5725