{"v":1,"accession":"PRJNA935265","title":"The dark side of laundry: microbial odour profile and buildup of resistome and virulome","description":"Human clothing constitutes a highly dynamic ecosystem undergoing cycles of wearing, washing and drying during which textile fabrics are variably exposed to human skin, its residing microbiome and metabolites, as well as chemicals and washing water microbiota from the laundry process. This study yields insight into the odour-generating microbiome and can form the basis for innovative strategies to control laundry malodour.","center":"Ghent University","data_type":"Raw sequence reads","submission_date":"2023/02/15 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN33302165","Armpit_T0","non_environmental",null,null,2019,"BE",null,null,null,"conflicting",51.0528,3.7068,"Belgium: Bredene",null,"skin environment [ENVO:2100003]",null,null,"host-derived or clinical material"],["SAMN33302196","Armpit_T1","non_environmental",null,null,2019,"BE",null,null,null,"conflicting",51.0528,3.7068,"Belgium: Bredene",null,"skin environment [ENVO:2100003]",null,null,"host-derived or clinical material"],["SAMN33302227","Worn T-shirt","non_environmental",null,null,2019,"BE",null,null,null,"conflicting",51.0528,3.7068,"Belgium: Bredene",null,"cloth [ENVO:02000058]",null,null,"host-derived or clinical material"],["SAMN33302258","Dry-dried worn T-shirt","non_environmental",null,null,2019,"BE",null,null,null,"conflicting",51.0528,3.7068,"Belgium: Bredene",null,"cloth [ENVO:02000058]",null,null,"host-derived or clinical material"],["SAMN33302289","Humid-dried worn T-shirt","non_environmental",null,null,2019,"BE",null,null,null,"conflicting",51.0528,3.7068,"Belgium: Bredene",null,"cloth [ENVO:02000058]",null,null,"h