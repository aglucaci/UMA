{"v":1,"accession":"PRJNA1504466","title":"Water WWTP Metagenome","description":"Based on metagenomics methods, this study conducted measurements on water samples from a sewage treatment plant in Yinchuan City, focusing on screening antibiotic types. Erythromycin and ofloxacin were identified as the main target antibiotics based on high detection rates. Combined with environmental factor analysis, the occurrence patterns of resistance genes and their correlation with water quality factors were explored. Meanwhile, through host identification, the microbial groups potentially carrying resistance genes were preliminarily revealed, providing a scientific basis for risk prevention and control of resistance genes in sewage treatment plants.","center":"Ningxia University","data_type":"Metagenome","submission_date":"2026/07/29 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN62061502","Yinchuan No.2 WWTP outlet","confirmed_urban","municipal_wastewater","2024-09-02",2024,"CN","Ningxia",1786657,"Yinchuan","verified",null,null,"China: Yinchuan","anammox sludge",null,null,null,"named urban infrastructure at sample level"],["SAMN62061503","Dali WWTP Phase I outlet","confirmed_urban","municipal_wastewater","2024-09-02",2024,"CN","Ningxia",1786657,"Yinchuan","verified",null,null,"China: Yinchuan","anammox sludge",null,null,null,"named urban infrastructure at sample level"],["SAMN62061504","Dali WWTP Phase II outlet","confirmed_urban","municipal_wastewater","2024-09-02",2024,"CN","Ningxia",1786657,"Yinchuan","verified",null,null,"China: Yinchuan","anammox sludge",null,null,null,"named urban infrastructure at sample level"],["SAMN62061505","Yinchuan No.6 WWTP outlet","confirmed_urban","municipal_wastewater","2024-09-02",2024,"CN","Ningxia",1786