{"v":1,"accession":"PRJDB18223","title":"Green Infrastructure Enhances Microbial Communities in the Built Environment","description":"High microbial diversity offers extensive benefits to both the environment and human health, contributing to ecosystem stability, nutrient cycling, and pathogen suppression. In built environments, factors such as building design, human activity, and cleaning protocols influence microbial communities. This study investigates the impact of landscape design on microbial diversity and function within the \"Visionary Lab\" exhibition at the National Museum of Emerging Science and Innovation (Miraikan) in Tokyo, Japan, using 16s rRNA amplicon sequencing and shallow shotgun sequencing.","center":"BIOTA inc.","data_type":"Metagenome","submission_date":"2026/06/16 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00790909","amplicon-1","probable_urban","built_environment","2023-08-03",2023,"JP","Tokyo",1850147,"Tokyo","probable",null,null,"Japan:Tokyo",null,null,null,null,"city-level location without sample-site confirmation"],["SAMD00790911","shotgun-1","probable_urban","built_environment","2023-08-03",2023,"JP","Tokyo",1850147,"Tokyo","probable",null,null,"Japan:Tokyo",null,null,null,null,"city-level location without sample-site confirmation"],["SAMD00790913","shotgun-3","probable_urban","built_environment","2023-08-03",2023,"JP","Tokyo",1850147,"Tokyo","probable",null,null,"Japan:Tokyo",null,null,null,null,"city-level location without sample-site confirmation"],["SAMD00790915","amplicon-3","probable_urban","built_environment","2023-08-03",2023,"JP","Tokyo",1850147,"Tokyo","probable",null,null,"Japan:Tokyo",null,null,null,null,"city-level location without sample-site confirmation"],["SAMD00790917","shotgu