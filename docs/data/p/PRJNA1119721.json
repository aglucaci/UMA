{"v":1,"accession":"PRJNA1119721","title":"Particulate matter pollution alters the bacterial community structure on the human skin with enriching the Acinetobacter and Psedomonas in vivo","description":"This study aims to investigate the effects of particulate matter pollution on the bacterial community structure of the human skin. We analyzed skin microbiota samples collected during haze and non-haze days in spring and winter. Using high-throughput sequencing, we examined the diversity, taxonomic composition, cooccurrence network, and functional potential of the skin bacterial community. Our findings contribute to the understanding of how environmental pollution affects the skin bacterial community and highlight the potential health risks associated with the altered skin bacteria due to haze pollution.","center":"Xinxiang Medical University","data_type":"Raw sequence reads","submission_date":"2024/06/04 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN41663151","MIMS Environmental/Metagenome sample from skin metagenome","non_environmental",null,"2018-11-29",2018,"CN","Henan",1788572,"Xinxiang","verified",35.28,113.93,"China: Xinxiang",null,"skin biome","retroauricular crease","female","host-derived or clinical material"],["SAMN41663152","MIMS Environmental/Metagenome sample from skin metagenome","non_environmental",null,"2018-12-30",2018,"CN","Henan",1788572,"Xinxiang","verified",35.28,113.93,"China: Xinxiang",null,"skin biome","retroauricular crease","female","host-derived or clinical material"],["SAMN41663153","MIMS Environmental/Metagenome sample from skin metagenome","non_environmental",null,"2018-11-29",2018,"CN","Henan",1788572,"Xinxiang","verified",35.28,113.93,"China: Xinxiang",null,"skin biome","retroauricular crease",