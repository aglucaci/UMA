{"v":1,"accession":"PRJNA553795","title":"High throughput 16S rRNA gene amplicon sequencing of three on-site wastewater treatment systems","description":"The bacterial community of three on-site wastewater treatment systems (OWTS) was characterized by 16S gene amplicon high throughput sequencing (2x300bp Illumina). Sampling times were January, February, April, July, November 2016. Samples collected from raw wastewater influent, septic tank effluent, partially treated wastewater, and treated wastewater. Sequences were used to determine similarities/differences between the three system. This constitutes the first description of OWTS microbial communities to this breadth and precision.","center":"Center for Clean Water Technology","data_type":"Raw sequence reads","submission_date":"2019/07/10 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN12250292","1X1","confirmed_urban","municipal_wastewater","2016-01-13",2016,"US","Massachusetts",4943297,"Mashpee","probable",41.6426,-70.5432,"USA: Massachuettes","System X, Port 1","wastewater treatment plant [ENVO:00002043]","sewage [ENVO:00002018]",null,"named urban infrastructure at sample level"],["SAMN12250293","1X2","confirmed_urban","municipal_wastewater","2016-01-13",2016,"US","Massachusetts",4943297,"Mashpee","probable",41.6426,-70.5432,"USA: Massachuettes","System X, Port 2","wastewater treatment plant [ENVO:00002043]","sewage [ENVO:00002018]",null,"named urban infrastructure at sample level"],["SAMN12250294","1X3","confirmed_urban","municipal_wastewater","2016-01-13",2016,"US","Massachusetts",4943297,"Mashpee","probable",41.6426,-70.5432,"USA: Massachuettes","System X, effluent","wastewater treatment plant [ENVO:00002043]","sewage [ENVO:00002018]",null,"named urban infrastructure at 