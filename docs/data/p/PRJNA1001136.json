{"v":1,"accession":"PRJNA1001136","title":"archaea in anaerobic digestion of sewage sludge and organic waste","description":"The study aims to investigate the effects and underlying mechanisms of organic ratios in feedstocks on the stability and CH4 production of SSAD. Organic ratios were determined by mixing sewage sludge, pig manure, food waste, and cornstalk based on their contents of carbohydrates, protein, fat, and lignocellulose. Dynamics of bacteria and archaea in response to different ratios of organic components were tracked. Microbial interplay and its correlation with digestate characteristics were deciphered by modular network and Mantel test. Furthermore, key genes involved in organic biodegradation and methane production were predicted to elucidate the underlying mechanisms of organic regulation for advanced SSAD performance.","center":"China Agricultural University","data_type":"Raw sequence reads","submission_date":"2023/08/02 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN36795685","AD0.T1","probable_urban","municipal_wastewater","2021-04-24",2021,"CN","Beijing",1816670,"Beijing","probable",null,null,"China: Beijing",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN36795686","AD0.T6","probable_urban","municipal_wastewater","2021-04-24",2021,"CN","Beijing",1816670,"Beijing","probable",null,null,"China: Beijing",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN36795687","AD0.T8","probable_urban","municipal_wastewater","2021-04-24",2021,"CN","Beijing",1816670,"Beijing","probable",null,null,"China: Beijing",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN36795688","AD0.T9","probable_urban","municipal_wastewater","20