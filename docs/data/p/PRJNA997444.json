{"v":1,"accession":"PRJNA997444","title":"Simultaneous nitrogen and phosphorus removal in oxic/anoxic process","description":"Traditional heterotrophic denitrification process needs enough organic substrates for electron donation. How to achieve efficient total nitrogen removal performance from low C/N ratio wastewater is challenging. This study presents a two-stage oxic/anoxic reactor, and iron scraps are introduced in various stages to further investigate the total nitrogen, phosphorous and COD removal performance.","center":"Donghua University","data_type":"Raw sequence reads","submission_date":"2023/07/21 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN36679432","Oxic(Fe)","uncertain",null,"2020-09-28",2020,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN36679433","Oxic","uncertain",null,"2020-09-28",2020,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN36679434","Oxic(Fe)-Anoxic(Fe)","uncertain",null,"2020-09-28",2020,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN36679435","Oxic(Fe)-Anoxic","uncertain",null,"2020-09-28",2020,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN36679436","Oxic-Anoxic(Fe)","uncertain",null,"2020-09-28",2020,null,null,null,null,"unresolved",null,null,null,"reactor samples",null,null,null,"environmental sample; urban association not established"],["SAMN36679437","Oxic-Anoxic","uncertain",null,"2020-09-28",2020,nu