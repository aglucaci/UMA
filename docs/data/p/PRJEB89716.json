{"v":1,"accession":"PRJEB89716","title":"High versus low organic loading impact on gypsum converting communities grown on sewage","description":"By comparing this enrichment to sewage sludge across a gradient of organic loading, we show that microbial origin, syntrophic structure, and organic availability collectively determine methane suppression and sulfate reduction efficiency. We further examined whether the balance between methanogenesis and sulfate reduction is governed by community composition, syntrophic structure, or initial inoculum biomass selected during enrichment. These results show that enrichment history, community structure, and organic availability together determine the balance of sulfate reduction and methane production during phosphogypsum treatment.","center":"MIT","data_type":"Other","submission_date":"2025/05/20 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA118336856","LOW_COD_PLUM_1D17","uncertain",null,"2024-09-23",2024,"US",null,null,null,"unresolved",null,null,"USA",null,null,null,null,"environmental sample; urban association not established"],["SAMEA118336857","LOW_COD_PLUM_2D17","uncertain",null,"2024-09-23",2024,"US",null,null,null,"unresolved",null,null,"USA",null,null,null,null,"environmental sample; urban association not established"],["SAMEA118336858","LOW_COD_PLUM_3D17","uncertain",null,"2024-09-23",2024,"US",null,null,null,"unresolved",null,null,"USA",null,null,null,null,"environmental sample; urban association not established"],["SAMEA118336859","LOW_COD_SICILY_417","uncertain",null,"2024-09-23",2024,"US",null,null,null,"unresolved",null,null,"USA",null,null,null,null,"environmental sample; urban association not established"],["SAMEA118336860","LOW_COD_SICILY_5D17","uncertain",null,"2024