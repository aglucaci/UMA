{"v":1,"accession":"PRJNA1037120","title":"Archaeological Dental Calculus Shotgun Data from 18th Century African Descended Individuals in South Carolina","description":"As part of the Anson Street African Burial Ground Project, we characterized the oral microbiomes of twelve 18th century African descended individuals from Charleston, South Carolina, USA. Dental Calculus was removed from the individuals and extracted at the Laboratories of Molecular Anthropology and Microbiome Research at the University of Oklahoma. Double stranded libraries were UDG treated, and shotgun sequenced on on land of a Illumina HiSeq X (2x150bp). All human genomic DNA has been filtered from this dataset. The goals of this project were to understand oral microbiome diversity and health of the Anson Street Ancestors.","center":"Dartmouth College","data_type":"Raw sequence reads","submission_date":"2023/11/08 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN38163707","Metagenome or environmental sample from human oral metagenome","non_environmental",null,null,2019,"US","South Carolina",4574324,"Charleston","probable",32.78,-79.93,"USA: South Carolina","Dental Calculus",null,null,null,"host-derived or clinical material"],["SAMN38163708","Metagenome or environmental sample from human oral metagenome","non_environmental",null,null,2019,"US","South Carolina",4574324,"Charleston","probable",32.78,-79.93,"USA: South Carolina","Dental Calculus",null,null,null,"host-derived or clinical material"],["SAMN38163709","Metagenome or environmental sample from human oral metagenome","non_environmental",null,null,2019,"US","South Carolina",4574324,"Charleston","probable",32.78,-79.93,"USA: South Carolina","Dental Calculus",null,null,null,"host-derived or clinical material