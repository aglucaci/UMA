{"v":1,"accession":"PRJNA267175","title":"Biowaste Metagenome","description":"The study aimed at the microbial production of lactic acid as an additional step within current biowaste treatment technology. Prior to fermentation the biowaste was separated into a liquid and a solid fraction following a biorefinery concept. The liquid fraction was fermented to lactic acid under different conditions employing only the biowaste`s indigenous microbiota. Fermentation was evaluated regarding physicochemical and especially microbial characteristics. Its residues and the solid fraction of biowaste can be treated in anaerobic digestion as usual. This implementation could increase the exploitation of the waste potential providing a cheap and efficient possibility of lactic acid production without forcing major changes in the current waste treatment technology.","center":"University of Innsbruck","data_type":"Metagenome","submission_date":"2014/11/14 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN03178172","MIMS Environmental/Metagenome sample from wastewater metagenome","confirmed_urban","municipal_wastewater","2012-11-15",2012,"AT",null,null,null,"unresolved",null,null,"Austria: Tirol",null,"municipal biowaste","waste treatment plant","organic waste","explicit urban setting at sample level"],["SAMN03178173","MIMS Environmental/Metagenome sample from wastewater metagenome","confirmed_urban","municipal_wastewater","2012-11-15",2012,"AT",null,null,null,"unresolved",null,null,"Austria: Tirol",null,"municipal biowaste","waste treatment plant","organic waste","explicit urban setting at sample level"],["SAMN03178174","MIMS Environmental/Metagenome sample from wastewater metagenome","confirmed_urban","municipal_wastewater","2012-11-15",2012,"AT",