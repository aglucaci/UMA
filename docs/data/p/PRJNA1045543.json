{"v":1,"accession":"PRJNA1045543","title":"Long-term Effects of Nickel Oxide Nanoparticles on the Physicochemical Properties and Microbial Metabolism of Activated Sludge","description":"In order to reveal the biotoxicity of nickel oxide nanoparticles in complex environmental systems, this study used activated sludge as the research target and investigated the long-term effects of NiO NPs on the operational efficacy of a sequencing batch reactor, sludge performance, and microbial metabolism. Results indicated that low concentrations of NiO NPs did not have significant effects on activated sludge operational efficacy, and high concentrations of NiO NPs significantly inhibited the removal of ammonia nitrogen and COD.","center":"Xi'an University of Architecture and Technology","data_type":"Raw sequence reads","submission_date":"2023/11/27 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN38446833","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2021-01-22",2021,"CN","Shaanxi",1790630,"Xi’an","probable",null,null,"China: Xian","avtive sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN38446834","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2021-01-22",2021,"CN","Shaanxi",1790630,"Xi’an","probable",null,null,"China: Xian","avtive sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN38446835","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2021-01-22",2021,"CN","Shaanxi",1790630,"Xi’an","probable",null,null,"China: Xian","avtive sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN3