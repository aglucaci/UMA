{"v":1,"accession":"PRJNA1122933","title":"Anaerobic digestion at different voltages","description":"Study on biogas production from pig manure wastewater by microbial electrosynthesis at sub-psychrophilic conditions. In this study, the applied voltage 0.4 V and 0.8 V of MES significantly increased the biogas production and COD removal rate. Biogas production and COD removal rate increased most when the voltage reached 0.8 V, and decreased when the voltage was 1.2 V. Low voltage did not significantly alter the microbial structure, but higher voltage resulted in a significant decrease in Clostridium and Methanosarcina.","center":"southwest university","data_type":"Raw sequence reads","submission_date":"2024/06/11 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN41793731","0","probable_urban","municipal_wastewater","2022-09-06",2022,"CN","Chongqing",1814906,"Chongqing","probable",null,null,"China: Chongqing","anaerobic digest reactor sample",null,null,null,"city-level location without sample-site confirmation"],["SAMN41793732","0.4","probable_urban","municipal_wastewater","2022-09-06",2022,"CN","Chongqing",1814906,"Chongqing","probable",null,null,"China: Chongqing","anaerobic digest reactor sample",null,null,null,"city-level location without sample-site confirmation"],["SAMN41793733","0.8","probable_urban","municipal_wastewater","2022-09-06",2022,"CN","Chongqing",1814906,"Chongqing","probable",null,null,"China: Chongqing","anaerobic digest reactor sample",null,null,null,"city-level location without sample-site confirmation"],["SAMN41793734","1.2","probable_urban","municipal_wastewater","2022-09-06",2022,"CN","Chongqing",1814906,"Chongqing","probable",null,null,"China: Chongqing","anaerobic digest reactor sample",null,null,null,"ci