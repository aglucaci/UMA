{"v":1,"accession":"PRJNA1097068","title":"Feasibility Study on In Situ Coupled System of Microalgae-Bacteria and Photocatalysis for Coking Wastewater Treatment: Synergistic Mechanism and Treatment Performance","description":"Traditional biological treatment technologies have difficulty stably treating industrial wastewater with high biological toxicity, such as coking wastewater. This study constructed an in situ coupled system of algal-bacterial consortium and immobilized photocatalysis for treating practical industrial coking wastewater. The introduction of polyether polyurethane-graphene foam carrier in situ coupled photocatalysis, bacteria and algae with good biocompatibility and enhanced the ecological stability of the system. This study verified the efficiency and synergistic mechanism of immobilized photocatalysis-algal-bacterial consortium in situ coupled system for treating practical industrial coking wastewater, providing ideas for the R&amp;D of novel biological intensified treatment technologies.","center":"Shaanxi University of Science and Technology","data_type":"Raw sequence reads","submission_date":"2024/04/07 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN40861424","Original aerobic activated sludge1","non_urban",null,"2021-09-15",2021,"CN","Shaanxi",1790630,"Xi’an","probable",null,null,"China:Xi'an","activated sludge",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN40861425","Original aerobic activated sludge2","non_urban",null,"2021-09-15",2021,"CN","Shaanxi",1790630,"Xi’an","probable",null,null,"China:Xi'an","activated sludge",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN40861426","Original aerobic activated sludge3","non_urban",null,"2