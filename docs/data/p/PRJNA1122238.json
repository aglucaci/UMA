{"v":1,"accession":"PRJNA1122238","title":"Tracing sources of microbial eukaryotic contamination in the Pasig River System in Metro Manila, Philippines using community-based microbial source tracking","description":"Community-based Microbial Source Tracking (MST) is a recent approach to trace sources of contamination in a polluted environment. Here, this method is employed to track the sources of contamination in the Pasig River System in Metro Manila, Philippines specifically targeting microbial eukaryotes. Potential host sources (fecal and sewage samples) were collected at different animal farm sites and treatment plants surrounding the rivers.","center":"University of the Philippines Diliman","data_type":"Raw sequence reads","submission_date":"2024/06/10 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN41783608","SW1","probable_urban","municipal_wastewater","2023-03-03",2023,"PH","National Capital Region",1692192,"Quezon City","probable",14.6619,121.0204,"Philippines: Sewage Treatment Plant","sewage",null,null,null,"city-level location without sample-site confirmation"],["SAMN41783610","SW3","probable_urban","municipal_wastewater","2023-05-25",2023,"PH","National Capital Region",1692192,"Quezon City","probable",14.5886,120.9931,"Philippines: Sewage Treatment Plant","sewage",null,null,null,"city-level location without sample-site confirmation"],["SAMN41783611","SW4","probable_urban","municipal_wastewater","2023-05-25",2023,"PH","National Capital Region",1692192,"Quezon City","probable",14.5886,120.9931,"Philippines: Sewage Treatment Plant","sewage",null,null,null,"city-level location without sample-site confirmation"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","b