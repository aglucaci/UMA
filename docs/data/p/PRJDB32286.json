{"v":1,"accession":"PRJDB32286","title":"Microbial community of municipal wastewater plant (PRJCA028781)","description":"In this paper, sewage and corresponding air samples from biological treatment units and aeration treatment units of two municipal sewage treatment plants in North China, as well as air samples from upwind and downwind of sewage treatment plants were collected, and the abundance and diversity of ARGs and bacteria in them were analyzed, and the escape characteristics and influencing factors of ARGs, dominant bacteria and pathogenic bacteria in aerosols were studied. And the concentration characteristics of three target pollutants in the air. On this basis, the respiratory exposure of workers to pathogenic bacteria was quantitatively assessed.","center":"Beijing Academy of Agriculture and Forestry Sciences","data_type":"Other","submission_date":"2025/12/03 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD01725412","A1 (SAMC4058004)","probable_urban","air_dust","2023-05-10",2023,null,null,null,null,"unresolved",null,null,"missing: data agreement established pre-2023","air",null,null,null,"city-level location without sample-site confirmation"],["SAMD01725413","A2 (SAMC4058005)","probable_urban","air_dust","2023-05-10",2023,null,null,null,null,"unresolved",null,null,"missing: data agreement established pre-2023","air",null,null,null,"city-level location without sample-site confirmation"],["SAMD01725414","A3 (SAMC4058006)","probable_urban","air_dust","2023-05-10",2023,null,null,null,null,"unresolved",null,null,"missing: data agreement established pre-2023","air",null,null,null,"city-level location without sample-site confirmation"],["SAMD01725415","A4 (SAMC4058007)","probable_urban","air_dust","2023-05-10",2023,null,