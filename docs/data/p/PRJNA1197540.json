{"v":1,"accession":"PRJNA1197540","title":"Dual role of carbon monoxide in medium-chain fatty acids production from food waste","description":"The study assessed the influence of carbon monoxide supplementation on the bacterial and archaeal community of a microbiome producing medium-chain fatty acids from food waste. The microbiome was originally derived from a municipal wastewater treatment plant in Finland. The impact of carbon monoxide was compared with other methanogenic inhibiting strategies, including 2-bromoethanesulfonate supplementation and thermal treatment at 100 degree Celsius.","center":"University of Naples Federico II","data_type":"Raw sequence reads","submission_date":"2024/12/12 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN46122714","MIMARKS Survey related sample from wastewater metagenome","non_environmental",null,"2023-10-02",2023,"FI","Pirkanmaa",634963,"Tampere","verified",61.4991,23.7871,"Finland: Tampere",null,"Wastewater","Anaerobic bioreactor","food waste fermentation broth","laboratory or culture material"],["SAMN46122715","MIMARKS Survey related sample from wastewater metagenome","non_environmental",null,"2023-10-02",2023,"FI","Pirkanmaa",634963,"Tampere","verified",61.4991,23.7871,"Finland: Tampere",null,"Wastewater","Anaerobic bioreactor","food waste fermentation broth","laboratory or culture material"],["SAMN46122716","MIMARKS Survey related sample from wastewater metagenome","non_environmental",null,"2023-10-02",2023,"FI","Pirkanmaa",634963,"Tampere","verified",61.4991,23.7871,"Finland: Tampere",null,"Wastewater","Anaerobic bioreactor","food waste fermentation broth","laboratory or culture material"],["SAMN46122717","MIMARKS Survey related sample from wastewater metagenome","non_environmental",