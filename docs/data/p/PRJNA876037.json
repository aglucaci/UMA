{"v":1,"accession":"PRJNA876037","title":"Effects of particulate matter on gut microrbiome of mice","description":"Epidemiological evidence reported that particulate matter (PM) was associated with increased schizophrenia (SCZ) risk. Disturbance of gut microbiome was involved in SCZ. However, it remains unclear whether PM induces SCZ-like symptoms and how gut microbiome regulates them. Therefore, a multi-omics randomized design was used to verify how urban PM induces SCZ-like behavior and altered gut microbiota and metabolic pathways.","center":"Anhui Medical University","data_type":"Raw sequence reads","submission_date":"2022/09/02 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN30636083","PM group","non_environmental",null,"2021-07-05",2021,null,null,null,null,"unresolved",null,null,null,"fecal sample in PM1",null,null,null,"host-derived or clinical material"],["SAMN30636084","PM group","non_environmental",null,"2021-07-05",2021,null,null,null,null,"unresolved",null,null,null,"fecal sample in PM2",null,null,null,"host-derived or clinical material"],["SAMN30636085","PM group","non_environmental",null,"2021-07-05",2021,null,null,null,null,"unresolved",null,null,null,"fecal sample in PM3",null,null,null,"host-derived or clinical material"],["SAMN30636086","PM group","non_environmental",null,"2021-07-05",2021,null,null,null,null,"unresolved",null,null,null,"fecal sample in PM4",null,null,null,"host-derived or clinical material"],["SAMN30636087","PM group","non_environmental",null,"2021-07-05",2021,null,null,null,null,"unresolved",null,null,null,"fecal sample in PM5",null,null,null,"host-derived or clinical material"],["SAMN30636088","PM group","non_environmental",null,"2021-07-05",2021,null,null,null,null,"unresolved",null,null,n