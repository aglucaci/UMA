{"v":1,"accession":"PRJNA1150118","title":"Characteristics and mechanisms of enhanced degradation of 2,4-difluoroaniline in a biochemical system mediated by magnetic biochar under Cu2+impact conditions","description":"The main goals of this article were as follows:(1) develop the PACT process, and evaluate the effects of the biochar type, the bacteria and biochar addition method on the treatment efficiencies under different concentrations of Cu(II) shock; (2) evaluate the contributions of biochar and EPS to 2,4-difluoroaniline (2,4-DFA) degradation and Cu(II) removal in the PACT system; (3)explore the effects of biochar on EPS production, and its adsorption capacity for Cu(II); (4) assess the relationship of the microbial community composition and the biochar type, the addition method in the PACT system.","center":"Quzhou University","data_type":"Raw sequence reads","submission_date":"2024/08/20 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN43270297","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2024-08-20",2024,"CN","Zhejiang",1797264,"Quzhou","probable",null,null,"China:quzhou",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN43270298","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2024-08-20",2024,"CN","Zhejiang",1797264,"Quzhou","probable",null,null,"China:quzhou",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN43270299","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2024-08-20",2024,"CN","Zhejiang",1797264,"Quzhou","probable",null,null,"China:quzhou",null,null,null,null,"city-level location with