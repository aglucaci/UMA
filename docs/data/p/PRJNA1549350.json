{"v":1,"accession":"PRJNA1549350","title":"Assessment of Antibiotic Resistant Bacterial Isolates in Wastewater from Informal Settlements at Ilala District, Dar Es Salaam, Tanzania.","description":"Antimicrobial resistance (AMR) has emerged as a major global public health threat, with wastewater increasingly recognized as an important environmental reservoir for antibiotic-resistant bacteria and antimicrobial resistance genes. Informal settlements in developing countries are particularly vulnerable due to inadequate sanitation, poor wastewater management, and uncontrolled discharge of domestic waste, which facilitate the persistence and dissemination of resistant microorganisms. This study assessed antibiotic-resistant bacteria isolated from wastewater in informal settlements at Ilala District, Dar es Salaam, Tanzania.","center":"Nationla public Health Laboratory","data_type":"Raw sequence reads","submission_date":"2026/10/23 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN64388431","Proteus mirabilis 1-MCA-A3 from wastewater, Dar es Salaam, Tanzania","uncertain",null,"2026-01-23",2026,"TZ","Dar es Salaam Region",160263,"Dar es Salaam","verified",-6.8842,39.1567,"Tanzania: Dar es Salaam, Ilala, Gongo la Mboto",null,"urban biome [ENVO:01000249]","open drainage channel","wastewater [ENVO:00002001]","conflicting evidence: environmental and host/clinical"],["SAMN64388432","Proteus mirabilis 5-BA-A from wastewater, Dar es Salaam, Tanzania","uncertain",null,"2026-01-26",2026,"TZ","Dar es Salaam Region",160263,"Dar es Salaam","verified",-6.82,39.27,"Tanzania: Dar es Salaam, Ilala, Jangwani",null,"urban biome [ENVO:01000249]","open drainage channel","wastewater [ENVO:00002001]","conflicting evidence: environmental and host/clinical"],["