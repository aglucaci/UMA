{"v":1,"accession":"PRJNA808107","title":"Acetaminophen concentrations found in recycled wastewater alter soil microbial community structure and functional diversity","description":"A green house study was conducted to assess the impacts of Tylenol (APAP) on the soil microbiome associated with Solanum melongena (eggplants). Plants were irrigated with water containing either 10 ug/L, 5 ug/L, or no APAP. The experiment was carried out for a single growing season ( 7 weeks). Illumina sequencing of the bacterial 16s rRNA gene was used to characterize the soil community and monitor for shifts in diversity (as measured by Shannon-Wiener index) or community structure (as determined by PERMANOVA of Bray Curtis distance matrices).","center":"UCR Gachomo Lab","data_type":"Raw sequence reads","submission_date":"2022/02/17 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN26028322","Metagenome or environmental sample from soil metagenome","uncertain",null,"2018-10-24",2018,"US",null,null,null,"unresolved",null,null,"USA","Eggplant soil from green house",null,null,null,"environmental sample; urban association not established"],["SAMN26028323","Metagenome or environmental sample from soil metagenome","uncertain",null,"2018-11-11",2018,"US",null,null,null,"unresolved",null,null,"USA","Eggplant soil from green house",null,null,null,"environmental sample; urban association not established"],["SAMN26028324","Metagenome or environmental sample from soil metagenome","uncertain",null,"2018-10-24",2018,"US",null,null,null,"unresolved",null,null,"USA","Eggplant soil from green house",null,null,null,"environmental sample; urban association not established"],["SAMN26028325","Metagenome or environmental sample from soil metagenome","uncertain",null,"2018-