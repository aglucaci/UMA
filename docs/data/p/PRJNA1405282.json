{"v":1,"accession":"PRJNA1405282","title":"Metagenomic analysis of microbial metabolism in a micro-aerobic hydrolytic acidification reactor treating printing and dyeing wastewater","description":"The limited understanding of microbial metabolic regulation mechanisms in microaerophilic hydrolysis-acidification reactors for textile wastewater restricts their widespread application. This project aims to investigate functional genes and metabolic potential within such reactors. Using metagenomic sequencing technology, we elucidate the regulatory effects of dissolved oxygen gradients on functional genes related to carbon metabolism, volatile fatty acid (VFA) synthesis, and azo dye degradation. The resulting metagenome dataset reveals metabolic regulatory mechanisms of microorganisms under microaerophilic conditions, providing a theoretical basis for optimizing hydrolysis-acidification systems in textile wastewater treatment.","center":"Xi'an University of Technology","data_type":"Raw sequence reads","submission_date":"2026/01/20 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN54739639","Micro-aerobic hydrolytic acidification reactor sample R1","non_urban",null,"2022-11-29",2022,"CN","Shaanxi",null,null,"unresolved",null,null,"China: Shaanxi Province",null,"engineered environment","wastewater treatment system","activated sludge","BioProject indicates an agricultural or industrial source"],["SAMN54739640","Micro-aerobic hydrolytic acidification reactor sample R2","non_urban",null,"2022-11-29",2022,"CN","Shaanxi",null,null,"unresolved",null,null,"China: Shaanxi Province",null,"engineered environment","wastewater treatment system","activated sludge","BioProject indicates an agricultural or industrial source"],["SAMN54739641","Micro-aero