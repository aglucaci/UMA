{"v":1,"accession":"PRJNA1180282","title":"Sludge raw sequence reads","description":"This data contains microbial community composition data from six lab-scale batch reactors simulating textile printing wastewater treatment under varying salinity levels across anoxic-oxic-anoxic (AOA) stages. The data highlight microbial shifts, urea hydrolysis, and total nitrogen (TN) and COD removal efficiencies under salinity stress. The goal is to analyze the simultaneous impact of sodium dithionite on urea hydrolysis and total nitrogen removal under sodium dithionite salinity stress.","center":"Donghua University","data_type":"Raw sequence reads","submission_date":"2024/10/31 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN44517708","Seed","non_urban",null,"2024-10-31",2024,"CN","Shanghai",1796236,"Shanghai","verified",31.06,121.21,"China:Shanghai",null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN44517709","Aa1","non_urban",null,"2024-10-31",2024,"CN","Shanghai",1796236,"Shanghai","verified",31.07,121.21,"China:Shanghai",null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN44517710","O1","non_urban",null,"2024-10-31",2024,"CN","Shanghai",1796236,"Shanghai","verified",31.08,121.21,"China:Shanghai",null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN44517711","Ab1","non_urban",null,"2024-10-31",2024,"CN","Shanghai",1796236,"Shanghai","verified",31.09,121.21,"China:Shanghai",null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN44517712","Aa3","non_urban",null,"2024-10-31",2024,"CN","Shanghai",1796236,"Shanghai","verified",31.1,121.21,"China:Shanghai",null,null,null,null,"BioProject indicates an agricultu