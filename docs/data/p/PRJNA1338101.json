{"v":1,"accession":"PRJNA1338101","title":"Microbiome analysis in female reproductive tract","description":"The aim of this study is to characterise the microbiome of the female reproductive tract (vagina, cervix, and endometrium) and adjacent sites (urine and rectum) using 16S rRNA gene sequencing in women with infertility. A total of 104 participants each provided a comprehensive set of samples during the mid-secretory phase, including a vaginal swab, cervical swab, endometrial Tao Brush, urine sample, and rectal swab. Environmental and procedural negative controls were also collected to ensure data quality.","center":"University of Granada","data_type":"Raw sequence reads","submission_date":"2025/10/06 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN52395414","Metagenome or environmental sample from air metagenome","uncertain",null,"2020-01-20",2020,"ES","Andalusia",2517117,"Granada","verified",37.19,-3.6,"Spain: Granada, Granada","air control",null,null,null,"environmental sample; urban association not established"],["SAMN52395415","Metagenome or environmental sample from air metagenome","uncertain",null,"2020-02-21",2020,"ES","Andalusia",2517117,"Granada","verified",37.19,-3.6,"Spain: Granada, Granada","air control",null,null,null,"environmental sample; urban association not established"],["SAMN52395416","Metagenome or environmental sample from air metagenome","uncertain",null,null,2020,"ES","Andalusia",2517117,"Granada","verified",37.19,-3.6,"Spain: Granada, Granada","air control",null,null,null,"environmental sample; urban association not established"],["SAMN52395417","Metagenome or environmental sample from air metagenome","uncertain",null,null,2021,"ES","Andalusia",2517117,"Granada","verified",37.19,-3.6,"Spain: Granad