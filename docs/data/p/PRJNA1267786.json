{"v":1,"accession":"PRJNA1267786","title":"Microbial shifts in anaerobic digestion via sludge recycling","description":"This project investigates the effects of increased solids retention time (SRT) through sludge recycling on anaerobic digestion performance and microbial community structure. 16S rRNA gene sequencing was conducted to compare microbial shifts between control and sludge-recycled reactors treating food waste leachate. The data provide insights into the enhancement of methane production and shifts in key microbial taxa under prolonged SRT.","center":"Konkuk University","data_type":"Raw sequence reads","submission_date":"2025/05/26 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN48730129","MIMARKS Survey related sample from wastewater metagenome","uncertain",null,"2023-10-11",2023,null,null,null,null,"unresolved",null,null,null,null,"wastewater treatment environment","anaerobic digester","sludge","environmental sample; urban association not established"],["SAMN48730130","MIMARKS Survey related sample from wastewater metagenome","uncertain",null,"2023-10-11",2023,null,null,null,null,"unresolved",null,null,null,null,"wastewater treatment environment","anaerobic digester","sludge","environmental sample; urban association not established"],["SAMN48730131","MIMARKS Survey related sample from wastewater metagenome","uncertain",null,"2024-02-29",2024,null,null,null,null,"unresolved",null,null,null,null,"wastewater treatment environment","anaerobic digester","digestate","environmental sample; urban association not established"],["SAMN48730132","MIMARKS Survey related sample from wastewater metagenome","uncertain",null,"2024-02-29",2024,null,null,null,null,"unresolved",null,null,null,null,"wastewater treatment environment","