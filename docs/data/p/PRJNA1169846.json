{"v":1,"accession":"PRJNA1169846","title":"Isolation and characterization of bacteriophages with lytic activity against multidrug-resistant non-typhoidal Salmonella from Nairobi City County, Kenya","description":"Non-typhoidal Salmonella NTS are associated with self-limiting enterocolitis in humans, but certain strains can lead to life threatening invasive diseases, particularly in sub-Saharan Africa. In Kenya, multidrug-resistant MDR NTS strains with increasing non-susceptibility to third-generation cephalosporins have been reported, posing a significant public health concern that requires urgent attention. Bacteriophages are increasingly being considered as an alternative treatment for MDR bacterial infections because of the growing ineffectiveness of traditional antimicrobial therapies. This study aimed to isolate and characterize bacteriophages as a potential alternative therapy for infections caused by MDR and ESBL producing NTS.","center":"Kenya Medical Research Institute","data_type":"Raw sequence reads","submission_date":"2024/10/07 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN44083729","Viral sample from Salmonella phage vB_SEnST11_KE06","non_environmental",null,"2022-10-15",2022,"KE","Nairobi County",184745,"Nairobi","probable",null,null,"Kenya:Nairobi, Ruai sewage treatment influent","Sewage",null,null,null,"host-derived or clinical material"],["SAMN44083731","Viral sample from Salmonella phage vB_STmST19_KE12","non_environmental",null,"2022-10-15",2022,"KE","Nairobi County",184745,"Nairobi","probable",null,null,"Kenya:Nairobi, Ruai sewage treatment influent","Sewage",null,null,null,"host-derived or clinical material"],["SAMN44083736","Viral sample from Salmonella phage vB_SEnST11_KE17","non_environmental",null,"2