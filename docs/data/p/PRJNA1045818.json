{"v":1,"accession":"PRJNA1045818","title":"Combining pre-fermentation and dual-chamber microbial electrolysis cell for efficient high-purity hydrogen production from food wastewater","description":"This study comprehensively investigated the effects of HRT and OLR on the composition of pre-fermentation effluents from food wastewater and the subsequent performance of dual-chamber MECs utilizing the effluents. Pre-fermentation was conducted without pH control to reflect a more sustainable and realistic approach. Both the pre-fermentation and MEC processes were closely monitored for their performance and active microbial community structures at the RNA level. The outcomes of this study will advance the understanding and potential of MECs combined with pre-fermentation for handling food wastewater and involved microbes.","center":"Ulasn National Institute of Science and Technology","data_type":"Raw sequence reads","submission_date":"2023/11/28 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN38454961","Metagenome or environmental sample from anaerobic digester metagenome","uncertain",null,"2023-10-09",2023,"KR",null,null,null,"unresolved",null,null,"South Korea",null,null,null,null,"environmental sample; urban association not established"],["SAMN38454962","Metagenome or environmental sample from anaerobic digester metagenome","uncertain",null,"2023-10-09",2023,"KR",null,null,null,"unresolved",null,null,"South Korea",null,null,null,null,"environmental sample; urban association not established"],["SAMN38454963","Metagenome or environmental sample from anaerobic digester metagenome","uncertain",null,"2023-10-09",2023,"KR",null,null,null,"unresolved",null,null,"South Korea",null,null,null,null,"environmental sample; urban association no