{"v":1,"accession":"PRJNA1031641","title":"Effect of formate on microorganisms in anaerobic sludge","description":"The role of formate as electron carrier and carbon source in syntrophic propionate metabolism is complicated. To identify the mechanisms of promoting or inhibitory effect of formate on syntrophic propionate metabolism, we investigated the effect of formate on syntrophic propionate metabolism by adding different dosages of formate in anaerobic sludge system, and through microbial structure and KEGG pathway analysis revealed the underlying mechanism.","center":"Chinese Academy of Sciences","data_type":"Raw sequence reads","submission_date":"2023/10/24 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN37950287","Metagenome or environmental sample from sludge metagenome","uncertain",null,null,2021,"CN",null,null,null,"unresolved",null,null,"China","Laboratory anaerobic sludge(no formate)",null,null,null,"environmental sample; urban association not established"],["SAMN37950288","Metagenome or environmental sample from sludge metagenome","uncertain",null,null,2021,"CN",null,null,null,"unresolved",null,null,"China","Laboratory anaerobic sludge(Add 5mM formate)",null,null,null,"environmental sample; urban association not established"],["SAMN37950289","Metagenome or environmental sample from sludge metagenome","uncertain",null,null,2021,"CN",null,null,null,"unresolved",null,null,"China","Laboratory anaerobic sludge(Add 10 mM formate)",null,null,null,"environmental sample; urban association not established"],["SAMN37950290","Metagenome or environmental sample from sludge metagenome","uncertain",null,null,2021,"CN",null,null,null,"unresolved",null,null,"China","Laboratory anaerobic sludge (Add 30mM formate)",null,null,null,"env