{"v":1,"accession":"PRJNA1158962","title":"Metagenome sequencing of soils from historical and recent urban parks and undisturbed natural ecosystems in Torino (Northern Italy)","description":"Microbial communties from public urban parks from the city of Torino (Italy) and those from surrounding unmanaged natural ecosystems (deciduous mixed forest and undisturbed grassland) were profiled using Illumina shotgun sequencing. Historical (>10 yrs) and recent (<10 yrs) parks, as well as different soil cover (tree canopy and lawn/grassland were considered. Microbial taxonomic diversity, functional genes, including the resistome, were analysed.","center":"University of Torino","data_type":"Raw sequence reads","submission_date":"2024/09/10 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN43555728","MIMS Environmental/Metagenome sample from soil metagenome","confirmed_urban","soil_greenspace","2022-10-17",2022,"IT","Piedmont",3165524,"Turin","verified",45.0431,7.6655,"Italy: Turin",null,"area of developed open space [ENVO:01000883]","woodland area [ENVO:00000109] | plant litter [ENVO:01000628] | canopy [ENVO:01001242] | urban biome [ENVO:01000249]","lawn soil [ENVO:00005756]","explicit urban setting at sample level"],["SAMN43555729","MIMS Environmental/Metagenome sample from soil metagenome","confirmed_urban","soil_greenspace","2022-10-17",2022,"IT","Piedmont",3165524,"Turin","verified",45.0425,7.6646,"Italy: Turin",null,"area of developed open space [ENVO:01000883]","woodland area [ENVO:00000109] | plant litter [ENVO:01000628] | canopy [ENVO:01001242] | urban biome [ENVO:01000249]","lawn soil [ENVO:00005756]","explicit urban setting at sample level"],["SAMN43555730","MIMS Environmental/Metagenome sample from soil metagenome","confirmed_urb