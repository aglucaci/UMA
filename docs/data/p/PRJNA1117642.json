{"v":1,"accession":"PRJNA1117642","title":"Thermal hydrolysis combined with potassium ferrate pretreatment improves methane production from waste-activated sludge: Performance and mechanisms","description":"Thermal hydrolysis (TH) is efficient in improving waste-activated sludge (WAS) anaerobic digestion (AD); however, opportunities for enhancement remain, particularly in optimising organic matter conversion rates and minimising the production of refractory substances. Therefore, this study proposes a novel method of TH combined with potassium ferrate (PF) to improve sludge AD and explores its performance and mechanism.","center":"Xiangtan University","data_type":"Raw sequence reads","submission_date":"2024/05/29 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN41577608","raw.split.C1.1","uncertain",null,"2024-01-18",2024,"CN","Hunan",1802875,"Guankou","probable",28.24,113.49,"China: Hunan","Waste activated sludge1",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN41577610","raw.split.C2.1","uncertain",null,"2024-01-18",2024,"CN","Hunan",1802875,"Guankou","probable",28.24,113.49,"China: Hunan","Waste activated sludge3",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN41577612","raw.split.C3.1","uncertain",null,"2024-01-18",2024,"CN","Hunan",1802875,"Guankou","probable",28.24,113.49,"China: Hunan","Waste activated sludge5",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN41577614","raw.split.C4.1","uncertain",null,"2024-01-18",2024,"CN","Hunan",1802875,"Guankou","probable",28.24,113.49,"China: Hunan","Waste activated sludge7",null,null,null,"conflicting evidence: environmental and host/clinical"]],"run_cols":["accession","sample","experiment","