{"v":1,"accession":"PRJNA926812","title":"Landfill leachate, wastewater and river water sequencing","description":"The main purpose of the study was to determine relationships between the presence of landfill leachate in wastewater delivered to wastewater treatment plant (WWTP) and the changes in microbial community as well as spread of drug resistance in the environment. For the study, two WWTPs characterized by a similar composition of the received wastewater and treatment technology was selected, one of which additionally carried out the leachate co-treatment process. Both leachate, as well as treated and untreated wastewater, and river water samples before and after wastewater point discharge, collected from both WWTPs were analyzed.","center":"University of Warmia and Mazury in Olsztyn, Poland","data_type":"Raw sequence reads","submission_date":"2023/01/24 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN32884807","treated wastewater","non_urban",null,null,2021,"PL","Warmia-Masuria",3090613,"Nowe Miasto Lubawskie","probable",53.41,19.57,"Poland: Warmia and Mazury","wastewater",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN32884808","treated wastewater","non_urban",null,null,2021,"PL",null,null,null,"unresolved",53.49,22.21,"Poland: Warmia and Mazury","wastewater",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN32884809","untreated wastewater","non_urban",null,null,2021,"PL","Warmia-Masuria",3090613,"Nowe Miasto Lubawskie","probable",53.41,19.57,"Poland: Warmia and Mazury","wastewater",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN32884810","untreated wastewater","non_urban",null,null,2021,"PL",null,null,null,"unresolved