{"v":1,"accession":"PRJNA1460336","title":"Solar panel surface metagenome Metagenome","description":"This project characterizes fungal communities colonizing solar panel surfaces using long read metagenomic sequencing. Samples were collected from three solar panel installations in North Carolina, USA, representing a gradient of surrounding agricultural land use (25.74 percent, 39.66 percent, and 95.60 percent cultivated land). At each site, microbial material was collected by swabbing a defined 5 x 5 cm area of panel surface using sterile swabs pre-moistened with phosphate-buffered saline (PBS). The resulting metagenomic data were used to assess fungal community composition and functional potential across sites with differing environmental context.","center":"Duke University","data_type":"Metagenome","submission_date":"2026/04/30 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN57592070","MIMS Environmental/Metagenome sample from metagenome","uncertain",null,"2024-03-24",2024,"US","North Carolina",4461101,"Clinton","probable",35.0422,-78.3314,"USA: North Carolina",null,"built environment","Hope Mills Panel 1 Sample 1","biofilm","environmental sample; urban association not established"],["SAMN57592071","MIMS Environmental/Metagenome sample from metagenome","uncertain",null,"2024-03-24",2024,"US","North Carolina",4461101,"Clinton","probable",35.0422,-78.3314,"USA: North Carolina",null,"built environment","Hope Mills Panel 1 Sample 2","biofilm","environmental sample; urban association not established"],["SAMN57592072","MIMS Environmental/Metagenome sample from metagenome","uncertain",null,"2024-03-24",2024,"US","North Carolina",4461101,"Clinton","probable",35.0422,-78.3314,"USA: North Carolina",null,"built environment","Hope Mills 