{"v":1,"accession":"PRJNA948164","title":"Influence of native and exotic plant diet on the gut microbiome of the Grays Malayan stick insect Lonchodes brevipes","description":"Herbivorous insects require an active lignocellulolytic microbiome to process their diet. Stick insects are common in the tropics and display a cosmopolitan host plant feeding preference. The microbiomes of social insects are vertically transmitted to offspring whilst for solitary species such as phasmids it has been assumed that microbiomes are acquired from their diet. This study reports characterization of the gut microbiome for the Grays Malayan stick insect, Lonchodes brevipes, reared on native and introduced species of host plants, and compared these to the microbiome of the host plant and surrounding soil to gain insight on possible sources of recruitment.","center":"Yale-NUS College","data_type":"Raw sequence reads","submission_date":"2023/03/24 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN33877290","MIMARKS Survey related sample from metagenome","uncertain",null,null,2020,"SG",null,1880252,"Singapore","probable",1.18,103.46,"Singapore",null,"tropics","urban park","buffer","conflicting evidence: environmental and host/clinical"],["SAMN33877291","MIMARKS Survey related sample from metagenome","uncertain",null,null,2020,"SG",null,1880252,"Singapore","probable",1.18,103.46,"Singapore",null,"tropics","urban park","buffer","conflicting evidence: environmental and host/clinical"],["SAMN33877292","MIMARKS Survey related sample from metagenome","uncertain",null,null,2020,"SG",null,1880252,"Singapore","probable",1.18,103.46,"Singapore",null,"tropics","urban park","buffer","conflicting evidence: environmental and host/clinical"],["SAMN33877293","MIMARKS S