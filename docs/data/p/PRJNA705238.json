{"v":1,"accession":"PRJNA705238","title":"Comparative analysis of nitrogen removals and microbial communities in air and pure oxygen aeration systems during treatment of municipal solid waste incineration (MSWI) leachate","description":"In this study, two parallel-operated full-scale anoxic-oxic process trains, one use PO aeration with IS-OTM system and the another used conventional air aeration, were used to evaluate the impact of PO use on the removal efficiencies of pollutions in the MSWI leachate treatment. Furthermore, a comparative metagenomic analysis were performed to reveals the changes of the microbial diversity, metabolism and biological nitrogen removal pathway between two trains.","center":"South China University of Technology","data_type":"Genome sequencing and assembly","submission_date":"2021/02/26 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN18079559","activated sludge","probable_urban","municipal_wastewater","2015-09-22",2015,"CN","Jiangsu",1815456,"Changzhou","verified",31.7224,120.0508,"China: Changzhou,Jiangsu","air aeration tank sample AAT.1",null,null,null,"city-level location without sample-site confirmation"],["SAMN18079560","activated sludge","probable_urban","municipal_wastewater","2015-09-22",2015,"CN","Jiangsu",1815456,"Changzhou","verified",31.7224,120.0508,"China: Changzhou,Jiangsu","air aeration tank sample AAT.2",null,null,null,"city-level location without sample-site confirmation"],["SAMN18079561","activated sludge","probable_urban","municipal_wastewater","2015-09-22",2015,"CN","Jiangsu",1815456,"Changzhou","verified",31.7224,120.0508,"China: Changzhou,Jiangsu","pure oxygen aeration tank sample POAT.1",null,null,null,"city-level location without sample-site confirmation"],["SAMN18079562","ac