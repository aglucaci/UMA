{"v":1,"accession":"PRJNA1492074","title":"Mixed microbial community composition for PHA synthesis under different biomass densities.","description":"We constructed mixed microbial consortia capable of PHA production at different biomass densities and examined their community composition as a function of biomass density, with the aim of determining whether PHA synthesis is feasible under high-density conditions. This work offers microbiological insights that can inform future process development for PHA production from high-density biomass, while also underscoring the potential for significant improvements in process productivity.","center":"Tsinghua university","data_type":"Raw sequence reads","submission_date":"2026/07/08 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN61474755","Metagenome or environmental sample from bioreactor metagenome","non_environmental",null,"2023-05-14",2023,"CN","Beijing",1816670,"Beijing","verified",39.9,116.4,"China: Beijing","activated sludge from a wastewater treatment plant",null,null,null,"laboratory or culture material"],["SAMN61474756","Metagenome or environmental sample from bioreactor metagenome","non_environmental",null,"2023-05-20",2023,"CN","Beijing",1816670,"Beijing","verified",39.9,116.4,"China: Beijing","activated sludge from a wastewater treatment plant",null,null,null,"laboratory or culture material"],["SAMN61474757","Metagenome or environmental sample from bioreactor metagenome","non_environmental",null,"2023-05-26",2023,"CN","Beijing",1816670,"Beijing","verified",39.9,116.4,"China: Beijing","activated sludge from a wastewater treatment plant",null,null,null,"laboratory or culture material"],["SAMN61474758","Metagenome or environmental sample from bioreactor metagenome","non_envir