{"v":1,"accession":"PRJNA1068586","title":"Waste activated sludge metagenome","description":"We studied the effects of humic substances combined with ofloxacin on microbial communities and functional genes during anaerobic digestion of waste activated sludge. We found that the coexistence of HS and OFL significantly affected the community abundance of hydrolytic, acidifying, and methanogenic microorganisms. At the same time, the coexistence of HS and OFL significantly changed the expression of genes related to hydrolysis, acidification and methanogenesis.","center":"Hunan University","data_type":"Raw sequence reads","submission_date":"2024/01/24 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN39596353","Waste activated sludge metagenome:HS0","probable_urban","municipal_wastewater","2023-03-13",2023,"CN","Hunan",1815577,"Changsha","probable",null,null,"China:Changsha","Digested sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN39596354","Waste activated sludge metagenome:HS1","probable_urban","municipal_wastewater","2023-03-13",2023,"CN","Hunan",1815577,"Changsha","probable",null,null,"China:Changsha","Digested sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN39596355","Waste activated sludge metagenome:HS2","probable_urban","municipal_wastewater","2023-03-13",2023,"CN","Hunan",1815577,"Changsha","probable",null,null,"China:Changsha","Digested sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN39596356","Waste activated sludge metagenome:HS3","probable_urban","municipal_wastewater","2023-03-13",2023,"CN","Hunan",1815577,"Changsha","probable",null,null,"China:Changsha","Digested sludge",null,null,null,"city-level location with