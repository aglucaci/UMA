{"v":1,"accession":"PRJDB4563","title":"Microbial community structure of enriched cultures fed with nitrous oxide as an electron acceptor","description":"This project focused on nitrous oxide reducing bacteria, which contribute to mitigation of nitrous oxide in natural environments and engineered systems. We developed a special enrichment device, termed a Gas Permeable Membrane Device, continuously supplying nitrous oxide as an electron acceptor. This device allows enrichment of N2O reducing bacteria to be grown on the membrane surface. The device was inoculated with activated sludge from a municipal wastewater treatment plant in Tokyo, Japan. The microbial community structure of the enriched culture was investigated using V4 region of 16S rRNA gene.","center":"Hosomi and Terada Laboratory, Chemical Engineering, Depertment of Technology, Tokyo University of Agriculture and Technology","data_type":"Other","submission_date":"2018/02/04 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD00046845","Enriched cultures fed with nitrous oxide_Inoculum_activated sludge","probable_urban","municipal_wastewater","2013-11-20",2013,"JP","Tokyo",1850147,"Tokyo","verified",35.655,139.508,"Japan:Tokyo, Kitatama-ichigo municipal wastewater treatment plant",null,null,"wasetewater treatment plant","activated sludge","urban context stated at BioProject level only"],["SAMD00046846","Enriched cultures fed with nitrous oxide_GPMD1_day12","non_environmental",null,"2013-12-02",2013,"JP","Tokyo",1850147,"Tokyo","verified",35.698,139.518,"Japan:Tokyo",null,null,"bioreactor","sludge","laboratory or culture material"],["SAMD00046847","Enriched cultures fed with nitrous oxide_GPMD1_day35","non_environmental",null,"2013-12-25",2013,"JP","Tokyo",1850147,"Tokyo","