{"v":1,"accession":"PRJNA489301","title":"Genome sequencing and assembly of Buchnera aphidicola","description":"Symbiotic interaction between hosts and microbes promotes the establishment of new ecological niches and has profound impacts on the evolutionary trajectory of eukaryotic lineages. Many insects harbor maternally transmitted endosymbionts that provision hosts with key nutrients. One key evolutionary consequence of vertically transmitted symbiosis is rapid degradation of symbiont genomes. We use the system of aphids and their obligate endosymbionts, Buchnera aphidicola, to explore the evolutionary process of symbiont genome degradation and the functional consequences of this process.","center":"Integrative Biology, University of Texas at Austin","data_type":"Genome sequencing and assembly","submission_date":"2018/09/04 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN09980500","Buchnera_aphidicola_str._Aar","non_environmental",null,null,2011,"CA","Alberta",null,null,"unresolved",49.1156,-110.4688,"Canada: Onefour, Alberta",null,"sagebrush","sagebrush","air","host-derived or clinical material"],["SAMN09980501","Buchnera_aphidicola_str._Acr","non_environmental",null,null,2010,"US","Arizona",5318313,"Tucson","verified",32.2318,-110.9507,"USA: Tucson, Arizona",null,"fava bean","fava bean","air","host-derived or clinical material"],["SAMN09980502","Buchnera_aphidicola_str._Ala","non_environmental",null,null,2005,"US","Arizona",5318313,"Tucson","verified",32.2318,-110.9507,"USA: Tucson, Arizona",null,"lettuce","lettuce","air","host-derived or clinical material"],["SAMN09980503","Buchnera_aphidicola_str._Ahe","non_environmental",null,null,2006,"US","Arizona",null,null,"unresolved",32.443,-110.788,"USA: Mt. Lemmon, Arizona",null