{"v":1,"accession":"PRJNA1013332","title":"Scalp microbiome study","description":"Aim of the present study was to compare the scalp microbiomes of healthy volunteers with normal or oily scalp. In the context of this study, oily scalp was defined as a Sebumeter value higher than 120 micrograms per square centimeter, normal scalp was defined as a Sebumeter value between 60 and 120 micrograms per square centimeter. The study participants were 19-66 years old, male or female, healthy, and of different ethnic backgrounds. Recruitment and sampling of study participants were conducted in August 2018 by BASF at the Tarrytown Consumer Testing Center (Tarrytown, NY, U.S.A).","center":"BASF Metabolome Solutions GmbH","data_type":"Raw sequence reads","submission_date":"2023/09/06 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN37295755","MIMS Environmental/Metagenome sample from human skin metagenome","non_environmental",null,null,2018,"US","New York",5110266,"The Bronx","probable",41.06,-73.84,"USA: New York metropolitan area",null,"skin environment","scalp","skin swab","host-derived or clinical material"],["SAMN37295756","MIMS Environmental/Metagenome sample from human skin metagenome","non_environmental",null,null,2018,"US","New York",5110266,"The Bronx","probable",41.06,-73.84,"USA: New York metropolitan area",null,"skin environment","scalp","skin swab","host-derived or clinical material"],["SAMN37295758","MIMS Environmental/Metagenome sample from human skin metagenome","non_environmental",null,null,2018,"US","New York",5110266,"The Bronx","probable",41.06,-73.84,"USA: New York metropolitan area",null,"skin environment","scalp","skin swab","host-derived or clinical material"],["SAMN37295759","MIMS Environmental/Metagenome sample from h