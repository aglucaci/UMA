{"v":1,"accession":"PRJNA1219086","title":"Plastispheres as Reservoirs of Antimicrobial Resistance","description":"We address knowledge gaps regarding the plastisphere's resistome and its accumulation in aquatic environments. We use metagenomics to analyze the resistome of plastispheres from freshwater, raw wastewater, and treated wastewater. Aims are to 1) Assess resistome diversity, 2) Quantify ARG abundance, 3) Identify clinically relevant pathogens (e.g., E. coli, ESKAPE pathogens), and 4) Link ARGs to bacterial hosts via assembly-based methods.This work enhances our understanding of the plastisphere's role in antimicrobial resistance dissemination and its ecological and public health risks.","center":"Norwegian University of Life Sciences","data_type":"Raw sequence reads","submission_date":"2025/02/04 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN46540836","Wastewater biofilm metagenome","uncertain",null,"2021-09-28",2021,"NO","Oslo",3143244,"Oslo","probable",59.7935,10.5007,"Norway: VEAS, Slemmestad","Biofilm from PP plastic in untreated wastewater",null,null,null,"environmental sample; urban association not established"],["SAMN46540837","Wastewater biofilm metagenome","uncertain",null,"2021-09-28",2021,"NO","Oslo",3143244,"Oslo","probable",59.7935,10.5007,"Norway: VEAS, Slemmestad","Biofilm from PVC plastic in untreated wastewater",null,null,null,"environmental sample; urban association not established"],["SAMN46540838","Wastewater biofilm metagenome","uncertain",null,"2021-09-28",2021,"NO","Oslo",3143244,"Oslo","probable",59.7935,10.5007,"Norway: VEAS, Slemmestad","Biofilm from PEHD plastic in untreated wastewater",null,null,null,"environmental sample; urban association not established"],["SAMN46540839","Wastewater bi