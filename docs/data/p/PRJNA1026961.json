{"v":1,"accession":"PRJNA1026961","title":"Metagenomic sequencing of urban stormwater runoff","description":"Surface water was collected for 10 days of dry weather, then stormwater samples were collected at five locations that ranged in drainage area characteristics. Stormwater and surface water samples were mixed to observe the impact on the resistome, and monitored for 5 days. DNA was extracted from all samples via MP Biomedicals FastDNA Spin Kit. A composite sample of the extracts was prepared for each site and sampling event by combining the triplicate samples by an equal DNA mass. Metagenomic sequencing completed on Illumina NextSeq 2000 platform (151 bp paired end) at a sequencing depth of 650 Mbp. Deposited sequences are full-length, untrimmed reads.","center":"Marquette University","data_type":"Raw sequence reads","submission_date":"2023/10/11 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN37769213","SUR_8_3","probable_urban","water_drainage","2023-08-03",2023,"US","Wisconsin",5263045,"Milwaukee","probable",43.025,-87.9009,"USA:Wisconsin","surface water",null,null,null,"urban context stated at BioProject level only"],["SAMN37769214","SUR_8_4","probable_urban","water_drainage","2023-08-04",2023,"US","Wisconsin",5263045,"Milwaukee","probable",43.025,-87.9009,"USA:Wisconsin","surface water",null,null,null,"urban context stated at BioProject level only"],["SAMN37769215","SUR_8_5","probable_urban","water_drainage","2023-08-05",2023,"US","Wisconsin",5263045,"Milwaukee","probable",43.025,-87.9009,"USA:Wisconsin","surface water",null,null,null,"urban context stated at BioProject level only"],["SAMN37769216","SUR_8_6","probable_urban","water_drainage","2023-08-06",2023,"US","Wisconsin",5263045,"Milwaukee","probable",43.025,-87.