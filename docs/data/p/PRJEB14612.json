{"v":1,"accession":"PRJEB14612","title":"Molecular-based evaluation of the influent and effluent microbial communities of membrane bioreactor (MBR) systems treating municipal wastewater","description":"Given that the majority of pathogens in wastewater are not detectable by culture-based methods, a molecular-based approach would be necessary to understand the risks associated with the microbial communities of MBR effluents. The present study examines two MBR systems treating municipal wastewater, one a full-scale MBR plant and the other a lab-scale anaerobic MBR, by using high-throughput sequencing and PCR quantification. Results showed that each of the two MBR effluents’ microbial communities contained genera associated with opportunistic pathogens (e.g., Pseudomonas, Acinetobacter) with a wide-range of log reduction values.","center":"WDRC KAUST","data_type":"Other","submission_date":"2017/03/02 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA4051617","01-Influent-10Mar15","probable_urban","municipal_wastewater",null,2015,"SA",null,null,null,"unresolved",null,null,"Saudi Arabia",null,null,null,null,"urban context stated at BioProject level only"],["SAMEA4051618","02-Influent-28Apr15","probable_urban","municipal_wastewater",null,2015,"SA",null,null,null,"unresolved",null,null,"Saudi Arabia",null,null,null,null,"urban context stated at BioProject level only"],["SAMEA4051619","03-Influent-1Jul15","probable_urban","municipal_wastewater",null,2015,"SA",null,null,null,"unresolved",null,null,"Saudi Arabia",null,null,null,null,"urban context stated at BioProject level only"],["SAMEA4051620","04-Influent-8Sept15","probable_urban","municipal_wastewater",null,2015,"SA",null,null,null,"unresolved",null,null,"Saudi Arabia",null,null,null