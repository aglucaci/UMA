{"v":1,"accession":"PRJNA1518401","title":"16S and 18S rRNA gene amplicon sequencing of algal-bacterial symbiotic sludge","description":"This project contains 16S and 18S rRNA gene amplicon sequencing data of algal-bacterial symbiotic sludge samples. The 16S rRNA gene was amplified to characterize bacterial community structure, and the 18S rRNA gene was amplified to characterize eukaryotic community structure. Samples were collected from a wastewater treatment reactor in China. High-throughput sequencing was performed on the Illumina platform. This dataset provides insights into the microbial community composition and diversity in algal-bacterial symbiotic sludge systems.","center":"Chongqing Jiaotong University","data_type":"Raw sequence reads","submission_date":"2026/08/26 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN62690372","Algal-bacterial symbiotic sludge sample D1","confirmed_urban","municipal_wastewater","2025-07-01",2025,"CN","Chongqing",1814906,"Chongqing","verified",29.5,106.5,"China: Chongqing",null,"wastewater treatment plant","algal-bacterial symbiotic sludge","sludge","named urban infrastructure at sample level"],["SAMN62690373","Algal-bacterial symbiotic sludge sample D2","confirmed_urban","municipal_wastewater","2025-07-20",2025,"CN","Chongqing",1814906,"Chongqing","verified",29.5,106.5,"China: Chongqing",null,"wastewater treatment plant","algal-bacterial symbiotic sludge","sludge","named urban infrastructure at sample level"],["SAMN62690374","Algal-bacterial symbiotic sludge sample D3","confirmed_urban","municipal_wastewater","2025-08-10",2025,"CN","Chongqing",1814906,"Chongqing","verified",29.5,106.5,"China: Chongqing",null,"wastewater treatment plant","algal-bacterial symbiotic sludge","sludge","named ur