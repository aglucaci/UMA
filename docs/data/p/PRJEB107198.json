{"v":1,"accession":"PRJEB107198","title":"Stormwater effects on two segrass species in the Derwent Estuary, Tasmania","description":"We examined how the condition of Zostera muelleri and Heterozostera nigricaulis and their below-ground bacterial communities (bulk sediment and rhizosphere) responded to large-scale abiotic factors and localized water quality stressors (e.g. proximity to stormwater outfalls) along the Derwent estuary, Tasmania. Overall, our results highlight the dominant influence of localized water quality stressors on seagrass condition and associated microbial communities in a highly urbanised temperate estuary.","center":"University of New South Wales","data_type":"Other","submission_date":"2026/07/24 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA121072945","Bulk_BB1_HeZos","non_environmental",null,"2022-02-20",2022,"AU",null,null,null,"unresolved",null,null,"Australia",null,null,null,null,"host-derived or clinical material"],["SAMEA121072946","Bulk_BB2_HeZos","non_environmental",null,"2022-02-20",2022,"AU",null,null,null,"unresolved",null,null,"Australia",null,null,null,null,"host-derived or clinical material"],["SAMEA121072947","Bulk_BB3_HeZos","non_environmental",null,"2022-02-20",2022,"AU",null,null,null,"unresolved",null,null,"Australia",null,null,null,null,"host-derived or clinical material"],["SAMEA121072948","Bulk_NTC_2","uncertain",null,"2022-02-20",2022,"AU",null,null,null,"unresolved",null,null,"Australia",null,null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMEA121072949","Bulk_NTC_3","uncertain",null,"2022-02-20",2022,"AU",null,null,null,"unresolved",null,null,"Australia",null,null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMEA121072950","B