{"v":1,"accession":"PRJEB28103","title":"Anaerobic digestion of phenol rich influent","description":"Aims of this study were (1) to investigate the phenol-degrading anaerobic population in operationally identical reactors in order to identify key players involved in phenol degradation and resistance in AD reactors and (2) to determine the impact of the inoculum in shaping the structure of the phenol-degrading community. It was tested whether different starting communities, adapted to different phenolic compounds, were as effective in treating a mixture of dairy and phenolic wastewater.Four different inocula were studied in triplicate lab-scale reactors run over a period of 180 to 265 days. The reactors were operated at mesophilic conditions with a mixture of a synthetic dairy and phenol wastewater.","center":"KU LEUVEN","data_type":"Other","submission_date":"2018/10/09 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA4820716","D1_0_DNA","non_urban",null,null,2016,"BE",null,null,null,"unresolved",null,null,"Belgium",null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMEA4820717","D1_103_DNA","non_urban",null,null,2016,"BE",null,null,null,"unresolved",null,null,"Belgium",null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMEA4820718","D1_180_DNA","non_urban",null,null,2016,"BE",null,null,null,"unresolved",null,null,"Belgium",null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMEA4820719","D2_0_DNA","non_urban",null,null,2016,"BE",null,null,null,"unresolved",null,null,"Belgium",null,null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMEA4820720","D2_103_DNA","non_urban",null,null,2016,"BE",null,null,null,"