{"v":1,"accession":"PRJNA1267697","title":"High-throughput 16S rRNA gene sequencing (V3V4) was used to characterize the microbial communities on two skin sites--palmar and facial surfaces--in human subjects. The study included two experimental approaches: short-term in vitro exposure to simul","description":"High-throughput 16S rRNA gene sequencing (V3V4) was used to characterize the microbial communities on two skin sites--palmar and facial surfaces--in human subjects. The study included two experimental approaches: short-term in vitro exposure to simulate the effects of post-collection environmental stressors on the skin microbiome, and longitudinal in vivo sampling to monitor its temporal dynamics under natural conditions. We further explored the potential of skin microbial profiles for distinguishing anatomical sites and identifying individuals based on inter-individual variations.","center":"Southern medical university","data_type":"Raw sequence reads","submission_date":"2025/05/25 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN48727090","N_6H_1","probable_urban","air_dust","2024-05-17",2024,"CN","Guangdong",1809858,"Guangzhou","verified",23.19,113.33,"China: Guangzhou",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN48727092","N_6H_2","probable_urban","air_dust","2024-05-17",2024,"CN","Guangdong",1809858,"Guangzhou","verified",23.19,113.33,"China: Guangzhou",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN48727094","N_6H_3","probable_urban","air_dust","2024-05-17",2024,"CN","Guangdong",1809858,"Guangzhou","verified",23.19,113.33,"China: Guangzhou",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN48727156","N_12H_1","proba