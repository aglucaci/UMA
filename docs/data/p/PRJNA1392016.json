{"v":1,"accession":"PRJNA1392016","title":"self-driven bio-electrochemical system for efficient nitrogen and phosphorus removal of wastewater","description":"It was first discovered that connecting iron-carbon located in different functional areas of the sewage treatment process with wire could enable the flow of electrons across regions. Batch experiments demonstrated that an iron-carbon self-driven bio-electrochemical system (SD-BES) significantly enhances the denitrification rate of microbial community. Leveraging this finding, we designed a SD-BES trickling filter in which iron-carbon electrodes are spatially separated into an anoxic zone and a micro-oxic zone and connected by a single wire to enable cross-zone electron flow for treating real municipal sewage.","center":"Zhejiang University of Technology","data_type":"Raw sequence reads","submission_date":"2025/12/21 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN54240263","L0","probable_urban","municipal_wastewater","2025-05-03",2025,"CN","Zhejiang",1808926,"Hangzhou","verified",null,null,"China:Hangzhou","wastewater",null,null,null,"city-level location without sample-site confirmation"],["SAMN54240264","L1","probable_urban","municipal_wastewater","2025-05-03",2025,"CN","Zhejiang",1808926,"Hangzhou","verified",null,null,"China:Hangzhou","wastewater",null,null,null,"city-level location without sample-site confirmation"],["SAMN54240265","L2","probable_urban","municipal_wastewater","2025-05-03",2025,"CN","Zhejiang",1808926,"Hangzhou","verified",null,null,"China:Hangzhou","wastewater",null,null,null,"city-level location without sample-site confirmation"],["SAMN54240266","L3","probable_urban","municipal_wastewater","2025-05-03",2025,"CN","Zhejiang",1808926,"Hangzhou","verified