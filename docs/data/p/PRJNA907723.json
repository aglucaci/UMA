{"v":1,"accession":"PRJNA907723","title":"16SrRNA amplicon sequeces of wastewater that treated by PFA, UV and chlorine","description":"This study provides a systematic overview of the PFA effect and that of chlorine and UV, two commonly used disinfectants, on microbial community diversity and structure. The study focuses on disinfection of pathogenic microorganisms, identifying sensitive and resistant bacteria to disinfectants that can serve as biomarkers for evaluating the disinfectant performances. As well, we investigated the modifications of microbial functions after treatment by functional predictive analysis. Wastewaters from three municipal wastewater treatment plants (WWTPs) processed by activated sludge, lagoon and reed beds, and biofilter, were investigated.","center":"Guangdong Academy of Sciences","data_type":"Raw sequence reads","submission_date":"2022/12/02 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN31988979","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater",null,2020,"FR","New Aquitaine",3036522,"Assat","verified",43.25,-0.29,"France:Assat","wastewater",null,null,null,"city-level location without sample-site confirmation"],["SAMN31988980","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater",null,2020,"FR","New Aquitaine",3036522,"Assat","verified",43.25,-0.29,"France:Assat","wastewater",null,null,null,"city-level location without sample-site confirmation"],["SAMN31988981","Metagenome or environmental sample from wastewater metagenome","probable_urban","municipal_wastewater",null,2020,"FR","New Aquitaine",3036522,"Assat","verified",43.25,-0.29,"France:Assat","wastewater",null,null,null,"city-level location