{"v":1,"accession":"PRJNA430711","title":"Metagenome from mesophilic biogas fermenters digesting food waste at different feeding frequencies","description":"Two digesters (CSTRs) were fed the same amount of thermally hydrolyzed food waste each day, with different feeding frequency. Three more digesters treating conventionally hygienized food waste is included in the study. Digesters were operated at mesophilic conditions (37 C) and at 10-60 days HRT. Feeding frequency influenced microbial community structure. Microbial community structure was studied by sequencing of the V3-V4 hypervariable region of the 16S rRNA gene.","center":"NIBIO","data_type":"Targeted loci environmental","submission_date":"2018/01/18 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN08377138","Mesofilic Digestion System D0 timepoint 2 (day 0)","non_environmental",null,"2016-08-25",2016,"NO","Akershus",3162797,"Ås","verified",59.6623,10.7511,"Norway: As",null,"anthropogenic","anaerobic bioreactor","anaerobic digester sludge","laboratory or culture material"],["SAMN08377139","Mesofilic Digestion System DFD timepoint 1 (day 38)","non_environmental",null,"2016-10-02",2016,"NO","Akershus",3162797,"Ås","verified",59.6623,10.7511,"Norway: As",null,"anthropogenic","anaerobic bioreactor","anaerobic digester sludge","laboratory or culture material"],["SAMN08377140","Mesofilic Digestion System DFD timepoint 2 (day 44)","non_environmental",null,"2016-10-08",2016,"NO","Akershus",3162797,"Ås","verified",59.6623,10.7511,"Norway: As",null,"anthropogenic","anaerobic bioreactor","anaerobic digester sludge","laboratory or culture material"],["SAMN08377141","Mesofilic Digestion System DFD timepoint 3 (day 46)","non_environmental",null,"2016-10-10",2016,"NO","Akershus",3162797