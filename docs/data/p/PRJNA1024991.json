{"v":1,"accession":"PRJNA1024991","title":"Metagenomic sequencing of green stormwater infrastructure","description":"25 soil samples were collected in various green stormwater infrastructure systems, i.e., bioswales, bioretention cells, and constructed wetland. DNA was extracted via QIAGEN DNeasy PowerLyzer PowerSoil Kit. A composite sample of the extracts was prepared for each site by combining the triplicate samples by an equal DNA mass. One sample was sequenced per site. Metagenomic sequencing completed on Illumina NextSeq 2000 platform (151 bp paired end) at a sequencing depth of 650 Mbp. Deposited sequences are full-length, untrimmed reads.","center":"Marquette University","data_type":"Raw sequence reads","submission_date":"2023/10/06 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN37707366","Metagenome or environmental sample from soil metagenome","uncertain",null,"2021-08-06",2021,"US","Wisconsin",null,null,"unresolved",42.936,-88.473,"USA:Wisconsin","Natural protected prairie",null,null,null,"environmental sample; urban association not established"],["SAMN37707367","Metagenome or environmental sample from soil metagenome","uncertain",null,"2021-07-20",2021,"US","Wisconsin",5263045,"Milwaukee","probable",43.062,-87.94,"USA:Wisconsin","bioswale",null,null,null,"environmental sample; urban association not established"],["SAMN37707368","Metagenome or environmental sample from soil metagenome","uncertain",null,"2021-08-06",2021,"US","Wisconsin",5263045,"Milwaukee","probable",43.059,-87.938,"USA:Wisconsin","bioswale",null,null,null,"environmental sample; urban association not established"],["SAMN37707369","Metagenome or environmental sample from soil metagenome","uncertain",null,"2021-07-29",2021,"US","Wisconsin",5263045,"Mil