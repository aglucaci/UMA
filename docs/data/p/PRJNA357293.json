{"v":1,"accession":"PRJNA357293","title":"Chlorella vulgaris associated bacterial community in a microbial fuel cell treating wastewater - Raw sequence reads","description":"Chlorella vulgaris can be used to treat wastewater and produce oxygen at the cathode of microbial fuel cells (MFCs), thereby enabling biomass and electricity production. We combined both features by growing C. vulgaris at the cathode of MFCs in wastewater previously treated by anodic bacteria. The bioelectrochemical performance was investigated with different catholytes including phosphate buffer and anode effluent either with or without C. vulgaris.","center":"University of Technology Sydney","data_type":"Raw sequence reads","submission_date":"2016/12/13 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN06140797","Bacterial_associated_Anode_MFC1","non_environmental",null,null,2016,null,null,null,null,"unresolved",null,null,null,"Fuel cell wastewater bioreactor",null,null,null,"laboratory or culture material"],["SAMN06140798","Bacterial_associated_Anode_MFC2","non_environmental",null,null,2016,null,null,null,null,"unresolved",null,null,null,"Fuel cell wastewater bioreactor",null,null,null,"laboratory or culture material"],["SAMN06140799","Bacterial_associated_Cathode_MFC1","non_environmental",null,null,2016,null,null,null,null,"unresolved",null,null,null,"Fuel cell wastewater bioreactor",null,null,null,"laboratory or culture material"],["SAMN06140800","Bacterial_associated_Cathode_MFC2","non_environmental",null,null,2016,null,null,null,null,"unresolved",null,null,null,"Fuel cell wastewater bioreactor",null,null,null,"laboratory or culture material"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","ba