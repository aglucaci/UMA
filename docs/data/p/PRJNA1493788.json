{"v":1,"accession":"PRJNA1493788","title":"Examining the Ice-Nucleating Particles from the Gruvebadet Observatory (ExINP-GVB)","description":"This project investigates the sources, abundance, composition, and ice-nucleating properties of atmospheric aerosols in the Atlantic Arctic to improve understanding of cloud feedbacks contributing to Arctic amplification. Using complementary online and offline ice-nucleating particle (INP) measurement techniques at the Gruvebadet Observatory, the international research team will characterize natural and anthropogenic INPs, including biological aerosols and marine-derived compounds, across multiple ice nucleation pathways. The resulting observations will be integrated with atmospheric model simulations to develop improved Arctic ice nucleation parameterizations, enabling more accurate representation of mixed-phase cloud processes and aerosols - cloud interactions in regional and global climate models.","center":"Agricultural University of Athens","data_type":"Raw sequence reads","submission_date":"2026/07/11 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN61572271","ExINP.GVB.8","probable_urban","air_dust","2023-03-25",2023,"SJ",null,null,null,"unresolved",78.9167,11.9333,"Svalbard:Gruvebadet","Ambient atmospheric aerosol",null,null,null,"city-level location without sample-site confirmation"],["SAMN61572272","ExINP.GVB.10","probable_urban","air_dust","2023-03-28",2023,"SJ",null,null,null,"unresolved",78.9167,11.9333,"Svalbard:Gruvebadet","Ambient atmospheric aerosol",null,null,null,"city-level location without sample-site confirmation"],["SAMN61572273","ExINP.GVB.13","probable_urban","air_dust","2023-03-31",2023,"SJ",null,null,null,"unresolved",78.9167,11.9333,"Svalbard:Gruvebadet","Ambien