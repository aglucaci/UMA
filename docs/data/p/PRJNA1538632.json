{"v":1,"accession":"PRJNA1538632","title":"Signaling molecule chain elongation","description":"The term \"signal molecule chain elongation\" refers to the enzymatic or biosynthetic extension of the carbon backbone of a signaling molecule, most commonly a lipid mediator, resulting in a longer acyl or sphingoid chain. It can also describe the extension of peptide chains during translation or the addition of repeating units (e.g., ubiquitin, glycosaminoglycans) to signaling proteins. This section focuses on lipid-derived signaling molecules, because chain elongation is a central determinant of their physicochemical and biological properties.","center":"Taiyuan University of Technology","data_type":"Raw sequence reads","submission_date":"2026/10/03 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN63859267","con320","uncertain",null,"2026-10-03",2026,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN63859268","con321","uncertain",null,"2026-10-03",2026,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN63859269","con322","uncertain",null,"2026-10-03",2026,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN63859270","con323","uncertain",null,"2026-10-03",2026,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN63859271","con324","uncertain",null,"2026-10-03",2026,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"environmental sample; urban association not established"],["SAMN63859272","con325",