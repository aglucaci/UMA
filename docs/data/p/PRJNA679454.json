{"v":1,"accession":"PRJNA679454","title":"A direct metamobilome approach increases the detection of larger-sized ciruclar DNA elements","description":"Metamobilomics (sequencing cirucular DNA < approx 100kb) is usually performed using DNA exonucleases to remove linear DNA followed by a rolling circle (typically phi29) amplification. The aim of this study is to systematically assess the size dependent bias introduced by phi29 amplification and show that omiting this step greatly increases our ability to sequence and assembly large circular DNA elements such as plasmids","center":"University of Copenhagen","data_type":"Raw sequence reads","submission_date":"2020/11/19 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN16834242","Skvinge wastewater 2016","non_environmental",null,null,2016,"DK","Capital Region",2613471,"Skævinge","verified",55.92,12.15,"Denmark: Skvinge","Municipal wastewater",null,null,null,"laboratory or culture material"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR13100866","SAMN16834242","SRX9546475","WGS","WGA","METAGENOMIC","PAIRED","ILLUMINA","NextSeq 500",580209424,2094941,"2021-05-04","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos13/sra-pub-zq-1301/SRR013/13100/SRR13100866/SRR13100866.lite.1"],["SRR13100867","SAMN16834242","SRX9546474","WGS","WGA","METAGENOMIC","PAIRED","ILLUMINA","NextSeq 500",682505012,2440873,"2021-05-04","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos13/sra-pub-zq-1301/SRR013/13100/SRR13100867/SRR13100867.lite.1"],["SRR13100868","SAMN16834242","SRX9546473","WGS","WGA","METAGENOMIC","PAIRED","ILLUMINA","NextSeq 500",558504285,2003328,"2021-05-04","https://sra-do