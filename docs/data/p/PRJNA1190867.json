{"v":1,"accession":"PRJNA1190867","title":"Algal and bacterial communities in mixotrophic cultures","description":"We investigated a potential of monoculturing Monoraphidium minutum using flue gas condensate water and cheese whey water in outdoor pilot-scale open ponds. Biocontamination is unevitable for cultivations in outdoor open systems. For successful cultivations, invaders should not outcompete the dominant species. In the study, 18S and amplicon sequencing using 18S and 16S rRNA gene markers were applied to keep track on the biocontamination throughout the experiment.","center":"Linnaeus University","data_type":"Raw sequence reads","submission_date":"2024/11/26 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN45059695","P28408_1001","uncertain",null,"2022-10-19",2022,"SE","Kalmar",2702261,"Kalmar","probable",null,null,"Sweden: Moskogen, Kalmar","Baltic Sea, Oland, Kalmar, Sweden",null,"2 wastewaters_replicate 1","Fluegas_whey","environmental sample; urban association not established"],["SAMN45059696","P28408_1002","uncertain",null,"2022-10-19",2022,"SE","Kalmar",2702261,"Kalmar","probable",null,null,"Sweden: Moskogen, Kalmar","Baltic Sea, Oland, Kalmar, Sweden",null,"1 wastewater_replicate 1","Fluegas","environmental sample; urban association not established"],["SAMN45059697","P28408_1003","uncertain",null,"2022-10-19",2022,"SE","Kalmar",2702261,"Kalmar","probable",null,null,"Sweden: Moskogen, Kalmar","Baltic Sea, Oland, Kalmar, Sweden",null,"2 wastewaters_replicate 2","Fluegas_whey","environmental sample; urban association not established"],["SAMN45059698","P28408_1004","uncertain",null,"2022-10-19",2022,"SE","Kalmar",2702261,"Kalmar","probable",null,null,"Sweden: Moskogen, Kalmar","Baltic Sea, Oland, Kalmar, Sweden",nul