{"v":1,"accession":"PRJNA1375486","title":"Engineered carbon-depleted zone in Anaerobic/Aerobic/Anoxic process as a key in-situ anammox incubation hub for mainstream municipal wastewater treatment","description":"Competitive nitrite consumption by heterotrophic organisms and the carbon sensitivity of anammox bacteria limit mainstream anammox performance. This study demonstrates that deliberately established carbon-depleted zones within anaerobic/aerobic/anoxic (AOA) processes served as in-situ anammox incubation hubs by regulating endogenous and exogenous carbon metabolism, achieving 92.3% nitrogen removal with 59.4% via anammox and effluent total inorganic nitrogen of 5.1 mg/L at C/N 3.2.","center":"Beijing University of Technology","data_type":"Raw sequence reads","submission_date":"2025/12/05 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN53686882","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater",null,2024,"CN",null,null,null,"unresolved",null,null,"China",null,null,null,null,"urban context stated at BioProject level only"],["SAMN53686883","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater",null,2024,"CN",null,null,null,"unresolved",null,null,"China",null,null,null,null,"urban context stated at BioProject level only"],["SAMN53686884","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater",null,2024,"CN",null,null,null,"unresolved",null,null,"China",null,null,null,null,"urban context stated at BioProject level only"],["SAMN53686885","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater",null,2024,"CN",null,null,null,"unresolved",null,null,"