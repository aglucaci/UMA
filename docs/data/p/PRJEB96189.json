{"v":1,"accession":"PRJEB96189","title":"16S survey of AD inhibition by NaPr in semi-continuous reactors","description":"In this study, four 5-liter reactors (R1, R2, R3, and R4) were operated in semi-continuous mode using municipal sewage sludge. The reactors were semi-continuously fed with different levels of sodium propionate, NaPr (0, 1.95, 7.78, and 13 g.L-1, equivalent to 0, 1.5, 6, and 10 g HPr.L-1) after an acclimation period. The reactors operated for 81 days at 37°C, with a hydraulic retention time of 20 days.","center":"INRAE Ile de France Jouy en Josas - Antony","data_type":"Other","submission_date":"2026/07/02 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA119518306","NDS_D00_S1a","confirmed_urban","municipal_wastewater","2023-05-30",2023,"FR",null,null,null,"unresolved",null,null,"France",null,null,null,null,"named urban infrastructure at sample level"],["SAMEA119518307","NDS_D00_S1b","confirmed_urban","municipal_wastewater","2023-05-30",2023,"FR",null,null,null,"unresolved",null,null,"France",null,null,null,null,"named urban infrastructure at sample level"],["SAMEA119518308","NDS_D40_S2a","confirmed_urban","municipal_wastewater","2023-07-07",2023,"FR",null,null,null,"unresolved",null,null,"France",null,null,null,null,"named urban infrastructure at sample level"],["SAMEA119518309","NDS_D40_S2b","confirmed_urban","municipal_wastewater","2023-07-07",2023,"FR",null,null,null,"unresolved",null,null,"France",null,null,null,null,"named urban infrastructure at sample level"],["SAMEA119518310","NDS_D51_S3a","confirmed_urban","municipal_wastewater","2023-07-21",2023,"FR",null,null,null,"unresolved",null,null,"France",null,null,null,null,"named urban infrastructure at sample level"],["SAMEA119518311","NDS_D51_S3b","confir