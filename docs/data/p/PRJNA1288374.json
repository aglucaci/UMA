{"v":1,"accession":"PRJNA1288374","title":"BIOFINDIC","description":"The BIOFilms as bioINDICators (BIOFINDIC) project aims to study the potential of diatom communities in marine biofilms as bioindicators of the quality of coastal Mediterranean water bodies. This study involves the analysis of biofilms that colonized 150 A4 polyethylene plates immersed at 50 sites from March 16 to July 7, 2021, along the 1,800 km of the French Mediterranean coast. These sites were selected to best represent the diversity of Mediterranean coastal contexts.","center":"University of Toulon","data_type":"Raw sequence reads","submission_date":"2025/07/08 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN49845356","MIMARKS Survey related sample from biofilm metagenome","non_urban",null,"2021-06-30",2021,"FR","Corsica",3038334,"Ajaccio","probable",41.9,8.7,"France:Ajaccio wastewater treatment plant outfall:North-Western Mediterranean Sea",null,"mediterranean sea biome","polyethylene plate in marine environment","biofilm on polyethylene","environmental sample from a non-urban site"],["SAMN49845357","MIMARKS Survey related sample from biofilm metagenome","non_urban",null,"2021-06-30",2021,"FR","Corsica",3038334,"Ajaccio","probable",41.9,8.79,"France:Ajaccio Gravone wastewater treatment plant outfall:North-Western Mediterranean Sea",null,"mediterranean sea biome","polyethylene plate in marine environment","biofilm on polyethylene","environmental sample from a non-urban site"],["SAMN49845362","MIMARKS Survey related sample from biofilm metagenome","non_urban",null,"2021-07-04",2021,"FR","Corsica",3034640,"Bastia","probable",42.71,9.46,"France:Bastia North wastewater treatment plant outfall:North-Western Mediterranean Sea",null,"mediterranean sea biome","pol