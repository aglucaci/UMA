{"v":1,"accession":"PRJNA1258752","title":"Microbial community succession during low temperature anaerobic digestion","description":"Anaerobic digestion (AD) is a circular approach to managing organic waste as well as producing biogas (renewable energy) and the process by-product, digestate. Digestate arising from low temperature AD harbors microorganisms that are cold-tolerant. This study seeks to investigate microbial succession in response to gradual temperature reduction during AD. Cold-resilient microbes will be identified and their potential applications in improving low temperature AD will be highlighted.","center":"Agricultural Research Council - Soil, Climate and Water","data_type":"Raw sequence reads","submission_date":"2025/05/05 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN48330773","MIMARKS Survey related sample from anaerobic digester metagenome","probable_urban",null,null,2022,"ZA","Gauteng",964137,"Pretoria","verified",null,null,"South Africa: Pretoria",null,"anaerobic digester",null,null,"city-level location without sample-site confirmation"],["SAMN48330774","MIMARKS Survey related sample from anaerobic digester metagenome","probable_urban",null,null,2022,"ZA","Gauteng",964137,"Pretoria","verified",null,null,"South Africa: Pretoria",null,"anaerobic digester",null,null,"city-level location without sample-site confirmation"],["SAMN48330775","MIMARKS Survey related sample from anaerobic digester metagenome","probable_urban",null,null,2022,"ZA","Gauteng",964137,"Pretoria","verified",null,null,"South Africa: Pretoria",null,"anaerobic digester",null,null,"city-level location without sample-site confirmation"],["SAMN48330776","MIMARKS Survey related sample from anaerobic digester metagenome","probable_urban",null,n