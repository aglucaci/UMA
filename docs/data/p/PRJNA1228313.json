{"v":1,"accession":"PRJNA1228313","title":"Bacterial community in the soybean rhizosphere soil","description":"Additionally, microbial inoculum and chlorothalonil application exerted substantial effects on the composition of the bacterial community. Specifically, co-inoculation with Rhizophagus intraradices and Acinetobacter calcoaceticus led to an increase in the relative abundance of Acidobacteriota and Patescibacteria in the rhizosphere soil. Conversely, chlorothalonil application resulted in a reduction in the relative abundance of these bacterial taxa.","center":"Heilongjiang University","data_type":"Raw sequence reads","submission_date":"2025/02/26 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN47034532","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2023-10-11",2023,null,null,null,null,"unresolved",null,null,null,"soil sampies",null,null,null,"environmental sample; urban association not established"],["SAMN47034533","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2023-10-11",2023,null,null,null,null,"unresolved",null,null,null,"soil sampies",null,null,null,"environmental sample; urban association not established"],["SAMN47034534","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2023-10-11",2023,null,null,null,null,"unresolved",null,null,null,"soil sampies",null,null,null,"environmental sample; urban association not established"],["SAMN47034535","Metagenome or environmental sample from sludge metagenome","uncertain",null,"2023-10-11",2023,null,null,null,null,"unresolved",null,null,null,"soil sampies",null,null,null,"environmental sample; urban association not established"],["SAMN47034536","Metagenome or environmental sample from slu