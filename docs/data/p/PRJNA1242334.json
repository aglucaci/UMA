{"v":1,"accession":"PRJNA1242334","title":"Comparing mcrA and V4 16S rRNA sequencing in methanogenic archaea","description":"Methanogenic archaea have been increasingly investigated concerning their impact on the environment, role in human health, and technological applications, including the industrial production of biofuel methane as a part of a sustainable energy economy.High-throughput DNA sequencing of the functional mcrA gene is the ideal tool for assessing methanogenic archaea diversity in environmental, biotechnological, and clinical samples. Compared to the 16S rRNA gene, the mcrA gene is specific to methanogenic archaea and provides higher resolution in the phylogeny analysis of methanogens.","center":"Masaryk University","data_type":"Raw sequence reads","submission_date":"2025/03/26 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN47586146","Sewage sludge","probable_urban","municipal_wastewater","2019-01-01",2019,"CZ","South Moravian",3070416,"Modřice","verified",49.1262,16.631,"Czech Republic: Modrice","sewage",null,null,null,"city-level location without sample-site confirmation"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR32868395","SAMN47586146","SRX28149854","Amplicon","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina MiniSeq",56726283,188372,"2026-04-30","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos9/sra-pub-zq-922/SRR032/32868/SRR32868395/SRR32868395.lite.1"],["SRR32868396","SAMN47586146","SRX28149853","Amplicon","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina MiniSeq",51568988,171231,"2026-04-30","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos9/sra-pub-zq-922/SRR032/3286