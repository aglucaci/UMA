{"v":1,"accession":"PRJNA1148285","title":"Sulfur metabolism 16S Raw sequence reads","description":"Biotrickling filter (BTF) is a green and effective method in odor mitigation, which has the advantages of low cost and less by-products. Here, hydrogen sulfide (H2S), dimethyl sulfide (DMS) and dimethyl disulfide (DMDS) were seen as the dominant sulphureous odorants, and the biodegradation performance of these odorants was evaluated in BTF, in which was packed with two modified PP materials and the SDBS was also added. The microbial adaption was investigated under starvation and low temperature under PP modification. Microbial samples were obtained from four stages: starvation (124th day), recovery from starvation (153th day), low temperature (184th day), and recovery to 25 (216th day).","center":"Zhejiang University","data_type":"Raw sequence reads","submission_date":"2024/08/14 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN43191384","MIMARKS Survey related sample from activated sludge metagenome","probable_urban","municipal_wastewater","2024-02-21",2024,"CN",null,null,null,"conflicting",29.11,118.5,"China:Hangzhou",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN43191385","MIMARKS Survey related sample from activated sludge metagenome","probable_urban","municipal_wastewater","2024-02-21",2024,"CN",null,null,null,"conflicting",29.11,118.6,"China:Hangzhou",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN43191386","MIMARKS Survey related sample from activated sludge metagenome","probable_urban","municipal_wastewater","2024-02-21",2024,"CN",null,null,null,"conflicting",29.11,118.7,"China:Hangzhou",null,null,null,null,"city-level location without sample-site confi