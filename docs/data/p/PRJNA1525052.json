{"v":1,"accession":"PRJNA1525052","title":"Community sequencing of Winogradsky column layers before and after Biofilm enrichment","description":"The goal was to determine the community composition of six Winogradsky column layers, developed over 2-years using urban stream sediment, supplemented with PHB bioplastic. The communities were used as starting material for a second enrichment step or 'biofilm assay', in which biomass was encouraged to form on plastic beads (PHB and PET), over 4-weeks. These 'biofilm' communities were then sequenced to allow for comparison between the Winogradsky community (WC) and Biofilm community (BF) composition.","center":"University of Canterbury","data_type":"Raw sequence reads","submission_date":"2026/09/07 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN62993377","Winogradsky Column Community 1","confirmed_urban",null,"2023-05-24",2023,"NZ","Canterbury",2192362,"Christchurch","verified",-43.52,172.58,"New Zealand: Christchurch","Winogradsky column made from urban stream sediment",null,null,null,"explicit urban setting at sample level"],["SAMN62993378","Winogradsky Column Community 2","confirmed_urban",null,"2023-05-24",2023,"NZ","Canterbury",2192362,"Christchurch","verified",-43.52,172.58,"New Zealand: Christchurch","Winogradsky column made from urban stream sediment",null,null,null,"explicit urban setting at sample level"],["SAMN62993379","Winogradsky Column Community 3","confirmed_urban",null,"2023-05-24",2023,"NZ","Canterbury",2192362,"Christchurch","verified",-43.52,172.58,"New Zealand: Christchurch","Winogradsky column made from urban stream sediment",null,null,null,"explicit urban setting at sample level"],["SAMN62993380","Winogradsky Column Community 4","confirmed_urban",null,"2023-05-24