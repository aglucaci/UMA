{"v":1,"accession":"PRJNA363053","title":"Whole Metagenome Profiles of Particulates Collected from the International Space Station","description":"The microbial composition of the International Space Station (ISS) environment is of critical interest due to potential impact of its constituents on human health and operational mission success. This study examined the whole metagenome of ISS microbes at both a species- and gene-level resolution. Air filter and dust samples from the ISS were analyzed and compared to samples collected in a terrestrial cleanroom environment. Samples were collected from ISS and cleanroom environments and treated to examine DNA from total versus viable populations. Microbial genes relevant to human health such as antimicrobial resistance and virulence genes were quantified.","center":"Lawrence Livermore National Laboratory","data_type":"Raw sequence reads","submission_date":"2017/01/24 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN03863796","ISS HEPA","non_urban",null,null,null,"US",null,null,null,"unresolved",null,null,"USA: International Space Station","HEPA debris",null,null,null,"environmental sample from a non-urban site"],["SAMN03863797","ISS HEPA_PMA","non_urban",null,null,null,"US",null,null,null,"unresolved",null,null,"USA: International Space Station","HEPA debris",null,null,null,"environmental sample from a non-urban site"],["SAMN03863798","ISS Debris","non_urban",null,null,null,"US",null,null,null,"unresolved",null,null,"USA: International Space Station","Vacuum cleaner bag debris",null,null,null,"environmental sample from a non-urban site"],["SAMN03863799","ISS Debris_PMA","non_urban",null,null,null,"US",null,null,null,"unresolved",null,null,"USA: International Space Station","Vacuum clea