{"v":1,"accession":"PRJNA1450735","title":"Swine wastewater anaerobic ceramic membrane bioreactor metagenome","description":"This study investigates the concentration-dependent effects of chlortetracycline (CTC) on methanogenesis, microbial community dynamics, and antibiotic resistance genes (ARGs) in an anaerobic ceramic membrane bioreactor (AnCMBR) treating swine wastewater. Metagenomic sequencing was performed on sludge and effluent samples from four operational stages (0, 10, and 50 mg/L CTC, and a recovery phase) to elucidate the microbial mechanisms underlying CTC-induced promotion or inhibition of methane production and the associated spread of ARGs.","center":"an University of Architecture and Technology (XAUAT)","data_type":"Raw sequence reads","submission_date":"2026/04/08 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN57169990","sludge","non_urban",null,null,2025,"CN","Shaanxi",1790630,"Xi’an","probable",null,null,"China:xian","sludge",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN57169991","sludge","non_urban",null,null,2025,"CN","Shaanxi",1790630,"Xi’an","probable",null,null,"China:xian","sludge",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN57169992","sludge","non_urban",null,null,2025,"CN","Shaanxi",1790630,"Xi’an","probable",null,null,"China:xian","sludge",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN57169993","sludge","non_urban",null,null,2025,"CN","Shaanxi",1790630,"Xi’an","probable",null,null,"China:xian","sludge",null,null,null,"BioProject indicates an agricultural or industrial source"],["SAMN57169994","sludge","non_urban",null,null,2025,"CN","Shaanxi",1790630,"Xi’an","probable",null,null,"China:xi