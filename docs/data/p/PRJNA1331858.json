{"v":1,"accession":"PRJNA1331858","title":"Airborne eDNA plant and arthropod communities in west Michigan eastern hemlock forests","description":"Hemlock woolly adelgid (Adelges tsugae) is an invasive insect causing the widespread decline and death of eastern hemlock (Tsuga canadensis). We sampled airborne eDNA in 15 eastern hemlock forests in west Michigan during the summer of 2023. Sites included eastern hemlock stands that had no known infestation and varying levels of infestation. We targeted plant and arthropod communities and sequenced the ITS2 and CO1 regions to compare the taxa detected in uninfested forests with those in infested forests. The goal was to determine if we could use airborne eDNA to characterize these communities and evaluate whether hemlock woolly adelgid has impacted the communities.","center":"Annis Water Resources Institute","data_type":"Raw sequence reads","submission_date":"2025/09/19 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN51696166","BBAP-P108","probable_urban","air_dust",null,2022,"US","West Virginia",4817070,"Oceana","probable",null,null,"USA: Michigan, Oceana County, Benona Township","air",null,null,null,"city-level location without sample-site confirmation"],["SAMN51696167","BBAP-P109","probable_urban","air_dust",null,2022,"US","West Virginia",4817070,"Oceana","probable",null,null,"USA: Michigan, Oceana County, Benona Township","air",null,null,null,"city-level location without sample-site confirmation"],["SAMN51696168","BBAP-P110","probable_urban","air_dust",null,2022,"US","West Virginia",4817070,"Oceana","probable",null,null,"USA: Michigan, Oceana County, Benona Township","air",null,null,null,"city-level location without sample-site confirmation"],["SAMN51696169","BBAP-P111","probable_