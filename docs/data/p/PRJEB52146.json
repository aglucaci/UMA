{"v":1,"accession":"PRJEB52146","title":"Inexpensive high-throughput genome screening of isolate cultures","description":"Conventional screening of cultured isolates uses marker gene amplification and sequencing, potentially leaving substantial amounts of strain diversity unrecognized. Using inexpensive laboratory automation and custom protocols, it is now possible to screen isolates using full genome sequences for only marginally more per unit than Sanger sequencing of 16S rRNA genes.","center":"University of California San Diego Microbiome Initiative","data_type":"Other","submission_date":"2022/05/20 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA13942877",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evidence"],["SAMEA13942938",null,"uncertain",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"no environmental-sample evidence"],["SAMEA13943888","Metagenome or environmental sample from human gut metagenome","non_environmental",null,"2016-02-22",2016,"PL","Mazovia",756135,"Warsaw","verified",52.14,21.0,"Poland:Warsaw",null,null,null,null,"host-derived or clinical material"],["SAMEA13944048","M121.fastq","uncertain",null,"2018-02-19",2018,"ES","Andalusia",2517117,"Granada","probable",37.1655,-3.5916,"Spain",null,"plantation","field soil","biofilter","environmental sample; urban association not established"],["SAMEA13944374","Pathogen: environmental/food/other sample from Salmonella enterica subsp. enterica serovar Cerro","non_environmental",null,"2019-09-17",2019,"US","Kansas",null,null,"unresolved",null,null,"USA:KS","feces",null,null,null,"host-derived or clinical material"]],"run_cols":["accession","sample","exp