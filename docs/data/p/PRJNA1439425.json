{"v":1,"accession":"PRJNA1439425","title":"Metagenomic characterization of wastewater-derived microalgal consortia and associated bacterial communities","description":"This study investigates the taxonomic composition and functional potential of microalgal consortia derived from wastewater environments. Shotgun metagenomic sequencing was used to characterize microbial communities associated with multiple consortia and to identify genes related to photosynthesis, central carbon metabolism, stress response, and nutrient transport. The analysis aimed to better understand microbial interactions within microalgae bacteria systems and to identify bacterial taxa that may influence algal growth dynamics. These data provide insights into the ecological structure and metabolic capabilities of wastewater derived algal consortia and contribute to ongoing efforts to develop stable and productive algal bacterial systems for applications in biofuel production, wastewater treatment, and environmental biotechnology.","center":"FLORIDA A AND M UNIVERSITY","data_type":"Raw sequence reads","submission_date":"2026/03/18 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN56580005","Wastewater microalgal consortium S3G1","uncertain",null,null,2022,"US","Florida",4174715,"Tallahassee","probable",30.4383,-84.2807,"USA: Florida","waste water treatment facility",null,null,null,"environmental sample; urban association not established"],["SAMN56580006","Wastewater microalgal consortium S3G2","uncertain",null,null,2022,"US","Florida",4174715,"Tallahassee","probable",30.4383,-84.2807,"USA: Florida","waste water treatment facility",null,null,null,"environmental sample; urban association not established"],["SAMN56580007","Wastewater microalgal consortium S3G3","u