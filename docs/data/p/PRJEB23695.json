{"v":1,"accession":"PRJEB23695","title":"Host range of antibiotic resistance genes in wastewater treatment plant influent and effluent","description":"We utilized epicPCR to detect the bacterial hosts of antibiotic resistance genes in two WWTPs. We identified the host distribution of four resistance-associated genes (tetM, int1, qacE∆1, blaOXA-58) in influent and effluent. The bacterial hosts of these resistance genes varied between the WWTP influent and effluent, with a generally decreasing host range in the effluent. Through 16S rRNA gene sequencing it was determined that the resistance gene-carrying bacteria include both abundant and rare taxa.","center":"University of Helsinki","data_type":"Other","submission_date":"2018/03/14 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA104680254","Host range of antibiotic resistance genes in wastewater treatment plant influent and effluent","uncertain",null,null,2016,"FI",null,null,null,"unresolved",null,null,"Finland",null,null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMEA104680255","Host range of antibiotic resistance genes in wastewater treatment plant influent and effluent","uncertain",null,null,2016,"FI",null,null,null,"unresolved",null,null,"Finland",null,null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMEA104680256","Host range of antibiotic resistance genes in wastewater treatment plant influent and effluent","uncertain",null,null,2016,"FI",null,null,null,"unresolved",null,null,"Finland",null,null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMEA104680257","Host range of antibiotic resistance genes in wastewater treatment plant influent and effluent","uncertain",null,null,2016,"FI",null,null,null,