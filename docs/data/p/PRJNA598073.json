{"v":1,"accession":"PRJNA598073","title":"Complete Genome Sequence of Moraxella osloensis Strain YV1, Isolated from an Australian Wastewater Treatment Plant","description":"We report the complete genome sequence of Moraxella osloensis strain YV1, which was isolated from a wastewater treatment plant in Australia. The YV1 genome comprises a 2,615,801-bp chromosome and four plasmids. Moraxella osloensis strain YV1 displays the distinctive morphology of Eikelboom morphotype 1863.","center":"La Trobe University","data_type":"Genome sequencing","submission_date":"2020/01/14 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN13697796","Microbe sample from Faucicola osloensis","uncertain",null,null,2017,"AU","Victoria",null,null,"unresolved",null,null,"Australia:Victoria","activated sludge",null,null,null,"conflicting evidence: environmental and host/clinical"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR10802356","SAMN13697796","SRX7476243","WGS","WGS","GENOMIC","SINGLE","OXFORD_NANOPORE","MinION",72124113,9877,"2020-01-13","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos12/sra-pub-zq-1216/SRR010/10802/SRR10802356/SRR10802356.lite.1"],["SRR10802357","SAMN13697796","SRX7476242","WGS","WGS","GENOMIC","PAIRED","ILLUMINA","Illumina MiSeq",596681114,992123,"2020-01-13","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos9/sra-pub-zq-922/SRR010/802/SRR10802357.sralite.1"]],"sample_projects":{}}