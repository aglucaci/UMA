{"v":1,"accession":"PRJNA1519054","title":"Zeolite-nano zero-valent iron-food waste and excess sludge co-digestion","description":"Anaerobic co-digestion of food waste and excess activated sludge is an important way to utilize organic solid waste. However, under high ammonia stress, the poor stability and low methane production efficiency of the process restrict its practical application. To this end, this study proposes a zeolite-supported nano-zero-valent iron regulation strategy to alleviate the inhibition of medium and high concentrations of ammonia and improve the methane production efficiency of the co-digestion system.","center":"Hangzhou normal university","data_type":"Raw sequence reads","submission_date":"2026/08/26 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN62709164","KW_1","probable_urban","municipal_wastewater","2024-12-03",2024,"CN","Zhejiang",1808926,"Hangzhou","verified",30.2489,120.2052,"China: hangzhou",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN62709165","KW_2","probable_urban","municipal_wastewater","2024-12-03",2024,"CN","Zhejiang",1808926,"Hangzhou","verified",30.248,120.205,"China: hangzhou",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN62709166","KW_3","probable_urban","municipal_wastewater","2024-12-03",2024,"CN","Zhejiang",1808926,"Hangzhou","verified",30.249,120.2052,"China: hangzhou",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN62709167","KW_4","probable_urban","municipal_wastewater","2024-12-03",2024,"CN","Zhejiang",1808926,"Hangzhou","verified",30.249,120.2052,"China: hangzhou",null,null,null,null,"city-level location without sample-site confirmation"]],"run_cols":["accession","sampl