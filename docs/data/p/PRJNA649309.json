{"v":1,"accession":"PRJNA649309","title":"Phages associated with dominant functional bacteria in activated sludge plants","description":"In the activated sludge process, many functional populations have been recognized to be vital for wastewater treatment performance. However, scientific information on phages associated with the important functional populations is rather scarce. In this study, phage sequences (vOTUs) were retrieved from the metagenomic data generated from the activated sludges in four full-scale activated sludge plants. Using the prediction methods based on oligonucleotide frequency, we linked many vOTUs to the dominant functional bacteria.","center":"University of Chinese Academy of Sciences","data_type":"Raw sequence reads","submission_date":"2020/07/28 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN15663114","Metagenome or environmental sample from activated sludge metagenome","confirmed_urban","municipal_wastewater",null,2017,"CN","Beijing",1816670,"Beijing","verified",39.96,116.51,"China: Beijing","wastewater treatment plant A",null,null,null,"named urban infrastructure at sample level"],["SAMN15663115","Metagenome or environmental sample from activated sludge metagenome","confirmed_urban","municipal_wastewater",null,2017,"CN","Beijing",1816670,"Beijing","verified",39.96,116.51,"China: Beijing","wastewater treatment plant A",null,null,null,"named urban infrastructure at sample level"],["SAMN15663116","Metagenome or environmental sample from activated sludge metagenome","confirmed_urban","municipal_wastewater",null,2017,"CN","Beijing",1816670,"Beijing","verified",39.96,116.51,"China: Beijing","wastewater treatment plant A",null,null,null,"named urban infrastructure at sample level"],["SAMN15663117","Metage