{"v":1,"accession":"PRJNA1378357","title":"A novel approach for achieving ultra-high enrichment of anaerobic ammonium oxidizing bacteria and nitrogen removal rate in municipal wastewater treatment: A pure biofilm process without suspended sludge","description":"This study aimed to assess the potential of the pure biofilm process without suspended sludge to achieve deep nitrogen removal and AnAOB enrichment in municipal wastewater; quantify the stability of the pure biofilm system under organic load shock and its N2O emission characteristics; explore mechanisms of AnAOB self-enrichment and microbial synergy in the pure biofilm system through FISH CLAM, 16S rRNA sequencing, and metagenomic sequencing analysis. Ultimately, this study offers valuable insights to guide the practical implementation of pure biofilm systems in wastewater treatment engineering.","center":"Beijing University of Technology","data_type":"Raw sequence reads","submission_date":"2025/12/09 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN53833605","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2024-03-10",2024,"CN","Beijing",1816670,"Beijing","probable",null,null,"China:Beijing","active sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN53833606","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2024-04-11",2024,"CN","Beijing",1816670,"Beijing","probable",null,null,"China:Beijing","active sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN53833607","Metagenome or environmental sample from sludge metagenome","probable_urban","municipal_wastewater","2024-04-11",2024,"CN","Beijing",1816670,"Be