{"v":1,"accession":"PRJNA1390389","title":"Mechanisms of  Quinone-Functionalized FeOOH for Enhanced Nitrogen Removal in a  Micro-aerobic Activated Sludge Process Treating Low C/N Wastewater","description":"Micro-aerobic biological nitrogen treatment technology for low carbon-to nitrogen (C/N) ratio wastewater often faces issues such as high effluent nitrate concentration and unstable treatment performance. This is because the inoculated sludge is typically dominated by heterotrophic denitrification and lacks the specialecological niche of multiple functional microorganisms coexisting under microaerobic conditions. In this study, quinone-functionalized FeOOH was synthesized via a green method and added to a microaerobic bioreactor to investigate its effects on activated sludge and the underlying promotion mechanisms.","center":"Taiyuan University of Technology","data_type":"Raw sequence reads","submission_date":"2025/12/17 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN54181269","Metagenome or environmental sample from metagenome","probable_urban","municipal_wastewater","2023-11-08",2023,"CN","Shanxi",10942283,"Jinzhong","verified",37.45,112.43,"China:Shanxi,Jinzhong","activated sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN54181270","Metagenome or environmental sample from metagenome","probable_urban","municipal_wastewater","2024-01-12",2024,"CN","Shanxi",10942283,"Jinzhong","verified",37.45,112.43,"China:Shanxi,Jinzhong","activated sludge",null,null,null,"city-level location without sample-site confirmation"],["SAMN54181271","Metagenome or environmental sample from metagenome","probable_urban","municipal_wastewater","2024-06-01",2024,"CN","Shanxi",10942283,"Jinzhong","verified",37.45,112