{"v":1,"accession":"PRJNA1152766","title":"Large-scale swine wastewater Raw sequence reads","description":"This study adopts high-throughput sequencing technology to characterize the structure of microbial community water samples from various treatment processes in a stably operating swine wastewater treatment system (SWTS) to determine the main functional bacteria and their changing rules in each treatment process. Furthermore, the correlation analysis between environmental factors and microbial communities is used (1) to determine functional microorganisms that play essential roles in pollutant degradation and (2) to search for environmental factors that drive variations in microbial community structure and abundance to lay a theoretical foundation for subsequent microbial community regulation.","center":"Fujian Academy of Agricultural Sciences","data_type":"Raw sequence reads","submission_date":"2024/08/27 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN43387862","CK_1","uncertain",null,"2024-04-15",2024,"CN","Fujian",1806167,"Jian’ou","probable",27.02,118.3,"China: Fujian","swine wastewater",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN43387863","CK_2","uncertain",null,"2024-04-15",2024,"CN","Fujian",1806167,"Jian’ou","probable",27.02,118.3,"China: Fujian","swine wastewater",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN43387864","CK_3","uncertain",null,"2024-04-15",2024,"CN","Fujian",1806167,"Jian’ou","probable",27.02,118.3,"China: Fujian","swine wastewater",null,null,null,"conflicting evidence: environmental and host/clinical"],["SAMN43387865","HM_1","uncertain",null,"2024-04-15",2024,"CN","Fujian",1806167,"Jian’ou","probable",27.02,118.3,"China: Fujian","sw