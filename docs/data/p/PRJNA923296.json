{"v":1,"accession":"PRJNA923296","title":"Farm contribution to the swine value chain microbiome","description":"A thorough understanding of the microbial ecology of the swine value chain is essential to develop new strategies to optimize the microbiological quality of pork products. To our knowledge, no study to date has been performed following farm animals to the meat obtained from these animals. The objective of this study is to evaluate how the microbiota of pigs, originating from two farms with different sanitary status, and their environment influence the microbial composition of the value chain, the contamination of the slaughterhouse and meat microbiological quality.","center":"Universite Laval","data_type":"Raw sequence reads","submission_date":"2023/01/12 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN32710735","Metagenome or environmental sample from air metagenome","non_urban",null,null,2019,"CA","Quebec",6325494,"Québec","probable",null,null,"Canada: Quebec","Housing barn air",null,null,null,"environmental sample from a non-urban site"],["SAMN32710736","Metagenome or environmental sample from air metagenome","non_urban",null,null,2019,"CA","Quebec",6325494,"Québec","probable",null,null,"Canada: Quebec","Housing barn air",null,null,null,"environmental sample from a non-urban site"],["SAMN32710737","Metagenome or environmental sample from air metagenome","non_urban",null,null,2019,"CA","Quebec",6325494,"Québec","probable",null,null,"Canada: Quebec","Housing barn air",null,null,null,"environmental sample from a non-urban site"],["SAMN32710738","Metagenome or environmental sample from air metagenome","non_urban",null,null,2019,"CA","Quebec",6325494,"Québec","probable",null,null,"Canada: Quebec","Housing barn air",null