{"v":1,"accession":"PRJNA718074","title":"WA state granular, mainstream WWTP, and fish sludge communities","description":"The sequence data presented here are derived from the King County West Point granular and mainstream sludge communities, fish sludge from Riverence Aquaculture. The communities were combined under two scenarios, one in which a fermentation of the fish sludge was carried out in a fermenter and another in an SBR. The data are presented in the submitted manuscript under review \" Novel, low-cost solid waste treatment for closed containment freshwater aquaculture combining fermentation with a sequential batch reactor for the remineralisation of fish solids\", Aquaculture Engineering, 2021.","center":"Univeristy of Gothenburg","data_type":"Raw sequence reads","submission_date":"2021/03/28 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN18521709","West Point WWTP (Seattle, USA) anaerobic sludge community","confirmed_urban","municipal_wastewater",null,2020,"US","Washington",5809844,"Seattle","probable",47.6,-122.33,"USA: Western Washington",null,"ENVO:00002043","ENVO:01000206","ENVO:00002043","named urban infrastructure at sample level"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR14120219","SAMN18521709","SRX10490584","Amplicon","AMPLICON","METATRANSCRIPTOMIC","PAIRED","ILLUMINA","Illumina NovaSeq 6000",37506674,169655,"2021-03-31","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos9/sra-pub-zq-924/SRR014/14120/SRR14120219/SRR14120219.lite.1"],["SRR14120220","SAMN18521709","SRX10490583","Amplicon","AMPLICON","METATRANSCRIPTOMIC","PAIRED","ILLUMINA","Illumina NovaSeq 6000",41482178,187917,"2021-