{"v":1,"accession":"PRJNA1222598","title":"Shotgun metagenome sequencing of human fecal","description":"This study focuses on the Shotgun metagenome sequencing of human fecal samples. The samples were collected from both Attention Deficit Hyperactivity Disorder (ADHD) patients and healthy controls. The main aim is to comprehensively analyze the microbial communities within these fecal samples.By conducting metagenome sequencing, we intend to identify characteristic bacteria at various taxonomic levels in ADHD patients. Specifically, we are particularly interested in uncovering the characteristic bacteria at the species level. Understanding the unique bacterial signatures associated with ADHD at the species level can potentially provide valuable insights into the complex relationship between the gut microbiota and ADHD. This knowledge may contribute to the development of novel diagnostic markers and therapeutic strategies for ADHD.","center":"Hangzhou Medical College","data_type":"Raw sequence reads","submission_date":"2025/02/12 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN46785179","Healthy Control","non_environmental",null,null,2020,"CN","Zhejiang",1808926,"Hangzhou","verified",null,null,"China: Hangzhou","feces",null,null,null,"host-derived or clinical material"],["SAMN46785180","Healthy Control","non_environmental",null,null,2020,"CN","Zhejiang",1808926,"Hangzhou","verified",null,null,"China: Hangzhou","feces",null,null,null,"host-derived or clinical material"],["SAMN46785181","Healthy Control","non_environmental",null,null,2020,"CN","Zhejiang",1808926,"Hangzhou","verified",null,null,"China: Hangzhou","feces",null,null,null,"host-derived or clinical material"],["SAMN46785182","Attention deficit and hyperactivity disorder