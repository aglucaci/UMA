{"v":1,"accession":"PRJNA1148129","title":"Microbial communities at the sea-air interface of the North Atlantic Ocean","description":"Microbial communities at the ocean-atmosphere interface were collected along a 14,400 km transect from the polar circle to the equator in the North Atlantic Ocean. Communities were analyzed using the v4-v5 region of the 16S rRNA gene sequenced (primers 515F, 924R). Air and surface ocean microbiomes were taxonomically distinct, sharing few species-level lineages. Terrestrial-derived air masses caused shifts in the air and water microbial communities.","center":"Max Planck Institute for Chemistry","data_type":"Raw sequence reads","submission_date":"2024/08/14 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN43183964","lower atmosphere sample","non_urban",null,"2020-07-12",2020,null,null,null,null,"unresolved",66.98,-5.97,"Atlantic Ocean",null,"aquatic biome [ENVO_00002030] | marine biome [ENVO_00000447] | atmospheric aerosol [ENVO_01001652]","subpolar biome [ENVO_01001834]","aerosol [ENVO_00010505] | atmospheric aerosol [ENVO_01001652]","environmental sample from a non-urban site"],["SAMN43183966","lower atmosphere sample","non_urban",null,"2020-07-12",2020,null,null,null,null,"unresolved",67.03,-5.98,"Atlantic Ocean",null,"aquatic biome [ENVO_00002030] | marine biome [ENVO_00000447] | atmospheric aerosol [ENVO_01001652]","subpolar biome [ENVO_01001834]","aerosol [ENVO_00010505] | atmospheric aerosol [ENVO_01001652]","environmental sample from a non-urban site"],["SAMN43183968","lower atmosphere sample","non_urban",null,"2020-07-13",2020,null,null,null,null,"unresolved",65.8,-9.64,"Atlantic Ocean",null,"aquatic biome [ENVO_00002030] | marine biome [ENVO_00000447] | atmospheric aerosol [ENVO_01001652