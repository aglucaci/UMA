{"v":1,"accession":"PRJEB26799","title":"The Influence of Occupancy and Ventilation on Airborne Bacterial Community Structure","description":"This study quantifies the influence of ventilation and indoor emissions on concentrations and particle sizes of airborne indoor bacterial taxa and further examines geographical variability, each of which may affect personal exposures to bacteria. Quantitative PCR and multiplexed DNA sequencing were employed to count and identify bacterial aerosol particles indoors and outdoors in seven school classrooms in four different countries. Quantitative diversity analysis was combined with building characterization and mass balance modeling to apportion source contributions of indoor airborne bacterial particles.","center":"University of California San Diego Microbiome Initiative","data_type":"Other","submission_date":"2019/05/19 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA4667254","The Influence of Occupancy and Ventilation on Airborne Bacterial Community Structure; 10430.A10occinD1P3","non_urban",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,"air","environmental sample from a non-urban site"],["SAMEA4667255","The Influence of Occupancy and Ventilation on Airborne Bacterial Community Structure; 10430.A10occinD1P6","non_urban",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,"air","environmental sample from a non-urban site"],["SAMEA4667256","10430.A10occinD1PEMALL; The Influence of Occupancy and Ventilation on Airborne Bacterial Community Structure","non_urban",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,"air","environmental sample from a non-urban site"],["SAMEA4667257","The Influence of Occupancy