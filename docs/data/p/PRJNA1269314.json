{"v":1,"accession":"PRJNA1269314","title":"Study on Mainstream Anaerobic Ammonium Oxidation Process under High Dissolved Oxygen Conditions.","description":"This research investigates the mainstream anaerobic ammonium oxidation (anammox) process under high dissolved oxygen conditions. By examining the behavior of anammox bacteria, reaction kinetics, and nitrogen removal efficiency, this study aims to uncover the underlying mechanisms affected by elevated oxygen levels. The findings will provide valuable insights for optimizing anammox processes in diverse water environments, contributing to more sustainable and cost-effective nitrogen pollution control in the future.","center":"Qingdao University","data_type":"Raw sequence reads","submission_date":"2025/05/29 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN48785445","Biofilm_1","probable_urban","municipal_wastewater","2024-07-01",2024,"CN",null,null,null,"conflicting",37.5109,122.1005,"China: qingdao",null,null,null,null,"city-level location without sample-site confirmation"],["SAMN48785446","Biofilm_2","probable_urban","municipal_wastewater","2024-10-11",2024,"CN",null,null,null,"conflicting",37.5109,122.1005,"China: qingdao",null,null,null,null,"city-level location without sample-site confirmation"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["SRR33745086","SAMN48785446","SRX28968369","Amplicon","AMPLICON","METAGENOMIC","PAIRED","ILLUMINA","Illumina MiSeq",12038012709,39949181,"2025-05-29","https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos1/sra-pub-zq-38/SRR033/33745/SRR33745086/SRR33745086.lite.1"],["SRR33745087","SAMN48785445","SRX28968368","Amplicon","AMPLI