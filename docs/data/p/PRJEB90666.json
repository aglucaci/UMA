{"v":1,"accession":"PRJEB90666","title":"Optimizing storage, high-molecular weight DNA extraction and genome reconstructions from human faecal samples","description":"We assessed the effectiveness of extracting high molecular weight DNA from faecal samples, using different combinations of collection, storage and extraction kits. Faecal samples were either immediately processed, frozen at -80°C or stored in DNA/RNA Shield, GutAlive or OMNIgeneGUT and then subjected to 3 different DNA isolation kits, totalling 32 evaluated combinations. Isolated DNA was assessed for its quality and quantity using Qubit, NanoDrop and Tapestation; taxonomic consistency of extracted microbiomes was validated using  metataxonomics.","center":"Quadram Institute Bioscience","data_type":"Other","submission_date":"2025/08/01 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMEA118581495",null,"non_environmental",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"host-derived or clinical material"],["SAMEA118581496",null,"non_environmental",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"host-derived or clinical material"],["SAMEA118581497",null,"non_environmental",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"host-derived or clinical material"],["SAMEA118581498",null,"non_environmental",null,null,null,null,null,null,null,"unresolved",null,null,null,null,null,null,null,"host-derived or clinical material"]],"run_cols":["accession","sample","experiment","assay","strategy","source","layout","platform","instrument","bases","spots","release_date","download_url"],"runs":[["ERR15463326","SAMEA118581498","ERX14867258","WGS","WGS","METAGENOMIC","PAIRED","ILLUMINA