{"v":1,"accession":"PRJNA1125196","title":"Enhanced Resistance and Resilience of Anaerobic Digestion Microbiome after Single and Dual Short-Term Disturbances","description":"Anaerobic digesters are often operated at high solids retention times (SRTs) of 20 d or longer to alleviate the effect of accidental substrate overloading. This study explores the potential of using pulse disturbances to prime the anaerobic digestion (AD) microbiome at a shorter SRT of 5 days by subjecting the digesters to single and dual short-term disturbances in the form of sudden reduction in SRT from 15 d to 5 d. Our findings suggest that strategic disturbances increased the resilience of the AD microbial community and facilitated a faster recovery of process performance during sustained disturbance periods at low SRT.","center":"Nanyang Technological University","data_type":"Raw sequence reads","submission_date":"2024/06/18 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMN47424525","16S rRNA amplicon sequence of substrate from municipal wastewater treatment plant","confirmed_urban","municipal_wastewater","2017-05-30",2017,"SG",null,1880252,"Singapore","probable",null,null,"Singapore","Genomic DNA",null,null,null,"explicit urban setting at sample level"],["SAMN47424527","16S rRNA amplicon sequence of substrate from municipal wastewater treatment plant","confirmed_urban","municipal_wastewater","2017-08-02",2017,"SG",null,1880252,"Singapore","probable",null,null,"Singapore","Genomic DNA",null,null,null,"explicit urban setting at sample level"],["SAMN47424528","16S rRNA amplicon sequence of substrate from municipal wastewater treatment plant","confirmed_urban","municipal_wastewater","2017-10-03",2017,"SG",null,1880252,"Singapore","probable",null,null,"Sing