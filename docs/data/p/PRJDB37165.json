{"v":1,"accession":"PRJDB37165","title":"Metagenomic sequencing of hospital wastewater samples from Chongqing, China (PRJCA041808)","description":"This project aims to characterize microbial communities, antibiotic resistance genes, and functional gene profiles in hospital wastewater collected from Chongqing, China. All samples were sequenced on the BGI T7 platform, with each sample generating over 20 Gb of paired-end data. The results provide insights into the public health risks and ecological impacts associated with hospital-derived microbial contaminants in urban environments.","center":"Ecological and Environment Monitoring Center of Chongqing","data_type":"Other","submission_date":"2025/09/24 00:00","sample_cols":["accession","title","tier","context","collection_date","collection_year","country","region","place_id","place","location_status","lat","lon","submitted_location","isolation_source","env_broad_scale","env_local_scale","env_medium","eligibility_reason"],"samples":[["SAMD01632661","CQHW-ZL1 (SAMC5315619)","uncertain",null,"2023-08-02",2023,null,null,null,null,"unresolved",null,null,"missing: data agreement established pre-2023",null,"hospital","sewage","waste water","conflicting evidence: environmental and host/clinical"],["SAMD01632662","CQHW-DP1 (SAMC5315620)","uncertain",null,"2023-08-02",2023,null,null,null,null,"unresolved",null,null,"missing: data agreement established pre-2023",null,"hospital","sewage","waste water","conflicting evidence: environmental and host/clinical"],["SAMD01632663","CQHW-LJET1 (SAMC5315621)","uncertain",null,"2023-08-02",2023,null,null,null,null,"unresolved",null,null,"missing: data agreement established pre-2023",null,"hospital","sewage","waste water","conflicting evidence: environmental and host/clinical"],["SAMD01632664","CQHW-XN1 (SAMC5315622)","uncertain",null,"2023-08-02",2023,null,null,null,null,"unresolved",null,null,"missing: data agreement established pre-2023",null,"hospital","sewage","waste water","conflicting e